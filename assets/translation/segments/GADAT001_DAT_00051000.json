      "channel": 1,
      "context": {
        "voice": "GA404044,3",
        "speaker": "006",
        "face": "181,189,0,142"
      },
      "original": "わかりました……。\n検討します。\n",
      "translation": "알겠습니다…… 검토하겠습니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
