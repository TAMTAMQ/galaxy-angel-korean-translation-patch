{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_00031800.txt",
    "encoding": "cp932",
    "sha256": "08983f90e88948feca9729a80b35ae9a9aaeb2e95c70aea89b9481e1b410ec8a",
    "dialogue_count": 125
  },
  "units": [
    {
      "id": "GADAT001_DAT_00031800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "小腹が空いたな。\n何か軽く食べていこうかな。\n",
      "translation": "출출하네. 뭐 좀 가볍게 먹고 갈까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "えーっと、今日のメニューはと……。\nＡランチにＢランチ、キーマカレーにおでんか。\n",
      "translation": "음, 오늘의 메뉴는... A 런치에 B 런치, 키마\n카레 아니면 오뎅인가.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0"
      },
      "original": "……おでん？\n食堂のメニューにしては、珍しいなぁ。\n",
      "translation": "...오뎅? 식당 메뉴치고는 드문데 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "定食というほどには、腹も減ってないし。\nすみませーん、おでんひとつ！\n",
      "translation": "정식이라고 하기엔 배도 안 고프고. 저기요,\n오뎅 하나 주세요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "024",
        "face": "581,0,0,0",
        "voice": "GA305001,3"
      },
      "original": "おでん一丁ね。\nはい、どうぞ。\n",
      "translation": "오뎅 하나 나왔습니다. 자, 여기요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA305001,3"
      },
      "original": "うわぁ、本当にアツアツのおでんだよ。\nチクワに大根にはんぺん……。\nどれもうまそうだな。\n",
      "translation": "우와, 정말 뜨끈뜨끈한 오뎅이야. 치쿠와에\n무에 한펜... 뭐든 맛있겠네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA305001,3"
      },
      "original": "よし、いただきまー……。\n",
      "translation": "좋아, 잘 먹겠습니...\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "142,0,0,0",
        "voice": "GA305002,3"
      },
      "original": "お、いいもの食べてるじゃないか。\n",
      "translation": "오, 좋은 거 먹고 있잖아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,0,0",
        "voice": "GA305003,3"
      },
      "original": "もぐもぐ……。\n",
      "translation": "우물우물...\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0",
        "voice": "GA305003,3"
      },
      "original": "ああっ、フォルテ！？\nい、いつの間に。\n",
      "translation": "아앗, 포르테!? 어, 언제 사이에.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,0,0",
        "voice": "GA305004,3"
      },
      "original": "うん、もふバイわふぃむえうえ。\n",
      "translation": "응, 모후바이와후이무에우에.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA305004,3"
      },
      "original": "いや、「よくダシがしみてるね」じゃなくて。\nそれ、オレのなんだけど？\n",
      "translation": "아니, \"국물이 잘 배었네\"가 아니라. 그거 내\n건데?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "142,0,0,0",
        "voice": "GA305005,3"
      },
      "original": "……よく言ってることがわかったね。\n",
      "translation": "……잘 말하고 있는 건 알겠네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,0,0",
        "voice": "GA305005,3"
      },
      "original": "いや、何となく。\nそんなことより、勝手に食べないでくれよ。\n",
      "translation": "아니, 왠지 말이야. 그런 것보다, 마음대로\n먹지 말아줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0015",
      "channel": 1,
      "context": {
        "face": "142,0,0,0",
        "speaker": "005",
        "voice": "GA305006,3"
      },
      "original": "いいじゃん、１個ぐらい。\nあ、大根ももらうよ。\n",
      "translation": "괜찮잖아, 한 개 정도는. 아, 무도 받을게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0",
        "voice": "GA305006,3"
      },
      "original": "１個じゃないじゃないか。\nああっ、チクワまで……！\n",
      "translation": "한 개가 아니잖아. 아앗, 치쿠와까지……!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0017",
      "channel": 1,
      "context": {
        "voice": "GA305006,3",
        "speaker": "001",
        "face": "004,0,141,0"
      },
      "original": "ひどいよ、フォルテ。\nオレのおでん……。\n",
      "translation": "너무해, 포르테. 내 오뎅이……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,142,0",
        "voice": "GA305007,3"
      },
      "original": "あはは、つい止まんなくなっちゃってねぇ。\n好きなんだよ、おでん。\n",
      "translation": "아하하, 나도 모르게 멈출 수가 없어서\n말이야. 좋아하거든, 오뎅.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,142,0",
        "voice": "GA305007,3"
      },
      "original": "まぁ、まだ残ってるけど。\nまさか、これもほしいなんて言わないよね？\n",
      "translation": "뭐, 아직 남아있긴 하지만. 설마, 이것도 갖고\n싶다고 하지는 않겠지?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,166,0",
        "voice": "GA305008,3"
      },
      "original": "おや、くれるのかい？\n",
      "translation": "어라, 주는 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,166,0",
        "voice": "GA305008,3"
      },
      "original": "え？\nどうしようかな……。\n",
      "translation": "에? 어떻게 할까나……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "009,0,166,0",
        "voice": "GA305008,3"
      },
      "original": "わかった、全部食べてくれていいよ。\nオレはそんなに腹が減ってるわけじゃないし。\n",
      "translation": "알았어, 전부 먹어도 좋아. 난 그렇게 배가\n고픈 건 아니니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0023",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,142,0",
        "voice": "GA305009,3"
      },
      "original": "ホントに？\n言ってみるもんだねぇ。\nんじゃ、遠慮なく。\n",
      "translation": "정말? 말해두길 잘했네. 그럼, 사양 않고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0024",
      "channel": 1,
      "context": {
        "voice": "GA305009,3",
        "speaker": "001",
        "face": "012,0,142,0"
      },
      "original": "そんなに好きなら、自分でももらって来ればいい\nのに。\n",
      "translation": "그렇게 좋으면, 직접 가서 가져오면 될 텐데.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,141,0",
        "voice": "GA305010,3"
      },
      "original": "もちろん、この後でまた食べるともさ。\n食えるときに食っとかないとね。\n毎日メニューに出るわけじゃないからさ。\n",
      "translation": "물론, 이따가 또 먹어야지. 먹을 수 있을 때\n먹어둬야 해. 매일 메뉴에 나오는 게 아니니까\n말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,141,0",
        "voice": "GA305010,3"
      },
      "original": "コンビニでも置いてるだろ？\n",
      "translation": "편의점에서도 팔잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,173,0",
        "voice": "GA305011,3"
      },
      "original": "コンビニのやつは、味が今イチでねぇ。\nその点、ここのおでんは、いつも行ってた屋台に\n匹敵するうまさなんだよ。\n",
      "translation": "편의점 건 맛이 좀 애매하거든. 그 점에선,\n여기 오뎅은 항상 가던 포장마차에 필적하는\n맛이라구.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,173,0",
        "voice": "GA305011,3"
      },
      "original": "そうなんだ？\n……って、オレまだ食べてないんだよな。\n",
      "translation": "그래? ……아니, 나 아직 안 먹었단 말이지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,142,0",
        "voice": "GA305012,3"
      },
      "original": "なんだ、まだ全然食べてなかったのかい？\nよし、じゃあ代わりに、今度はあたしがおごるよ。\n",
      "translation": "뭐야, 아직 전혀 못 먹었던 거야? 좋아, 그럼\n대신에 이번엔 내가 쏠게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,142,0",
        "voice": "GA305012,3"
      },
      "original": "おごると言ったって、ここの食堂はお金を払って\n買うわけじゃないけどね。\n",
      "translation": "쏜다고 해도, 여기 식당은 돈을 내고 사는 건\n아니지만 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0031",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,166,0",
        "voice": "GA305013,3"
      },
      "original": "それもそうだね。\nあはははは！\n",
      "translation": "그것도 그렇네. 아하하하하!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0032",
      "channel": 1,
      "context": {
        "face": "141,0,142,0",
        "speaker": "005",
        "voice": "GA305014,3"
      },
      "original": "じゃあ、この礼はそのうちするよ。\n",
      "translation": "그럼, 이 답례는 조만간 할게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,142,0",
        "voice": "GA305014,3"
      },
      "original": "ああ、期待せずに待ってるよ。\n",
      "translation": "아아, 기대하지 않고 기다릴게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0034",
      "channel": 1,
      "context": {
        "face": "005,0,166,0",
        "voice": "GA305014,3",
        "speaker": "001"
      },
      "original": "ずうずうしいなぁ。\nオレのを勝手に食べた上に、それはないだろ？\n",
      "translation": "뻔뻔스럽긴. 내 걸 멋대로 먹어놓고선, 그건\n좀 아니잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0035",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,173,0",
        "voice": "GA305015,3"
      },
      "original": "へいへい、悪かったよ。\nそんなに怒ることないだろ？\n",
      "translation": "에이 에이, 미안해. 그렇게 화낼 것까지는\n없잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0036",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,173,0",
        "voice": "GA305015,3"
      },
      "original": "いや、怒るというか、あきれたというか……。\n",
      "translation": "아니, 화를 낸다기보다 어이가 없달까……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0037",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,141,0",
        "voice": "GA305016,3"
      },
      "original": "それじゃ、ふたつもらってきて、ひとつお前さん\nにあげるよ。\nどうせ、自分でも別に食べるつもりだったし。\n",
      "translation": "그럼, 두 개 받아와서 하나는 너한테 줄게.\n어차피 너도 딱히 먹을 생각은 없었을 테고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,141,0",
        "voice": "GA305016,3"
      },
      "original": "いや、いいよ。\nフォルテの食べっぷりを見ているだけで、お腹が\nいっぱいになったし。\n",
      "translation": "아니, 됐어. 포르테가 먹는 걸 보는 것만으로도\n배가 불러버렸으니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0039",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "010,0,166,0",
        "voice": "GA305016,3"
      },
      "original": "せめて、玉子だけは残してくれ！\nそれだけが楽しみなんだ。\n",
      "translation": "적어도 계란만큼은 남겨줘! 그것만이 내\n즐거움이라고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0040",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,141,0",
        "voice": "GA305017,3"
      },
      "original": "大丈夫。\nあたしにだって、そのくらいの情けはあるよ。\n……で、それ以外は食べちまっていいんだね？\n",
      "translation": "괜찮아. 나도 그 정도 자비는 있다구. ……그래\n서, 그거 말고 나머지는 다 먹어도 되는 거지?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0041",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "009,0,141,0",
        "voice": "GA305017,3"
      },
      "original": "ああ……お好きなように。\n驚くやら脱力するやらで、もうどうでもいいや。\n",
      "translation": "아아…… 마음대로 해. 놀라울지 탈진할지,\n이제 아무래도 상관없어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0042",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,173,0",
        "voice": "GA305018,3"
      },
      "original": "なにボーッとしてんだい？\nヘンな男だねぇ。\n",
      "translation": "왜 멍하니 있는 거야? 이상한 남자네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0043",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,166,0",
        "voice": "GA305019,3"
      },
      "original": "まぁ、いいや。\nいただきまーす。\n",
      "translation": "뭐, 됐어. 잘 먹겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0044",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,166,0",
        "voice": "GA305019,3"
      },
      "original": "はい、どうぞ。\n……って、何だかなぁ……。\n",
      "translation": "자, 드세요. ……아니, 뭐야 이게……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0045",
      "channel": 1,
      "context": {
        "voice": "GA305019,3",
        "speaker": "001",
        "face": "006,0,0,0"
      },
      "original": "あ、ミントじゃないか。\nおーい、ミント。\n",
      "translation": "아, 민트잖아. 어이, 민트.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0046",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "103,0,0,0",
        "voice": "GA306001,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0047",
      "channel": 1,
      "context": {
        "face": "006,0,0,0",
        "voice": "GA306001,3",
        "speaker": "001"
      },
      "original": "あれ、聞こえてないのかな？\nミント？\n",
      "translation": "어라, 안 들리는 건가? 민트?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0048",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,104,0",
        "voice": "GA306002,3"
      },
      "original": "あら、タクトさん。\n失礼いたしました。\n",
      "translation": "어머, 택트 씨. 실례했습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0049",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,104,0",
        "voice": "GA306002,3"
      },
      "original": "ずいぶん熱心に立ち読みしてたみたいだね。\n何の雑誌？\n",
      "translation": "꽤 열심히 훑어보고 있었나 보네. 무슨 잡지야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0050",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,101,0",
        "voice": "GA306003,3"
      },
      "original": "『月刊　駄菓子クラブ』ですわ。\n　いつも買っている雑誌なのですが、見かけると\n　つい読みふけってしまいまして。\n",
      "translation": "『월간 막과자 클럽』이에요. 항상 사는 잡지인데, 보이면 그만 푹 빠져 읽게 되어서요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0051",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,101,0",
        "voice": "GA306003,3"
      },
      "original": "なるほど、ミントらしいというか……。\nオレはてっきり、また占いの本でも読んでるのか\nと思ったよ。\n",
      "translation": "그렇구나, 민트답다고 해야 할까…… 난 내심,\n또 점술 책이라도 읽고 있는 건가 싶었어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0052",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,102,0",
        "voice": "GA306004,3"
      },
      "original": "うふふふ。\nそういった本も、たまにランファさんから貸して\nいただいていますけれど。\n",
      "translation": "우후후후. 그런 책도, 가끔 란파 씨에게\n빌려서 읽고 있습니다만.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0053",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,102,0",
        "voice": "GA306004,3"
      },
      "original": "ミントも、やっぱり占いは好きなの？\n",
      "translation": "민트도, 역시 점술은 좋아해?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0054",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,101,0",
        "voice": "GA306005,3"
      },
      "original": "ランファさんほどではありませんが、興味はあり\nますわね。\n",
      "translation": "란파 씨만큼은 아니지만, 흥미는 있어요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0055",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,109,0",
        "voice": "GA306006,3"
      },
      "original": "もっとも、どちらかというと私の場合、人の心理\nに対するアプローチ手法について、ですが。\n",
      "translation": "다만, 굳이 말하자면 제 경우에는, 사람의\n심리 에 대한 접근 방식에 대해서입니다만.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0056",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,109,0",
        "voice": "GA306006,3"
      },
      "original": "え……？\nえーと、よくわからないんだけど……とりあえず、\n興味はあるんだね。\n",
      "translation": "어……? 음, 잘 모르겠지만…… 일단, 흥미는\n있다는 거네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0057",
      "channel": 1,
      "context": {
        "face": "101,0,102,0",
        "voice": "GA306007,3",
        "speaker": "004"
      },
      "original": "そういえば、タクトさん。\nこの雑誌に、駄菓子を使った占いが載っていたの\nですが、試してご覧になります？\n",
      "translation": "그러고 보니, 택트 씨. 이 잡지에, 과자를\n이용한 점술이 실려 있었 는데, 한번 해\n보시겠어요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0058",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,102,0",
        "voice": "GA306007,3"
      },
      "original": "駄菓子を使った占い？\n",
      "translation": "과자를 이용한 점술?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0059",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,121,0",
        "voice": "GA306008,3"
      },
      "original": "ええ。\nこちらに来てください。\n",
      "translation": "네. 이쪽으로 오세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0060",
      "channel": 1,
      "context": {
        "voice": "GA306009,3",
        "speaker": "004",
        "face": "101,0,0,0"
      },
      "original": "さあ、ここですわ。\n",
      "translation": "자, 여기예요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0061",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,0,0",
        "voice": "GA306010,3"
      },
      "original": "これは、ガムボールマシンという機械ですわ。\nお金を入れてハンドルを回すと、フーセンガムが\n出てきますの。\n",
      "translation": "이것은, 껌볼 머신이라는 기계입니다. 돈을\n넣고 핸들을 돌리면, 풍선껌이 나온답니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0062",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA306010,3"
      },
      "original": "それは知ってるけど……。\nまさか、これで占いを？\n",
      "translation": "그건 알고 있지만…… 설마, 이걸로 점을 치는\n건가?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0063",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,0,0",
        "voice": "GA306011,3"
      },
      "original": "そのとおりです。\n気になる人のことを思い浮かべながら、ハンドル\nを回してくださいませ。\n",
      "translation": "그렇습니다. 궁금한 사람을 떠올리면서,\n핸들을 돌려주세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0064",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "122,0,0,0",
        "voice": "GA306012,3"
      },
      "original": "そうして出てきたガムの色で、相手に思いが届く\nかどうかを占うんですの。\n",
      "translation": "그렇게 해서 나온 껌의 색깔로, 상대에게\n마음이 닿을지 어떨지를 점치는 것이랍니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0065",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA306012,3"
      },
      "original": "へぇ、いろんな占いがあるんだな。\n気になる相手を思い浮かべて……か。\n",
      "translation": "헤에, 여러 가지 점술이 있구나. 궁금한\n상대를 떠올리며…… 인가.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0066",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA306012,3"
      },
      "original": "よし、やってみるか。\nものは試しってやつだよな。\n",
      "translation": "좋아, 해볼까. 밑져야 본전이라는 거지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0067",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "102,0,0,0",
        "voice": "GA306013,3"
      },
      "original": "では、気になる人のことを思い浮かべてください。\n",
      "translation": "그럼, 궁금한 사람을 떠올려 주세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0068",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA306013,3"
      },
      "original": "ああ、それでこのハンドルを回すんだよね？\n",
      "translation": "아아, 그래서 이 핸들을 돌리는 거지?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0069",
      "channel": 1,
      "context": {
        "voice": "GA306013,3",
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "……うん？\nちょっと待てよ？\n",
      "translation": "……응? 잠깐 기다려 봐.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0070",
      "channel": 1,
      "context": {
        "voice": "GA306014,3",
        "speaker": "004",
        "face": "101,0,101,0"
      },
      "original": "どうかなさいました？\n",
      "translation": "왜 그러시나요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0071",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,101,0",
        "voice": "GA306014,3"
      },
      "original": "いや……気になる人のことを考えると、ミントに\nテレパシーで読まれちゃうんじゃないか？\n",
      "translation": "아니…… 궁금한 사람을 생각하면, 민트에게\n텔레파시로 읽혀버리는 거 아냐?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0072",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,102,0",
        "voice": "GA306015,3"
      },
      "original": "あら、わかりました？\nさすがですわね。\n",
      "translation": "어머, 눈치채셨나요? 역시 대단하시네요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0073",
      "channel": 1,
      "context": {
        "voice": "GA306015,3",
        "speaker": "001",
        "face": "005,0,102,0"
      },
      "original": "やっぱり。\nオレを引っかけようとしたな？\n",
      "translation": "역시. 나를 골탕 먹이려 했지?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0074",
      "channel": 1,
      "context": {
        "face": "101,0,121,0",
        "speaker": "004",
        "voice": "GA306016,3"
      },
      "original": "まぁ、人聞きが悪い。\nほんの茶目っ気ですわ。\n",
      "translation": "어머, 사람 듣기 안 좋게. 그저 작은 장난이었\n답니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0075",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "009,0,121,0",
        "voice": "GA306016,3"
      },
      "original": "たはは……。\nまったく、ミントにはかなわないな。\n",
      "translation": "하하하…… 정말이지, 민트에게는 못 당하겠\n네 .\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0076",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,109,0",
        "voice": "GA306017,3"
      },
      "original": "うふふ。\nでも、占いをなさろうとしたということは、誰か\n気になるかたがいらっしゃるんですのね？\n",
      "translation": "우후후. 하지만, 점을 치려고 했다는 건\n누군가 마음에 두신 분이 계시다는 뜻이겠죠?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0077",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,109,0",
        "voice": "GA306017,3"
      },
      "original": "い、いや、別にそういうわけじゃ……！\n",
      "translation": "아, 아니, 딱히 그런 건……!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0078",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,109,0",
        "voice": "GA306017,3"
      },
      "original": "いかん、考えまいとすると、かえって逆効果だ。\nそ、それじゃ、オレはもう行くよっ！\n",
      "translation": "안 돼, 생각하지 않으려 할수록 오히려\n역효과다. 그, 그럼 난 이만 갈게!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0079",
      "channel": 1,
      "context": {
        "face": "101,0,102,0",
        "speaker": "004",
        "voice": "GA306018,3"
      },
      "original": "うふふふっ。\nはい、失礼いたします。\nそのかたと、うまくいくといいですわね？\n",
      "translation": "우후후훗. 네, 실례하겠습니다. 그분과 잘\n되기를 바랄게요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0080",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "009,0,102,0",
        "voice": "GA306018,3"
      },
      "original": "（……いかん、手玉に取られとる……）\n",
      "translation": "(……안 돼, 손바닥 위에서 놀아나고 있어……)\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0081",
      "channel": 1,
      "context": {
        "voice": "GA306018,3",
        "speaker": "001",
        "face": "008,0,0,0"
      },
      "original": "な、なんか恥ずかしいよ……。\nやっぱり、やめておくよ。\n",
      "translation": "어, 왠지 부끄러워…… 역시, 그만둘래.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0082",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "120,0,0,0",
        "voice": "GA306019,3"
      },
      "original": "あら、そうですか。\n残念ですわ。\n",
      "translation": "어머, 그렇습니까. 아쉽네요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0083",
      "channel": 1,
      "context": {
        "face": "101,0,109,0",
        "voice": "GA306020,3",
        "speaker": "004"
      },
      "original": "でも、恥ずかしがるということは、誰か気になる\nかたがいらっしゃるんですのね？\n",
      "translation": "하지만, 부끄러워한다는 건 누군가 신경\n쓰이는 분이 계시다는 뜻이겠죠?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0084",
      "channel": 1,
      "context": {
        "face": "012,0,109,0",
        "speaker": "001",
        "voice": "GA306020,3"
      },
      "original": "い、いや、そういう意味じゃ……！\n",
      "translation": "아, 아니, 그런 의미가 아니라……!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0085",
      "channel": 1,
      "context": {
        "voice": "GA306021,3",
        "speaker": "004",
        "face": "101,0,102,0"
      },
      "original": "で、それはどなたですの？\nこっそり教えてくださいませ。\n",
      "translation": "그래서, 그분은 누구신가요? 살짝 알려주시겠어\n요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0086",
      "channel": 1,
      "context": {
        "face": "012,0,102,0",
        "speaker": "001",
        "voice": "GA306021,3"
      },
      "original": "だ、だから、別に……。\n",
      "translation": "그, 그러니까, 딱히……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0087",
      "channel": 1,
      "context": {
        "face": "101,0,104,0",
        "voice": "GA306022,3",
        "speaker": "004"
      },
      "original": "……あら、まぁ……。\nこれは意外ですわね……。\n",
      "translation": "……어머, 세상에…… 이건 의외네요……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0088",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,104,0",
        "voice": "GA306022,3"
      },
      "original": "え？\nどうしたの、急に？\n",
      "translation": "어? 갑자기 왜 그래?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0089",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,102,0",
        "voice": "GA306023,3"
      },
      "original": "いいえ、何でも……。\n",
      "translation": "아니요, 아무것도……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0090",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,102,0",
        "voice": "GA306023,3"
      },
      "original": "ああっ！\nまさか、テレパシーでオレの心を読んだのか！？\n",
      "translation": "아앗! 설마, 텔레파시로 내 마음을 읽은 거야!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0091",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,109,0",
        "voice": "GA306024,3"
      },
      "original": "誰にも申し上げませんから、ご安心くださいませ。\n",
      "translation": "누구에게도 말하지 않을 테니 안심하세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0092",
      "channel": 1,
      "context": {
        "face": "009,0,109,0",
        "speaker": "001",
        "voice": "GA306024,3"
      },
      "original": "そういう問題じゃないってばぁ。\n",
      "translation": "그런 문제가 아니라니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0093",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,121,0",
        "voice": "GA306025,3"
      },
      "original": "あ、私、用事を思い出しましたわ。\nそれでは、ごきげんよう。\n",
      "translation": "아, 저, 볼일이 생각났어요. 그럼, 안녕히\n계세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0094",
      "channel": 1,
      "context": {
        "speaker": "094",
        "face": "000,0,0,0",
        "voice": "GA306025,3"
      },
      "original": "　\n",
      "translation": "　\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0095",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0",
        "voice": "GA306025,3"
      },
      "original": "あ、ちょっと、ミント！\n待ってくれぇ～！\n",
      "translation": "아, 잠깐만, 민트! 기다려줘～!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0096",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA306025,3"
      },
      "original": "せっかくだけど、遠慮しとくよ。\n今のところ、気になる人ってのもいないんでね。\n",
      "translation": "기왕 이렇게 된 거, 사양할게. 지금으로선\n신경 쓰이는 사람 같은 건 없으니까 말이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0097",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,0,0",
        "voice": "GA306026,3"
      },
      "original": "あら？\n本当は誰かいらっしゃるんじゃありませんこと？\n",
      "translation": "어라? 사실은 누군가 계신 것 아니랍니다?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0098",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,101,0",
        "voice": "GA306026,3"
      },
      "original": "からかわないでくれよ。\n本当にいないってば。\n",
      "translation": "놀리지 말아줘. 정말 아무도 없다니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0099",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,107,0",
        "voice": "GA306027,3"
      },
      "original": "そうですの、いらっしゃいませんの……。\n",
      "translation": "그렇군요, 계시지 않는 거군요……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0100",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,107,0",
        "voice": "GA306027,3"
      },
      "original": "そうだな、そういう相手ができたら、そのときは\n試してみようかな。\n",
      "translation": "그렇네, 그런 상대가 생긴다면 그때는 시험해\n볼까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0101",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,101,0",
        "voice": "GA306028,3"
      },
      "original": "わかりましたわ。\nではタクトさん、私はこれで。\n",
      "translation": "알겠습니다. 그럼 택트 씨, 저는 이만.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0102",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA306028,3"
      },
      "original": "ああ、それじゃあ。\nさてと、オレもそろそろ行こうか。\n",
      "translation": "아아, 그럼. 자, 나도 슬슬 가볼까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0103",
      "channel": 1,
      "context": {
        "face": "141,147,0,0",
        "speaker": "005",
        "voice": "GA307001,3"
      },
      "original": "……おっかしいなぁ。\nどこに行ったんだろ？\n",
      "translation": "……이상하네. 어디로 간 거지?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0104",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,147,0,181",
        "voice": "GA307002,3"
      },
      "original": "……見つかりませんか……？\n",
      "translation": "……찾을 수 없나요……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0105",
      "channel": 1,
      "context": {
        "face": "006,147,0,181",
        "speaker": "001",
        "voice": "GA307002,3"
      },
      "original": "あれ？\nふたりとも、どうしたんだい？\n",
      "translation": "어라? 둘 다, 무슨 일이야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0106",
      "channel": 1,
      "context": {
        "face": "141,142,0,181",
        "voice": "GA307003,3",
        "speaker": "005"
      },
      "original": "ああ、司令官どのか。\nいや、さっきの占い、ヴァニラだけしてなかった\nだろ？\n",
      "translation": "아아, 사령관님. 아니, 아까 점술, 바닐라만\n안 했었지?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0107",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,141,0,181",
        "voice": "GA307004,3"
      },
      "original": "今しがた、ちょうどヴァニラを見つけたもんでね。\nせっかくだからチェックしてあげようかと思って、\n連れて来たのさ。\n",
      "translation": "방금 막, 마침 바닐라를 발견해서 말이야.\n기왕 이렇게 된 거 체크해 줄까 싶어서,\n데려온 거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0108",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,141,0,181",
        "voice": "GA307004,3"
      },
      "original": "なるほど、そういうことか。\nそれで、何を捜しているの？\n",
      "translation": "그렇구나, 그런 거였나. 그래서, 뭘 찾고 있는\n거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0109",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,141,0,200",
        "voice": "GA307005,3"
      },
      "original": "……占いの載っている雑誌が、見当たらないよう\nなのです。\n",
      "translation": "……점술이 실린 잡지가, 보이지 않는 것\n같습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0110",
      "channel": 1,
      "context": {
        "face": "141,146,0,200",
        "voice": "GA307006,3",
        "speaker": "005"
      },
      "original": "ここに置いて行ったと思ったんだけどねぇ。\nもう片づけられたのかな？\n",
      "translation": "여기에 두고 갔다고 생각했는데 말이야. 벌써\n치워버린 걸까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0111",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,147,0,200",
        "voice": "GA307007,3"
      },
      "original": "悪いね、ヴァニラ。\nせっかくついて来てもらったのにさ。\n",
      "translation": "미안해, 바닐라. 기껏 따라오게 해놓고 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0112",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,147,0,181",
        "voice": "GA307008,3"
      },
      "original": "いえ……気にしないでください。\n",
      "translation": "아니에요…… 신경 쓰지 마세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0113",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,147,0,181",
        "voice": "GA307008,3"
      },
      "original": "ふむ……。\n",
      "translation": "흠……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0114",
      "channel": 1,
      "context": {
        "face": "001,147,0,181",
        "voice": "GA307008,3",
        "speaker": "001"
      },
      "original": "フォルテは仲間思いなんだな。\nヴァニラのために、わざわざもう一度占いをして\nあげるなんて。\n",
      "translation": "포르테는 동료를 아끼는구나. 바닐라를\n위해서, 일부러 다시 한번 점을 봐주다니.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0115",
      "channel": 1,
      "context": {
        "voice": "GA307009,3",
        "speaker": "005",
        "face": "141,148,0,181"
      },
      "original": "よしとくれよ。\nこれは……あたしが、ヴァニラの占い結果に興味\nがあったから、引っ張ってきただけさ。\n",
      "translation": "그렇게 말해줘. 이건…… 내가, 바닐라의 점술\n결과에 흥미가 있어서, 데려온 것뿐이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0116",
      "channel": 1,
      "context": {
        "voice": "GA307009,3",
        "speaker": "001",
        "face": "001,148,0,181"
      },
      "original": "そう？\nまぁいいや、そういうことにしておこうか。\n実際、他人の占いは気になるもんだしね。\n",
      "translation": "그래? 뭐 됐어, 그렇게 해두자고. 실제로\n타인의 점술은 궁금한 법이니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0117",
      "channel": 1,
      "context": {
        "face": "141,141,0,181",
        "speaker": "005",
        "voice": "GA307010,3"
      },
      "original": "そうそう。\n今回は残念だったけど、そのうちまたランファに\nチェックしてもらうさ。\n",
      "translation": "맞아 맞아. 이번에는 아쉬웠지만, 조만간 다시\n란파에게 체크받으면 돼.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0118",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,147,0,181",
        "voice": "GA307010,3"
      },
      "original": "ヴァニラ、気にすることないよ。\nまた次の機会があるさ。\n",
      "translation": "바닐라, 신경 쓰지 마. 다음에 또 기회가 있을\n거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0119",
      "channel": 1,
      "context": {
        "voice": "GA307011,3",
        "speaker": "006",
        "face": "181,147,0,181"
      },
      "original": "はい……。\n",
      "translation": "네……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0120",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,147,0,181",
        "voice": "GA307011,3"
      },
      "original": "オレもヴァニラの運勢がどうなってるか、聞いて\nみたいな。\n占うときには、オレも呼んでよ。\n",
      "translation": "나도 바닐라의 운세가 어떻게 되어 있는지,\n듣고 싶은걸. 점을 칠 때는, 나도 불러줘.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0121",
      "channel": 1,
      "context": {
        "face": "181,147,0,200",
        "speaker": "006",
        "voice": "GA307012,3"
      },
      "original": "わかりました。\nそうお望みでしたら……。\n",
      "translation": "알겠습니다. 그렇게 원하신다면……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0122",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,147,0,185",
        "voice": "GA307013,3"
      },
      "original": "……では、私は用事があるので、失礼します……。\n",
      "translation": "……그럼, 저는 볼일이 있어서, 실례하겠습니\n다 ……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0123",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,141,0,185",
        "voice": "GA307014,3"
      },
      "original": "ああ、つきあってくれてありがと。\n",
      "translation": "아아, 같이 있어줘서 고마워.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0124",
      "channel": 1,
      "context": {
        "speaker": "094",
        "face": "000,141,0,0",
        "voice": "GA307014,3"
      },
      "original": "　\n",
      "translation": "　\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00031800:dialogue:0125",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,141,0,0",
        "voice": "GA307014,3"
      },
      "original": "オレも別の場所に行ってみるか。\nそれじゃあ、また。\n",
      "translation": "나도 다른 곳에 가볼까. 그럼, 나중에 봐.\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
