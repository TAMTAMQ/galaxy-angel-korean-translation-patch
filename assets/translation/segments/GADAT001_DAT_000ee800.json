{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000ee800.txt",
    "encoding": "cp932",
    "sha256": "57e966ba409ab08b7feb3bda1bedf4d2bf0a15a2e23105b7ba67e3a6b5901bea",
    "dialogue_count": 116
  },
  "units": [
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0"
      },
      "original": "あ、いたいた。\nミルフィー！\n",
      "translation": "아, 찾았다. 밀피!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA734001,3"
      },
      "original": "あ、タクトさん……。\n",
      "translation": "아, 택트 씨……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,042,0",
        "voice": "GA734001,3"
      },
      "original": "お待たせ、ミルフィー。\n……どうしたの？\n何だか元気がないみたいだけど。\n",
      "translation": "기다렸지, 밀피. ……왜 그래? 왠지 기운이\n없어 보이는데.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,045,0",
        "voice": "GA734002,3"
      },
      "original": "え？\nいえ、別に……。\n",
      "translation": "에? 아니, 딱히……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,045,0",
        "voice": "GA734002,3"
      },
      "original": "もうすぐラストダンスだ。\n約束どおり、踊ろう。\n",
      "translation": "이제 곧 라스트 댄스다. 약속대로, 춤추자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA734003,3"
      },
      "original": "そうですね。\n……もう舞踏会もおしまいなんだ……。\n",
      "translation": "그렇네요. ……이제 무도회도 끝이라니……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,042,0",
        "voice": "GA734003,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,042,0",
        "voice": "GA734003,3"
      },
      "original": "あのさ……ミルフィー。\n今夜は楽しかった？\n",
      "translation": "저기 말이야…… 밀피. 오늘 밤은 즐거웠어?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,040,0",
        "voice": "GA734004,3"
      },
      "original": "はい。\nそれなりに……いえ、とても楽しかったです！\n",
      "translation": "네. 나름대로…… 아니, 정말로 즐거웠어요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,040,0",
        "voice": "GA734004,3"
      },
      "original": "おいおい、どっちなんだい？\nそれとも、何かイヤな目にでもあったの？\n",
      "translation": "어이 어이, 어느 쪽이야? 아니면, 뭔가 싫은\n일이라도 있었던 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA734005,3"
      },
      "original": "いえ、あたしは何ともないです。\nただ……あたしのまわりにいた人たちが、次々と\nすごい目に……。\n",
      "translation": "아니요, 저는 아무렇지도 않아요. 다만…… 제\n주변에 있던 사람들이, 차례차례 대단한 일을\n겪어서……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,042,0",
        "voice": "GA734005,3"
      },
      "original": "ああ……そういえば、最初に踊ろうとした人が、\n頭からシャンパンをかぶっていたね。\n",
      "translation": "아아…… 그러고 보니, 처음에 춤추려던\n사람이, 머리 위로 샴페인을 뒤집어쓰고\n있었지.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0013",
      "channel": 1,
      "context": {
        "face": "034,0,042,0",
        "speaker": "002",
        "voice": "GA734006,3"
      },
      "original": "その後も、オーケストラに近づいただけで楽器が\nいきなり壊れたりとか、踊っている人同士の服が\nからまったりとか、いろいろと……。\n",
      "translation": "그 후에도, 오케스트라에 다가간 것만으로\n악기가 갑자기 부서지거나, 춤추는 사람들끼리\n옷이 엉키거나 해서, 여러 가지로……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA734007,3"
      },
      "original": "あ～あ、どうしてあたし、こんなヘンテコな星の\n下に生まれちゃったんだろ。\nみんなに迷惑なんて、かけたくないのに……。\n",
      "translation": "아～아, 어째서 난 이런 이상한 별의 아래에서\n태어나버린 걸까. 모두에게 폐를 끼치고 싶지\n않은데……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0015",
      "channel": 1,
      "context": {
        "face": "002,0,042,0",
        "voice": "GA734007,3",
        "speaker": "001"
      },
      "original": "その運のおかげで、いいこともあるじゃないか。\nそれで帳消しだよ。\n",
      "translation": "그 운 덕분에, 좋은 일도 있잖아. 그걸로\n퉁치는 거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA734008,3"
      },
      "original": "そうですか？\n",
      "translation": "그런가요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0017",
      "channel": 1,
      "context": {
        "face": "002,0,042,0",
        "voice": "GA734008,3",
        "speaker": "001"
      },
      "original": "少なくとも、オレとエンジェル隊のみんなはそう\n考えてると思うね。\n",
      "translation": "적어도, 나랑 엔젤대 모두는 그렇게 생각하고\n있을 거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,040,0",
        "voice": "GA734009,3"
      },
      "original": "えへへっ。\nそう言っていただけると、なんかホッとします。\n",
      "translation": "에헤헷. 그렇게 말씀해 주시니, 왠지 안심이\n돼요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,043,0",
        "voice": "GA734010,3"
      },
      "original": "あー……ホッとして気が抜けたせいか、ちょっと\n暑くなってきたみたい。\n",
      "translation": "아～……안심해서 긴장이 풀린 탓인지, 좀\n더워진 것 같아요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,043,0",
        "voice": "GA734010,3"
      },
      "original": "本当だ、顔が赤いんじゃないか？\n涼しいところへ行こうか？\n",
      "translation": "정말이네, 얼굴이 빨개진 거 아냐? 시원한\n곳으로 갈까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0021",
      "channel": 1,
      "context": {
        "face": "034,0,041,0",
        "voice": "GA734011,3",
        "speaker": "002"
      },
      "original": "いいえ、これがラストダンスなんだもん。\n踊ります。\n",
      "translation": "아니요, 이게 라스트 댄스인걸요. 춤출래요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,041,0",
        "voice": "GA734011,3"
      },
      "original": "ん？\nミルフィー……今、何か音が聞こえた？\n",
      "translation": "응? 밀피…… 방금, 무슨 소리 들리지 않았어?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0023",
      "channel": 1,
      "context": {
        "voice": "GA734012,3",
        "speaker": "002",
        "face": "034,0,045,0"
      },
      "original": "はい。\nなんか、パチッていいましたよね。\n",
      "translation": "네. 뭔가, 탁 하고 났던 것 같아요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0024",
      "channel": 1,
      "context": {
        "face": "004,0,045,0",
        "voice": "GA734012,3",
        "speaker": "001"
      },
      "original": "うん？\nまただ。\n",
      "translation": "응? 또다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,045,0",
        "voice": "GA734013,3"
      },
      "original": "今度はパチパチっていいましたよね？\n",
      "translation": "이번에는 파치파치 소리가 났었죠?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,045,0",
        "voice": "GA734013,3"
      },
      "original": "また何か音が……。\nあれ、何だか焦げ臭くないか？\n",
      "translation": "또 무슨 소리가…… 어라, 뭔가 타는 냄새가\n나지 않아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0",
        "voice": "GA734013,3"
      },
      "original": "ああっ！\nミルフィー、足もとから煙が出てる！\n",
      "translation": "아앗! 밀피, 발치에서 연기가 나오고 있어!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0028",
      "channel": 1,
      "context": {
        "voice": "GA734014,3",
        "speaker": "002",
        "face": "036,0,0,0"
      },
      "original": "きゃあ！\nスカートのすそが焦げてる！？\n何で、どうして！？\n",
      "translation": "꺄악! 스커트 밑단이 타고 있어!? 왜, 어째서\n야 !?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0029",
      "channel": 1,
      "context": {
        "face": "005,0,0,0",
        "voice": "GA734014,3",
        "speaker": "001"
      },
      "original": "考えるのは後だ！\nとりあえず、そのドレスを脱ぐんだ！\n",
      "translation": "생각하는 건 나중이다! 일단 그 드레스를 벗어!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "036,0,0,0",
        "voice": "GA734015,3"
      },
      "original": "できません！\nいろんな意味で！\n",
      "translation": "못 해요! 여러 의미로!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0031",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "010,0,0,0",
        "voice": "GA734015,3"
      },
      "original": "ごもっとも！\n……とにかく、マントではたいてみよう！\nこのっ、このっ！\n",
      "translation": "말도 안 되는 소리 마! ……어쨌든, 망토로\n털어보자! 이게, 이게!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0032",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "036,0,0,0",
        "voice": "GA734016,3"
      },
      "original": "あ～ん、まだ煙が消えない！\nあたし、このまま焼け死んじゃうんだぁ～！\n",
      "translation": "아～앙, 아직 연기가 안 꺼져! 나, 이대로 타\n죽는 거야～!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0033",
      "channel": 1,
      "context": {
        "face": "012,0,0,0",
        "speaker": "001",
        "voice": "GA734016,3"
      },
      "original": "うわー、野次馬がどんどんと……。\nみなさん、危ないですから下がってください！\n",
      "translation": "우와, 구경꾼들이 점점…… 여러분, 위험하니\n까 물러나 주세요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0034",
      "channel": 1,
      "context": {
        "voice": "GA734016,3",
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "……おかしいな、煙は上がってるのに火の気配が\nない。\n焦げてるだけか？\n",
      "translation": "……이상하네, 연기는 올라오는데 불의 기운이\n없어. 그냥 타고 있는 것뿐인가?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0035",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "036,0,0,0",
        "voice": "GA734017,3"
      },
      "original": "あたし、舞踏会で立ったまま死ぬんだ～。\nこういうの、『宇宙弁慶の立ち往生』って言うん\nだっけ～……。\n",
      "translation": "나, 무도회에서 선 채로 죽는구나～. 이런 걸\n'우주 벤케이의 길을 잃음'이라고 하던가～…\n….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0036",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "011,0,0,0",
        "voice": "GA734017,3"
      },
      "original": "落ち着け、あきらめるんじゃない！\nああもう、いったい何が原因なんだ……。\n",
      "translation": "진정해, 포기하지 마! 아아 정말, 도대체\n원인이 뭐야……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0037",
      "channel": 1,
      "context": {
        "face": "004,0,0,0",
        "speaker": "001",
        "voice": "GA734017,3"
      },
      "original": "……ん？\nドレスの内側から熱気が……。\nスカートの中に異常があるのか？\n",
      "translation": "……응? 드레스 안쪽에서 열기가…… 스커트\n안에 이상이 있는 건가?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0",
        "voice": "GA734017,3"
      },
      "original": "わかった！\n宇宙ペチコートだ！\nあれが熱を持って、布地を焦がしてるんだ！\n",
      "translation": "알았다! 우주 페치코트다! 저게 열을 품어서,\n천을 태우고 있어!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0039",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "039,0,0,0",
        "voice": "GA734018,3"
      },
      "original": "宇宙ペチコートが？\nでも、故障や事故はないって、店員さんが……。\n",
      "translation": "우주 페치코트가? 하지만, 고장이나 사고는\n없다고 점원이……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0040",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,0,0",
        "voice": "GA734018,3"
      },
      "original": "だけど現に、煙のもとはペチコートだ！\n早く電源を切って！\nドレスの上からでもできるだろう？\n",
      "translation": "하지만 실제로 연기의 근원은 페치코트다!\n빨리 전원을 꺼! 드레스 위에서도 할 수\n있잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0041",
      "channel": 1,
      "context": {
        "face": "036,0,0,0",
        "voice": "GA734019,3",
        "speaker": "002"
      },
      "original": "は、はい！\nえーっと、確かここらへんに……。\n",
      "translation": "네, 네! 어디 보자, 분명 이 근처에……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0042",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "009,0,0,0",
        "voice": "GA734019,3"
      },
      "original": "……はぁぁ～。\nやっとおさまったか。\nミルフィー、大丈夫？\n",
      "translation": "……하아～. 겨우 가라앉았나. 밀피, 괜찮아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0043",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA734020,3"
      },
      "original": "は、はい。\nとりあえず、ヤケドとかはしてないです。\nでも……。\n",
      "translation": "네, 네. 일단, 화상 같은 건 입지 않았어요.\n하지만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0044",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,042,0",
        "voice": "GA734020,3"
      },
      "original": "あ……そうか。\nドレスのすそが、焦げちゃったね。\nそでの方まで、少し焦げてるし。\n",
      "translation": "아…… 그렇구나. 드레스 밑단이 타버렸네.\n소매 쪽까지, 조금 탔고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0045",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA734021,3"
      },
      "original": "宇宙ペチコートが、急に壊れるなんて……。\n故障なんかしないって言われてたのに……。\n",
      "translation": "우주 페치코트가 갑자기 고장 나다니…… 고장\n같은 건 나지 않는다고 들었는데……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0046",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,042,0",
        "voice": "GA734021,3"
      },
      "original": "きっと不良品だったんだよ。\nそれに、焦げ目もこうして見ている分には、全然\n目立たないって。\n",
      "translation": "분명 불량품이었던 거야. 게다가, 탄 자국도\n이렇게 보고 있으면 전혀 눈에 띄지 않아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0047",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA734022,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0048",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0",
        "voice": "GA734022,3"
      },
      "original": "あ、また野次馬が……。\nみなさん、もう大丈夫です。\nどうぞ、ご歓談を続けてください！\n",
      "translation": "아, 또 구경꾼이…… 여러분, 이제 괜찮습니\n다 . 부디, 담소를 계속해 주세요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0049",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA734023,3"
      },
      "original": "ごめんなさい……。\n",
      "translation": "미안해요……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0050",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,042,0",
        "voice": "GA734023,3"
      },
      "original": "え？\n",
      "translation": "에?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0051",
      "channel": 1,
      "context": {
        "voice": "GA734024,3",
        "speaker": "002",
        "face": "034,0,042,0"
      },
      "original": "ごめんなさい。\nあたしのせいです。\nあたしのせいなんです。\n",
      "translation": "미안해요. 제 탓이에요. 제 잘못이에요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0052",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,042,0",
        "voice": "GA734024,3"
      },
      "original": "ミルフィー……。\n何を言い出すんだ？\n",
      "translation": "밀피…… 무슨 소리를 하는 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0053",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA734025,3"
      },
      "original": "だって、普通じゃ起きないようなことばかりじゃ\nないですか。\n",
      "translation": "그치만, 보통은 일어나지 않을 일들뿐이\n잖아요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0054",
      "channel": 1,
      "context": {
        "face": "034,0,042,0",
        "voice": "GA734026,3",
        "speaker": "002"
      },
      "original": "ペチコートが加熱したり、ドレスが焦げたり。\nなのに、あたしはヤケドひとつしなくて……。\n",
      "translation": "페티코트가 가열되거나, 드레스가 타버리거나.\n그런데 저는 화상 하나 입지 않아서……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0055",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA734027,3"
      },
      "original": "……あたしのせいです。\nごめんなさい、タクトさんにまで迷惑かけちゃっ\nて、ごめんなさい……。\n",
      "translation": "……제 탓이에요. 미안해요, 택트 씨에게까지\n폐를 끼쳐버려 서, 미안해요……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0056",
      "channel": 1,
      "context": {
        "voice": "GA734027,3",
        "speaker": "001",
        "face": "004,0,042,0"
      },
      "original": "ミルフィー……。\n",
      "translation": "밀피……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0057",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,040,0",
        "voice": "GA734028,3"
      },
      "original": "……えへへ。\n約束していたラストダンス、ダメになっちゃった\nみたいです。\n",
      "translation": "……에헤헤. 약속했던 라스트 댄스, 못 하게\n된 것 같아요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0058",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,040,0",
        "voice": "GA734028,3"
      },
      "original": "ミルフィー、オレは……。\n",
      "translation": "밀피, 나는……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0059",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,040,0",
        "voice": "GA734029,3"
      },
      "original": "すそやそでの焦げたドレス着てる女の子となんか、\n恥ずかしくて踊れませんよね。\n",
      "translation": "소매나 밑단이 탄 드레스를 입은 여자애랑은,\n부끄러워서 춤출 수 없겠죠.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0060",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,040,0",
        "voice": "GA734029,3"
      },
      "original": "……そんなこと、ない……。\n",
      "translation": "……그렇지 않아……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0061",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA734030,3"
      },
      "original": "ごめんなさい、タクトさん。\n誰かほかの人を誘ってください。\nあたし、今夜はもう帰ります。\n",
      "translation": "미안해요, 택트 씨. 누군가 다른 사람을\n불러주세요. 저, 오늘 밤은 이제 돌아갈게요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0062",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,0,0",
        "voice": "GA734030,3"
      },
      "original": "……待ってくれ、ミルフィー！\n",
      "translation": "……기다려줘, 밀피!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0063",
      "channel": 1,
      "context": {
        "face": "034,0,045,0",
        "voice": "GA734031,3",
        "speaker": "002"
      },
      "original": "……え……！？\n",
      "translation": "……에……!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0064",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,045,0",
        "voice": "GA734031,3"
      },
      "original": "待ってほしい。\n行かないでくれ。\n……君はわかってるのかい？\n",
      "translation": "기다려줬으면 해. 가지 말아줘. ……너는 알고\n있는 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0065",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA734032,3"
      },
      "original": "何が、ですか……？\n",
      "translation": "뭐가, 말인가요……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0066",
      "channel": 1,
      "context": {
        "face": "003,0,042,0",
        "voice": "GA734032,3",
        "speaker": "001"
      },
      "original": "何がって……。\n",
      "translation": "뭐냐니……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0067",
      "channel": 1,
      "context": {
        "voice": "GA734032,3",
        "speaker": "001",
        "face": "003,0,042,0"
      },
      "original": "今夜が最後の夜なんだ。\nなのに、オレは君と、ろくに話もできていない。\nせめて、せめてラストダンスだけは……。\n",
      "translation": "오늘 밤이 마지막 밤이야. 그런데 나는 너와,\n제대로 대화도 나누지 못했어. 적어도, 적어도\n라스트 댄스만큼은……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0068",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA734033,3"
      },
      "original": "でも……あたし、こんな格好です。\n",
      "translation": "하지만…… 저, 이런 모습이에요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0069",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,042,0",
        "voice": "GA734033,3"
      },
      "original": "オレはドレスと踊りたいんじゃない。\n君と踊りたいんだ。\n",
      "translation": "나는 드레스와 춤추고 싶은 게 아니야. 너와\n춤추고 싶은 거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0070",
      "channel": 1,
      "context": {
        "voice": "GA734034,3",
        "face": "034,0,043,0",
        "speaker": "002"
      },
      "original": "タクトさん……。\n",
      "translation": "택트 씨……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0071",
      "channel": 1,
      "context": {
        "face": "001,0,043,0",
        "speaker": "001",
        "voice": "GA734034,3"
      },
      "original": "だいたい、ドレスのすそが焦げてるのがマズイの\nなら、焦げたところを何とかすればいいんだろ？\n",
      "translation": "애초에, 드레스 밑단이 탄 게 문제 라면, 탄\n부분을 어떻게든 하면 되잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0072",
      "channel": 1,
      "context": {
        "face": "003,0,042,0",
        "speaker": "001",
        "voice": "GA734034,3"
      },
      "original": "わからないのかい？\nだったら、自分の胸に聞いてみるんだ。\n",
      "translation": "모르는 거야? 그렇다면, 자신의 가슴에 물어봐.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0073",
      "channel": 1,
      "context": {
        "voice": "GA734035,3",
        "speaker": "002",
        "face": "034,0,042,0"
      },
      "original": "わからないから、タクトさんに聞いてるんじゃな\nいですか。\n",
      "translation": "모르니까, 택트 씨에게 묻고 있는 거 아니겠어\n요?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0074",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,042,0",
        "voice": "GA734035,3"
      },
      "original": "あ、それもそうか。\nつまりだな……。\n",
      "translation": "아, 그것도 그렇네. 그러니까 말이지……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0075",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,042,0",
        "voice": "GA734035,3"
      },
      "original": "オレはミルフィーと踊りたいってことさ。\n",
      "translation": "나는 밀피와 춤추고 싶다는 거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0076",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,043,0",
        "voice": "GA734036,3"
      },
      "original": "タクトさん……。\n",
      "translation": "택트 씨……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0077",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,043,0",
        "voice": "GA734036,3"
      },
      "original": "ドレスが少し焦げたくらい、オレは気にしないよ。\nオレはドレスと踊りたいわけじゃないんだ。\n",
      "translation": "드레스가 조금 탔을 정도는, 나는 신경 쓰지\n않아. 나는 드레스와 춤추고 싶은 게 아니니까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0078",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA734037,3"
      },
      "original": "でも、あたし……。\n",
      "translation": "하지만, 나……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0079",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,042,0",
        "voice": "GA734037,3"
      },
      "original": "そんなに焦げ目が気になるんなら、焦げた部分を\n何とかすればいいんだろ？\n",
      "translation": "그렇게 탄 자국이 신경 쓰인다면, 탄 부분을\n어떻게든 하면 되잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0080",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,042,0",
        "voice": "GA734037,3"
      },
      "original": "まだ完全に鎮火したかどうか、わからないぞ。\nほら、背中のあたりから、かすかに煙が！\n",
      "translation": "아직 완전히 진화했는지, 모르겠어. 봐, 등\n쪽에서, 희미하게 연기가!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0081",
      "channel": 1,
      "context": {
        "face": "034,0,045,0",
        "voice": "GA734038,3",
        "speaker": "002"
      },
      "original": "えええっ！？\nほ、ホントですか！？\nぜんぜん気がつかなかった！\n",
      "translation": "에에엣!? 정, 정말인가요!? 전혀 몰랐어요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0082",
      "channel": 1,
      "context": {
        "face": "001,0,045,0",
        "speaker": "001",
        "voice": "GA734038,3"
      },
      "original": "うんうん、やっぱり気づいてなかったか。\n",
      "translation": "응응, 역시 눈치채지 못했나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0083",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,044,0",
        "voice": "GA734039,3"
      },
      "original": "タクトさん、そういうことは、もっと早く教えて\nください！\nは、早く消さなきゃ！\n",
      "translation": "택트 씨, 그런 건 좀 더 빨리 알려 주세요!\n얼, 얼른 꺼야 해!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0084",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,044,0",
        "voice": "GA734039,3"
      },
      "original": "……いや、ウソだけどね。\n",
      "translation": "……아니, 거짓말이지만.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0085",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,041,0",
        "voice": "GA734040,3"
      },
      "original": "なぁんだ、ウソですか。\nよかったぁ。\n",
      "translation": "뭐야, 거짓말이었나요. 다행이다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0086",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,044,0",
        "voice": "GA734041,3"
      },
      "original": "……って、ウソ！？\nそんな、ヒドイですよ、タクトさん！\n",
      "translation": "……라니, 거짓말!? 너무해요, 택트 씨!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0087",
      "channel": 1,
      "context": {
        "voice": "GA734041,3",
        "speaker": "001",
        "face": "012,0,044,0"
      },
      "original": "ごめん、ごめん。\n悪かったよ。\n",
      "translation": "미안, 미안. 내가 잘못했어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0088",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,044,0",
        "voice": "GA734041,3"
      },
      "original": "……でも、やっといつものミルフィーに戻ったね。\n",
      "translation": "……하지만, 드디어 평소의 밀피로 돌아왔네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0089",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,045,0",
        "voice": "GA734042,3"
      },
      "original": "あ……。\n",
      "translation": "아……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0090",
      "channel": 1,
      "context": {
        "face": "001,0,045,0",
        "speaker": "001",
        "voice": "GA734042,3"
      },
      "original": "ラストダンス、一緒に踊ってくれないか？\nドレスが少し焦げたくらい、オレは気にしないよ。\n",
      "translation": "라스트 댄스, 같이 춰주지 않을래? 드레스가\n조금 탄 정도는, 나는 신경 쓰지 않아.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0091",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA734043,3"
      },
      "original": "そ、それはそうですけど……でも……。\n",
      "translation": "그, 그건 그렇지만…… 하지만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0092",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,042,0",
        "voice": "GA734043,3"
      },
      "original": "そんなに焦げ目が気になるんなら、焦げた部分を\n何とかすればいいんだろ？\n",
      "translation": "그렇게 탄 자국이 신경 쓰인다면, 탄 부분을\n어떻게든 하면 되잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0093",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,045,0",
        "voice": "GA734044,3"
      },
      "original": "何とかって……？\n",
      "translation": "어떻게든이라니……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0094",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,045,0",
        "voice": "GA734044,3"
      },
      "original": "いいから、いいから。\nオレに任せて。\n",
      "translation": "됐으니까, 됐으니까. 나한테 맡겨.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0095",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA734044,3"
      },
      "original": "少しじっとしてて。\nえーと、ここをこうやって……。\n",
      "translation": "잠시 가만히 있어 봐. 음, 여기를 이렇게\n해서……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0096",
      "channel": 1,
      "context": {
        "face": "039,0,0,0",
        "voice": "GA734045,3",
        "speaker": "002"
      },
      "original": "え、え？\nちょ、ちょっと、タクトさん？\n",
      "translation": "에, 에? 자, 잠깐만요, 택트 씨?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0097",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA734045,3"
      },
      "original": "そでも焦げてるんだよな。\nよし、これもこうしよう。\n",
      "translation": "소매도 그을렸단 말이지. 좋아, 이것도 이렇게\n하자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0098",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "039,0,0,0",
        "voice": "GA734046,3"
      },
      "original": "あっ！？\n",
      "translation": "앗!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0099",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA734046,3"
      },
      "original": "ほら、どうだい？\nちょっとドレスは短くなったけど、うまくいった\nと思うんだけどな。\n",
      "translation": "자, 어때? 드레스는 좀 짧아졌지만, 잘 된 것\n같은데 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0100",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "039,0,0,0",
        "voice": "GA734047,3"
      },
      "original": "ほんとだ……。\nというより、初めからこのデザインだったみたい\nにピッタリ合ってる。\n",
      "translation": "정말이다…… 그보다라기보다, 처음부터 이\n디자인이었던 것처럼 딱 맞아.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0101",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "035,0,0,0",
        "voice": "GA734048,3"
      },
      "original": "すごい！\nタクトさんって、器用なんですね！\n",
      "translation": "대단해! 택트 씨는 손재주가 좋으시네요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0102",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA734048,3"
      },
      "original": "安心してくれたかい？\n",
      "translation": "안심했나?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0103",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "035,0,0,0",
        "voice": "GA734049,3"
      },
      "original": "はい！\nそれに、かえってこの方が、かわいくなったかも！\n",
      "translation": "네! 게다가, 오히려 이쪽이 더 귀여워졌을지도!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0104",
      "channel": 1,
      "context": {
        "voice": "GA734049,3",
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "これなら、恥ずかしがる必要もないだろ。\nじゃあ、仕切り直しになったところで……。\n",
      "translation": "이 정도라면, 부끄러워할 필요도 없겠군.\n그럼, 다시 시작하기로 한 김에……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0105",
      "channel": 1,
      "context": {
        "voice": "GA734049,3",
        "speaker": "001",
        "face": "001,0,055,0"
      },
      "original": "ミルフィー、楽しい？\n",
      "translation": "밀피, 즐거워?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0106",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,055,0",
        "voice": "GA734050,3"
      },
      "original": "はい、とっても！\n",
      "translation": "네, 아주 많이!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0107",
      "channel": 1,
      "context": {
        "voice": "GA734051,3",
        "speaker": "002",
        "face": "034,0,052,0"
      },
      "original": "……あの、タクトさん。\n",
      "translation": "……저기, 택트 씨.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0108",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,052,0",
        "voice": "GA734051,3"
      },
      "original": "何だい？\n",
      "translation": "왜 그러지?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0109",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,052,0",
        "voice": "GA734052,3"
      },
      "original": "これで……お別れなんですよね……？\n",
      "translation": "이걸로…… 작별인 거죠……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0110",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,052,0",
        "voice": "GA734052,3"
      },
      "original": "ああ……そうだな。\n舞踏会も、もうすぐ終わる。\n",
      "translation": "아아…… 그렇군. 무도회도, 곧 끝난다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0111",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,052,0",
        "voice": "GA734053,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0112",
      "channel": 1,
      "context": {
        "face": "034,0,057,0",
        "voice": "GA734054,3",
        "speaker": "002"
      },
      "original": "あの、あたし……。\n",
      "translation": "저기, 나……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0113",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,051,0",
        "voice": "GA734055,3"
      },
      "original": "きゃああ！\nじ、地震……！？\n",
      "translation": "꺄아악! 지, 지진……!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0114",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,051,0",
        "voice": "GA734055,3"
      },
      "original": "いや、違うな……。\nでも、だとしたら、これは……？\n",
      "translation": "아니, 아니야…… 하지만, 만약 그렇다면,\n이건……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0115",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,051,0",
        "voice": "GA734055,3"
      },
      "original": "こ、今度は何だ！？\n",
      "translation": "이, 이번엔 뭐야!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ee800:dialogue:0116",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,057,0",
        "voice": "GA734056,3"
      },
      "original": "タクトさん、あれ！\n外に誰かいます！\n",
      "translation": "택트 씨, 저거! 밖에 누군가 있어요!\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
