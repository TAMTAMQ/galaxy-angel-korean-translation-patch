{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000bd800.txt",
    "encoding": "cp932",
    "sha256": "fc108ce3137afe6b81f9b3d7f29f10dbb1a75af93643ba18fe08ead22b5155dc",
    "dialogue_count": 15
  },
  "units": [
    {
      "id": "GADAT001_DAT_000bd800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "503,0,0,0",
        "voice": "GAF07001,3"
      },
      "original": "Ａブロックに被弾！\n通信系統に異常発生！\n",
      "translation": "A 블록 피격! 통신 계통에 이상 발생!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000bd800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "010,0,0,0",
        "voice": "GAF07001,3"
      },
      "original": "何だって！？\n",
      "translation": "뭐라고!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000bd800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "011,0,0,0",
        "voice": "GAF07001,3"
      },
      "original": "……エンジェル隊、聞こえるか！？\nエンジェル隊！\n",
      "translation": "……엔젤대, 들리는가!? 엔젤대!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000bd800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,225,0",
        "voice": "GAF07002,3"
      },
      "original": "……ダメか。\nまずいな、これじゃ指揮ができないぞ！\n",
      "translation": "……안 되는 건가. 큰일이군, 이래서는 지휘를\n할 수 없어!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000bd800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,225,0",
        "voice": "GAF07002,3"
      },
      "original": "それでも……やるしかない！\n",
      "translation": "그래도…… 해야만 해!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000bd800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,0,0",
        "voice": "GAF07002,3"
      },
      "original": "全速前進！\nクロノ・ブレイク・キャノンのチャージが終わり\nしだい、『黒き月』を攻撃する！\n",
      "translation": "전속 전진! 크로노・브레이크・캐논의 충전이\n끝나는 대로, 『흑색 달』을 공격한다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000bd800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "493,0,0,0",
        "voice": "GAF07003,3"
      },
      "original": "１０時方向より、攻撃衛星２基！\n",
      "translation": "10시 방향에서, 공격 위성 2기!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000bd800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "011,0,0,0",
        "voice": "GAF07003,3"
      },
      "original": "かまうな！\nこのまま前進だ！\n",
      "translation": "상관 마라! 이대로 전진이다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000bd800:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,225,0",
        "voice": "GAF07004,3"
      },
      "original": "おい、タクト……！？\n",
      "translation": "어이, 택트……!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000bd800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "492,0,0,0",
        "voice": "GAF07005,3"
      },
      "original": "トリックマスター、攻撃衛星を撃破！\n",
      "translation": "트릭 마스터, 공격 위성 격파!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000bd800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,225,0",
        "voice": "GAF07006,3"
      },
      "original": "ふぅ、助かった……。\nだが、どうしてこっちの意図が……？\n",
      "translation": "후우, 살았다…… 하지만, 어째서 이쪽의\n의도를……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000bd800:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,225,0",
        "voice": "GAF07006,3"
      },
      "original": "ミントだからさ。\n",
      "translation": "민트니까 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000bd800:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "493,0,225,0",
        "voice": "GAF07007,3"
      },
      "original": "エルシオールに接近する敵を、トリックマスター\nが次々に迎撃しています！\n",
      "translation": "에르시올에 접근하는 적을, 트릭 마스터 가\n차례차례 요격하고 있습니다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000bd800:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,225,0",
        "voice": "GAF07008,3"
      },
      "original": "すげぇ……。\nタクト、これなら行けるぜ！\n",
      "translation": "굉장해…… 택트, 이 정도라면 갈 수 있겠어!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000bd800:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAF07008,3"
      },
      "original": "ああ！\nクロノ・ブレイク・キャノンの方は、どうなって\nいる？\n",
      "translation": "아아! 크로노・브레이크・캐논 쪽은, 어떻게\n되어 있어?\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
