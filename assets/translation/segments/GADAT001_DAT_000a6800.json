  "units": [
    {
      "id": "GADAT001_DAT_000a6800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0"
      },
      "original": "明日にはエオニア軍と決戦か……。\nどんな結果になるにしろ、これですべてが終わる\nはずだ……。\n",
      "translation": "내일이면 에오니아군과 결전인가……\n결과가 어떻든 이걸로 모두 끝날 터다……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a6800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0"
      },
      "original": "そう思うと、何だか緊張してきたなぁ。\nうう～……。\n",
      "translation": "그렇게 생각하니 왠지 긴장되기 시작하네.\n으우～……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a6800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "みんなは、どうしているんだろう？\nやっぱり、オレと同じく、プレッシャーを感じて\nいるんだろうか……？\n",
      "translation": "다들 뭐 하고 있을까? 역시 나처럼\n부담을 느끼고 있는 걸까……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a6800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "ちょっと様子を見てこようかな。\n３０分ばかり、艦内を回ってこよう。\n",
      "translation": "잠깐 상태를 보러 갈까. 30분 정도\n함내를 돌아보고 오자.\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
