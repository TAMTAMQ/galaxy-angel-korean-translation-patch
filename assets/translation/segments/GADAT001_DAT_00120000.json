{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_00120000.txt",
    "encoding": "cp932",
    "sha256": "b1b0da2c513418b5bb2e80c15cff266e3d80ffc78c62492a3c2eecdef07b31e8",
    "dialogue_count": 41
  },
  "units": [
    {
      "id": "GADAT001_DAT_00120000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,022,0",
        "voice": "GAA06001,3"
      },
      "original": "これでいよいよ、『白き月』まで一直線ですね！\nやっと帰ってこれたって気がします。\n",
      "translation": "이걸로 드디어, 『백색 달』까지 직행이네요!\n겨우 돌아온 것 같은 기분이 들어요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,101,0,0",
        "voice": "GAA06002,3"
      },
      "original": "ところで、タクトさん。\nなにをソワソワなさっているんですの？\n",
      "translation": "그런데, 택트 씨. 뭘 그렇게 안절부절못하고\n계신가요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,101,0,0",
        "voice": "GAA06002,3"
      },
      "original": "えっ？\nそ、そんなことないよ。\n",
      "translation": "엣? 그, 그런 거 아니야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,0,141",
        "voice": "GAA06003,3"
      },
      "original": "まったく、素直じゃないねぇ。\nほら、お待ちかねの彼女が来たよ。\n",
      "translation": "정말이지, 솔직하지 못하네. 자, 기다리던\n그녀가 왔어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GAA06003,3"
      },
      "original": "ランファ！\n",
      "translation": "란파!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,094,0",
        "voice": "GAA06004,3"
      },
      "original": "見ててくれた、タクト？\nアンタの指揮のおかげで、アタシも絶好調よ！\nこれぞ、愛のパワーってヤツよね★\n",
      "translation": "보고 있었어, 택트? 너의 지휘 덕분에, 나도\n컨디션 최고야! 이게 바로, 사랑의 파워라는\n거겠지★\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,094,0",
        "voice": "GAA06004,3"
      },
      "original": "ああ、そのとおりさ。\nだけど、ランファが無事だったことが、いちばん\nうれしいよ。\n",
      "translation": "아아, 맞아. 하지만, 란파가 무사했던 게 가장\n기뻐.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,088,0",
        "voice": "GAA06005,3"
      },
      "original": "さすがはタクトの指揮ね。\n安心して戦えたわ。\nやっぱり、アンタが司令官でよかった。\n",
      "translation": "역시 택트의 지휘네. 안심하고 싸울 수\n있었어. 역시, 네가 사령관이라서 다행이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,088,0",
        "voice": "GAA06005,3"
      },
      "original": "うん。\nともかく、ランファが無事でよかった。\nよくがんばったな。\n",
      "translation": "응. 어쨌든, 란파가 무사해서 다행이야. 잘\n버텼구나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,062,0",
        "voice": "GAA06006,3"
      },
      "original": "また勝てたわね、タクト。\nでも、ちょっと暴れ足りないかも。\n次は、もっといっぱい、がんばるからね！\n",
      "translation": "또 이겼네, 택트. 하지만, 조금 더 날뛰고\n싶을지도. 다음엔, 훨씬 더 많이, 힘낼 테니까!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,062,0",
        "voice": "GAA06006,3"
      },
      "original": "うん。\nともかく、ランファが無事でよかった。\nよくがんばったな。\n",
      "translation": "응. 어쨌든, 란파가 무사해서 다행이야. 잘\n버텼구나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,069,0",
        "voice": "GAA06007,3"
      },
      "original": "ごめん……カンフーファイター、壊しちゃった。\nだけど、タクトがちゃんと指揮してくれないのが\nいけないんだからね？\n",
      "translation": "미안……쿵푸 파이터, 부숴버렸어. 하지만,\n택트가 제대로 지휘해주지 않은 게 잘못한\n거니까 말이야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,069,0",
        "voice": "GAA06007,3"
      },
      "original": "すまない、ランファ。\nでも、君が無事でよかったよ。\n",
      "translation": "미안해, 란파.\n하지만, 네가 무사해서 다행이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,063,0",
        "voice": "GAA06008,3"
      },
      "original": "ありがと、タクト。\nえへへ……。\n",
      "translation": "고마워, 택트. 에헤헤……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0015",
      "channel": 1,
      "context": {
        "voice": "GAA06009,3",
        "speaker": "003",
        "face": "089,0,0,0"
      },
      "original": "タクト！\nタクト！\nタクト！\n",
      "translation": "택트! 택트! 택트!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GAA06009,3"
      },
      "original": "お、おいおい。\nそんなに力いっぱい抱きつくなって。\n倒れちゃうよ。\n",
      "translation": "어, 어이어이. 그렇게 힘껏 매달리지 마.\n넘어져 버린다고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "089,0,0,0",
        "voice": "GAA06010,3"
      },
      "original": "いいわよ。\n倒れたって、離さないんだから★\n",
      "translation": "상관없어. 넘어진대도, 놓지 않을 거니까★\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "022,0,0,0",
        "voice": "GAA06011,3"
      },
      "original": "きゃー、ランファったら、だいたん！\n",
      "translation": "꺄아ー, 란파는 정말 대담해!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0019",
      "channel": 1,
      "context": {
        "face": "142,0,0,0",
        "speaker": "005",
        "voice": "GAA06012,3"
      },
      "original": "よっ、おふたりさん！\nお熱いねぇ。\n",
      "translation": "여어, 두 분 다! 뜨겁구먼.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,0,0",
        "voice": "GAA06013,3"
      },
      "original": "……お熱いです。\n",
      "translation": "……뜨겁습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GAA06013,3"
      },
      "original": "何だか照れるなぁ。\nそんなに冷やかさないでくれよ。\n",
      "translation": "왠지 쑥스럽네. 그렇게 놀리지 말아줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,0,0",
        "voice": "GAA06014,3"
      },
      "original": "そうは言っても、タクトさんのお顔、今にも土砂\nくずれを起こしそうですわ。\n",
      "translation": "말씀은 그렇게 하셔도, 택트 씨의 얼굴,\n금방이라도 토사 붕괴를 일으킬 것 같아요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0023",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "087,0,0,0",
        "voice": "GAA06015,3"
      },
      "original": "アタシ、タクトのためにがんばったわ。\n",
      "translation": "나, 택트를 위해서 열심히 했어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAA06015,3"
      },
      "original": "オレもランファのために戦ったよ。\n",
      "translation": "나도 란파를 위해 싸웠어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "087,0,0,0",
        "voice": "GAA06016,3"
      },
      "original": "うれしい★\nねぇ、タクト？\n",
      "translation": "기뻐★ 있지, 택트?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAA06016,3"
      },
      "original": "何だい？\n",
      "translation": "왜 그래?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "063,0,0,0",
        "voice": "GAA06017,3"
      },
      "original": "交換日記、まだ続けてくれる？\n",
      "translation": "교환 일기, 계속 써 줄 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GAA06017,3"
      },
      "original": "もちろんだよ。\n",
      "translation": "물론이지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "063,0,0,0",
        "voice": "GAA06018,3"
      },
      "original": "お弁当も食べてくれる？\n",
      "translation": "도시락도 먹어 줄 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0030",
      "channel": 1,
      "context": {
        "voice": "GAA06018,3",
        "speaker": "001",
        "face": "002,0,0,0"
      },
      "original": "あったりまえさ。\n",
      "translation": "당연하지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0031",
      "channel": 1,
      "context": {
        "face": "063,0,0,0",
        "voice": "GAA06019,3",
        "speaker": "003"
      },
      "original": "それなら、ペアルックもしてくれる？\n",
      "translation": "그렇다면, 커플룩도 해 줄 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0032",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GAA06019,3"
      },
      "original": "ペ、ペアルック！？\n",
      "translation": "커, 커플룩!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "087,0,0,0",
        "voice": "GAA06020,3"
      },
      "original": "そう。\nアタシとタクトで、おそろいの服を着るの。\n",
      "translation": "응. 나랑 택트가, 똑같은 옷을 입는 거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0034",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "050,0,0,0",
        "voice": "GAA06021,3"
      },
      "original": "えーっ！\nタクトさんがランファの格好をするんですかー？\n",
      "translation": "에엑! 택트 씨가 란파의 차림을 하는 건가요ー?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0035",
      "channel": 1,
      "context": {
        "face": "007,0,0,0",
        "voice": "GAA06021,3",
        "speaker": "001"
      },
      "original": "ぶっ！\n",
      "translation": "푸흡!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0036",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "174,0,0,0",
        "voice": "GAA06022,3"
      },
      "original": "あははは。\nあいかわらずミルフィーのボケは容赦がないねぇ。\n",
      "translation": "아하하하. 여전히 밀피의 보케는 가차 없네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0037",
      "channel": 1,
      "context": {
        "face": "009,0,0,0",
        "voice": "GAA06022,3",
        "speaker": "001"
      },
      "original": "おいおい、ミルフィー。\nいくら何でも、オレが女装するわけないだろ？\n",
      "translation": "이봐 이봐, 밀피. 아무리 그래도, 내가 여장을\n할 리가 없잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "022,0,0,0",
        "voice": "GAA06023,3"
      },
      "original": "え、違うんですか？\nなーんだ。\nあたしも、なんかヘンだと思ったんです。\n",
      "translation": "에, 아닌가요? 뭐야. 저도, 뭔가 이상하다고\n생각했어요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0039",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "122,0,0,0",
        "voice": "GAA06024,3"
      },
      "original": "でも、意外と似合うかもしれませんわ。\n",
      "translation": "하지만, 의외로 잘 어울릴지도 모르겠어요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0040",
      "channel": 1,
      "context": {
        "face": "089,0,0,0",
        "voice": "GAA06025,3",
        "speaker": "003"
      },
      "original": "そうねぇ、けっこうイイかも。\nタクト、アタシの服、着てみる？\n",
      "translation": "글쎄, 꽤 괜찮을지도. 택트, 내 옷, 입어 볼래?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00120000:dialogue:0041",
      "channel": 1,
      "context": {
        "face": "007,0,0,0",
        "speaker": "001",
        "voice": "GAA06025,3"
      },
      "original": "そ、それだけは、かんべんしてくれぇ～！\n",
      "translation": "그, 그것만은, 사양할게～!\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
