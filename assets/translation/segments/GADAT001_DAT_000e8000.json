{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000e8000.txt",
    "encoding": "cp932",
    "sha256": "df1a5d3c42967a468e5e60151cb7536d1359736e7f89aba28e5aa76c86add572",
    "dialogue_count": 42
  },
  "units": [
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,040,0",
        "voice": "GA728001,3"
      },
      "original": "じゃあ、タクトさん。\nあたしたちも行きませんか？\n",
      "translation": "그럼, 택트 씨. 우리도 갈까요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,040,0",
        "voice": "GA728001,3"
      },
      "original": "うん。\nだけど、その前に……。\n",
      "translation": "응. 하지만, 그전에……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,045,0",
        "voice": "GA728002,3"
      },
      "original": "はい？\n",
      "translation": "네?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "008,0,045,0",
        "voice": "GA728002,3"
      },
      "original": "さっき言いかけた続きだけど……。\nその、とても……。\n",
      "translation": "아까 하려던 말의 뒷부분인데…… 그게,\n무척……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,040,0",
        "voice": "GA728003,3"
      },
      "original": "とても？\n",
      "translation": "무척?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,040,0",
        "voice": "GA728003,3"
      },
      "original": "とても……きれいだよ。\n",
      "translation": "무척…… 예뻐.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,043,0",
        "voice": "GA728004,3"
      },
      "original": "あ……。\n",
      "translation": "아……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,043,0",
        "voice": "GA728005,3"
      },
      "original": "や、やだなぁ、タクトさんったら。\nまじめな顔で、そんな冗談言うなんて。\n",
      "translation": "어, 어머나, 택트 씨도 참. 진지한 얼굴로\n그런 농담을 하다니.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,043,0",
        "voice": "GA728005,3"
      },
      "original": "いや、本当だよ。\n今日のミルフィーは、とてもきれいだ。\n",
      "translation": "아니, 정말이야. 오늘의 밀피는 무척 예뻐.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA728006,3"
      },
      "original": "タクトさん……。\n",
      "translation": "택트 씨……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,041,0",
        "voice": "GA728007,3"
      },
      "original": "……ありがとうございます。\nタクトさんにそう言ってもらえて、うれしいです。\n",
      "translation": "……감사합니다. 택트 씨가 그렇게 말씀해\n주셔서 기뻐요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,041,0",
        "voice": "GA728007,3"
      },
      "original": "オレもうれしいよ。\nいつもと違う、新しいミルフィーを発見した気分\nなんだ。\n",
      "translation": "나도 기뻐. 평소와는 다른, 새로운 밀피를\n발견한 기분이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,040,0",
        "voice": "GA728008,3"
      },
      "original": "そうですか？\nあたしは、いつもと同じあたしですよ。\n",
      "translation": "그런가요? 저는 평소와 같은 저인걸요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,040,0",
        "voice": "GA728008,3"
      },
      "original": "そうだな。\nオレが今まで気づかなかっただけなんだ。\n",
      "translation": "그렇네. 내가 지금까지 깨닫지 못했을 뿐이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,040,0",
        "voice": "GA728008,3"
      },
      "original": "それを発見できただけでも、今日ここに来た意味\nがあったよ。\n",
      "translation": "그걸 발견한 것만으로도, 오늘 여기 온 의미가\n있었어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,041,0",
        "voice": "GA728009,3"
      },
      "original": "えへへっ。\n今夜は、いっぱい楽しみましょうね。\n",
      "translation": "에헤헷. 오늘 밤은 마음껏 즐겨요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,041,0",
        "voice": "GA728009,3"
      },
      "original": "ああ、そうしよう。\n",
      "translation": "아아, 그러자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0018",
      "channel": 1,
      "context": {
        "face": "006,0,041,0",
        "speaker": "001",
        "voice": "GA728009,3"
      },
      "original": "ん？\nこの音楽は……。\n",
      "translation": "응? 이 음악은……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0019",
      "channel": 1,
      "context": {
        "voice": "GA728010,3",
        "speaker": "002",
        "face": "034,0,045,0"
      },
      "original": "あ、もう始まっちゃったんですね。\n",
      "translation": "아, 벌써 시작됐군요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0020",
      "channel": 1,
      "context": {
        "voice": "GA728010,3",
        "speaker": "001",
        "face": "001,0,045,0"
      },
      "original": "本当だ。\nみんな踊り始めたな。\nオレたちも行こうか。\n",
      "translation": "정말이다. 다들 춤추기 시작했네. 우리도 갈까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0021",
      "channel": 1,
      "context": {
        "face": "726,0,0,0",
        "speaker": "060",
        "voice": "GA728011,3"
      },
      "original": "失礼、エンジェル隊のお嬢さん。\n次の曲は、先約がおありですかな？\n",
      "translation": "실례합니다, 엔젤대 아가씨. 다음 곡은 선약이\n있으신가요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0022",
      "channel": 1,
      "context": {
        "voice": "GA728012,3",
        "speaker": "002",
        "face": "034,0,042,0"
      },
      "original": "え？\nい、いいえ……。\n",
      "translation": "에? 아, 아니에요……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0023",
      "channel": 1,
      "context": {
        "voice": "GA728013,3",
        "speaker": "060",
        "face": "726,0,0,0"
      },
      "original": "それでは、私と踊っていただけないでしょうか。\n",
      "translation": "그렇다면, 저와 춤춰 주시지 않겠습니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,045,0",
        "voice": "GA728014,3"
      },
      "original": "えぇっ？\nでも、あたしはタクトさんのパートナーで……。\n",
      "translation": "에엣? 하지만 저는 택트 씨의 파트너라서……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0025",
      "channel": 1,
      "context": {
        "voice": "GA728015,3",
        "speaker": "060",
        "face": "726,0,0,0"
      },
      "original": "それは、ラストダンスのときのことでしょう。\nそのときまでは、うわさに名高いエンジェル隊と\n踊る機会を、我々にも与えてくださいませんか？\n",
      "translation": "그것은, 라스트 댄스 때의 일이지요.\n그때까지는, 소문이 자자한 엔젤대와 춤출\n기회를, 저희에게도 주시지 않겠습니까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA728016,3"
      },
      "original": "タクトさん……。\n",
      "translation": "택트 씨……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,042,0",
        "voice": "GA728016,3"
      },
      "original": "……まぁ、正論ではあるね。\n",
      "translation": "……뭐, 정론이긴 하네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "060",
        "face": "726,0,0,0",
        "voice": "GA728017,3"
      },
      "original": "それでは、パートナー君にも納得していただいた\nところで……。\n踊っていただけますか、お嬢さん？\n",
      "translation": "그렇다면, 파트너 군도 납득해 주신 것으로\n보고…… 춤춰 주시겠습니까, 아가씨?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "034,0,042,0",
        "voice": "GA728018,3"
      },
      "original": "あ……はい。\n承知しました。\n",
      "translation": "아…… 네. 알겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,042,0",
        "voice": "GA728018,3"
      },
      "original": "ラストダンスの時間が近くなったら迎えに行くよ、\nミルフィー。\n",
      "translation": "라스트 댄스 시간이 다가오면 데리러 갈게,\n밀피.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0031",
      "channel": 1,
      "context": {
        "face": "034,0,042,0",
        "speaker": "002",
        "voice": "GA728019,3"
      },
      "original": "はい、タクトさん。\nそれじゃ、また後で。\n",
      "translation": "네, 택트 씨. 그럼, 나중에 봐요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0032",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,0,0",
        "voice": "GA728019,3"
      },
      "original": "ちぇっ、せっかくいいところだったのに。\nあの客、シャンパンをかぶってビショ濡れにでも\nなっちまえばいいのに。\n",
      "translation": "쳇, 기껏 좋은 분위기였는데. 저 손님,\n샴페인을 뒤집어써서 흠뻑 젖어버리면 좋을\n텐데.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0033",
      "channel": 1,
      "context": {
        "voice": "GA728020,3",
        "speaker": "060",
        "face": "726,0,0,0"
      },
      "original": "うひゃあああ、冷たい～！\n",
      "translation": "우와아아아, 차가워～!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0034",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0",
        "voice": "GA728020,3"
      },
      "original": "な、何だ？\nいきなりシャンパングラスで作ったピラミッドが\n崩れたぞ！\n",
      "translation": "뭐, 뭐야? 갑자기 샴페인 잔으로 만든\n피라미드가 무너졌어!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0035",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "039,0,0,0",
        "voice": "GA728021,3"
      },
      "original": "きゃあ、ビショ濡れ……。\n大丈夫ですか？\nケガはないですか？\n",
      "translation": "꺄악, 흠뻑 젖었어…… 괜찮으세요? 다친 곳은\n없나요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0036",
      "channel": 1,
      "context": {
        "speaker": "060",
        "face": "726,0,0,0",
        "voice": "GA728022,3"
      },
      "original": "い、いや、大丈夫。\n誰もシャンパングラスに触れたりしていなかった\nのに、どういうわけだ……？\n",
      "translation": "아, 아니, 괜찮아. 아무도 샴페인 잔을\n건드리지 않았는데, 어째서지……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0037",
      "channel": 1,
      "context": {
        "speaker": "060",
        "face": "726,0,0,0",
        "voice": "GA728023,3"
      },
      "original": "すまないが、別室で着替えてくるよ。\n失礼……。\n",
      "translation": "미안하지만, 다른 방에서 갈아입고 올게.\n실례할게……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0038",
      "channel": 1,
      "context": {
        "face": "012,0,0,0",
        "voice": "GA728023,3",
        "speaker": "001"
      },
      "original": "あはは、しょんぼりして帰っていくよ。\n運が悪かったな、あの人。\n",
      "translation": "아하하, 풀이 죽어서 돌아가네. 운이 나빴어,\n저 사람.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0039",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA728023,3"
      },
      "original": "……運？\nまさか、これってミルフィーの……？\n",
      "translation": "……운? 설마, 이거 밀피의……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0040",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA728023,3"
      },
      "original": "まぁ、いいか。\nともかく、これでミルフィーと踊れるぞ！\n",
      "translation": "뭐, 됐나. 어쨌든, 이걸로 밀피와 춤출 수\n있어!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0041",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA728023,3"
      },
      "original": "……って、あ～あ、ダメだ。\nあっという間に取り囲まれてるよ、ミルフィー。\n",
      "translation": "……라고, 아～아, 안 되겠네. 순식간에\n둘러싸였어, 밀피.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8000:dialogue:0042",
      "channel": 1,
      "context": {
        "voice": "GA728023,3",
        "speaker": "001",
        "face": "009,0,0,0"
      },
      "original": "しかたないか。\nあの客の言うとおり、ラストダンスまでは誰でも\nミルフィーと踊る権利はあるし。\n",
      "translation": "어쩔 수 없나. 저 손님이 말한 대로, 라스트\n댄스까지는 누구든 밀피와 춤출 권리는\n있으니까.\n",
      "state": "needs_human",
      "use_translation": true
    }
  ]
}
