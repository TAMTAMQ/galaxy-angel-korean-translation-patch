  },
  "units": [
    {
      "id": "GADAT001_DAT_000ad000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "さてと、これからどうしようかな……？\n",
      "translation": "자, 이제부터 어떻게 할까……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ad000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "そういえば、ミルフィーはどうしているかな。\nどこにいるんだろう？\n",
      "translation": "그러고 보니 밀피는 뭐 하고 있을까.\n어디에 있는 걸까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ad000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "ミルフィーがいるとしたら……きっとあそこだな。\n行ってみよう。\n",
      "translation": "밀피가 있다면…… 분명 저기겠지. 가 보자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ad000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "そういえば、ランファはどうしているんだろう？\n",
      "translation": "그러고 보니 란파는 뭐 하고 있을까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ad000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "ランファがいるとしたら……きっとあそこだな。\n行ってみよう。\n",
      "translation": "란파가 있다면…… 분명 저기겠지. 가 보자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ad000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "そういえば、フォルテはどうしているだろう？\n明日の戦いの前に、一度会っておきたいな……。\n",
      "translation": "그러고 보니 포르테는 뭐 하고 있을까?\n내일 전투 전에 한 번 만나고 싶네……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ad000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "フォルテがいるとしたら……きっとあそこだな。\n行ってみよう。\n",
      "translation": "포르테가 있다면…… 분명 저기겠지. 가 보자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ad000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "そうだ、クジラルームに行ってみようかな。\n波の音を聞いていれば、少しは気が落ち着くかも\nしれない。\n",
      "translation": "그래, 고래 룸에 가 볼까. 파도 소리를 듣고\n있으면 조금은 마음이 진정될지도 몰라.\n",
      "state": "needs_human",
      "use_translation": true
    }
  ]
}
