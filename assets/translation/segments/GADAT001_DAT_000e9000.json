{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000e9000.txt",
    "encoding": "cp932",
    "sha256": "7f1ce1a6444841eac80e900f4cbc6b7747b64a1b53357f2c253ca745bba78588",
    "dialogue_count": 30
  },
  "units": [
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,116,0",
        "voice": "GA730001,3"
      },
      "original": "では、タクトさん。\n私たちも参りましょう。\n",
      "translation": "그럼, 택트 씨. 우리도 가도록 하죠.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,116,0",
        "voice": "GA730001,3"
      },
      "original": "うん。\nだけど、その前に……。\n",
      "translation": "응. 하지만, 그 전에……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,115,0",
        "voice": "GA730002,3"
      },
      "original": "何でしょう？\n",
      "translation": "무엇인가요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "008,0,115,0",
        "voice": "GA730002,3"
      },
      "original": "さっき言いかけた続きだけど……。\nその、とても……。\n",
      "translation": "아까 하려던 말의 뒷부분인데…… 그게,\n무척……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,115,0",
        "voice": "GA730003,3"
      },
      "original": "とても？\n",
      "translation": "무척?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,115,0",
        "voice": "GA730003,3"
      },
      "original": "とても……きれいだよ。\n",
      "translation": "무척…… 아름다워.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,118,0",
        "voice": "GA730004,3"
      },
      "original": "え……。\n",
      "translation": "에……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,125,0",
        "voice": "GA730005,3"
      },
      "original": "こ……困りましたわね。\nそうストレートに言われると……。\n",
      "translation": "곤…… 곤란하네요. 그렇게 직설적으로\n말씀하시면……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,125,0",
        "voice": "GA730005,3"
      },
      "original": "えっ、何かまずかったかな？\n",
      "translation": "엣, 내가 뭐 잘못 말했나?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,124,0",
        "voice": "GA730006,3"
      },
      "original": "いえ、そういうわけではありませんの。\nただ、その……。\n",
      "translation": "아니요, 그런 건 아니랍니다. 다만, 그……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,124,0",
        "voice": "GA730007,3"
      },
      "original": "……不思議ですわ。\nどうしてタクトさんは、こうもたやすく人の心に\n入り込むことができるのか……。\n",
      "translation": "……신기하군요. 어째서 택트 씨는 이렇게나\n쉽게 사람의 마음에 파고들 수 있는 것인\n지…… .\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,124,0",
        "voice": "GA730007,3"
      },
      "original": "えっ、何のこと？\nオレはただ、きれいだと思ったから素直にきれい\nだって言っただけなんだけど。\n",
      "translation": "엣, 무슨 소리야? 난 그냥, 아름답다고\n생각해서 솔직하게 아름답다 고 말했을 뿐인데.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,115,0",
        "voice": "GA730008,3"
      },
      "original": "うふふっ。\nきっと、それだから……ですわね。\n",
      "translation": "우후훗. 분명, 그것 때문……이겠군요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,115,0",
        "voice": "GA730008,3"
      },
      "original": "はぁ……？\n",
      "translation": "하아……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,116,0",
        "voice": "GA730009,3"
      },
      "original": "お気になさらないでください。\nほめていただいて、うれしいですわ、タクトさん。\n",
      "translation": "신경 쓰지 마세요. 칭찬해 주셔서 기쁘답니다,\n택트 씨.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,116,0",
        "voice": "GA730009,3"
      },
      "original": "ん？\nこの音楽は……。\n",
      "translation": "응? 이 음악은……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0017",
      "channel": 1,
      "context": {
        "voice": "GA730010,3",
        "speaker": "004",
        "face": "110,0,118,0"
      },
      "original": "あら……もう始まってしまったみたいですわ。\n",
      "translation": "어머…… 벌써 시작된 모양이에요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,118,0",
        "voice": "GA730010,3"
      },
      "original": "本当だ。\nみんな踊り始めたな。\nオレたちも行こうか。\n",
      "translation": "정말이다. 다들 춤추기 시작했네. 우리도 갈까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "060",
        "face": "726,0,0,0",
        "voice": "GA730011,3"
      },
      "original": "失礼、エンジェル隊のお嬢さん。\n次の曲は、先約がおありですかな？\n",
      "translation": "실례합니다, 엔젤대 아가씨. 다음 곡은 선약이\n있으신가요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,118,0",
        "voice": "GA730012,3"
      },
      "original": "はい？\nいえ、特には……。\n",
      "translation": "네? 아니요, 딱히는……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0021",
      "channel": 1,
      "context": {
        "voice": "GA730013,3",
        "speaker": "060",
        "face": "726,0,0,0"
      },
      "original": "それでは、私と踊っていただけないでしょうか。\n",
      "translation": "그렇다면, 저와 춤춰 주시지 않겠습니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0022",
      "channel": 1,
      "context": {
        "face": "110,0,115,0",
        "voice": "GA730014,3",
        "speaker": "004"
      },
      "original": "申し訳ありませんが、私はタクトさんのパートナー\nなんですの。\n",
      "translation": "죄송합니다만, 저는 택트 씨의 파트너 랍니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0023",
      "channel": 1,
      "context": {
        "speaker": "060",
        "face": "726,0,0,0",
        "voice": "GA730015,3"
      },
      "original": "それは、ラストダンスのときのことでしょう。\nそのときまでは、うわさに名高いエンジェル隊と\n踊る機会を、我々にも与えてくださいませんか？\n",
      "translation": "그건 라스트 댄스 때의 이야기겠지요. 그때\n전까지는, 소문이 자자한 엔젤대와 춤출\n기회를 저희에게도 주시지 않겠습니까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0024",
      "channel": 1,
      "context": {
        "voice": "GA730016,3",
        "speaker": "004",
        "face": "110,0,124,0"
      },
      "original": "それは……そうですが……。\n",
      "translation": "그건…… 그렇습니다만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,124,0",
        "voice": "GA730016,3"
      },
      "original": "……まぁ、正論ではあるね。\n",
      "translation": "……뭐, 정론이긴 하네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0026",
      "channel": 1,
      "context": {
        "voice": "GA730017,3",
        "speaker": "060",
        "face": "726,0,0,0"
      },
      "original": "それでは、パートナー君にも納得していただいた\nところで……。\n踊っていただけますか、お嬢さん？\n",
      "translation": "그럼, 파트너 군도 납득한 것으로 보고……\n춤을 추어 주시겠습니까, 아가씨?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0027",
      "channel": 1,
      "context": {
        "face": "110,0,115,0",
        "speaker": "004",
        "voice": "GA730018,3"
      },
      "original": "……承知いたしましたわ。\n",
      "translation": "……알겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0028",
      "channel": 1,
      "context": {
        "face": "001,0,115,0",
        "voice": "GA730018,3",
        "speaker": "001"
      },
      "original": "ラストダンスの時間が近くなったら迎えに行くよ、\nミント。\n",
      "translation": "라스트 댄스 시간이 가까워지면 데리러 갈게,\n민트.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0029",
      "channel": 1,
      "context": {
        "face": "110,0,115,0",
        "speaker": "004",
        "voice": "GA730019,3"
      },
      "original": "はい、お待ちしておりますわ。\nそれでは、また後ほど。\n",
      "translation": "네, 기다리고 있겠습니다. 그럼, 나중에\n뵙지요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e9000:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA730019,3"
      },
      "original": "ちぇっ……まぁ、しかたないか。\nあの客の言うとおり、ラストダンスまでは誰でも\nミントと踊る権利はあるし。\n",
      "translation": "쳇…… 뭐, 어쩔 수 없나. 저 손님이 말한\n대로, 라스트 댄스까지는 누구든 민트와 춤출\n권리는 있으니까.\n",
      "state": "needs_human",
      "use_translation": true
    }
  ]
}
