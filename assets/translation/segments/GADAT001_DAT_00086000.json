{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_00086000.txt",
    "encoding": "cp932",
    "sha256": "250d99302268fbc799315f03ad18e95cf0a109f8417c99a13ef561ebe0b77eb0",
    "dialogue_count": 108
  },
  "units": [
    {
      "id": "GADAT001_DAT_00086000:dialogue:0001",
      "channel": 1,
      "context": {
        "face": "021,0,0,046",
        "speaker": "002",
        "voice": "GA535001,3"
      },
      "original": "ミルフィーユ・桜葉、以下５名、まいりました！\n",
      "translation": "밀피유・사쿠라바 외 4명, 도착했습니다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0002",
      "channel": 1,
      "context": {
        "face": "001,0,0,046",
        "speaker": "001",
        "voice": "GA535001,3"
      },
      "original": "うん、みんなお疲れさま。\n",
      "translation": "응, 다들 수고했어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0003",
      "channel": 1,
      "context": {
        "face": "101,101,0,046",
        "speaker": "004",
        "voice": "GA535002,3"
      },
      "original": "クロノ・ドライヴ中に招集があるなんて、珍しい\nですわね。\n",
      "translation": "크로노・드라이브 중에 소집이라니, 드문\n일이네요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0004",
      "channel": 1,
      "context": {
        "face": "004,101,0,046",
        "speaker": "001",
        "voice": "GA535002,3"
      },
      "original": "うん。\nクロノ・ドライヴが終わる前に、みんなに話して\nおきたいことがあってね。\n",
      "translation": "응. 크로노・드라이브가 끝나기 전에, 모두에게\n말해두고 싶은 게 있어서 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0005",
      "channel": 1,
      "context": {
        "face": "141,0,0,143",
        "speaker": "005",
        "voice": "GA535003,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0006",
      "channel": 1,
      "context": {
        "face": "068,066,0,181",
        "speaker": "003",
        "voice": "GA535004,3"
      },
      "original": "話なら、早くしてよね。\nアタシたちだって、ヒマじゃないんだから。\n",
      "translation": "할 말이 있으면 빨리 해. 우리도 바쁘단 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0007",
      "channel": 1,
      "context": {
        "face": "004,066,0,181",
        "speaker": "001",
        "voice": "GA535004,3"
      },
      "original": "わかってる。\nみんな、よく聞いてほしい。\n",
      "translation": "알고 있어. 모두, 잘 들어줬으면 좋겠어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0008",
      "channel": 1,
      "context": {
        "face": "003,0,0,0",
        "speaker": "001",
        "voice": "GA535004,3"
      },
      "original": "まず、合流するはずだったギムソン星系駐留艦隊\nなんだけど、彼らはエオニア軍の手によって全滅\nさせられた可能性がある。\n",
      "translation": "우선, 합류할 예정이었던 김슨 성계 주둔 함대\n말인데, 그들은 에오니아군에 의해 전멸\n당했을 가능성이 있어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0009",
      "channel": 1,
      "context": {
        "face": "021,0,0,026",
        "speaker": "002",
        "voice": "GA535005,3"
      },
      "original": "え……！？\n",
      "translation": "어……!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0010",
      "channel": 1,
      "context": {
        "face": "004,0,0,026",
        "speaker": "001",
        "voice": "GA535005,3"
      },
      "original": "もちろん、可能性があるというだけだ。\n今、我々が向かっているポイントに、再集結して\nいる可能性も残っている。\n",
      "translation": "물론, 가능성이 있다는 것뿐이야. 지금 우리가\n향하고 있는 포인트에 재집결해 있을 가능성도\n남아 있어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,106,0,026",
        "voice": "GA535006,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,106,0,026",
        "voice": "GA535006,3"
      },
      "original": "だが通常空間に出たとたん、エオニア軍の大戦力\nが待ち受けているかもしれない。\nオレはこの可能性が、いちばん高いと思う。\n",
      "translation": "하지만 통상 공간에 나가자마자 에오니아군의\n대전력이 기다리고 있을지도 몰라. 난 이\n가능성이 가장 높다고 생각해.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,106,0,027",
        "voice": "GA535007,3"
      },
      "original": "そ、それは……要約すると、えーっと……。\nつまり、全滅の大戦力が高くって、可能性の味方\nがクロノ・ドライヴということですか！？\n",
      "translation": "그, 그게…… 요약하면, 으ー음…… 그러니까\n전멸의 대전력이 높고, 가능성의 아군이\n크로노・드라이브라는 건가요!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0014",
      "channel": 1,
      "context": {
        "face": "061,067,0,027",
        "speaker": "003",
        "voice": "GA535008,3"
      },
      "original": "ワケわかんないこと言ってんじゃなーいっ！\n",
      "translation": "뭔 소리를 하는 거야ー!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0015",
      "channel": 1,
      "context": {
        "face": "021,067,0,023",
        "voice": "GA535009,3",
        "speaker": "002"
      },
      "original": "だ、だって、びっくりして……。\nどうして、そんなあぶないところに行くんですか、\nタクトさん？\n",
      "translation": "그, 그치만 너무 놀라서…… 왜 그렇게 위험한\n곳에 가려는 거예요, 택트 씨?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0016",
      "channel": 1,
      "context": {
        "voice": "GA535009,3",
        "speaker": "001",
        "face": "004,067,0,023"
      },
      "original": "そうするよりほかになかった。\nオレたちはポイントＹＪｅ６３０へ行くしかない\nように、敵に追い込まれたんだ。\n",
      "translation": "그렇게 할 수밖에 없었어. 우리는 포인트\nYJe630으로 갈 수밖에 없도록, 적에게 몰린\n거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,067,0,186",
        "voice": "GA535010,3"
      },
      "original": "……そうでしたか……。\n",
      "translation": "……그랬군요……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,067,0,186",
        "voice": "GA535011,3"
      },
      "original": "それがわかっていて、何でクロノ・ドライヴした\nのよ！？\nあのまま戦っていれば、もしかしたら……。\n",
      "translation": "그걸 알면서 왜 크로노・드라이브를 한 거야!?\n그대로 싸웠다면, 어쩌면……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0019",
      "channel": 1,
      "context": {
        "face": "003,067,0,186",
        "voice": "GA535011,3",
        "speaker": "001"
      },
      "original": "あのまま戦っていれば、我々が確実に負けていた。\nだから、少しでも体勢を立て直す時間がかせげる\nクロノ・ドライヴを選んだ。\n",
      "translation": "그대로 싸웠다면 우리가 확실히 졌을 거야.\n그래서 조금이라도 전열을 재정비할 시간을\n벌 수 있는 크로노・드라이브를 선택했어.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,072,0,186",
        "voice": "GA535012,3"
      },
      "original": "そんなの、やってみなきゃわかんないじゃない！\nだいいち、今度のドライヴ・アウト先には、この\n前と同じか、それ以上の敵がいるんでしょ？\n",
      "translation": "그런 건 해보기 전엔 모르는 거잖아! 애초에\n이번 드라이브・아웃 장소에는, 전이랑 같거나\n그 이상의 적이 있는 거지?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,0,143",
        "voice": "GA535013,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,120,0,0",
        "voice": "GA535014,3"
      },
      "original": "落ち着いてくださいな、ランファさん。\nクロノ・ドライヴに入ってしまったのですから、\n今さら何を言ってもしかたがありませんわ。\n",
      "translation": "진정하세요, 란파 씨. 크로노・드라이브에\n들어간 이상, 이제 와서 무슨 말을 해도\n소용없어요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0023",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,072,0",
        "voice": "GA535015,3"
      },
      "original": "わかってるわよ！\nだけど、これから戦闘になるってのに、どうして\nそんなこと言うのよ、タクト！\n",
      "translation": "알고 있다고! 그런데 이제 곧 전투인데, 왜\n그런 말을 하는 거야, 택트!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0024",
      "channel": 1,
      "context": {
        "voice": "GA535016,3",
        "speaker": "002",
        "face": "021,0,0,047"
      },
      "original": "あたしも、心配です……。\nタクトさん……あたしたちは、どうしたらいいん\nですか……？\n",
      "translation": "저도 걱정돼요…… 택트 씨…… 저희는 어떻게\n해야 하는 건가요……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0025",
      "channel": 1,
      "context": {
        "face": "181,187,0,047",
        "speaker": "006",
        "voice": "GA535017,3"
      },
      "original": "……タクトさんの方針をお聞かせください。\n",
      "translation": "……택트 씨의 방침을 들려주세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,187,0,047",
        "voice": "GA535017,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA535017,3"
      },
      "original": "オレが包み隠さず打ち明けたのは、みんなを信頼\nしているからだ。\n",
      "translation": "내가 숨김없이 털어놓은 건 다들 믿고 있기\n때문이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA535017,3"
      },
      "original": "オレは、エンジェル隊のみんなを信じている。\nオレたちみんなの力があれば、負けるはずはない。\n",
      "translation": "난 엔젤대 모두를 믿어. 우리 모두의 힘이\n있다면 질 리가 없어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,0,165",
        "voice": "GA535018,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA535018,3"
      },
      "original": "オレは、オレのベストをつくす。\nみんなのために、全力で指揮してみせる。\n",
      "translation": "난 최선을 다할 거야. 모두를 위해 전력을 다해\n지휘할게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0031",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA535018,3"
      },
      "original": "たとえどれほどの大軍が待ちかまえていようとも、\n必ず活路を見つけて、エルシオールとエンジェル\n隊を脱出させてみせる！\n",
      "translation": "아무리 대군이 기다리고 있어도 반드시 활로를\n찾아내서 에르시올과 엔젤대를 탈출시키겠어!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0032",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,0,0",
        "voice": "GA535018,3"
      },
      "original": "だから……みんなも、オレを信じてくれ。\nオレを信じて、ベストの戦いをしてくれ！\n",
      "translation": "그러니까…… 다들 나를 믿어 줘. 나를 믿고\n최선을 다해 싸워 줘!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,065,0",
        "voice": "GA535019,3"
      },
      "original": "タクトを……信じて……。\n",
      "translation": "택트를…… 믿고……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0034",
      "channel": 1,
      "context": {
        "voice": "GA535020,3",
        "speaker": "004",
        "face": "101,0,0,106"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0035",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,186,0,106",
        "voice": "GA535021,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0036",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,027,0",
        "voice": "GA535022,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0037",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,025,0",
        "voice": "GA535023,3"
      },
      "original": "……はい！\nあたし、タクトさんを信じます！\n",
      "translation": "……네! 저, 택트 씨를 믿을게요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,062,0,0",
        "voice": "GA535024,3"
      },
      "original": "わかったわよ。\nアタシも覚悟を決めようじゃないの！\n",
      "translation": "알았어. 나도 각오를 다지겠어!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0039",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,062,0,101",
        "voice": "GA535025,3"
      },
      "original": "タクトさんを信頼し、全力をつくしますわ。\n",
      "translation": "택트 씨를 믿고 전력을 다하겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0040",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,198,0,101",
        "voice": "GA535026,3"
      },
      "original": "指揮……よろしくお願いします。\n",
      "translation": "지휘…… 잘 부탁드립니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0041",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,165,0",
        "voice": "GA535027,3"
      },
      "original": "タクト、よく言ったよ。\nそれでこそ、あたしの司令官だ。\n",
      "translation": "택트, 잘 말했어. 그래야 내 사령관이지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0042",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,141,0",
        "voice": "GA535027,3"
      },
      "original": "フォルテ……みんな……。\nありがとう。\n",
      "translation": "포르테…… 모두들…… 고마워.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0043",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,142,0",
        "voice": "GA535028,3"
      },
      "original": "よーし、みんな！\nタクトを信頼して、いっちょうやってやろうじゃ\nないのさ！\n",
      "translation": "좋ー아, 다들! 택트를 믿고 한판 제대로\n해보자고!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0044",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,142,0",
        "voice": "GA535028,3"
      },
      "original": "頼んだぞ。\nエンジェル隊、第１戦闘配備で待機！\n",
      "translation": "부탁한다. 엔젤대, 제1 전투태세로 대기!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0045",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,143,0",
        "voice": "GA535029,3"
      },
      "original": "了解。\nじゃあ、行ってくるよ。\nそっちも、しっかり指揮しておくれ。\n",
      "translation": "알았어. 그럼 다녀올게. 그쪽도 제대로\n지휘해 줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0046",
      "channel": 1,
      "context": {
        "speaker": "094",
        "face": "000,0,0,0",
        "voice": "GA535029,3"
      },
      "original": "　\n",
      "translation": "　\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0047",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,0,0,0",
        "voice": "GA535030,3"
      },
      "original": "司令、ドライヴ・アウトまで、あと９０秒です。\n",
      "translation": "사령관님, 드라이브・아웃까지 앞으로 90초입니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0048",
      "channel": 1,
      "context": {
        "face": "003,0,0,0",
        "voice": "GA535030,3",
        "speaker": "001"
      },
      "original": "わかった。\n総員、第１戦闘配備だ。\n",
      "translation": "알았다. 전원, 제1 전투태세다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0049",
      "channel": 1,
      "context": {
        "face": "221,0,221,0",
        "voice": "GA535031,3",
        "speaker": "007"
      },
      "original": "タクト……お前、よく恥ずかしくないな、あんな\nセリフを吐いて。\n",
      "translation": "택트…… 너, 그런 낯간지러운 말을 잘도\n아무렇지 않게 하는구나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0050",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,221,0",
        "voice": "GA535031,3"
      },
      "original": "どうして？\nオレは思っていることを素直に口にしただけだよ。\n",
      "translation": "왜? 난 생각하는 걸 솔직하게 말했을 뿐이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0051",
      "channel": 1,
      "context": {
        "face": "221,0,224,0",
        "voice": "GA535032,3",
        "speaker": "007"
      },
      "original": "ふぅん。\n……まぁ、それなら別にいいがな。\n",
      "translation": "흐음. ……뭐, 그렇다면 별 상관없지만 말이다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0052",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,224,0",
        "voice": "GA535032,3"
      },
      "original": "あ、そういやレスターは、オレを信じてるの？\n",
      "translation": "아, 그러고 보니 레스터는, 나를 믿고 있어?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0053",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA535033,3"
      },
      "original": "いや、これっぽっちも信じてないぞ。\n",
      "translation": "아니, 눈곱만큼도 믿지 않는다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0054",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,223,0",
        "voice": "GA535033,3"
      },
      "original": "うわ！\n副司令とも思えないお言葉。\n",
      "translation": "우와! 부사령관답지 않은 말씀이네요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0055",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GA535034,3"
      },
      "original": "信頼してないから、こうやってお前の後をついて\n回って、何かしでかしたら、すぐフォローできる\nようにしてるんじゃないか。\n",
      "translation": "못 믿으니까 이렇게 네 뒤를 따라다니며, 네가\n무슨 사고를 치면 바로 수습해 주는 거 아니냐.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0056",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,221,0",
        "voice": "GA535034,3"
      },
      "original": "はいはい。\nありがたいお心づかい、痛み入ります。\n",
      "translation": "네, 네. 고마운 배려, 송구스럽습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0057",
      "channel": 1,
      "context": {
        "face": "501,0,0,0",
        "speaker": "017",
        "voice": "GA535035,3"
      },
      "original": "間もなく、通常空間に移行します。\nドライヴ・アウトまで、あと５秒。\n４、３、２……。\n",
      "translation": "곧 통상 공간으로 전환합니다.\n드라이브・아웃까지 앞으로 5초. 4, 3,\n2……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0058",
      "channel": 1,
      "context": {
        "face": "003,0,0,0",
        "speaker": "001",
        "voice": "GA535035,3"
      },
      "original": "おっと、いよいよか。\nさぁ、何が出るやら……。\n",
      "translation": "이런, 드디어인가. 자, 무엇이 나올지……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0059",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,0,0,0",
        "voice": "GA535036,3"
      },
      "original": "エルシオール、ドライヴ・アウトしました。\n艦内には異常なし。\n",
      "translation": "에르시올, 드라이브・아웃했습니다. 함내에는\n이상 없음.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0060",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "493,0,0,0",
        "voice": "GA535037,3"
      },
      "original": "レーダーに反応あり！\n敵艦隊……正面に……。\n",
      "translation": "레이더에 반응 있음! 적 함대…… 정면에……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0061",
      "channel": 1,
      "context": {
        "voice": "GA535038,3",
        "speaker": "007",
        "face": "221,0,225,0"
      },
      "original": "正面がどうした。\nちゃんと報告しろ。\n",
      "translation": "정면이 어쨌다는 거냐. 제대로 보고해라.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0062",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "493,0,225,0",
        "voice": "GA535039,3"
      },
      "original": "か……数えきれません！\nとにかく、大艦隊です！\n見たこともないくらい、たくさん！！\n",
      "translation": "세…… 셀 수 없습니다! 어쨌든 대함대입니다!\n본 적도 없을 만큼 많습니다!!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0063",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,0,225,0",
        "voice": "GA535040,3"
      },
      "original": "映像とらえました。\nメインモニターに出します！\n",
      "translation": "영상을 포착했습니다. 메인 모니터에\n띄우겠습니다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0064",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "224,0,0,0",
        "voice": "GA535041,3"
      },
      "original": "こ、これは……！？\nまさか、これほどの数が……。\n",
      "translation": "이, 이것은……!? 설마, 이 정도의 수가……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0065",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA535041,3"
      },
      "original": "さすがに、こんな大艦隊とは予想してなかったな。\nエオニア軍の本隊ってところか？\n",
      "translation": "역시나, 이런 대함대일 줄은 예상 못 했네.\n에오니아군의 본대라는 건가?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0066",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,0",
        "voice": "GA535042,3"
      },
      "original": "敵艦隊中央に、大型艦があります。\nこれが旗艦と思われます。\n",
      "translation": "적 함대 중앙에, 대형함이 있습니다. 이것이\n기함으로 판단됩니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0067",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "493,0,0,0",
        "voice": "GA535043,3"
      },
      "original": "後方、クロノ・ドライヴ反応です！\n",
      "translation": "후방, 크로노・드라이브 반응입니다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0068",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "223,0,0,0",
        "voice": "GA535044,3"
      },
      "original": "友軍か？\n",
      "translation": "아군인가?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0069",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,0",
        "voice": "GA535045,3"
      },
      "original": "い、いいえ。\nポイントＹＪｎ６７４で交戦した艦隊のようです。\n",
      "translation": "아, 아니요. 포인트 YJn674에서 교전한\n함대인 것 같습니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0070",
      "channel": 1,
      "context": {
        "face": "004,0,0,0",
        "voice": "GA535045,3",
        "speaker": "001"
      },
      "original": "シェリーさんか。\nやっぱり追って来てたんだな。\n",
      "translation": "셰리 씨인가. 역시 쫓아오고 있었구나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0071",
      "channel": 1,
      "context": {
        "speaker": "042",
        "face": "361,0,0,0",
        "voice": "GA535046,3"
      },
      "original": "ウフフ……。\n追いつめたわよ、働きバチさん。\n",
      "translation": "우후후…… 몰아넣었어, 일벌 씨.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0072",
      "channel": 1,
      "context": {
        "speaker": "042",
        "face": "361,0,0,0",
        "voice": "GA535047,3"
      },
      "original": "これで遊びはもうおしまい。\n……たとえわたくしから逃れることができても、\nエオニア様からは、決して逃げられないわ。\n",
      "translation": "이것으로 놀이는 이제 끝이야. ……설령\n나로부터 도망칠 수 있다 해도, 에오니아\n님으로부터는, 결코 도망칠 수 없어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0073",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,0,0,0",
        "voice": "GA535048,3"
      },
      "original": "前方の艦隊から、通信が入りました。\n敵の旗艦からです。\n",
      "translation": "전방의 함대로부터 통신이 들어왔습니다. 적의\n기함으로부터입니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0074",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA535048,3"
      },
      "original": "……つないでくれ。\n",
      "translation": "……연결해 줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0075",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "311,0,0,0",
        "voice": "GA535049,3"
      },
      "original": "……直接、諸君と言葉を交わすのは初めてだな。\n自己紹介は必要かね？\n",
      "translation": "……직접, 그대들과 말을 나누는 건 처음이군.\n자기소개는 필요한가?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0076",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA535049,3"
      },
      "original": "…………！！\n",
      "translation": "…………!!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0077",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "224,0,0,0",
        "voice": "GA535050,3"
      },
      "original": "なっ……。\nエオニア……本人かよ！？\n",
      "translation": "뭣…… 에오니아…… 본인이야!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0078",
      "channel": 1,
      "context": {
        "voice": "GA535050,3",
        "speaker": "001",
        "face": "012,0,0,0"
      },
      "original": "いきなり総大将のお出ましとはね。\nオレたちも、えらくなったもんだ。\n",
      "translation": "갑자기 총대장이 나서다니 말이야. 우리도,\n대단해졌구만.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0079",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA535050,3"
      },
      "original": "こちらエルシオール司令官、タクト・マイヤーズ。\n自己紹介はけっこうです。\nお目にかかれて光栄ですよ、エオニア元皇子。\n",
      "translation": "여기는 에르시올 사령관, 택트・마이어스.\n자기소개는 됐습니다. 만나 뵙게 되어\n영광이군요, 에오니아 전 황자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0080",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "311,0,0,0",
        "voice": "GA535051,3"
      },
      "original": "よく我々の手を逃れ、ここまでたどり着いた。\n君の健闘には心から賞賛を贈ろう。\n",
      "translation": "잘도 우리의 손을 벗어나, 여기까지 도달했군.\n그대의 건투에는 진심으로 찬사를 보내지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0081",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA535051,3"
      },
      "original": "それはどうも。\nついでに、そちらの艦隊を我々の進路からどけて\nもらえると、もっとありがたいんですが。\n",
      "translation": "별말씀을요. 덧붙여서, 그쪽 함대를 우리\n항로에서 비켜 주신다면 더 고맙겠습니다만.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0082",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "311,0,0,0",
        "voice": "GA535052,3"
      },
      "original": "ふふ……なるほど、シェリーの話どおりの男だな。\n残念だが、それはできない。\n",
      "translation": "후후…… 과연, 셰리의 말 그대로인 남자군.\n유감이지만, 그건 불가능하다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0083",
      "channel": 1,
      "context": {
        "face": "311,0,0,0",
        "voice": "GA535053,3",
        "speaker": "012"
      },
      "original": "ただちに武装解除し、貴艦が身柄を拘束している\nシヴァを解放してもらおう。\n",
      "translation": "즉시 무장을 해제하고, 귀함이 억류하고 있는\n시바를 풀어 주도록.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0084",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "311,0,0,0",
        "voice": "GA535054,3"
      },
      "original": "素直に応じるならば、それでよし。\n君たちの身柄と、エルシオール、紋章機の安全は、\n私の名において保証しよう。\n",
      "translation": "순순히 응한다면, 그걸로 됐다. 그대들의\n신변과, 에르시올, 문장기의 안전은, 내\n이름으로 보증하겠다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0085",
      "channel": 1,
      "context": {
        "face": "004,0,0,0",
        "voice": "GA535054,3",
        "speaker": "001"
      },
      "original": "それには応じられませんね。\nそっちがどかないんなら、オレたちは自力でここ\nを突破するだけですから。\n",
      "translation": "그건 응할 수 없겠네요. 그쪽이 비키지 않는다면\n우린 우리 힘으로 여길 돌파할 뿐이니까요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0086",
      "channel": 1,
      "context": {
        "face": "312,0,0,0",
        "speaker": "012",
        "voice": "GA535055,3"
      },
      "original": "思いのほか、つまらん答えだな。\nよかろう、ではその蛮勇を、ゆっくり見学させて\nもらうとしよう。\n",
      "translation": "생각보다, 시시한 대답이군. 좋다, 그럼 그\n만용을, 천천히 구경하도록 하지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0087",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "315,0,0,0",
        "voice": "GA535056,3"
      },
      "original": "……シェリー、後は任せる。\nシヴァを私の元まで連れてこい。\n",
      "translation": "……셰리, 나머지는 맡기마. 시바를 내 곁으로\n데려와라.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0088",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,0",
        "voice": "GA535057,3"
      },
      "original": "……旗艦が後退していきます。\n戦闘宙域から離脱するもようです。\n",
      "translation": "……기함이 후퇴하고 있습니다. 전투 구역에서\n이탈하려는 모양입니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0089",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,224,0",
        "voice": "GA535058,3"
      },
      "original": "さてと……じゃあ、やるか。\nタクトが大見得切ったんだ、負けるわけにはいか\nねぇよな。\n",
      "translation": "자, 그럼…… 가볼까. 택트가 큰소리를\n쳤으니, 질 수는 없겠지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0090",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,224,0",
        "voice": "GA535058,3"
      },
      "original": "ああ……あきらめてたまるか。\nオレは活路を見つけるって約束したんだ。\n絶対に、何か方法があるはずだ。\n",
      "translation": "아아…… 포기할 수 없어. 나는 활로를\n찾겠다고 약속했으니까. 분명, 어떤 방법이\n있을 거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0091",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,0",
        "voice": "GA535059,3"
      },
      "original": "あ、あの……。\n",
      "translation": "저, 저기……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0092",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA535060,3"
      },
      "original": "何だ、こんなときに。\n",
      "translation": "뭐야, 이럴 때.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0093",
      "channel": 1,
      "context": {
        "voice": "GA535061,3",
        "speaker": "016",
        "face": "491,0,223,0"
      },
      "original": "は、はい。\nレーダーが、異常な重力場をとらえているんです。\n",
      "translation": "네, 네. 레이더가, 이상 중력장을 포착하고\n있어요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0094",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,223,0",
        "voice": "GA535061,3"
      },
      "original": "異常な重力場？\n",
      "translation": "이상 중력장?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0095",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,223,0",
        "voice": "GA535062,3"
      },
      "original": "旗艦が後退していった方向……敵艦隊の後方から\nです。\n小惑星クラスの巨大な質量が検知されています。\n",
      "translation": "기함이 후퇴한 방향…… 적 함대 후방입니다.\n소행성급의 거대한 질량이 탐지되고 있습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0096",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA535063,3"
      },
      "original": "このあたりに小惑星なんてないはずだが。\nかといって、この先の恒星なわけもないし……。\nレーダーの故障じゃないのか？\n",
      "translation": "이 근처에 소행성 같은 건 없을 텐데. 그렇다고\n해서, 이 앞의 항성일 리도 없고…… 레이더\n고장 아닌가?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0097",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,223,0",
        "voice": "GA535064,3"
      },
      "original": "そうかもしれませんけど……。\n",
      "translation": "그럴지도 모르겠지만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0098",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,223,0",
        "voice": "GA535064,3"
      },
      "original": "気になるけど、今は目の前の敵に集中しよう。\n敵艦隊の分析を急いでくれ。\n",
      "translation": "신경 쓰이지만, 지금은 눈앞의 적에게\n집중하자. 적 함대의 분석을 서둘러 줘.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0099",
      "channel": 1,
      "context": {
        "face": "503,0,0,0",
        "voice": "GA535065,3",
        "speaker": "017"
      },
      "original": "…………！？\nマイヤーズ司令、大変です！\n",
      "translation": "…………!? 마이어스 사령관님, 큰일입니다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0100",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA535065,3"
      },
      "original": "今度はどうした？\n",
      "translation": "이번엔 또 무슨 일이지?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0101",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,0,0,0",
        "voice": "GA535066,3"
      },
      "original": "前後に展開しているエオニア軍以外のところから、\n通信が入っています。\n友軍からのメッセージのようです！\n",
      "translation": "앞뒤에 포진한 에오니아군이 아닌 곳에서 통신이\n들어옵니다. 아군의 메시지인 것 같습니다!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0102",
      "channel": 1,
      "context": {
        "face": "221,0,223,0",
        "voice": "GA535067,3",
        "speaker": "007"
      },
      "original": "友軍だって？\n何かの間違いじゃないのか？\n",
      "translation": "아군이라고? 무슨 착각 아니냐?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0103",
      "channel": 1,
      "context": {
        "voice": "GA535068,3",
        "speaker": "017",
        "face": "501,0,223,0"
      },
      "original": "最初はノイズかと思ったんですが……確かです。\n暗号を解読しました。\n",
      "translation": "처음에는 노이즈인가 싶었습니다만……\n확실합니다. 암호를 해독했습니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0104",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,0,223,0",
        "voice": "GA535069,3"
      },
      "original": "『ただちにポイントＹＪｎ６３１まで来られたし』\n　だそうです。\n　右舷前方の恒星のそばですね。\n",
      "translation": "『즉시 포인트 YJn631까지 오라』고\n합니다. 우현 전방 항성 근처군요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0105",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,225,0",
        "voice": "GA535070,3"
      },
      "original": "そんな無茶な。\nそのポイントへ行くためには、前方の敵の左翼を\n突っ切ることになるぞ！\n",
      "translation": "말도 안 돼. 그 포인트로 가려면 전방에 있는\n적의 좌익을 뚫고 지나가야 한다고!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0106",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,225,0",
        "voice": "GA535070,3"
      },
      "original": "オレは仲間を信じるよ。\nそれにエルシオールには、紋章機がある。\nエンジェル隊がいる。\n",
      "translation": "나는 동료를 믿어. 게다가 에르시올에는,\n문장기가 있다. 엔젤대가 있어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0107",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,222,0",
        "voice": "GA535071,3"
      },
      "original": "……そうだな、お前はそういうヤツだったよな。\nわかった、つきあうよ。\n",
      "translation": "……그렇군, 너는 그런 녀석이었지. 알았다,\n함께해 주지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00086000:dialogue:0108",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,222,0",
        "voice": "GA535071,3"
      },
      "original": "ありがとう、レスター。\nじゃあ、行くか。\n",
      "translation": "고마워, 레스터. 그럼, 갈까.\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
