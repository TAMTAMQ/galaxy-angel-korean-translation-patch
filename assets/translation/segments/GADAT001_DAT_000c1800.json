{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000c1800.txt",
    "encoding": "cp932",
    "sha256": "03e6114aba6db090cf6c3c3b155d9d42540bc526b7709bf6d71daa1de91cdd11",
    "dialogue_count": 13
  },
  "units": [
    {
      "id": "GADAT001_DAT_000c1800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "　ランファたちが、がんばってくれたおかげで、\n『黒き月』を破壊することができたんですから。\n",
      "translation": "란파 일행이 열심히 해 준 덕분에\n『흑색 달』을 파괴할 수 있었으니까요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c1800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "062,0,0,0",
        "voice": "GAF13001,3"
      },
      "original": "まぁ、ハッキリ言って、余裕だったわね！\nオーッホホホホ！\n",
      "translation": "뭐, 솔직히 말해 여유로웠지!\n오홋호호호!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c1800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "008,0,0,0",
        "voice": "GAF13001,3"
      },
      "original": "泣いたカラスが、もう笑ったよ……。\n",
      "translation": "방금 울더니 벌써 웃네……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c1800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "086,0,0,0",
        "voice": "GAF13002,3"
      },
      "original": "うっさいわね！\nホントに心配したんだから……。\n",
      "translation": "시끄러워!\n정말 걱정했단 말이야……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c1800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAF13002,3"
      },
      "original": "あ、やっぱり心配してくれたんだ。\n",
      "translation": "아, 역시 걱정해 준 거구나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c1800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "065,0,0,0",
        "voice": "GAF13003,3"
      },
      "original": "うっ……。\n",
      "translation": "윽……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c1800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "063,0,0,0",
        "voice": "GAF13004,3"
      },
      "original": "そ……そうよ。\n悪い？\n",
      "translation": "그…… 그래.\n불만 있어?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c1800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GAF13004,3"
      },
      "original": "いや、ぜんぜん。\nうれしいよ、ランファ。\n",
      "translation": "아니, 전혀.\n기뻐, 란파.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c1800:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "089,0,0,0",
        "voice": "GAF13005,3"
      },
      "original": "えへへへっ。\nやだぁ、タクトったら★\n",
      "translation": "에헤헤헷.\n정말이지, 택트도 참★\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c1800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "142,0,0,0",
        "voice": "GAF13006,3"
      },
      "original": "あー、ゴホン。\nお熱いカップルさんには申し訳ないんだけどさ、\nそろそろ引きあげないかい？\n",
      "translation": "아, 크흠. 사이좋은 커플 씨한텐 미안한데\n이제 슬슬 철수하지 않을래?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c1800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0",
        "voice": "GAF13006,3"
      },
      "original": "あ、そうだった。\n",
      "translation": "아, 맞다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c1800:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GAF13006,3"
      },
      "original": "みんな、本当にお疲れさま。\nエルシオールとエンジェル隊は『白き月』へ帰還\nする！\n",
      "translation": "다들 정말 수고했어.\n에르시올과 엔젤대는 『백색 달』로 귀환한다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c1800:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "089,0,0,0",
        "voice": "GAF13007,3"
      },
      "original": "続きは帰ってからね、タクト★\n",
      "translation": "나머지는 돌아가서 하자, 택트★\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
