{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000f3800.txt",
    "encoding": "cp932",
    "sha256": "bae65ce64935f36651f32fc3d87ebbb36da57130caad51db2bff1fc0863cc838",
    "dialogue_count": 58
  },
  "units": [
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0"
      },
      "original": "うーん、見当たらないなぁ。\nヴァニラ、どこにいるんだろう……。\n",
      "translation": "으음, 안 보이네. 바닐라, 어디에 있는\n걸까……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0"
      },
      "original": "……あっ、あそこにいるのは……。\n",
      "translation": "……앗, 저기에 있는 건……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "189,0,0,0",
        "voice": "GA738001,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA738001,3"
      },
      "original": "おーい、ヴァニラ！\n",
      "translation": "어이, 바닐라!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "191,0,0,0",
        "voice": "GA738002,3"
      },
      "original": "あ……。\n",
      "translation": "아……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA738002,3"
      },
      "original": "こんなところにいたのか。\n探したんだぞ？\n",
      "translation": "이런 곳에 있었구나. 한참 찾았어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "198,0,0,0",
        "voice": "GA738003,3"
      },
      "original": "……申し訳ありません……。\n",
      "translation": "……죄송합니다……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA738003,3"
      },
      "original": "いや、怒ってるわけじゃないんだ。\nそれより、もうラストダンスが始まるよ。\n",
      "translation": "아니, 화난 게 아니야. 그보다, 이제 라스트\n댄스가 시작돼.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "198,0,0,0",
        "voice": "GA738004,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA738004,3"
      },
      "original": "ヴァニラ……どうしたの？\n",
      "translation": "바닐라…… 왜 그래?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "198,0,0,0",
        "voice": "GA738005,3"
      },
      "original": "私……やっぱり、遠慮します。\n",
      "translation": "저…… 역시, 사양하겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA738005,3"
      },
      "original": "遠慮って……踊らないのかい？\nどうして？\n",
      "translation": "사양이라니…… 안 추는 거야? 어째서?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0013",
      "channel": 1,
      "context": {
        "face": "198,0,0,0",
        "speaker": "006",
        "voice": "GA738006,3"
      },
      "original": "それは……。\n私、ダンスが苦手ですから……。\n",
      "translation": "그건…… 제가, 춤을 잘 못 추니까……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0014",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "speaker": "001",
        "voice": "GA738006,3"
      },
      "original": "うまく踊れないかもしれないことを、心配してる\nのかい？\nそんなの気にすることないよ。\n",
      "translation": "잘 못 출지도 모른다는 걸, 걱정하는 거야?\n그런 건 신경 쓸 거 없어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "198,0,0,0",
        "voice": "GA738007,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA738007,3"
      },
      "original": "うーん……。\nねぇ、ヴァニラ。\n",
      "translation": "으음…… 있지, 바닐라.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA738007,3"
      },
      "original": "もっと自分に自信を持ってよ。\nヴァニラなら、できるさ。\n",
      "translation": "좀 더 자신감을 가져. 바닐라라면, 할 수 있어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA738007,3"
      },
      "original": "前にも言ったよね。\nオレは、ヴァニラと踊ることで、感謝の気持ちを\n伝えたいんだ。\n",
      "translation": "전에도 말했었지. 난 바닐라와 춤추면서\n감사한 마음을 전하고 싶은 거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "192,0,0,0",
        "voice": "GA738008,3"
      },
      "original": "タクトさん……。\n",
      "translation": "택트 씨……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0020",
      "channel": 1,
      "context": {
        "face": "198,0,0,0",
        "voice": "GA738009,3",
        "speaker": "006"
      },
      "original": "でも……私は、消去法で選ばれただけの相手です\nから……。\n",
      "translation": "하지만…… 전 소거법으로 뽑힌 상대일\n뿐이니까……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0021",
      "channel": 1,
      "context": {
        "face": "012,0,0,0",
        "speaker": "001",
        "voice": "GA738009,3"
      },
      "original": "いや、あれは単なる言葉のアヤというか……。\nヴァニラが気にすることなんかないってば。\n",
      "translation": "아니, 그건 말이 좀 그렇게 나온\n것뿐이랄까…… 바닐라가 신경 쓸 건 아무것도\n없다니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA738009,3"
      },
      "original": "さぁ、せっかくの舞踏会なんだから。\n勇気を出して、オレと踊ってくれないか？\n",
      "translation": "자, 모처럼의 무도회니까. 용기를 내서, 나와\n춤춰 주지 않을래?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0023",
      "channel": 1,
      "context": {
        "face": "191,0,0,0",
        "voice": "GA738010,3",
        "speaker": "006"
      },
      "original": "……タクトさん……。\n",
      "translation": "……택트 씨……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA738010,3"
      },
      "original": "うん、何だい？\n",
      "translation": "응, 왜 그래?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "198,0,0,0",
        "voice": "GA738011,3"
      },
      "original": "私、今日は少し変です……。\n",
      "translation": "저, 오늘은 조금 이상해요……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0026",
      "channel": 1,
      "context": {
        "voice": "GA738011,3",
        "speaker": "001",
        "face": "006,0,0,0"
      },
      "original": "えっ？\n",
      "translation": "어?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "198,0,0,0",
        "voice": "GA738012,3"
      },
      "original": "たぶん、それは……。\n",
      "translation": "아마, 그건……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "192,0,0,0",
        "voice": "GA738013,3"
      },
      "original": "……タクトさんと、一緒にいるからだと思います。\n",
      "translation": "……택트 씨와, 함께 있어서 그런 것 같아요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA738013,3"
      },
      "original": "ヴァニラ……。\n",
      "translation": "바닐라……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA738013,3"
      },
      "original": "踊ろう、一緒に。\n",
      "translation": "같이 춤추자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0031",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA738013,3"
      },
      "original": "オレと踊りたいんじゃなかったの？\n前にオレの部屋に来たとき、そう言っていたじゃ\nないか。\n",
      "translation": "나랑 춤추고 싶었던 거 아니었어? 전에 내\n방에 왔을 때 그렇게 말했잖아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0032",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "198,0,0,0",
        "voice": "GA738014,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA738014,3"
      },
      "original": "それに、公園でも言ってただろ？\n舞踏会で踊るパートナーは、オレがいいって。\n",
      "translation": "게다가 공원에서도 말했잖아? 무도회에서\n춤출 파트너는 내가 좋다고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0034",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA738014,3"
      },
      "original": "オレだって、ヴァニラと踊りたいんだ。\nほら、早くしないと、曲が終わっちゃうよ。\n",
      "translation": "나도, 바닐라와 춤추고 싶단 말이야. 자, 빨리\n안 하면, 곡이 끝나버릴 거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0035",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA738014,3"
      },
      "original": "それじゃ、ダンスはあきらめるよ。\n踊りたくないと言っているのを、無理に誘うのは\n本意じゃないし。\n",
      "translation": "그럼 춤은 포기할게. 춤추고 싶지 않다는 걸\n억지로 권하고 싶진 않으니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0036",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "191,0,0,0",
        "voice": "GA738015,3"
      },
      "original": "え……？\n",
      "translation": "네……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0037",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA738015,3"
      },
      "original": "ああ、残念だなぁ。\n最後の思い出に、ヴァニラと踊りたかったのに。\n",
      "translation": "아아, 아쉽네. 마지막 추억으로, 바닐라와\n춤추고 싶었는데.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "191,0,0,0",
        "voice": "GA738016,3"
      },
      "original": "……最後……。\n",
      "translation": "……마지막……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0039",
      "channel": 1,
      "context": {
        "face": "004,0,0,0",
        "voice": "GA738016,3",
        "speaker": "001"
      },
      "original": "だけど、しかたがないよな。\nオレは向こうで休むことにするよ。\nそれじゃね、ヴァニラ。\n",
      "translation": "하지만, 어쩔 수 없지. 나는 저쪽에서 쉬기로\n할게. 그럼 이만, 바닐라.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0040",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "198,0,0,0",
        "voice": "GA738017,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0041",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "189,0,0,0",
        "voice": "GA738018,3"
      },
      "original": "……ま……待ってください。\n",
      "translation": "……기…… 기다려 주세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0042",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA738018,3"
      },
      "original": "うん、何か用かい？\n",
      "translation": "응, 무슨 일이야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0043",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "192,0,0,0",
        "voice": "GA738019,3"
      },
      "original": "私も……タクトさんと一緒に……踊りたい、です。\n",
      "translation": "저도…… 택트 씨와 함께…… 춤추고……\n싶어요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0044",
      "channel": 1,
      "context": {
        "voice": "GA738019,3",
        "speaker": "001",
        "face": "002,0,0,0"
      },
      "original": "よし、作戦成功！\n",
      "translation": "좋아, 작전 성공!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0045",
      "channel": 1,
      "context": {
        "face": "191,0,0,0",
        "speaker": "006",
        "voice": "GA738020,3"
      },
      "original": "はい……？\n",
      "translation": "네……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0046",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA738020,3"
      },
      "original": "ヴァニラの口から、そう言わせたかったんだ。\nオレの演技も、なかなかのものだろ？\n",
      "translation": "바닐라의 입에서, 그렇게 말하게 하고 싶었어.\n내 연기도, 제법이지?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0047",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "199,0,0,0",
        "voice": "GA738021,3"
      },
      "original": "……私を、だましたんですか……？\n",
      "translation": "……저를, 속인 건가요……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0048",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA738021,3"
      },
      "original": "いや、だましたというか……。\nごめん、ちょっとやりすぎたかも。\n",
      "translation": "아니, 속였다기보다…… 미안, 좀 과했을지도.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0049",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA738021,3"
      },
      "original": "でも、ヴァニラと踊りたいっていうのは本当だよ。\nさあ、踊ろう。\n",
      "translation": "하지만, 바닐라와 춤추고 싶다는 건 진심이야.\n자, 춤추자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0050",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "198,0,0,0",
        "voice": "GA738022,3"
      },
      "original": "はい……ですが……。\n",
      "translation": "네…… 하지만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0051",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,194,0",
        "voice": "GA738022,3"
      },
      "original": "……曲が終わった。\n舞踏会も、これで終わりだな。\n",
      "translation": "……곡이 끝났다. 무도회도, 이걸로 끝이군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0052",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "189,0,203,0",
        "voice": "GA738023,3"
      },
      "original": "……はい。\nタクトさんとも……お別れですね……。\n",
      "translation": "……네. 택트 씨와도…… 작별이네요……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0053",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,203,0",
        "voice": "GA738023,3"
      },
      "original": "……そうだな……。\n",
      "translation": "……그렇군……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0054",
      "channel": 1,
      "context": {
        "face": "189,0,203,0",
        "voice": "GA738024,3",
        "speaker": "006"
      },
      "original": "タクトさん……。\nあの、私は……。\n",
      "translation": "택트 씨…… 저기, 저는……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0055",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "189,0,196,0",
        "voice": "GA738025,3"
      },
      "original": "……地震……？\n",
      "translation": "……지진……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0056",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,196,0",
        "voice": "GA738025,3"
      },
      "original": "いや、違うな……。\nでも、だとしたら、これは……？\n",
      "translation": "아니, 그건 아닌데…… 하지만 그렇다면\n이건……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0057",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,196,0",
        "voice": "GA738025,3"
      },
      "original": "こ、今度は何だ！？\n",
      "translation": "이, 이번엔 뭐야!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f3800:dialogue:0058",
      "channel": 1,
      "context": {
        "voice": "GA738026,3",
        "speaker": "006",
        "face": "189,0,204,0"
      },
      "original": "……タクトさん、外に誰かいます。\n",
      "translation": "……택트 씨, 밖에 누군가 있어요.\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
