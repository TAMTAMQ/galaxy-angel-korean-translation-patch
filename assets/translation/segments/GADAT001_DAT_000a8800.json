{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000a8800.txt",
    "encoding": "cp932",
    "sha256": "ef3ae290d2471c4157f836ce65714516ce3159e14b8008550abf8469f7166b8f",
    "dialogue_count": 81
  },
  "units": [
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "ふぅ……ここで少し落ち着くとするかな。\n",
      "translation": "후우…… 여기서 잠시 진정할까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,121,0",
        "voice": "GAE06001,3"
      },
      "original": "あら、タクトさんじゃありませんか。\nよろしければ、こちらでご一緒いたしません？\n",
      "translation": "어머, 택트 씨. 괜찮으시면 같이 하시겠어요?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,121,0",
        "voice": "GAE06001,3"
      },
      "original": "それじゃ、同席させてもらうよ。\nミントも、眠れないのかい？\n",
      "translation": "그럼 같이 앉을게. 민트도 잠이 안 와?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,107,0",
        "voice": "GAE06002,3"
      },
      "original": "あ、はい。\n何だか目がさえてしまって。\n",
      "translation": "아, 네. 왠지 잠이 달아나 버려서요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,107,0",
        "voice": "GAE06003,3"
      },
      "original": "エンジェル隊に配属されたときには、こんなこと\nになるなんて、思ってもいませんでした。\n",
      "translation": "엔젤대에 배속되었을 때는, 이런 일이 벌어질\n줄은 생각지도 못했습니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,107,0",
        "voice": "GAE06003,3"
      },
      "original": "それはそうだろうな。\nオレだって、こんな状況、夢にも思わなかったよ。\n",
      "translation": "그렇겠지. 나도 이런 상황은 꿈에도 몰랐어.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,101,0",
        "voice": "GAE06004,3"
      },
      "original": "ですが、これはこれで、たいへん興味深いことだ\nと思っていますの。\n",
      "translation": "하지만 이건 이것대로, 매우 흥미로운 일이라고\n생각하고 있어요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,101,0",
        "voice": "GAE06004,3"
      },
      "original": "え？\n",
      "translation": "어?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,101,0",
        "voice": "GAE06005,3"
      },
      "original": "だって、この戦いは、皇国の命運をかけたもので\nあると同時に、数百年もの時間に連なる、ふたつ\nのロストテクノロジーの決戦でもあるのでしょう？\n",
      "translation": "그치만 이 싸움은 황국의 운명을 건 동시에,\n수백 년에 걸친 두 로스트 테크놀로지의\n결전이기도 하잖아요?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,102,0",
        "voice": "GAE06006,3"
      },
      "original": "自分の悩みや世俗のゴタゴタも、このスケールの\n前では、かすんで見えますわ。\n",
      "translation": "제 고민이나 세상사도 이 정도 규모 앞에서는\n별것 아닌 것처럼 보여요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,102,0",
        "voice": "GAE06006,3"
      },
      "original": "そうだな。\nよく考えてみると、かなりでっかい話に関わって\nいるんだよな、オレたち。\n",
      "translation": "그렇네. 생각해 보면 우리도 꽤 큰일에\n발을 들인 셈이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,109,0",
        "voice": "GAE06007,3"
      },
      "original": "ええ。\n自分がこれほどの大事件の当事者となるなんて、\n考えただけでワクワクしてきますわ★\n",
      "translation": "네. 제가 이런 큰 사건의 당사자라니, 생각만\n해도 두근거려요★\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,109,0",
        "voice": "GAE06007,3"
      },
      "original": "うーん……。\n",
      "translation": "으음……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,109,0",
        "voice": "GAE06007,3"
      },
      "original": "確かに、ワクワクするね！\nそう考えると、何だかやる気が出てきたよ。\n",
      "translation": "그러게, 두근거리네! 그렇게 생각하니\n의욕이 생겨.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0015",
      "channel": 1,
      "context": {
        "face": "101,0,102,0",
        "speaker": "004",
        "voice": "GAE06008,3"
      },
      "original": "そうですか。\nそれはよかったですわ。\n",
      "translation": "그렇습니까. 다행이네요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0016",
      "channel": 1,
      "context": {
        "face": "101,0,109,0",
        "voice": "GAE06009,3",
        "speaker": "004"
      },
      "original": "あとは、これをハッピーエンドにできれば、言う\nことなしですわね。\n",
      "translation": "이걸 해피 엔딩으로 끝낼 수만 있다면 더할\n나위 없겠네요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,109,0",
        "voice": "GAE06009,3"
      },
      "original": "ああ、もちろんそうするさ。\nエオニアを倒して、『黒き月』も破壊する。\nそれで、この戦いも終わりさ。\n",
      "translation": "아, 물론이지. 에오니아를 쓰러뜨리고 『흑색\n달』도 파괴한다. 그러면 이 싸움도 끝이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,102,0",
        "voice": "GAE06010,3"
      },
      "original": "はい。\n明日はお互い、がんばりましょう。\n",
      "translation": "네. 내일은 서로 힘냅시다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0019",
      "channel": 1,
      "context": {
        "voice": "GAE06010,3",
        "speaker": "001",
        "face": "012,0,109,0"
      },
      "original": "そんなことでワクワクするなんて、子供っぽいん\nだなぁ……。\n",
      "translation": "그런 일로 두근거리다니, 어린애 같구나……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,105,0",
        "voice": "GAE06011,3"
      },
      "original": "子供っぽくて悪かったですわね。\n何も波乱のない人生よりは、こちらの方が楽しい\nと思いますけど？\n",
      "translation": "어린애 같아서 미안하네요. 아무 일 없는\n인생보단 이쪽이 더 즐겁다고 생각하는데요?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,105,0",
        "voice": "GAE06011,3"
      },
      "original": "波乱にも限度ってものがあるよ。\nこう波乱続きだと、平穏な生活がなつかしくなる。\n",
      "translation": "파란에도 한계가 있어. 계속 이러니 평온한\n생활이 그리워져.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,101,0",
        "voice": "GAE06012,3"
      },
      "original": "この戦いに勝ったら、平穏も取り戻せますわ。\n",
      "translation": "이 싸움에서 이기면 평온도 되찾을 수 있어요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0023",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,101,0",
        "voice": "GAE06012,3"
      },
      "original": "そうだなぁ。\nとにかく、エオニアを倒すのが先決か。\nやれやれ……。\n",
      "translation": "그렇겠네. 어쨌든 에오니아를 쓰러뜨리는 게\n우선인가. 이런이런……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,109,0",
        "voice": "GAE06012,3"
      },
      "original": "スケールが大きすぎて、実感がないよ。\n正直に言って、おとぎ話の中に迷い込んだような\n気分だ。\n",
      "translation": "스케일이 너무 커서 실감이 안 나. 솔직히\n동화 속에 들어온 기분이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,101,0",
        "voice": "GAE06013,3"
      },
      "original": "無理もありませんわ。\n文字どおり、数百年に一度あるかどうか、という\nレベルのお話ですものね。\n",
      "translation": "그럴 만도 해요. 말 그대로 수백 년에 한 번\n있을까 말까 한 이야기인걸요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,101,0",
        "voice": "GAE06013,3"
      },
      "original": "だよなぁ。\nそれとも、この戦いが終わったら、実感もわいて\nくるのかな？\n",
      "translation": "그렇지. 이 싸움이 끝나면 실감이 나려나?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,109,0",
        "voice": "GAE06014,3"
      },
      "original": "そうかもしれませんわね。\nできることなら、「めでたしめでたし」で終わり\nたいものですけど。\n",
      "translation": "그럴지도 모르겠네요. 할 수 있다면,\n「행복하게 잘 살았습니다」 하고 끝내고\n싶지만요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,109,0",
        "voice": "GAE06014,3"
      },
      "original": "うん。\nそうなるように、明日はがんばらないと。\n",
      "translation": "응. 그렇게 되도록 내일은 힘내야지.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,102,0",
        "voice": "GAE06015,3"
      },
      "original": "ええ、よろしくお願いしますわ。\n",
      "translation": "네, 잘 부탁드려요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAE06015,3"
      },
      "original": "ちょっと遅いけど、メシでも食うか。\n腹がふくれれば、気持ちも落ち着くってもんだし。\n",
      "translation": "좀 늦었지만 밥이나 먹을까. 배가 차면 마음도\n진정되니까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0031",
      "channel": 1,
      "context": {
        "speaker": "024",
        "face": "581,0,0,0",
        "voice": "GAE07001,3"
      },
      "original": "いらっしゃい、司令さん。\nちょうどよかった、今ミルフィーちゃんの作った\nコロッケが揚がったところだよ。\n",
      "translation": "어서 와요, 사령관 씨. 마침 밀피쨩이 만든\n고로케가 막 튀겨졌어요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0032",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GAE07001,3"
      },
      "original": "へっ、ミルフィーの？\n",
      "translation": "어, 밀피가 만든 거야?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,046,0",
        "voice": "GAE07002,3"
      },
      "original": "あ、タクトさんじゃないですか！\nどうですか、このコロッケ。\nおいしそうでしょ？\n",
      "translation": "아, 택트 씨! 어때요, 이 고로케. 맛있어\n보이죠?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0034",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,046,0",
        "voice": "GAE07002,3"
      },
      "original": "うん、うまそうだな。\n思わずヨダレが……。\n",
      "translation": "응, 맛있겠네. 나도 모르게 침이……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0035",
      "channel": 1,
      "context": {
        "voice": "GAE07002,3",
        "speaker": "001",
        "face": "012,0,046,0"
      },
      "original": "……って、何でミルフィーがキッチンにいるの？\n",
      "translation": "……잠깐, 왜 밀피가 주방에 있는 거야?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0036",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,022,0",
        "voice": "GAE07003,3"
      },
      "original": "明日のためのお料理を作ろうと思って。\nそのついでに、食堂のお手伝いをしてたんです。\n",
      "translation": "내일 먹을 요리를 만들려고요. 그 김에\n식당 일도 돕고 있었어요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0037",
      "channel": 1,
      "context": {
        "voice": "GAE07003,3",
        "speaker": "001",
        "face": "001,0,022,0"
      },
      "original": "明日のための料理って？\n",
      "translation": "내일을 위한 요리라니?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,046,0",
        "voice": "GAE07004,3"
      },
      "original": "明日、エオニア軍に勝ったら、そのお祝いをする\nでしょう？\nそのためのお料理ですよ！\n",
      "translation": "내일 에오니아군을 이기면 축하할 거잖아요?\n그걸 위한 요리예요!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0039",
      "channel": 1,
      "context": {
        "face": "001,0,046,0",
        "voice": "GAE07004,3",
        "speaker": "001"
      },
      "original": "ああ、なるほど。\n祝勝会のためか……。\n",
      "translation": "아아, 그렇구나. 축하회 때문인가……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0040",
      "channel": 1,
      "context": {
        "speaker": "024",
        "face": "582,0,0,0",
        "voice": "GAE07005,3"
      },
      "original": "今晩のうちに、仕込みをしておかないとね。\nミルフィーちゃんが、手伝ってくれるおかげで、\n本当に助かるよ。\n",
      "translation": "오늘 밤 안에 밑준비해야 해. 밀피쨩이\n도와줘서 정말 살았어.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0041",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,021,0",
        "voice": "GAE07006,3"
      },
      "original": "いえ、そんな。\nあたしの取り柄って、これぐらいですし。\n",
      "translation": "아니에요, 별말을. 제가 잘하는 건 이\n정도뿐이라서요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0042",
      "channel": 1,
      "context": {
        "voice": "GAE07007,3",
        "speaker": "002",
        "face": "021,0,046,0"
      },
      "original": "タクトさん、明日は期待しててくださいね。\nあたし、腕にヨリをかけて作っちゃいますから！\n",
      "translation": "택트 씨, 내일 기대해 주세요.\n정성껏 만들어 드릴 테니까요!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0043",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,046,0",
        "voice": "GAE07007,3"
      },
      "original": "あ、ああ……。\n",
      "translation": "아, 아아……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0044",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,046,0",
        "voice": "GAE07007,3"
      },
      "original": "そうだね、楽しみにしてるよ。\nミルフィーの料理を食べるまでは、死んでも死に\nきれないもんな。\n",
      "translation": "그래, 기대할게. 밀피 요리를 먹기 전엔\n죽어도 눈을 못 감지.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0045",
      "channel": 1,
      "context": {
        "voice": "GAE07008,3",
        "speaker": "002",
        "face": "021,0,022,0"
      },
      "original": "えへへ、うれしいなぁ。\nそれじゃ、もっと気合い入れて作らなきゃ！\n",
      "translation": "에헤헤, 기뻐라. 그럼 더 힘내서 만들어야지!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0046",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,022,0",
        "voice": "GAE07008,3"
      },
      "original": "それはいいけど、あまりがんばりすぎて、明日の\n戦闘に差し支えないようにしてくれよ？\n",
      "translation": "좋은데, 너무 무리해서 내일 전투에\n지장 생기진 않게 해?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0047",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,021,0",
        "voice": "GAE07009,3"
      },
      "original": "はい、わかってます。\n",
      "translation": "네, 알고 있어요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0048",
      "channel": 1,
      "context": {
        "face": "582,0,0,0",
        "speaker": "024",
        "voice": "GAE07010,3"
      },
      "original": "司令さん、絶対に無事に戻って、ちゃんと料理食\nべとくれよ？\n",
      "translation": "사령관 씨, 꼭 무사히 돌아와서\n요리도 꼭 먹어줘요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0049",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "voice": "GAE07010,3",
        "speaker": "001"
      },
      "original": "はい、約束します。\n",
      "translation": "네, 약속할게요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0050",
      "channel": 1,
      "context": {
        "speaker": "024",
        "face": "581,0,0,0",
        "voice": "GAE07011,3"
      },
      "original": "うん、待ってるからね。\nそれより、食事に来たんじゃなかったのかい？\n",
      "translation": "응, 기다릴게. 그보다 식사하러 온 거\n아니었어?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0051",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GAE07011,3"
      },
      "original": "あ、そうだった。\nそれじゃあ、ミルフィーの作ったコロッケ定食を\nいただこうかな。\n",
      "translation": "아, 맞다. 밀피가 만든 고로케 정식을 먹을까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0052",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,022,0",
        "voice": "GAE07012,3"
      },
      "original": "はーい、コロッケ定食一丁！\n",
      "translation": "네ー 고로케 정식 하나요!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0053",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,046,0",
        "voice": "GAE07012,3"
      },
      "original": "でも、負けたらこの料理も食べられないんだよな。\nムダにならなきゃいいんだけど……。\n",
      "translation": "하지만 지면 이 요리도 못 먹겠지. 헛수고가\n아니면 좋겠는데……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0054",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,023,0",
        "voice": "GAE07013,3"
      },
      "original": "え～っ、そんなぁ！？\nあたしたち、負けちゃうんですかぁ？\n",
      "translation": "에～, 그럴 수가!? 저희가 지는 건가요오?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0055",
      "channel": 1,
      "context": {
        "speaker": "024",
        "face": "583,0,0,0",
        "voice": "GAE07014,3"
      },
      "original": "ちょいと、司令さん。\n縁起でもないこと言わないでおくれよ。\n",
      "translation": "잠깐, 사령관 씨. 불길한 소리 마요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0056",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GAE07014,3"
      },
      "original": "いやぁ、つい……。\n",
      "translation": "아니, 나도 모르게……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0057",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,022,0",
        "voice": "GAE07015,3"
      },
      "original": "じゃあ、ムダにならないように、明日はがんばり\nましょう！\n",
      "translation": "그럼, 헛수고가 되지 않도록 내일은 힘내요!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0058",
      "channel": 1,
      "context": {
        "face": "012,0,022,0",
        "voice": "GAE07015,3",
        "speaker": "001"
      },
      "original": "そうだね。\n……って、司令のオレがはげまされてるようじゃ、\nやっぱダメかも……。\n",
      "translation": "그렇네. ……아니, 사령관인 내가 격려받고\n있다니 역시 안 되겠네……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0059",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,046,0",
        "voice": "GAE07016,3"
      },
      "original": "もう、タクトさんったら。\nファイトですよ、ファイト！\n",
      "translation": "정말, 택트 씨도 참. 파이팅이에요, 파이팅!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0060",
      "channel": 1,
      "context": {
        "face": "012,0,046,0",
        "speaker": "001",
        "voice": "GAE07016,3"
      },
      "original": "う、うん……。\nそれじゃ、オレはこれで失礼するよ。\n",
      "translation": "으, 응…… 그럼, 난 이만 실례할게.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0061",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,046,0",
        "voice": "GAE07016,3"
      },
      "original": "また失敗しないようにね。\nミルフィーの料理はおいしいけど、よく失敗する\nからなぁ。\n",
      "translation": "또 실수하지 마. 밀피 요리는 맛있지만 자주\n실수하니까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0062",
      "channel": 1,
      "context": {
        "voice": "GAE07017,3",
        "speaker": "002",
        "face": "021,0,023,0"
      },
      "original": "うう……タクトさんのいじわるぅ。\n失敗したくてしてるんじゃないのにぃ。\n",
      "translation": "으으…… 택트 씨 심술쟁이. 일부러 실수하는\n게 아닌데에.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0063",
      "channel": 1,
      "context": {
        "face": "012,0,023,0",
        "speaker": "001",
        "voice": "GAE07017,3"
      },
      "original": "いや、そんな顔しなくても……。\nごめん、冗談だってば。\n期待してるよ。\n",
      "translation": "아니, 그런 표정 짓지 마…… 미안, 농담이야.\n기대할게.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0064",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,053,0",
        "voice": "GAE07018,3"
      },
      "original": "そんなこと言うと、タクトさんの食べるお料理に\nだけ、激辛トウガラシを入れちゃいますよ。\n",
      "translation": "그런 말 하면 택트 씨 요리에만 매운 고추를\n넣을 거예요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0065",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,053,0",
        "voice": "GAE07018,3"
      },
      "original": "そ、それはかんべんしてほしい……。\n",
      "translation": "그, 그건 사양하고 싶은데……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0066",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,053,0",
        "voice": "GAE07018,3"
      },
      "original": "でも、ミルフィーはこれといってプレッシャーを\n感じたりはしていないみたいだな。\nちょっと安心したよ。\n",
      "translation": "하지만 밀피는 별로 압박을 느끼지 않는 것\n같네. 안심했어.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0067",
      "channel": 1,
      "context": {
        "face": "021,0,026,0",
        "voice": "GAE07019,3",
        "speaker": "002"
      },
      "original": "え、何の話ですか？\n",
      "translation": "에, 무슨 말씀이세요?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0068",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,026,0",
        "voice": "GAE07019,3"
      },
      "original": "いや、何でもないよ。\nそれじゃ、オレはこれで。\n",
      "translation": "아니, 아무것도 아니야. 그럼 난 이만.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0069",
      "channel": 1,
      "context": {
        "speaker": "025",
        "face": "561,0,0,0",
        "voice": "GAE08001,3"
      },
      "original": "いらっしゃいませ～。\n",
      "translation": "어서 오세요～.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0070",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAE08001,3"
      },
      "original": "ああ、こんばんは。\n",
      "translation": "아아, 안녕히 계세요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0071",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GAE08001,3"
      },
      "original": "……って、『白き月』に戻っても営業してるの？\n",
      "translation": "……근데 『백색 달』로 돌아와도 영업해?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0072",
      "channel": 1,
      "context": {
        "speaker": "025",
        "face": "561,0,0,0",
        "voice": "GAE08002,3"
      },
      "original": "はい～。\nいつでもどこでも２４時間営業ですから～。\n",
      "translation": "네～. 언제 어디서나 24시간 영업이니까요～.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0073",
      "channel": 1,
      "context": {
        "face": "012,0,0,0",
        "voice": "GAE08002,3",
        "speaker": "001"
      },
      "original": "そのわりには、いつ来ても君しか店員を見た記憶\nがないんだけど。\n交替は……というか、いつ寝てるの？\n",
      "translation": "그런데 언제 와도 점원은 너뿐이던데.\n교대는…… 아니, 언제 자는 거야?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0074",
      "channel": 1,
      "context": {
        "speaker": "025",
        "face": "561,0,0,0",
        "voice": "GAE08003,3"
      },
      "original": "それは企業秘密です～。\n",
      "translation": "그건 기업 비밀입니다～.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0075",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GAE08003,3"
      },
      "original": "どんな秘密だ……。\n",
      "translation": "무슨 비밀이야……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0076",
      "channel": 1,
      "context": {
        "speaker": "025",
        "face": "561,0,0,0",
        "voice": "GAE08004,3"
      },
      "original": "ところで～、明日はいよいよ決戦だそうですね～。\n当店としても～、心から応援してます～。\n",
      "translation": "그런데～, 내일이 드디어 결전이라면서요～.\n저희 가게도 진심으로 응원합니다～.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0077",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GAE08004,3"
      },
      "original": "そ、それはどうも。\n",
      "translation": "그, 그거 고맙군.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0078",
      "channel": 1,
      "context": {
        "speaker": "025",
        "face": "561,0,0,0",
        "voice": "GAE08005,3"
      },
      "original": "というわけで～、今日から『がんばれエンジェル\n隊＆エルシオール・キャンペーン』として、特別\n出血大サービスを行なっております～。\n",
      "translation": "그래서～, 오늘부터 『힘내라 엔젤대 &\n에르시올・캠페인』으로 특별 대서비스\n중입니다～.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0079",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GAE08005,3"
      },
      "original": "出血サービスって……景気がいいんだか、縁起が\n悪いんだか……。\n",
      "translation": "출혈 서비스라니…… 경기가 좋은 건지 불길한\n건지……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0080",
      "channel": 1,
      "context": {
        "speaker": "025",
        "face": "561,0,0,0",
        "voice": "GAE08006,3"
      },
      "original": "司令も、何か買って行かれませんか～？\n今なら、ホカホカの肉まんが２割引ですよ～。\n",
      "translation": "사령관님도 뭐 좀 사가시겠어요～? 지금 따끈한\n고기만두가 2할 할인이에요～.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a8800:dialogue:0081",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GAE08006,3"
      },
      "original": "……ひとつもらうよ。\nしかし、何だかなぁ……。\n",
