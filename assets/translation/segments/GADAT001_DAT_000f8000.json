{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000f8000.txt",
    "encoding": "cp932",
    "sha256": "cbd014e6cc847cdf5e69a7e2a98d11d83cc088a50334c8789f42432fd69997f1",
    "dialogue_count": 33
  },
  "units": [
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0"
      },
      "original": "アルモ、作戦図をモニターへ。\n",
      "translation": "아르모, 작전도를 모니터로.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,0,0,0",
        "voice": "GA299001_BL,3"
      },
      "original": "了解。\n",
      "translation": "네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,0,0",
        "voice": "GA799002_BL,3"
      },
      "original": "エルシオールの現在位置は、ここだ。\n",
      "translation": "에르시올의 현재 위치는, 여기다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,0,0",
        "voice": "GA799003_BL,3"
      },
      "original": "我々と同じくファーゴを脱出した友軍から、共同\nでエオニア軍の迎撃にあたるとの連絡があった。\n",
      "translation": "우리와 마찬가지로 파고를 탈출한 우군으로부\n터 , 공동 으로 에오니아군의 요격을 맡겠다는\n연락이 왔다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,0,0",
        "voice": "GA799004_BL,3"
      },
      "original": "この巡洋艦と戦艦が、ともに戦ってくれる。\n",
      "translation": "이 순양함과 전함이, 함께 싸워줄 것이다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "022,0,0,0",
        "voice": "GA799005_BL,3"
      },
      "original": "味方もいるんですね。\n心強いです。\n",
      "translation": "아군도 있군요. 든든합니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "223,0,0,0",
        "voice": "GA799006_BL,3"
      },
      "original": "だが、安心してもいられないぞ。\nこの宙域には、ファーゴを脱出した民間の客船が\nいる。\n",
      "translation": "하지만 안심할 수는 없다. 이 우역에는 파고를 탈출한 민간 여객선이 있다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA799006_BL,3"
      },
      "original": "エンジェル隊は、民間船から敵を引き離すように\nして戦ってくれ。\n",
      "translation": "엔젤대는, 민간선으로부터 적을 떼어놓듯이\n싸워줘라.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "195,0,0,0",
        "voice": "GA799007_BL,3"
      },
      "original": "はい……。\n私たちで守ります。\n",
      "translation": "네…… 저희가 지키겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "223,0,0,0",
        "voice": "GA799008_BL,3"
      },
      "original": "交戦圏内にいる敵は、大型戦闘母艦……。\n",
      "translation": "교전권 내에 있는 적은, 대형 전투 모함……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "223,0,0,0",
        "voice": "GA799008_MD,3"
      },
      "original": "装甲ミサイル艦……。\n",
      "translation": "장갑 미사일함……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0012",
      "channel": 1,
      "context": {
        "voice": "GA799009_BL,3",
        "speaker": "007",
        "face": "223,0,0,0"
      },
      "original": "高速突撃艦……。\n",
      "translation": "고속 돌격함……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "223,0,0,0",
        "voice": "GA799010_BL,3"
      },
      "original": "そして、詳細不明の新型戦闘機が５機だ。\n",
      "translation": "그리고, 상세 불명의 신형 전투기가 5기다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0014",
      "channel": 1,
      "context": {
        "voice": "GA799010_BL,3",
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "どことなく紋章機に似ているな。\n確かに姿だけを見れば、敵が紋章機と呼んでいた\nのもわかる気がするが……。\n",
      "translation": "어딘가 문장기와 닮았군. 확실히 모습만 보면,\n적이 문장기라고 불렀던 것도 이해가 가는\n기분이 듭니다만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "064,0,0,0",
        "voice": "GA799011_BL,3"
      },
      "original": "あんなの、コケおどしに決まってるわ。\n紋章機はロストテクノロジーの結晶よ。\n形だけマネたところで、どうせ中身はポンコツよ。\n",
      "translation": "저런 건, 겁주기용임이 분명해. 문장기는\n로스트 테크놀로지의 결정이야. 형태만 흉내\n내봤자, 어차피 알맹이는 고물이라고.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "103,0,0,0",
        "voice": "GA799012_BL,3"
      },
      "original": "そうとも言い切れませんわ。\n少なくとも、速度だけなら、紋章機とほぼ互角の\nようです。\n",
      "translation": "그렇게 단정 지을 수도 없어요. 적어도,\n속도만이라면, 문장기와 거의 호각인 듯합니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "142,0,0,0",
        "voice": "GA799013_BL,3"
      },
      "original": "相手が何だろうと、全部ブッ倒すまでさ！\n",
      "translation": "상대가 무엇이든, 전부 쓰러뜨릴 때까지다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA799013_BL,3"
      },
      "original": "そのとおりだ。\nこれ以上、やつらに好き勝手はさせるな！\n",
      "translation": "그렇다. 이 이상, 녀석들에게 멋대로 하게\n두지 마라!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA799013_BL,3"
      },
      "original": "作戦目標は、民間客船の防衛。\n",
      "translation": "작전 목표는, 민간 객선의 방위.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA799013_BL,3"
      },
      "original": "客船が安全圏に到達するまで、エオニア軍を食い\n止めるんだ。\n",
      "translation": "객선이 안전권에 도달할 때까지, 에오니아군을\n저 지해라.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,0,0",
        "voice": "GA799013_BL,3"
      },
      "original": "以上だ。\n頼むぞ、みんな！\n",
      "translation": "이상이다. 부탁한다, 모두!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0022",
      "channel": 0,
      "context": {
        "face": "0,0,0,0",
        "speaker": "094",
        "voice": "GA799013_BL,3"
      },
      "original": "～敵部隊の編成～\n　大型戦闘母艦×１　　　装甲ミサイル艦×４\n　高速突撃艦×２　　　　大型戦闘機×５\n　\n～勝利条件～\n　客船が目標エリアまで移動\n　敵の全滅\n　\n～敗北条件～\n　エルシオールの破壊\n　タイムオーバー\n",
      "translation": "～적 부대 편성～\n　대형 전투 모함×1　　　장갑 미사일함×4\n　고속 돌격함×2　　　　대형 전투기×5\n　\n～승리 조건～\n　객선이 목표 에어리어까지 이동\n　적의 전멸\n　\n～패배 조건～\n　에르시올의 파괴\n　타임 오버\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0023",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA198010_BL,3"
      },
      "original": "もう一度、作戦内容を確認するか？\n",
      "translation": "다시 한번, 작전 내용을 확인할까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0024",
      "channel": 1,
      "context": {
        "voice": "GA198010_BL,3",
        "speaker": "001",
        "face": "004,0,223,0"
      },
      "original": "そうだなぁ……。\n",
      "translation": "글쎄...\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0025",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "voice": "GA198010_BL,3",
        "speaker": "001"
      },
      "original": "うん。\n念のため、もう一度確認しておこう。\n",
      "translation": "응. 만약을 위해, 다시 한번 확인해 두자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA198010_BL,3"
      },
      "original": "いや、その必要はない。\nみんな、準備はいいな？\n",
      "translation": "아니, 그럴 필요는 없다. 모두, 준비는 됐나?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "025,0,0,0",
        "voice": "GA799015_BL,3"
      },
      "original": "はい。\nタクトさん、ご命令を。\n",
      "translation": "네. 택트 씨, 명령을.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "064,0,0,0",
        "voice": "GA799016_BL,3"
      },
      "original": "いいわよ！\nタクト、命令をちょうだい！\n",
      "translation": "좋아! 택트, 명령을 내려줘!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "103,0,0,0",
        "voice": "GA799017_BL,3"
      },
      "original": "もちろんですわ。\nご命令願います、タクトさん。\n",
      "translation": "물론이죠. 명령을 내려주세요, 택트 씨.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "143,0,0,0",
        "voice": "GA799018_BL,3"
      },
      "original": "やってやろうじゃないか。\nタクト、命令を。\n",
      "translation": "해버리자고. 택트, 명령을.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0031",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "195,0,0,0",
        "voice": "GA799019_BL,3"
      },
      "original": "はい。\n……タクトさん、ご命令を。\n",
      "translation": "네. ……택트 씨, 명령을.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0032",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "011,0,0,0",
        "voice": "GA799019_BL,3"
      },
      "original": "エンジェル隊、出撃！\n",
      "translation": "엔젤대, 출격!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f8000:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "099",
        "face": "0,0,0,0",
        "voice": "GA199012_BL,3"
      },
      "original": "了解！\n",
      "translation": "네！\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
