{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_00022000.txt",
    "encoding": "cp932",
    "sha256": "ab973ac11efb3733c455c188900e8b2202cbb4da1bf90c8a326fe20b2dda0611",
    "dialogue_count": 20
  },
  "units": [
    {
      "id": "GADAT001_DAT_00022000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "ふぅ……何だか疲れた。\n少し休もうかな。\n",
      "translation": "후우…… 왠지 피곤하네. 잠시 쉴까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0"
      },
      "original": "いや、まだ大丈夫だ。\nそれに、ここじゃ暇つぶしもできないしな。\nまた艦内を回ってみよう。\n",
      "translation": "아니, 아직 괜찮아. 게다가 여기선 시간\n때우기도 안 되고 말이야. 다시 함내를\n돌아봐야겠어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "疲れを取るには、横になるのが一番だ。\nちょっと休もう……。\n",
      "translation": "피로를 풀려면, 누워 있는 게 제일이다. 잠깐\n쉬자……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0"
      },
      "original": "……ふあぁ～あ。\nん、もうこんな時間か。\n",
      "translation": "……후아아～아. 음, 벌써 이런 시간인가.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "少しの間だったけど、けっこう疲れは取れたな。\nミルフィーの準備も、もうできたかもしれないし、\nそろそろ出ようか。\n",
      "translation": "잠깐이었지만, 꽤 피로가 풀렸네. 밀피의\n준비도, 벌써 끝났을지도 모르니까, 슬슬\n나가볼까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GA221001,3"
      },
      "original": "よう、どうした？\n",
      "translation": "여어, 무슨 일이야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,221,0",
        "voice": "GA221001,3"
      },
      "original": "いや……ブリッジの調子はどう？\n",
      "translation": "아니…… 브릿지의 상태는 어때?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,224,0",
        "voice": "GA221002,3"
      },
      "original": "こっちは順調そのものだ。\nまぁ、ドライヴ中は、よほどのことがない限り、\n様子を見てるだけだしな。\n",
      "translation": "이쪽은 아주 순조로워. 뭐, 드라이브 중에는\n웬만한 일이 없는 한, 상태를 지켜보고 있을\n뿐이니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GA221003,3"
      },
      "original": "ところで、聞いたぜ？\nエンジェル隊とピクニックやるんだって？\n",
      "translation": "그건 그렇고, 들었다고? 엔젤대와 피크닉을\n한다며?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,221,0",
        "voice": "GA221003,3"
      },
      "original": "うん、そうなんだけど……。\n",
      "translation": "응, 그렇긴 한데……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA221004,3"
      },
      "original": "なんだ、急に暗い顔になって。\nどうかしたのか？\n",
      "translation": "뭐야, 갑자기 어두운 얼굴을 하고. 무슨\n일이라도 있어?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,223,0",
        "voice": "GA221004,3"
      },
      "original": "あれ、そんな顔してたかい……？\n",
      "translation": "어라, 그런 표정을 짓고 있었나……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0013",
      "channel": 1,
      "context": {
        "face": "004,0,223,0",
        "speaker": "001",
        "voice": "GA221004,3"
      },
      "original": "そうだな……ルフト准将が、命がけで脱出させて\nくれたってのに、こんなことしてていいのかって、\n一瞬思ったせいかな。\n",
      "translation": "글쎄…… 루프트 준장이 목숨을 걸고 탈출시켜\n줬는데, 이런 짓이나 하고 있어도 되는 건가\n하고, 잠시 생각한 탓일까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0014",
      "channel": 1,
      "context": {
        "face": "221,0,224,0",
        "speaker": "007",
        "voice": "GA221005,3"
      },
      "original": "……何を今さら。\n別にいいんじゃないのか？\n",
      "translation": "……이제 와서 무슨 소리야. 별로 상관없지\n않아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GA221006,3"
      },
      "original": "せっかく向こうから誘ってくれたんだ。\n素直に甘えておいてもいいだろう。\n",
      "translation": "모처럼 저쪽에서 권해준 거야. 솔직하게\n응해도 괜찮을 거다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,222,0",
        "voice": "GA221007,3"
      },
      "original": "それもお前の仕事のうちだ。\n得意だろうが？\n",
      "translation": "그것도 네 업무 중 하나다. 잘하잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,222,0",
        "voice": "GA221007,3"
      },
      "original": "否定できないあたりが、少しくやしいような……。\n",
      "translation": "부정할 수 없다는 게, 조금 분한 것 같기도\n하고……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0018",
      "channel": 1,
      "context": {
        "voice": "GA221007,3",
        "speaker": "001",
        "face": "001,0,222,0"
      },
      "original": "でも、お前の言うとおりだな。\nそれじゃ、思い切り楽しんでくるとするよ。\n",
      "translation": "하지만 네 말대로네. 그럼, 마음껏 즐기고\n올게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,224,0",
        "voice": "GA221008,3"
      },
      "original": "ああ、せいぜい鼻の下をのばしてこい。\n",
      "translation": "아아, 실컷 넋을 놓고 다녀오라고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00022000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "009,0,224,0",
        "voice": "GA221008,3"
      },
      "original": "そこまで言うかね……。\n",
      "translation": "그렇게까지 말하나……\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
