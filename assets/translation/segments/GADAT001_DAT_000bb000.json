{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000bb000.txt",
    "encoding": "cp932",
    "sha256": "a0d8f8c1fc7368c9307abce4468798759a5d71aac8306ef82443102066d520e1",
