    {
      "id": "GADAT001_DAT_000be000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "144,0,0,0",
        "voice": "GAF08001,3"
      },
      "original": "タクト！\n",
      "translation": "택트!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000be000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "143,0,0,0",
        "voice": "GAF08002,3"
      },
      "original": "くそっ、やってくれるじゃないか。\n……このおおおぉぉっ！！\n",
      "translation": "젠장, 제법이잖아.\n……이이이익!!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000be000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "493,0,0,0",
        "voice": "GAF08003,3"
      },
      "original": "ハッピートリガー、エルシオール周辺の敵を一掃\nしていきます！\n",
      "translation": "해피 트리거가 에르시올 주변의 적을\n쓸어버리고 있습니다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000be000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "143,0,0,0",
        "voice": "GAF08004,3"
      },
      "original": "タクト、今だ！\nクロノ・ブレイク・キャノンを！\n",
      "translation": "택트, 지금이야!\n크로노・브레이크・캐논을!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000be000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,0,0",
        "voice": "GAF08004,3"
      },
      "original": "わかった！\nアルモ、エネルギーのチャージは？\n",
      "translation": "알았어!\n아르모, 에너지 충전은?\n",
      "state": "draft",
      "use_translation": true
    }
  ]
