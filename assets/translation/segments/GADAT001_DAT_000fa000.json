{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000fa000.txt",
    "encoding": "cp932",
    "sha256": "0e6c3694494c4bf0c98566872c82642f72aadd2776e55742b3e49dd57e4a9807",
    "dialogue_count": 31
  },
  "units": [
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0"
      },
      "original": "アルモ、作戦図をモニターへ。\n",
      "translation": "아르모, 작전도를 모니터로.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,0,0,0",
        "voice": "GA299001_BL,3"
      },
      "original": "了解。\n",
      "translation": "네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA299001_BL,3"
      },
      "original": "我々の目的は、ファーゴの人々が脱出するまでの\n間、敵を接近させないようにすることだ。\n",
      "translation": "우리의 목적은, 파르고 사람들이 탈출할\n때까지 동안, 적을 접근시키지 않도록 하는\n것이다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA299001_BL,3"
      },
      "original": "しかし、『黒き月』から新手が次々と現れている\n状況では、目の前の敵をいくら叩いたところで、\nキリがない。\n",
      "translation": "하지만, 『흑색 달』에서 새로운 적이 차례차례\n나타나고 있는 상황에서는, 눈앞의 적을\n아무리 때려눕힌다 해도, 끝이 없다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA299001_BL,3"
      },
      "original": "可能ならば、『黒き月』そのものに攻撃をしかけ、\nこれを撃破したい。\nだが……。\n",
      "translation": "가능하다면, 『흑색 달』 그 자체에 공격을\n가해, 이를 격파하고 싶다. 하지만……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA299001_BL,3"
      },
      "original": "この正体不明の新型がぐるりと取り囲んでいて、\n我々の接近をはばんでいる。\n",
      "translation": "이 정체불명의 신형이 빙 둘러싸고 있어서,\n우리의 접근을 가로막고 있다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,0,0,0",
        "voice": "GA898002_BL,3"
      },
      "original": "解析によると、攻撃衛星の一種ではないかと思わ\nれます。\n",
      "translation": "해석에 따르면, 공격 위성의 일종이 아닐까\n생각 됩니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "223,0,0,0",
        "voice": "GA898003_BL,3"
      },
      "original": "こちらの交戦圏内にある攻撃衛星はこの１基だけ\nだ。\nしかし、ほかにも無人艦が多数確認されている。\n",
      "translation": "이쪽의 교전권 내에 있는 공격 위성은 이\n1기뿐 이다. 하지만, 그 외에도 무인함이 다수\n확인되고 있다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "223,0,0,0",
        "voice": "GA898004_BL,3"
      },
      "original": "まずは攻撃衛星を守っている装甲ミサイル艦……。\n",
      "translation": "우선은 공격 위성을 지키고 있는 장갑 미사일\n함 ……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "223,0,0,0",
        "voice": "GA898004_MD,3"
      },
      "original": "高速突撃艦……。\n",
      "translation": "고속 돌격함……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "223,0,0,0",
        "voice": "GA898005_MD,3"
      },
      "original": "巡洋艦……。\n",
      "translation": "순양함……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "223,0,0,0",
        "voice": "GA898005_BL,3"
      },
      "original": "それと、駆逐艦だ。\n",
      "translation": "그리고, 구축함이다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "223,0,0,0",
        "voice": "GA898006_BL,3"
      },
      "original": "なお、友軍の艦が援護についてくれた。\nこの位置だ。\n",
      "translation": "또한, 아군 함선이 엄호에 붙어주었다. 이\n위치다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "223,0,0,0",
        "voice": "GA898006_MD,3"
      },
      "original": "今回も、共同で作戦にあたることになる。\n",
      "translation": "이번에도, 공동으로 작전에 임하게 된다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "103,0,0,0",
        "voice": "GA898007_BL,3"
      },
      "original": "敵が紋章機と称していた、あの大型戦闘機はいま\nせんの？\n",
      "translation": "적이 문장기라고 칭했던, 그 대형 전투기는\n지금 없는 거야?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,0",
        "voice": "GA898008_BL,3"
      },
      "original": "はい、レーダーには今のところ、それらしい反応\nはありません。\n",
      "translation": "네, 레이더에는 현재로서는, 그것다운 반응은\n없습니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "062,0,0,0",
        "voice": "GA898009_BL,3"
      },
      "original": "さっきの戦いでボコボコにしてやったから、出て\n来られないのよ、きっと。\n",
      "translation": "아까의 전투에서 아주 박살을 내줬으니까,\n나오지 못하는 거야, 분명.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA898009_BL,3"
      },
      "original": "いずれにしても、『黒き月』を放置しておくのは\n危険すぎる。\nまずは『黒き月』の防衛ラインを突破するんだ。\n",
      "translation": "어찌 되었든, 『흑색 달』을 방치해 두는 것은\n너무 위험하다. 우선은 『흑색 달』의 방위\n라인을 돌파하는 거다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA898009_BL,3"
      },
      "original": "作戦目標は、攻撃衛星の破壊だ。\n",
      "translation": "작전 목표는, 공격 위성의 파괴다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0020",
      "channel": 1,
      "context": {
        "voice": "GA898009_BL,3",
        "speaker": "001",
        "face": "003,0,0,0"
      },
      "original": "敵艦は友軍に任せてもいいから、エンジェル隊は\n防衛ラインの突破を優先してほしい。\n",
      "translation": "적함은 아군에게 맡겨도 되니까, 엔젤대는\n방위 라인 돌파를 우선해 줬으면 한다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA898009_BL,3"
      },
      "original": "ただし、攻撃衛星の性能は未知数だ。\nくれぐれも注意して戦ってくれ。\n",
      "translation": "단, 공격 위성의 성능은 미지수다. 부디\n주의해서 싸워줘.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0022",
      "channel": 1,
      "context": {
        "voice": "GA898010_BL,3",
        "speaker": "007",
        "face": "223,0,0,0"
      },
      "original": "補給や修理のタイミングが重要になるだろう。\nタクト、紋章機が危なくなったら、すぐに指示を\n出せよ。\n",
      "translation": "보급이나 수리 타이밍이 중요해질 것이다.\n택트, 문장기가 위험해지면 바로 지시를\n내려라.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0023",
      "channel": 1,
      "context": {
        "voice": "GA898010_BL,3",
        "speaker": "001",
        "face": "003,0,0,0"
      },
      "original": "ああ、わかってる。\n油断はしないつもりだ。\n",
      "translation": "아아, 알고 있다. 방심할 생각은 없다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA898010_BL,3"
      },
      "original": "みんなも、気をつけてくれよ。\n以上だ。\n",
      "translation": "모두들, 조심해라. 이상이다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0025",
      "channel": 0,
      "context": {
        "face": "0,0,0,0",
        "voice": "GA898010_BL,3",
        "speaker": "094"
      },
      "original": "～敵部隊の編成～\n　駆逐艦×４　　　　　　巡洋艦×２\n　装甲ミサイル艦×５　　高速突撃艦×５\n　攻撃衛星×１\n　\n～勝利条件～\n　攻撃衛星の破壊\n　\n～敗北条件～\n　エルシオールの破壊\n　タイムオーバー\n",
      "translation": "～적 부대 편성～\n　구축함×4　　　　　　순양함×2\n　장갑 미사일함×5　　고속 돌격함×5\n　공격 위성×1\n　\n～승리 조건～\n　공격 위성의 파괴\n　\n～패배 조건～\n　에르시올의 파괴\n　타임 오버\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA198010_BL,3"
      },
      "original": "もう一度、作戦内容を確認するか？\n",
      "translation": "다시 한번, 작전 내용을 확인할까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,223,0",
        "voice": "GA198010_BL,3"
      },
      "original": "そうだなぁ……。\n",
      "translation": "글쎄...\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,223,0",
        "voice": "GA198010_BL,3"
      },
      "original": "うん。\n念のため、もう一度確認しておこう。\n",
      "translation": "응. 만약을 위해, 다시 한번 확인해 두자.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,223,0",
        "voice": "GA198010_BL,3"
      },
      "original": "いや、その必要はない。\nみんな、準備はいいな？\n",
      "translation": "아니, 그럴 필요는 없다. 모두, 준비는 됐나?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,0,0",
        "voice": "GA198010_BL,3"
      },
      "original": "エンジェル隊、出撃！\n",
      "translation": "엔젤대, 출격!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fa000:dialogue:0031",
      "channel": 1,
      "context": {
        "face": "0,0,0,0",
        "speaker": "099",
        "voice": "GA199012_BL,3"
      },
      "original": "了解！\n",
      "translation": "네！\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
