    {
      "id": "GADAT001_DAT_000fe000:dialogue:0084",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,225,0",
        "voice": "GA807060,3"
      },
      "original": "どうした！？\n",
      "translation": "무슨 일이야!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0085",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "493,0,0,0",
        "voice": "GA807061,3"
      },
      "original": "『黒き月』に変化が見られます！\n　メインモニターに映像を出します！\n",
      "translation": "『흑색 달』에 변화가 포착되었습니다! 메인\n모니터에 영상을 띄우겠습니다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0086",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "493,0,0,0",
        "voice": "GA807062,3"
      },
      "original": "『黒き月』の内部から、無人艦が次々と出現して\n　います！\n　周辺の無人艦も、集結しつつあるようです。\n",
      "translation": "『흑색 달』의 내부에서, 무인함이 차례차례\n출현하고 있습니다! 주변의 무인함도, 집결하고\n있는 듯합니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0087",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,0,0",
        "voice": "GA807062,3"
      },
      "original": "また出てきたのか！\nいったいどれだけの艦が格納されているんだ！？\n",
      "translation": "또 나타난 건가! 대체 얼마나 많은 함선이\n격납되어 있는 거지!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0088",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,0",
        "voice": "GA807063,3"
      },
      "original": "新手の無人艦隊、ほかの艦隊と合流しつつ『黒き\n月』を囲むように布陣しています。\n",
      "translation": "새로운 무인함대가, 다른 함대와 합류하며\n『흑색 달』을 포위하듯 진을 치고 있습니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0089",
      "channel": 1,
      "context": {
        "face": "224,0,0,0",
        "voice": "GA807064,3",
        "speaker": "007"
      },
      "original": "攻撃衛星の代わりの防衛ラインってわけか？\nこれじゃ本当にキリがないぜ。\n",
      "translation": "공격 위성을 대신하는 방어 라인이라는 건가?\n이래서는 정말 끝이 없겠군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0090",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA807064,3"
      },
      "original": "シヴァ皇子、『黒き月』とは自己増殖を繰り返す\n自動機械……人に仇なすロストテクノロジー、と\nおっしゃいましたね。\n",
      "translation": "시바 왕자님, 『흑색 달』이란 자기 증식을\n반복하는 자동 기계…… 인간에게 해를 끼치는\n로스트 테크놀로지, 라고 말씀하셨지요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0091",
      "channel": 1,
      "context": {
        "voice": "GA807065,3",
        "speaker": "011",
        "face": "281,0,273,0"
      },
      "original": "いかにも。\nあのまがまがしい姿……あれはまさしく『黒き月』\nに違いない。\n",
      "translation": "그렇다네. 저 불길한 모습…… 저것은 틀림없이\n『흑색 달』 임이 분명해.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0092",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,0,189",
        "voice": "GA807066,3"
      },
      "original": "『黒き月』……。\n　自己増殖……。\n",
      "translation": "『흑색 달』…… 자기 증식……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0093",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,103,0,189",
        "voice": "GA807067,3"
      },
      "original": "察するに、『黒き月』とは、無人艦隊の生産工場\nといったところでしょうか。\n",
      "translation": "짐작건대, 『흑색 달』이란 무인함대의 생산\n공장 같은 것이 아닐까요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0094",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,103,0,072",
        "voice": "GA807068,3"
      },
      "original": "だとしたら、大変じゃない！\nあの『黒き月』がある限り、無人艦隊がどんどん\n作られるってワケでしょ？\n",
      "translation": "그렇다면 큰일이야! 저 『흑색 달』이 있는\n한, 무인함대가 계속해서 만들어진다는 거잖아?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0095",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,103,0,072",
        "voice": "GA807068,3"
      },
      "original": "そういうことになるな。\nあの敵側の大型戦闘機も、『黒き月』がこちらの\n紋章機をコピーしたものなのかも……。\n",
      "translation": "그렇게 되는군. 저 적측의 대형 전투기도,\n『흑색 달』이 이쪽의 문장기를 카피한\n것일지도 몰라……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0096",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,145,0,072",
        "voice": "GA807069,3"
      },
      "original": "それだけじゃないよ。\nファーゴとロームを壊滅させた攻撃や、紋章機を\n機能停止させた妙な光も、アイツのしわざなんだ。\n",
      "translation": "그것뿐만이 아니야. 파고와 롬을 괴멸시킨\n공격이나, 문장기를 기능 정지시킨 묘한 빛도,\n저놈의 소행이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0097",
      "channel": 1,
      "context": {
        "voice": "GA807070,3",
        "speaker": "002",
        "face": "021,0,028,0"
      },
      "original": "これから……どうなっちゃうんでしょう？\n勝てるんですか、あたしたち……？\n",
      "translation": "앞으로…… 어떻게 되는 걸까요? 이길 수 있는\n건가요, 우리들……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0098",
      "channel": 1,
      "context": {
        "face": "004,0,0,0",
        "voice": "GA807070,3",
        "speaker": "001"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0099",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA807070,3"
      },
      "original": "……とりあえず、今言えることがひとつだけある。\n",
      "translation": "……일단, 지금 말할 수 있는 건 하나뿐이다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0100",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,181,0",
        "voice": "GA807071,3"
      },
      "original": "何でしょうか……？\n",
      "translation": "무엇인가요……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0101",
      "channel": 1,
      "context": {
        "face": "001,0,181,0",
        "voice": "GA807071,3",
        "speaker": "001"
      },
      "original": "今は休息をとることだ。\nみんな疲れてるだろ？\nここはオレとレスターに任せて、休んでくれ。\n",
      "translation": "지금은 휴식을 취하는 것이다. 다들 지쳤잖아?\n여기는 나와 레스터에게 맡기고, 쉬어줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0102",
      "channel": 1,
      "context": {
        "face": "221,0,221,0",
        "voice": "GA807072,3",
        "speaker": "007"
      },
      "original": "ああ、そうだな。\n何だかんだで、ずっと戦いっぱなしだったからな。\n",
      "translation": "아아, 그렇네. 이래저래 계속 싸우기만\n했으니까 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0103",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,337",
        "voice": "GA807073,3"
      },
      "original": "ファーゴを離れてから、もう２０時間ほどたって\nいます。\n",
      "translation": "파고를 떠난 지 벌써 20시간 정도 지났습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0104",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,343,0,337",
        "voice": "GA807074,3"
      },
      "original": "そんなに時間がたってたんだ。\n興奮しているせいか、ぜんぜん気がつかなかった。\n",
      "translation": "그렇게 시간이 흘렀구나. 흥분한 탓인지, 전혀\n몰랐어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0105",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,343,0,337",
        "voice": "GA807074,3"
      },
      "original": "特にエンジェル隊は、舞踏会からずっと休みなし\nだったもんな。\nひとまず、これで解散にしよう。\n",
      "translation": "특히 엔젤대는 무도회 때부터 계속 쉬지\n않았으니까 말이야. 일단, 이걸로 해산하도록\n하자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0106",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,165,0",
        "voice": "GA807075,3"
      },
      "original": "それじゃあ、あたしたちは先に休ませてもらうと\nするよ。\n行こう、みんな。\n",
      "translation": "그럼, 우리는 먼저 쉬러 갈게. 가자, 모두.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0107",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,165,0",
        "voice": "GA807075,3"
      },
      "original": "うん、お疲れさま。\n",
      "translation": "응, 수고했어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0108",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,029,0",
        "voice": "GA807076,3"
      },
      "original": "何だか不思議……。\n舞踏会に行ってたのが、何だか夢の中のできごと\nみたいな気がしますね。\n",
      "translation": "왠지 신기해요…… 무도회에 갔던 것이, 왠지\n꿈속의 일 같은 기분이 드네요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0109",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,029,0",
        "voice": "GA807076,3"
      },
      "original": "そうだな、オレも不思議だよ。\nとにかく今は、ゆっくり身体を休めてくれ。\n",
      "translation": "그렇네, 나도 신기해. 어쨌든 지금은, 푹 몸을\n쉬어줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0110",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,021,0",
        "voice": "GA807077,3"
      },
      "original": "はい。\nタクトさんも、お疲れさまでした。\nそれじゃ、失礼します。\n",
      "translation": "네. 택트 씨도, 수고하셨습니다. 그럼,\n실례할게요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0111",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,069,0",
        "voice": "GA807078,3"
      },
      "original": "ちょっと前まで、舞踏会で踊っていたような気が\nするのにね。\nまったく、とんだ一日だったわ。\n",
      "translation": "조금 전까지 무도회에서 춤을 추고 있었던 것\n같은 기분이 드는데 말이야. 정말이지, 엄청난\n하루였어.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0112",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,069,0",
        "voice": "GA807078,3"
      },
      "original": "そうだな。\nとにかく今は、ゆっくり身体を休めてくれ。\n",
      "translation": "그렇네. 어쨌든 지금은, 푹 몸을 쉬어줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0113",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,062,0",
        "voice": "GA807079,3"
      },
      "original": "そうね。\n美容にも悪いから、もう寝るわ。\nそれじゃ、お先に～。\n",
      "translation": "그러게. 미용에도 안 좋으니까, 이제 잘게.\n그럼, 먼저 실례할게～.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0114",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,109,0",
        "voice": "GA807080,3"
      },
      "original": "舞踏会が開かれていたなんて、まるで遠い世界の\nできごとのようですわね。\n",
      "translation": "무도회가 열리고 있었다니, 마치 먼 세계의\n일처럼 느껴지네요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0115",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,109,0",
        "voice": "GA807080,3"
      },
      "original": "本当にそうだな。\nとにかく今は、ゆっくり身体を休めてくれ。\n",
      "translation": "정말 그렇네. 어쨌든 지금은, 푹 몸을 쉬어줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0116",
      "channel": 1,
      "context": {
        "face": "101,0,101,0",
        "speaker": "004",
        "voice": "GA807081,3"
      },
      "original": "はい、お先に失礼させていただきますわ。\nタクトさんも、無理をなさらないでください。\n",
      "translation": "네, 먼저 실례하겠습니다. 택트 씨도, 무리하지\n마세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0117",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,141,0",
        "voice": "GA807082,3"
      },
      "original": "舞踏会で大立ち回りした後は、宇宙でも……か。\nやれやれ、この一日は長かったような、短かった\nような……。\n",
      "translation": "무도회에서 한바탕 소동을 피운 뒤에는, 우주에\n서도……인가. 이런이런, 이 하루는 길었던 것\n같기도 하고, 짧았던 것 같기도 하고……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0118",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,141,0",
        "voice": "GA807082,3"
      },
      "original": "そうだな、まったく大活躍だよ。\nとにかく今は、ゆっくり身体を休めてくれ。\n",
      "translation": "그렇네, 정말 대활약이야. 어쨌든 지금은, 푹\n몸을 쉬어줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0119",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,173,0",
        "voice": "GA807083,3"
      },
      "original": "ああ、お言葉に甘えさせてもらうよ。\nお疲れさん。\n",
      "translation": "아아, 말씀하신 대로 할게. 수고했어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0120",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,188,0",
        "voice": "GA807084,3"
      },
      "original": "……舞踏会で踊ったこと……まるで夢を見ていた\nかのようです。\nそれとも……今のこの状態が、夢なのでしょうか。\n",
      "translation": "……무도회에서 춤을 춘 것…… 마치 꿈을\n꾸고 있었던 것 같습니다. 아니면…… 지금 이\n상태가, 꿈인 걸까요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0121",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,188,0",
        "voice": "GA807084,3"
      },
      "original": "どっちも現実さ。\nともかく、本当にお疲れさま。\nゆっくり身体を休めてくれ。\n",
      "translation": "둘 다 현실이야. 어쨌든, 정말 수고했어. 푹\n쉬도록 해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0122",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,182,0",
        "voice": "GA807085,3"
      },
      "original": "はい……。\n……では、失礼します。\n",
      "translation": "네…… ……그럼, 실례하겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0123",
      "channel": 1,
      "context": {
        "face": "000,0,0,0",
        "voice": "GA807085,3",
        "speaker": "094"
      },
      "original": "　\n",
      "translation": "　\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0124",
      "channel": 1,
      "context": {
        "speaker": "011",
        "face": "281,0,271,0",
        "voice": "GA807086,3"
      },
      "original": "では、私も部屋に戻らせてもらうぞ。\n皆の者、ご苦労であった。\n",
      "translation": "그럼, 나도 방으로 돌아가도록 하겠다.\n모두들, 수고했다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0125",
      "channel": 1,
      "context": {
        "speaker": "094",
        "face": "000,0,0,0",
        "voice": "GA807086,3"
      },
      "original": "　\n",
      "translation": "　\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0126",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA807086,3"
      },
      "original": "さてと……。\nみんなにはああ言ったけど、これから本当にどう\nしたもんかなぁ？\n",
      "translation": "자, 그럼…… 애들한테는 그렇게 말했지만,\n이제부터 정말 어떻게 해야 할까?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0127",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA807087,3"
      },
      "original": "そうだな……。\n敵はどんどん数を増やせるのに対して、こっちの\n戦力はガタ落ちだからな。\n",
      "translation": "글쎄다…… 적은 계속해서 수를 늘려가는 것에\n비해, 이쪽의 전력은 엉망이니까 말이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0128",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,341,0,0",
        "voice": "GA807088,3"
      },
      "original": "数少ない味方も、自分たちの修理や被害を受けた\n民間人の救助で、大忙しですもんね。\n",
      "translation": "얼마 안 되는 아군도, 자신들의 수리나 피해를\n입은 민간인 구호로 눈코 뜰 새 없이\n바쁘니까요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0129",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,341,0,336",
        "voice": "GA807089,3"
      },
      "original": "エルシオールにしても、ファーゴを大急ぎで脱出\nしてきたせいで、かろうじて修理ができる程度の\n補給物資しかありません。\n",
      "translation": "에르시올도, 파고를 급히 탈출해 온 탓에,\n간신히 수리할 수 있을 정도의 보급 물자밖에\n없습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0130",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,341,0,336",
        "voice": "GA807089,3"
      },
      "original": "聞けば聞くほど、手詰まりって感じだねぇ。\n",
      "translation": "들으면 들을수록, 막막하다는 느낌이네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0131",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA807090,3"
      },
      "original": "まったくだ。\n今のところ、『黒き月』が動かないでいるのが、\nせめてもの救いか。\n",
      "translation": "정말이지. 지금으로선, 『흑색 달』이 움직이지\n않고 있는 것이, 그나마 다행일까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0132",
      "channel": 1,
      "context": {
        "face": "001,0,223,0",
        "speaker": "001",
        "voice": "GA807090,3"
      },
      "original": "まぁ、何とかなるでしょ。\n今までだって、何とかなってきたわけだし。\n",
      "translation": "뭐, 어떻게든 되겠지. 지금까지도, 어떻게든\n되어 왔으니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0133",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,224,0",
        "voice": "GA807091,3"
      },
      "original": "お前のその性格が、今はうらやましいよ。\nところで、お前も休んだらどうだ？\n",
      "translation": "네 그 성격이, 지금은 부럽군. 그건 그렇고,\n너도 좀 쉬는 게 어때?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0134",
      "channel": 1,
      "context": {
        "face": "006,0,224,0",
        "speaker": "001",
        "voice": "GA807091,3"
      },
      "original": "そりゃ助かるけど、お前はいいのか？\n",
      "translation": "그거 고맙긴 한데, 너는 괜찮아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0135",
      "channel": 1,
      "context": {
        "face": "221,0,221,0",
        "speaker": "007",
        "voice": "GA807092,3"
      },
      "original": "交替が必要になったら呼ぶ。\nひと眠りするなり、艦内の様子を見てくるなり、\n好きにしていいぞ。\n",
      "translation": "교대가 필요해지면 부르겠다. 한숨 자든, 함내\n상황을 보러 가든, 마음대로 해도 좋아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0136",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,342,0,337",
        "voice": "GA807093,3"
      },
      "original": "あたしたちも、交替で休ませてもらいますから、\nご心配なく。\n",
      "translation": "저희도 교대로 쉴 테니까, 걱정 마세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0137",
      "channel": 1,
      "context": {
        "voice": "GA807094,3",
        "speaker": "016",
        "face": "491,342,0,337"
      },
      "original": "司令もお休みになってください。\nお疲れさまです。\n",
      "translation": "사령관님도 쉬어 가세요. 수고 많으십니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0138",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,342,0,337",
        "voice": "GA807094,3"
      },
      "original": "わかった。\nそれじゃ、しばらくここを頼むよ。\n",
      "translation": "알았다. 그럼, 잠시 여기를 부탁할게.\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
