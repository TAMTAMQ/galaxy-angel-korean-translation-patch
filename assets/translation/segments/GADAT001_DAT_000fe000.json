{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000fe000.txt",
    "encoding": "cp932",
    "sha256": "521a0199379d9a2b457611190f58acd8d81717483f0a864c59775d160b5eafc5",
    "dialogue_count": 138
  },
  "units": [
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,0,0,0",
        "voice": "GA807001,3"
      },
      "original": "マイヤーズ司令。\n味方艦隊との合流ポイントに到着しました。\n",
      "translation": "마이어스 사령관님. 아군 함대와의 합류\n포인트에 도착했습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA807001,3"
      },
      "original": "了解。\nやれやれ、何とか生きのびられたか。\n",
      "translation": "알았다. 이런이런, 어떻게든 살아남았나 보군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA807001,3"
      },
      "original": "ところで、エオニア軍と『黒き月』の様子はどう\nなっている？\n",
      "translation": "그건 그렇고, 에오니아군과 『흑색 달』의\n상태는 어떻게 되어 있지?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,0",
        "voice": "GA807002,3"
      },
      "original": "いぜん、沈黙を保っています。\n",
      "translation": "여전히, 침묵을 유지하고 있습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA807003,3"
      },
      "original": "惑星ロームをはさんで、にらみ合いか。\nあのデカブツも、いずれ動き出すだろう。\nそうなる前に、何とかカタをつけたいもんだな。\n",
      "translation": "행성 롬을 사이에 두고, 대치 중인가. 그 거구\n도, 머지않아 움직이기 시작하겠군. 그렇게 되\n기 전에, 어떻게든 매듭짓고 싶군 말이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,223,0",
        "voice": "GA807003,3"
      },
      "original": "そうしたいけど、今はうかつに手出しできないよ。\n紋章機は、まだ整備中だし、さっきの出力上昇も\n謎だらけだし。\n",
      "translation": "그러고 싶지만, 지금은 함부로 손을 쓸 수\n없어. 문장기는 아직 정비 중이고, 아까의\n출력 상승도 수수께끼투구니까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA807004,3"
      },
      "original": "生き残った味方が集結できたとはいえ、前途多難\nだな……。\n",
      "translation": "살아남은 아군이 집결했다고는 해도, 앞날이\n캄캄하군……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,025,0",
        "voice": "GA807005,3"
      },
      "original": "失礼します！\nエンジェル隊、ただいま戻りました！\n",
      "translation": "실례하겠습니다! 엔젤대, 방금 귀환했습니다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,025,0",
        "voice": "GA807005,3"
      },
      "original": "みんな、お疲れさま。\n",
      "translation": "모두, 수고했다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,143,0,0",
        "voice": "GA807006,3"
      },
      "original": "来る途中で、外の様子も見てきたけど……ひどい\nもんだね。\n無傷の艦なんて、ぜんぜんいないよ。\n",
      "translation": "오는 길에 밖의 상황도 보고 왔는데…… 심각\n하네. 무사한 함선은 전혀 없어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0011",
      "channel": 1,
      "context": {
        "voice": "GA807007,3",
        "speaker": "004",
        "face": "101,143,0,107"
      },
      "original": "みなさん、この合流ポイントまでたどり着いたの\nが不思議なくらいですわ。\n",
      "translation": "여러분, 이 합류 포인트까지 도달했다는 게\n신기할 정도예요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,186,0,107",
        "voice": "GA807008,3"
      },
      "original": "……死傷者も、相当な数にのぼっているようです。\n",
      "translation": "……사상자도 상당한 수에 달하는 것 같습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,186,0,089",
        "voice": "GA807009,3"
      },
      "original": "これじゃ、体勢の立て直しといっても、２、３日\nどころじゃきかないわね。\n",
      "translation": "이래서는, 전열을 재정비한다고 해도 2, 3일\n정도로는 안 되겠는걸.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,186,0,089",
        "voice": "GA807009,3"
      },
      "original": "そうだな……。\nでも、君たちがいたから、全滅をまぬがれたんだ。\n本当に感謝してる。\n",
      "translation": "그렇군…… 하지만, 너희가 있었기에 전멸을\n면할 수 있었다. 정말 고맙게 생각한다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,028,0",
        "voice": "GA807010,3"
      },
      "original": "いえ、そんな……。\nあたしにも、何がなんだかよくわからないうちに\nああなっちゃって。\n",
      "translation": "아니요, 그런…… 저도 뭐가 뭔지 잘 모르는\n사이에 그렇게 되어버려서.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,062,0",
        "voice": "GA807011,3"
      },
      "original": "ま、当然よね！\n……と言いたいところだけど、アタシにも正直、\nよくわかんないのよね。\n",
      "translation": "뭐, 당연한 결과지! ……라고 말하고 싶지만,\n나도 솔직히, 잘 모르겠어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,107,0",
        "voice": "GA807012,3"
      },
      "original": "私たちも驚いているところですわ。\n紋章機に、あのような力があったなんて。\n",
      "translation": "저희도 놀라고 있는 참이에요. 문장기에, 그런\n힘이 있었다니.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,141,0",
        "voice": "GA807013,3"
      },
      "original": "こっちも命拾いしたんだ、お互いさまさ。\nできれば、あのデカブツにとどめを刺しておきた\nかったけどね。\n",
      "translation": "이쪽도 목숨을 건졌으니, 서로 돕고 사는\n거지. 가능하다면, 그 거구에게 결정타를 날려\n두었겠지만 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,200,0",
        "voice": "GA807014,3"
      },
      "original": "いえ……。\n紋章機に、救われました……。\n",
      "translation": "아니…… 문장기에, 구원받았습니다……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,147,0",
        "voice": "GA807015,3"
      },
      "original": "それにしても、あのとき紋章機とエルシオールに\n起きたアレは、いったい何だったんだい？\n",
      "translation": "그건 그렇고, 그때 문장기와 에르시올에 일어난\n그건, 도대체 뭐였던 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,147,0",
        "voice": "GA807015,3"
      },
      "original": "さてね。\nさっぱりわからないよ。\n",
      "translation": "글쎄. 전혀 모르겠군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,147,0",
        "voice": "GA807016,3"
      },
      "original": "それに関しては、クレータ班長を中心に調査して\nもらっているところです。\n何かわかったら、報告があるでしょう。\n",
      "translation": "그 점에 관해서는, 크레이타 반장을 중심으로\n조사하고 있는 중입니다. 무언가 밝혀지면,\n보고가 있겠지요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0023",
      "channel": 1,
      "context": {
        "face": "501,0,0,0",
        "voice": "GA807017,3",
        "speaker": "017"
      },
      "original": "司令、ルフト准将から通信が入っています。\n",
      "translation": "사령관님, 루프트 준장으로부터 통신이 들어와\n있습니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA807017,3"
      },
      "original": "わかった。\n回線をつないでくれ。\n",
      "translation": "알았다. 회선을 연결해 줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "009",
        "face": "251,0,0,0",
        "voice": "GA807018,3"
      },
      "original": "ご苦労じゃったな、タクト。\nエンジェル隊もそろっておるか。\n",
      "translation": "수고가 많았다, 택트. 엔젤대도 곧 모이는\n건가.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA807018,3"
      },
      "original": "はい、こちらはとりあえず、全員無事です。\nそれで……そちらの状況はどうなっていますか？\n",
      "translation": "네, 이쪽은 우선 전원 무사합니다. 그래서……\n그쪽 상황은 어떻게 되어 있습니까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "009",
        "face": "252,0,0,0",
        "voice": "GA807019,3"
      },
      "original": "状況か……。\n簡単に言うと、今はワシが総司令代行をつとめて\nおる。\n",
      "translation": "상황이라…… 간단히 말하자면, 지금은 내가\n총사령 대행을 맡고 있느니라.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA807019,3"
      },
      "original": "総司令……代行？\nジーダマイア大将は、どうされたんです？\n",
      "translation": "총사령…… 대행? 지더마이어 대장은 어떻게\n되신 겁니까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "009",
        "face": "254,0,0,0",
        "voice": "GA807020,3"
      },
      "original": "ファーゴを脱出する際、エオニア軍の攻撃で……。\n",
      "translation": "파고를 탈출할 때, 에오니아군의 공격으로……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA807020,3"
      },
      "original": "そうでしたか……。\n",
      "translation": "그러셨군요……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0031",
      "channel": 1,
      "context": {
        "speaker": "009",
        "face": "254,0,0,0",
        "voice": "GA807021,3"
      },
      "original": "ほかにも、ワシより階級が上のかたがたは、全員\n行方知れずでな。\nやむなく、今はワシが指揮をとっておるのじゃ。\n",
      "translation": "그 외에도, 나보다 계급이 높은 분들은 모두\n행방불명이라서 말이다. 어쩔 수 없이, 지금은\n내가 지휘를 맡고 있느니라.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0032",
      "channel": 1,
      "context": {
        "speaker": "011",
        "face": "281,0,282,0",
        "voice": "GA807022,3"
      },
      "original": "多くの犠牲者が出たのだな……。\n",
      "translation": "많은 희생자가 나온 것이로군……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "009",
        "face": "252,0,282,0",
        "voice": "GA807023,3"
      },
      "original": "はっ……。\nしかし、シヴァ皇子がご無事であられただけでも、\n不幸中の幸いです。\n",
      "translation": "예…… 하지만, 시바 황자께서 무사하시다는\n것만으로도 불행 중 다행입니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0034",
      "channel": 1,
      "context": {
        "voice": "GA807024,3",
        "speaker": "011",
        "face": "281,0,273,0"
      },
      "original": "うむ……。\nルフトよ、皇国軍を再びまとめ上げる役目、お前\nにゆだねる。\n",
      "translation": "음…… 루프트여, 황국군을 다시 결집시킬\n임무를 네게 맡기겠다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0035",
      "channel": 1,
      "context": {
        "speaker": "009",
        "face": "252,0,0,0",
        "voice": "GA807025,3"
      },
      "original": "つつしんで拝命いたします。\n老骨にムチ打って、最大限の努力をいたします。\n",
      "translation": "삼가 명을 받들겠습니다. 노쇠한 몸을 채찍질하\n여, 최대한의 노력을 다하겠습니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0036",
      "channel": 1,
      "context": {
        "speaker": "009",
        "face": "251,0,0,0",
        "voice": "GA807026,3"
      },
      "original": "さて、タクトよ。\nお前の今後のことなんじゃが……。\n",
      "translation": "자, 택트여. 너의 향후 일에 대해서\n말이다만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0037",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA807026,3"
      },
      "original": "はい、何でしょうか？\n",
      "translation": "네, 무엇입니까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0038",
      "channel": 1,
      "context": {
        "face": "251,0,0,0",
        "voice": "GA807027,3",
        "speaker": "009"
      },
      "original": "エルシオールとエンジェル隊の司令は、引き続き\nお前に任せようと思う。\n引き受けてもらえるか？\n",
      "translation": "에르시올과 엔젤대의 사령은 계속해서 네게\n맡기려 한다. 맡아줄 수 있겠느냐?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0039",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "speaker": "001",
        "voice": "GA807027,3"
      },
      "original": "もちろんです。\nありがたく拝命します。\n",
      "translation": "물론입니다. 감사히 받들겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0040",
      "channel": 1,
      "context": {
        "face": "254,0,0,0",
        "voice": "GA807028,3",
        "speaker": "009"
      },
      "original": "うむ、頼むぞ。\nほかにも、いろいろと聞きたいことはあるが……\nいかんせん処理せねばならない問題が山積みでな。\n",
      "translation": "음, 부탁하마. 그 외에도 여러 가지 묻고 싶은\n것이 있다만…… 상황이 여의치 않아 처리해야\n할 문제가 산더미라 말이다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0041",
      "channel": 1,
      "context": {
        "speaker": "009",
        "face": "251,0,0,0",
        "voice": "GA807029,3"
      },
      "original": "また時間が取れたら、こちらから連絡しよう。\nともかく、今はゆっくり休んでくれ。\n",
      "translation": "다시 시간이 나면, 이쪽에서 연락하마.\n어쨌든, 지금은 푹 쉬도록 해라.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0042",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA807029,3"
      },
      "original": "はい。\nルフト准将も、あまり無理なさらないでください。\nそれでは、失礼します。\n",
      "translation": "네. 루프트 준장님도 너무 무리하지 마세요.\n그럼, 실례하겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0043",
      "channel": 1,
      "context": {
        "voice": "GA807029,3",
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "……というわけだ、みんな。\nオレはまた司令官に戻ったよ。\n",
      "translation": "……라는 상황이야, 모두들. 난 다시 사령관으\n로 돌아갔어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0044",
      "channel": 1,
      "context": {
        "voice": "GA807030,3",
        "speaker": "002",
        "face": "021,0,028,0"
      },
      "original": "タクトさん……。\n",
      "translation": "택트 씨……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0045",
      "channel": 1,
      "context": {
        "voice": "GA807031,3",
        "speaker": "003",
        "face": "061,0,0,062"
      },
      "original": "ほら、ミルフィー。\nぼけーっとしてないで、何か言ったら？\n",
      "translation": "자, 밀피. 멍하니 있지 말고, 뭐라고 말 좀\n해봐?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0046",
      "channel": 1,
      "context": {
        "face": "021,0,026,0",
        "voice": "GA807032,3",
        "speaker": "002"
      },
      "original": "あ、うん。\n",
      "translation": "아, 응.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0047",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,027,0",
        "voice": "GA807033,3"
      },
      "original": "え～っと、その……。\n",
      "translation": "저기, 그게……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0048",
      "channel": 1,
      "context": {
        "voice": "GA807034,3",
        "speaker": "002",
        "face": "021,0,046,0"
      },
      "original": "……お帰りなさい、タクトさん！\n",
      "translation": "……어서 와요, 택트 씨!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000fe000:dialogue:0049",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,046,0",
        "voice": "GA807034,3"
      },
      "original": "ただいま、ミルフィー。\n",
      "translation": "다녀왔어, 밀피.\n",
      "state": "draft",
      "use_translation": true
    },
