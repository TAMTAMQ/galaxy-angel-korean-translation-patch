{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000ca800.txt",
    "encoding": "cp932",
    "sha256": "fdbf7c4b7f04a3f538f350f29288223df22d7c005b0139f75dfd553df31ae475",
    "dialogue_count": 64
  },
  "units": [
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "それじゃ……行こうか、ランファ。\n",
      "translation": "그럼…… 가자, 란파.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,061,0",
        "voice": "GAF24001,3"
      },
      "original": "うん。\nそれじゃね、みんな。\n",
      "translation": "응. 그럼 안녕, 얘들아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,028,0,0",
        "voice": "GAF24002,3"
      },
      "original": "あの、タクトさん。\nランファのこと、よろしくお願いしますね。\nあたしがめんどう見てあげられないことが心配で。\n",
      "translation": "저기, 택트 씨. 란파를 잘 부탁드려요. 제가\n돌봐주지 못할까 봐 걱정돼서.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,028,0,072",
        "voice": "GAF24003,3"
      },
      "original": "逆でしょ、逆！\nアタシが、いつアンタにめんどう見てもらったっ\nてのよ！？\n",
      "translation": "반대겠지, 반대! 내가 언제 너한테 돌봄을\n받았 다고 말이야!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,023,0,072",
        "voice": "GAF24004,3"
      },
      "original": "そんなことないよぅ。\nいつもあたしが、ランファのことをフォローして\nあげてたんだもん。\n",
      "translation": "그렇지 않아～. 항상 내가 란파를 서포트해\n줬는걸.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,023,0,072",
        "voice": "GAF24004,3"
      },
      "original": "そ、そうだったの？\n",
      "translation": "그, 그랬던 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,023,0,066",
        "voice": "GAF24005,3"
      },
      "original": "ウソに決まってるでしょ。\nミルフィーの言うこと、いちいち本気にしてたら、\nやってらんないわよ。\n",
      "translation": "거짓말임이 뻔하잖아. 밀피가 하는 말, 일일이\n진심으로 받아들이면, 못 해 먹는다고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,021,0,066",
        "voice": "GAF24006,3"
      },
      "original": "あー、ひどーい。\nでも、いいもん。\nひかえめな気配りが、友情維持のヒケツだもんね。\n",
      "translation": "아～ 너무해. 하지만 뭐 어때. 적당한 배려가\n우정 유지의 비결인걸.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,021,0,072",
        "voice": "GAF24007,3"
      },
      "original": "まーだ言うかっ。\nこのこのこのー！\n",
      "translation": "아직도 말이야? 이 이 이 이—!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,023,0,072",
        "voice": "GAF24008,3"
      },
      "original": "ふえ～ん、痛いよランファ～。\n",
      "translation": "후에엥, 아파 란파～.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,187,0",
        "voice": "GAF24009,3"
      },
      "original": "……ケンカ……止めなくていいのですか？\n",
      "translation": "……싸움…… 말리지 않아도 되는 겁니까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0012",
      "channel": 1,
      "context": {
        "face": "141,173,0,0",
        "voice": "GAF24010,3",
        "speaker": "005"
      },
      "original": "放っといておやり。\nいつものケンカも、出発したら、しばらくできな\nくなるんだから。\n",
      "translation": "내버려 두게나. 평소의 싸움도, 출발하고\n나면, 한동안 할 수 없게 될 테니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0013",
      "channel": 1,
      "context": {
        "voice": "GAF24011,3",
        "speaker": "004",
        "face": "101,173,0,101"
      },
      "original": "そうですわね。\n思う存分、させてあげましょう。\n",
      "translation": "그렇네요. 마음껏 하게 둡시다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,173,0,101",
        "voice": "GAF24011,3"
      },
      "original": "あははは、そうだね。\nしばらくお別れだからな……。\n",
      "translation": "아하하하, 그렇네. 잠시 동안은 작별이니까\n말이야……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0015",
      "channel": 1,
      "context": {
        "voice": "GAF24012,3",
        "speaker": "007",
        "face": "221,0,221,0"
      },
      "original": "タクト、そろそろ出港の時間だ。\n行くぞ。\n",
      "translation": "택트, 슬슬 출항 시간이다. 가자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,221,0",
        "voice": "GAF24012,3"
      },
      "original": "おっと、もうそんな時間か。\nそれじゃ……みんな、元気で。\n",
      "translation": "앗차, 벌써 그런 시간인가. 그럼…… 모두, 잘\n지내.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0017",
      "channel": 1,
      "context": {
        "voice": "GAF24013,3",
        "speaker": "002",
        "face": "021,028,0,0"
      },
      "original": "ランファ、タクトさん……。\n宇宙インフルエンザなんかにかからないように、\n身体には気をつけてくださいね。\n",
      "translation": "란파, 택트 씨…… 우주 인플루엔자 같은 거\n걸리지 않게, 몸 조심하세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0018",
      "channel": 1,
      "context": {
        "voice": "GAF24014,3",
        "speaker": "006",
        "face": "181,028,0,187"
      },
      "original": "……またお会いできる日を、楽しみにしています。\n",
      "translation": "……다시 만날 날을, 기대하고 있겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0019",
      "channel": 1,
      "context": {
        "face": "141,142,0,187",
        "voice": "GAF24015,3",
        "speaker": "005"
      },
      "original": "つらいこともあるかもしれないけど、あんたたち\nふたりなら、きっと乗り越えられるよ。\nだから、思いきりやっといで。\n",
      "translation": "힘든 일도 있을지 모르겠지만, 너희 둘이라면\n분명 이겨낼 수 있을 거야. 그러니까, 마음껏\n해봐.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,142,0,101",
        "voice": "GAF24016,3"
      },
      "original": "ランファさん、タクトさんとお幸せに。\n",
      "translation": "란파 씨, 택트 씨와 행복하세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,063,0",
        "voice": "GAF24017,3"
      },
      "original": "みんな……ありがとう。\n",
      "translation": "모두…… 고마워.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,088,0",
        "voice": "GAF24018,3"
      },
      "original": "アタシ、みんなのためにも、タクトと幸せになる\nからね！\n",
      "translation": "나, 모두를 위해서라도 택트와 행복해질\n거니까!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0023",
      "channel": 1,
      "context": {
        "face": "001,0,088,0",
        "voice": "GAF24018,3",
        "speaker": "001"
      },
      "original": "さあ、ランファ。\nそろそろ行こうか。\n",
      "translation": "자, 란파. 슬슬 가자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0024",
      "channel": 1,
      "context": {
        "face": "061,0,094,0",
        "speaker": "003",
        "voice": "GAF24019,3"
      },
      "original": "うん！\n",
      "translation": "응!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,094,0",
        "voice": "GAF24019,3"
      },
      "original": "それじゃ、みんな。\n行ってくるよ！\n",
      "translation": "그럼, 모두. 다녀올게!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0026",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "speaker": "001",
        "voice": "GAF24019,3"
      },
      "original": "辺境調査の旅か……。\n星の海を好きなだけ飛び回れるなんて、夢みたい\nだな。\n",
      "translation": "변방 조사 여행인가…… 별의 바다를 마음껏\n누빌 수 있다니, 꿈만 같 구려.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0027",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "voice": "GAF24019,3",
        "speaker": "001"
      },
      "original": "しかも、ランファと一緒だなんて……。\n",
      "translation": "게다가, 란파와 함께라니……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GAF24019,3"
      },
      "original": "さあ、新しい船出だ！\n気分一新でがんばろうぜ、レスター！\n",
      "translation": "자, 새로운 출항이다! 기분 전환해서 힘내자고,\n레스터!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "223,0,0,0",
        "voice": "GAF24020,3"
      },
      "original": "ああ……それは別にかまわないんだがな。\nそれはそうと……。\n",
      "translation": "아아…… 그건 딱히 상관없다만. 그건 그렇\n고… ….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "224,0,0,0",
        "voice": "GAF24021,3"
      },
      "original": "このありさまは、いったい何なんだ！？\nここは本当に、エルシオールのブリッジかぁ！？\n",
      "translation": "이 꼴은, 도대체 뭐야!? 여기가 정말로,\n에르시올의 브릿지냐아!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0031",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,0",
        "voice": "GAF24022,3"
      },
      "original": "ええ……確かにエルシオールのブリッジなんです\nけど……。\n",
      "translation": "에에…… 확실히 에르시올의 브릿지입니다 만\n……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0032",
      "channel": 1,
      "context": {
        "face": "501,0,0,0",
        "voice": "GAF24023,3",
        "speaker": "017"
      },
      "original": "実はその、出発前に、ランファさんが……。\n",
      "translation": "사실은 그게, 출발 전에, 란파 씨가……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "089,0,0,0",
        "voice": "GAF24024,3"
      },
      "original": "どう？\nステキでしょ、このコーディネート。\n",
      "translation": "어때? 멋지지, 이 코디네이트.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0034",
      "channel": 1,
      "context": {
        "voice": "GAF24025,3",
        "speaker": "007",
        "face": "224,0,0,0"
      },
      "original": "なにがステキだ！\nどうしてブリッジが、こんな少女趣味丸出しの、\nレースヒラヒラ仕様になってるんだ！？\n",
      "translation": "뭐가 멋지다는 거냐! 어째서 브릿지가, 이런\n소녀 취향이 가득한, 레이스 프릴 사양으로\n되어 있는 거냐!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0035",
      "channel": 1,
      "context": {
        "face": "062,0,0,0",
        "speaker": "003",
        "voice": "GAF24026,3"
      },
      "original": "決まってるじゃない。\nこれからエルシオールは、アタシとタクトの新居\n同然になるわけでしょ？\n",
      "translation": "당연하잖아. 이제부터 에르시올은, 아타시와\n택트의 새집 이나 다름없게 될 텐데?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0036",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "089,0,0,0",
        "voice": "GAF24027,3"
      },
      "original": "だったら、やっぱり気分よく暮らしたいじゃない？\nふたりの愛の巣なんだもん★\n",
      "translation": "그렇다면, 역시 기분 좋게 지내고 싶잖아? 두\n사람의 사랑의 요람인걸★\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0037",
      "channel": 1,
      "context": {
        "face": "224,0,0,0",
        "speaker": "007",
        "voice": "GAF24028,3"
      },
      "original": "あ、愛の巣ぅ！？\n",
      "translation": "아, 사랑의 요람이라고!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "068,0,0,0",
        "voice": "GAF24029,3"
      },
      "original": "一応、アタシなりに気をつかって色調をおさえた\nつもりなんだけど……。\nやっぱり、ちょっと地味だったかな？\n",
      "translation": "일단, 아타시 나름대로 신경 써서 색조를\n억제해 둔 것 같은데…… 역시, 좀 수수했나?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0039",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GAF24029,3"
      },
      "original": "いやぁ、そんなことないよ。\nオレは気に入ったな。\n",
      "translation": "아니, 그렇지 않아. 난 마음에 들어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0040",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "089,0,0,0",
        "voice": "GAF24030,3"
      },
      "original": "そう？\nダーリンがそう言ってくれるんなら、オッケーね。\n",
      "translation": "그래? 달링이 그렇게 말해준다면, 오케이네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0041",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "227,0,0,0",
        "voice": "GAF24031,3"
      },
      "original": "こ、こいつら……。\n",
      "translation": "이, 이 녀석들……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0042",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "089,0,0,0",
        "voice": "GAF24032,3"
      },
      "original": "あ、でも安心して。\nアタシたちの部屋は、もうカンペキにリフォーム\nしておいたから！\n",
      "translation": "아, 그래도 안심해. 아타시들의 방은, 이미\n완벽하게 리폼 해뒀으니까!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0043",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "224,0,0,0",
        "voice": "GAF24033,3"
      },
      "original": "なにぃ、ここだけじゃないのか！？\nひょっとして、艦内全部がこんな感じになってる\nのか！？\n",
      "translation": "뭐라고, 여기뿐만이 아닌 거냐!? 혹시, 함내\n전부가 이런 느낌으로 되어 있는 거냐!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0044",
      "channel": 1,
      "context": {
        "face": "491,0,0,0",
        "voice": "GAF24034,3",
        "speaker": "016"
      },
      "original": "はい、そうなんです……。\n",
      "translation": "네, 그렇습니다……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0045",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,0,0,0",
        "voice": "GAF24035,3"
      },
      "original": "あたしたちも、必死に止めたんですけど……。\n",
      "translation": "저희들도, 필사적으로 말렸습니다만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0046",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "089,0,0,0",
        "voice": "GAF24036a,3"
      },
      "original": "あとね、エルシオールも名前を変えようと思うの。\n",
      "translation": "그리고 말이야, 에르시올도 이름을 바꾸려고 해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0047",
      "channel": 1,
      "context": {
        "voice": "GAF24036b,3",
        "speaker": "003",
        "face": "089,0,0,0"
      },
      "original": "その名も『スウィート戦艦ラブシオール』！\n",
      "translation": "그 이름은 『스위트 전함 러브시올』!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0048",
      "channel": 1,
      "context": {
        "face": "224,0,0,0",
        "voice": "GAF24037,3",
        "speaker": "007"
      },
      "original": "ス……スイート戦艦？\n",
      "translation": "스…… 스위트 전함?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0049",
      "channel": 1,
      "context": {
        "voice": "GAF24038,3",
        "speaker": "003",
        "face": "062,0,0,0"
      },
      "original": "　ノンノン。\n「スイート」じゃなくて、「スウィート」よ。\n　わかる？\n",
      "translation": "　노, 노.\n「스위트」가 아니라 「스윗」이야.\n　알겠어?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0050",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "089,0,0,0",
        "voice": "GAF24039,3"
      },
      "original": "どう、タクト。\n気に入ってくれた？\n",
      "translation": "어때, 택트. 마음에 들어?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0051",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GAF24039,3"
      },
      "original": "もちろんさ！\nふたりで手に手を取り合って、銀河の海を渡って\nいこう。\n",
      "translation": "물론이지! 둘이서 손에 손을 맞잡고, 은하의\n바다를 건너 가자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0052",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "223,0,0,0",
        "voice": "GAF24040,3"
      },
      "original": "……ダメだこりゃ。\n",
      "translation": "……안 되겠구먼.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0053",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "502,0,0,0",
        "voice": "GAF24041,3"
      },
      "original": "えーと……。\nおじゃまみたいですから、失礼しますね。\n",
      "translation": "저기…… 방해될 것 같으니까, 실례할게요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0054",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "493,0,0,0",
        "voice": "GAF24042,3"
      },
      "original": "あ、私もー！\n",
      "translation": "아, 나도ー!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0055",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "224,0,0,0",
        "voice": "GAF24043,3"
      },
      "original": "おい、ちょっと待て、俺もつきあう。\n置いて行かないでくれ！\n",
      "translation": "어이, 잠깐 기다려, 나도 끼워줘. 두고 가지\n말라고!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0056",
      "channel": 1,
      "context": {
        "voice": "GAF24044,3",
        "speaker": "003",
        "face": "089,0,0,0"
      },
      "original": "……ねぇ、タクト。\n知ってた？\n",
      "translation": "……있지, 택트. 알고 있었어?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0057",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAF24044,3"
      },
      "original": "何が？\n",
      "translation": "뭐가?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0058",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "089,0,0,0",
        "voice": "GAF24045,3"
      },
      "original": "アタシが、タクトのこと大好きだってこと。\n",
      "translation": "내가, 택트를 정말 좋아한다는 거.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0059",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAF24045,3"
      },
      "original": "ああ、知ってたよ。\n",
      "translation": "아아, 알고 있었어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0060",
      "channel": 1,
      "context": {
        "voice": "GAF24046,3",
        "speaker": "003",
        "face": "089,0,0,0"
      },
      "original": "うふふっ。\nアタシも、タクトがアタシのこと大好きだって、\nちゃんと知ってるわ。\n",
      "translation": "우후훗. 나도, 택트가 나를 정말 좋아한다는\n거, 똑똑히 알고 있어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0061",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GAF24046,3"
      },
      "original": "うん。\nランファ、オレについて来てくれるかい？\n",
      "translation": "응. 란파, 나를 따라와 줄래?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0062",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "089,0,0,0",
        "voice": "GAF24047,3"
      },
      "original": "もっちろん！\nタクトと一緒なら、たとえ銀河の果てまでだって\nついて行くわ。\n",
      "translation": "당연하지! 택트와 함께라면, 설령 은하의\n끝이라도 따라갈게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0063",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "089,0,0,0",
        "voice": "GAF24048,3"
      },
      "original": "目が覚めたらタクトのそばで。\n眠ってるときは、夢の中で。\n",
      "translation": "눈을 뜨면 택트의 곁에서. 잠들어 있을 때는,\n꿈속에서.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca800:dialogue:0064",
      "channel": 1,
      "context": {
        "face": "089,0,0,0",
        "voice": "GAF24049,3",
        "speaker": "003"
      },
      "original": "タクト……。\nどんなときでも愛してる★\n",
      "translation": "택트…… 언제라도 사랑해★\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
