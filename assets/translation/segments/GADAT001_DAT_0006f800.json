      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,026,0",
        "voice": "GA504019,3"
      },
      "original": "あ、そうか。\nそれもそうですね。\n",
      "translation": "아, 그렇구나. 그것도 그렇네요.\n",
      "state": "draft",
      "use_translation": true
