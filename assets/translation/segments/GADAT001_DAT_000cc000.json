{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000cc000.txt",
    "encoding": "cp932",
    "sha256": "74f26df06504d3fe396853cf8759c211d4433aebd2b8b37d832a97c5fbe097ca",
    "dialogue_count": 30
  },
  "units": [
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GAF26001,3"
      },
      "original": "俺がつきあえるのも、ここまでだ。\n無事を祈ってるぜ、タクト。\n",
      "translation": "내가 같이 있어 줄 수 있는 것도, 여기까지다.\n무사하길 빌지, 택트.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,221,0",
        "voice": "GAF26001,3"
      },
      "original": "ありがとう、レスター。\nオレがいなくなっても、しっかりやれよ？\n",
      "translation": "고마워, 레스터. 내가 없어져도, 똑바로\n하라고?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GAF26002,3"
      },
      "original": "それはこっちのセリフだ。\nお前こそ、覚悟しておいた方がいいんじゃないか？\n新しい副官は、きっと俺よりも手ごわいぜ。\n",
      "translation": "그건 내가 할 소리다. 너야말로, 각오해 두는\n게 좋지 않겠나? 새로운 부관은, 분명 나보다\n더 까다로울 테니까 말이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,223,0",
        "voice": "GAF26002,3"
      },
      "original": "なぁに、大丈夫さ。\n何とかなるって。\n",
      "translation": "뭐 어때, 괜찮아. 어떻게든 되겠지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,224,0",
        "voice": "GAF26003,3"
      },
      "original": "まぁ、お前らのことだから、心配はしてないがな。\n",
      "translation": "뭐, 너희들이니까, 걱정은 안 하지만 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GAF26004,3"
      },
      "original": "……そろそろ時間だ。\nじゃあな、タクト。\n",
      "translation": "……슬슬 시간이다. 그럼 이만, 택트.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,221,0",
        "voice": "GAF26004,3"
      },
      "original": "ああ。\nそれじゃ、みんな元気で！\n",
      "translation": "아아. 그럼, 다들 건강해!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,341,0,0",
        "voice": "GAF26005,3"
      },
      "original": "遅いじゃないですか、マイヤーズ司令。\n",
      "translation": "늦으시네요, 마이어스 사령관님.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,341,0,0",
        "voice": "GAF26005,3"
      },
      "original": "いやぁ、悪い。\n見送りが長引いちゃって。\n",
      "translation": "이야아, 미안. 배웅이 길어져 버려서 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0010",
      "channel": 1,
      "context": {
        "face": "491,341,0,337",
        "voice": "GAF26006,3",
        "speaker": "016"
      },
      "original": "さっきから、副司令がお待ちかねでしたよ。\n",
      "translation": "아까부터, 부사령관님이 기다리고 계셨다고요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,341,0,337",
        "voice": "GAF26006,3"
      },
      "original": "そうか、すまない。\n",
      "translation": "그런가, 미안하군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAF26006,3"
      },
      "original": "じゃあ……出発しようか、副司令どの。\n",
      "translation": "그럼…… 출발할까, 부사령관님.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,0,0",
        "voice": "GAF26007,3"
      },
      "original": "はい。\n出航の許可をお願いします、マイヤーズ司令。\n",
      "translation": "네. 출항 허가를 부탁드립니다, 마이어스\n사령관님.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAF26007,3"
      },
      "original": "許可する、シュトーレン副司令。\n",
      "translation": "허가한다, 슈토렌 부사령관.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "158,0,0,0",
        "voice": "GAF26008,3"
      },
      "original": "エルシオール、発進！\n",
      "translation": "에르시올, 발진!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0016",
      "channel": 1,
      "context": {
        "voice": "GAF26009,3",
        "speaker": "016",
        "face": "492,0,0,0"
      },
      "original": "了解！\n",
      "translation": "네！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0017",
      "channel": 1,
      "context": {
        "face": "502,0,0,0",
        "speaker": "017",
        "voice": "GAF26010,3"
      },
      "original": "エルシオール、発進します！\n",
      "translation": "에르시올, 발진합니다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0018",
      "channel": 1,
      "context": {
        "face": "002,0,0,0",
        "speaker": "001",
        "voice": "GAF26010,3"
      },
      "original": "いよいよ、辺境宙域へ出発か。\n何だかワクワクするなぁ。\n",
      "translation": "드디어, 변방 우역으로 출발인가. 왠지\n두근거리네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "164,0,0,0",
        "voice": "GAF26011,3"
      },
      "original": "……ふふふっ。\n",
      "translation": "……후후훗.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GAF26011,3"
      },
      "original": "ん？\n何を笑ってるんだい、フォルテ？\n",
      "translation": "응? 뭘 웃고 있는 거야, 포르테?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0021",
      "channel": 1,
      "context": {
        "voice": "GAF26012,3",
        "speaker": "005",
        "face": "142,0,0,0"
      },
      "original": "いや、何となくね。\nタクトと最初に出会ったときには、こんなことに\nなるとは想像もしてなかったからさ。\n",
      "translation": "아니, 왠지 말이야. 택트와 처음 만났을\n때에는, 이런 일이 될 줄은 상상도 못 했으니\n까 .\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GAF26012,3"
      },
      "original": "オレだってそうだよ。\nフォルテが副官として、オレの隣にいるなんて、\n夢を見てるみたいだ。\n",
      "translation": "나도 마찬가지야. 포르테가 부관으로서, 내\n옆에 있다니, 꿈을 꾸고 있는 것 같아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0023",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "142,0,0,0",
        "voice": "GAF26013,3"
      },
      "original": "いや、夢じゃないさ。\n",
      "translation": "아니, 꿈이 아니야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,0,0",
        "voice": "GAF26014,3"
      },
      "original": "ずっとそばにいるよ。\nタクトが望むなら、いつまでも。\n",
      "translation": "계속 곁에 있을게. 택트가 원한다면, 언제까지\n나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAF26014,3"
      },
      "original": "だったら、オレの答えは決まってる。\n",
      "translation": "그렇다면, 내 대답은 정해져 있어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAF26014,3"
      },
      "original": "オレのそばにいてくれ、フォルテ。\nこれから先の人生も、ずっと。\n",
      "translation": "내 곁에 있어줘, 포르테. 앞으로의 인생도,\n계속.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0027",
      "channel": 1,
      "context": {
        "face": "141,0,0,0",
        "voice": "GAF26015,3",
        "speaker": "005"
      },
      "original": "ありがとう、タクト。\nあんたの人生という旅に、あたしもつきあわせて\nもらうよ。\n",
      "translation": "고마워, 택트. 당신의 인생이라는 여행에,\n나도 함께 할게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0028",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "voice": "GAF26015,3",
        "speaker": "001"
      },
      "original": "退屈しない旅になりそうだな。\n",
      "translation": "지루하지 않은 여행이 되겠는걸.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0029",
      "channel": 1,
      "context": {
        "voice": "GAF26016,3",
        "speaker": "005",
        "face": "142,0,0,0"
      },
      "original": "もちろんさ。\nふたり一緒なんだもの。\n",
      "translation": "물론이지. 둘이 함께인걸.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000cc000:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "142,0,0,0",
        "voice": "GAF26017,3"
      },
      "original": "これからもよろしく、タクト。\n",
      "translation": "앞으로도 잘 부탁해, 택트.\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
