{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_0002f000.txt",
    "encoding": "cp932",
    "sha256": "4e160833b86b505d79e7a584527434a83e419043e3a5b6bd4826bf83f27640a7",
    "dialogue_count": 120
  },
  "units": [
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,0",
        "voice": "GA301001,3"
      },
      "original": "航路クリア、重力障害も許容範囲内。\n現在のところ、順調に航行中です。\n",
      "translation": "항로 클리어, 중력 장애도 허용 범위 내. 현재\n순조롭게 항행 중입니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA301001,3"
      },
      "original": "了解。\nうーん、平和っていいもんだねぇ。\n",
      "translation": "알았다. 으음, 평화란 건 참 좋구먼.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GA301002,3"
      },
      "original": "そういうセリフは、この戦いが終わってから言え。\n",
      "translation": "그런 대사는 이 전투가 끝나고 나서 해라.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "502,0,0,0",
        "voice": "GA301003,3"
      },
      "original": "この前の戦闘から４８時間……。\nルフト准将が指揮をしておられたころも含めて、\nこんな穏やかな時間は久しぶりです。\n",
      "translation": "지난 전투로부터 48시간…… 루프트 준장이\n지휘하던 시절을 포함해, 이런 평온한 시간은\n오랜만입니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA301003,3"
      },
      "original": "きっと、新司令官の人徳のなせるワザかな。\n",
      "translation": "분명 신임 사령관의 인덕이 이룬 결과겠지.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,0,0,0",
        "voice": "GA301004,3"
      },
      "original": "は、はぁ……。\n",
      "translation": "하, 하아……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA301005,3"
      },
      "original": "つかの間の平和にしても、ルフト准将がオトリに\nなってくれたおかげだろうが。\n",
      "translation": "잠시뿐인 평화라 해도, 루프트 준장이 미끼가\n되어준 덕분이겠지만 말이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA301006,3"
      },
      "original": "……ルフト准将、どうなっただろうな……。\n",
      "translation": "……루프트 준장, 어떻게 됐으려나……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,223,0",
        "voice": "GA301006,3"
      },
      "original": "本人が大丈夫だって言ってただろ？\nだったら大丈夫さ。\n",
      "translation": "본인이 괜찮다고 했잖아? 그렇다면 괜찮을\n거야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA301007,3"
      },
      "original": "そうだよな……。\nエオニア軍にやられるほど、ヤワじゃないよな。\n",
      "translation": "그렇겠지…… 에오니아군에 당할 만큼 무르진\n않으니까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,0",
        "voice": "GA301008,3"
      },
      "original": "そのエオニア軍の動向なんですが、今のところ、\nこちらの動きが察知された気配はなさそうです。\n",
      "translation": "그 에오니아 군의 동향입니다만, 현재로서는\n이쪽의 움직임이 감지된 기색은 없어 보입니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0012",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "voice": "GA301008,3",
        "speaker": "001"
      },
      "original": "そうか、それなら安心だな。\n",
      "translation": "그런가, 그렇다면 안심이군.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,0",
        "voice": "GA301009,3"
      },
      "original": "ですが、収集した情報が完璧とは限りません。\nまだ油断はできませんよ。\n",
      "translation": "하지만 수집한 정보가 완벽하진 않습니다. 아직\n방심할 수는 없어요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA301009,3"
      },
      "original": "まぁ、クロノ・ドライヴに入ってしまえば、攻撃\nは受けなくてすむし。\nこのまますんなり、ローム星系まで行きたいな。\n",
      "translation": "뭐, 크로노・드라이브에 들어가면 공격을 받지\n않아도 되니까 말이야. 이대로 순조롭게 롬\n성계까지 가고 싶네.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0015",
      "channel": 1,
      "context": {
        "voice": "GA301010,3",
        "speaker": "007",
        "face": "221,0,223,0"
      },
      "original": "うまく行けばいいがな。\n次のクロノ・ドライヴまでは、どれぐらいだ？\n",
      "translation": "잘 풀리면 좋겠군. 다음 크로노・드라이브까지\n얼마나 남았지?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0016",
      "channel": 1,
      "context": {
        "face": "501,0,223,0",
        "speaker": "017",
        "voice": "GA301011,3"
      },
      "original": "あと３０分ほどで、予定ポイントに到達します。\n",
      "translation": "앞으로 30분 정도면 예정 포인트에 도달합니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0017",
      "channel": 1,
      "context": {
        "voice": "GA301012,3",
        "speaker": "007",
        "face": "221,0,221,0"
      },
      "original": "了解した。\nタクト、お前はそれまで自由にしていいぞ。\nクロノ・ドライヴに移ったら交替しよう。\n",
      "translation": "알았다. 택트, 너는 그때까지 자유롭게 있어도\n좋다. 크로노・드라이브로 옮기면 교대하자.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,221,0",
        "voice": "GA301012,3"
      },
      "original": "すまないな。\nそれじゃ、ひと休みするか。\nみんな、お先に。\n",
      "translation": "미안하군. 그럼 좀 쉴까. 모두, 먼저 실례하지.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA301013,3"
      },
      "original": "念のため言っておくが、非番ってのはあくまでも\n待機時間であって、何かあったらすぐ任務に復帰\nする決まりなんだからな。\n",
      "translation": "말해두겠는데, 비번은 어디까지나 대기 시간이야.\n무슨 일 생기면 즉시 임무에 복귀하는\n규칙이니까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,223,0",
        "voice": "GA301013,3"
      },
      "original": "へいへい、わかってるって。\nところで、エンジェル隊のみんなは？\n",
      "translation": "예이 예이, 알고 있다니까. 그건 그렇고,\n엔젤대 애들은?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GA301014,3"
      },
      "original": "俺がここに来る前に、ティーラウンジにいたのを\n見かけたぞ。\nなんか知らんが、きゃいきゃい騒いでたけど。\n",
      "translation": "내가 여기 오기 전, 티 라운지에 있는 걸 봤다.\n뭔지는 몰라도 왁자지껄하더군.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,221,0",
        "voice": "GA301014,3"
      },
      "original": "そうか。\nじゃあ、ちょっと顔を出してみるかな。\n",
      "translation": "그런가. 그럼, 얼굴 좀 비춰볼까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0023",
      "channel": 1,
      "context": {
        "face": "221,0,224,0",
        "voice": "GA301015,3",
        "speaker": "007"
      },
      "original": "任せた。\n俺には、ああいう雰囲気は理解できん。\n",
      "translation": "부탁하마. 나에게 그런 분위기는 이해할 수\n없다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,224,0",
        "voice": "GA301015,3"
      },
      "original": "あいかわらずお堅いねぇ、レスターは。\nそのお堅さでもって、留守番よろしく。\nじゃあ、オレはこれで。\n",
      "translation": "여전히 딱딱하네, 레스터는. 그 딱딱함으로\n자리를 좀 지켜줘. 그럼 난 이만.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA301015,3"
      },
      "original": "おっ、みんなの話し声が聞こえる。\nレスターの言ってたとおりだ。\nなんだか楽しそうだな。\n",
      "translation": "오, 모두의 말소리가 들려. 레스터 말대로군.\n왠지 즐거워 보이네.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "022,0,0,0",
        "voice": "GA302001,3"
      },
      "original": "じゃ、今度はあたしの番ね。\n",
      "translation": "자, 이번엔 내 차례야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,022,0",
        "voice": "GA302001,3"
      },
      "original": "やあ、何してるんだい？\n",
      "translation": "야아, 뭐 하고 있는 거야?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,046,0",
        "voice": "GA302002,3"
      },
      "original": "あ、タクトさん。\nランファが、雑誌に載っていた星占いをチェック\nしてくれているんです。\n",
      "translation": "아, 택트 씨. 란파가 잡지에 실린 별자리를\n체크해 주고 있어요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,046,0",
        "voice": "GA302002,3"
      },
      "original": "　どれどれ……。\n『マダムが導く　あなたのステキな未来航路』？\n",
      "translation": "어디 어디…… 『마담이 인도하는 당신의 멋진\n미래 항로』?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,0,142",
        "voice": "GA302003,3"
      },
      "original": "すごくよく当たるんだってさ。\n",
      "translation": "굉장히 잘 맞는대.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0031",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,094,0",
        "voice": "GA302004,3"
      },
      "original": "当然よ。\nなんたってマダム・ギャプレーの星占いだもん。\n",
      "translation": "당연하지. 무려 마담 갸프레의 별자리니까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0032",
      "channel": 1,
      "context": {
        "face": "012,0,094,0",
        "voice": "GA302004,3",
        "speaker": "001"
      },
      "original": "マダム・ギャ……えーと？\n",
      "translation": "마담 갸…… 그러니까?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,072,0",
        "voice": "GA302005,3"
      },
      "original": "マダム・ギャプレー！\nまさか、知らないの？\n",
      "translation": "마담 갸프레! 설마, 모르는 거야?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0034",
      "channel": 1,
      "context": {
        "face": "061,0,090,0",
        "speaker": "003",
        "voice": "GA302006,3"
      },
      "original": "的中率９９パーセントを誇る、皇国最高の占い師\nよ。\n",
      "translation": "적중률 99퍼센트를 자랑하는, 황국 최고의\n점술가야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0035",
      "channel": 1,
      "context": {
        "face": "021,0,046,0",
        "speaker": "002",
        "voice": "GA302007,3"
      },
      "original": "あたしが持ってきた雑誌が、ちょうど占いの特集\n号だったんです。\n",
      "translation": "제가 가져온 잡지가 마침 점성 특집\n호였거든요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0036",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,101,0,0",
        "voice": "GA302008,3"
      },
      "original": "それをランファさんが見つけたんですの。\n占いの方法が書いてあったので、みんなで順番に\n運勢を見てもらっているのですわ。\n",
      "translation": "그걸 란파 씨가 찾아내신 거예요. 점치는\n방법이 적혀 있어서, 다 같이 차례대로 운세를\n보고 있는 것이랍니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0037",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA302008,3"
      },
      "original": "ふーん……あれ、ヴァニラがいないようだけど？\n",
      "translation": "흐음…… 어라, 바닐라가 없는 것 같은데?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,101,0,0",
        "voice": "GA302009,3"
      },
      "original": "ヴァニラさんは、医務室のお手伝いだそうです。\n私とフォルテさんは、もう占ってもらって、次は\nミルフィーさんの番ですの。\n",
      "translation": "바닐라 씨는 의무실 일을 돕고 있다고 합니다.\n저와 포르테 씨는 이미 점을 쳤고, 다음은\n밀피 씨 차례예요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0039",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,088,0",
        "voice": "GA302010,3"
      },
      "original": "じゃあミルフィー、チェックしてあげる。\nアンタの星座は、第７てんびん座だったわね？\n",
      "translation": "그럼 밀피, 체크해 줄게. 네 별자리는\n제7천칭자리였지?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0040",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,021,0",
        "voice": "GA302011,3"
      },
      "original": "うん。\n",
      "translation": "응.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0041",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,061,0,021",
        "voice": "GA302012,3"
      },
      "original": "趣味は、料理でしょ？\n",
      "translation": "취미는 요리 맞지?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0042",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,061,0,022",
        "voice": "GA302013,3"
      },
      "original": "そうね、やっぱりそれかな。\n",
      "translation": "그렇네, 역시 그거일까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0043",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,062,0,022",
        "voice": "GA302014,3"
      },
      "original": "そして好きな食べ物は……甘いもの系ってことで\nまとめちゃっていいわよね。\n",
      "translation": "그리고 좋아하는 음식은…… 단것 계열인 걸로\n정리해 버려도 되겠지.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0044",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,062,0,028",
        "voice": "GA302015,3"
      },
      "original": "うーん……細かく言うと、クレープとか、アイス\nクリームとか……。\n",
      "translation": "으음…… 자세히 말하자면, 크레이프나, 아이스\n크림 같은 거……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0045",
      "channel": 1,
      "context": {
        "face": "061,066,0,028",
        "voice": "GA302016,3",
        "speaker": "003"
      },
      "original": "言い始めるとキリがないから、やめときなさい。\n甘いものでいいわね？\n",
      "translation": "말하기 시작하면 끝이 없으니 그만둬. 단것으로\n해도 되지?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0046",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,066,0,028",
        "voice": "GA302016,3"
      },
      "original": "ミルフィーのことを知りつくしてるって感じだな、\nランファは。\n",
      "translation": "밀피를 꿰뚫고 있다는 느낌이네, 란파는.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0047",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,109,0,0",
        "voice": "GA302017,3"
      },
      "original": "ランファさんとミルフィーさんは、私たちの中で\nも、特に仲がよろしいんですの。\nエンジェル隊に入る前からのおつきあいですし。\n",
      "translation": "란파 씨와 밀피 씨는 저희 중에서도 특히\n사이가 좋답니다. 엔젤대에 들어가기 전부터\n알고 지낸 사이니까요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0048",
      "channel": 1,
      "context": {
        "voice": "GA302018,3",
        "speaker": "003",
        "face": "061,0,068,0"
      },
      "original": "ふむふむ。\nこれがこうなって、あれがああなって……えーと、\n結果はと……。\n",
      "translation": "흠흠. 이게 이렇게 되고, 저게 저렇게 되고……\n음, 결과는 이렇고……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0049",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,033,0",
        "voice": "GA302019,3"
      },
      "original": "わくわく……。\n",
      "translation": "두근두근……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0050",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,094,0",
        "voice": "GA302020,3"
      },
      "original": "わー、ちょっと何これ？\n信じらんない！\n",
      "translation": "와-, 잠깐 뭐야 이거? 믿을 수 없어!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0051",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,104,0,0",
        "voice": "GA302021,3"
      },
      "original": "結果は、何と出たんですの？\n",
      "translation": "결과는 어떻게 나왔나요?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0052",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,104,0,144",
        "voice": "GA302022,3"
      },
      "original": "ランファ、さっさと言っとくれよ。\nそういう言い方は、気になるじゃないか。\n",
      "translation": "란파, 어서 말해줘. 그런 식으로 말하면 신경\n쓰이잖아.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0053",
      "channel": 1,
      "context": {
        "face": "021,0,022,0",
        "voice": "GA302023,3",
        "speaker": "002"
      },
      "original": "ねーねー、何て書いてあるの？\n早く教えて。\n",
      "translation": "있지 있지, 뭐라고 써 있어? 빨리 알려줘.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0054",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,023,0",
        "voice": "GA302024,3"
      },
      "original": "ま、まさか……あなたは明日死にますとか、遺言\nは今のうちにしておけとかって書いてあるんじゃ\n……いやー、そんなの！\n",
      "translation": "설마…… 당신은 내일 죽습니다라든가, 유언을\n지금 미리 해두라는 식으로 적혀 있는 건\n……아니야, 그럴 리가!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0055",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,023,0",
        "voice": "GA302024,3"
      },
      "original": "おいおい、ミルフィー。\nいくら何でも、そんな占いあるわけないだろ？\n",
      "translation": "어이 어이, 밀피. 아무리 그래도 그런 점술이\n있을 리 없잖아?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0056",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,062,0",
        "voice": "GA302025,3"
      },
      "original": "　コホン……。\n　じゃあ、いくわよ。\n「第７てんびん座のあなた」……。\n",
      "translation": "흠흠…… 그럼, 시작할게. 「제7천칭자리인\n당신」……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0057",
      "channel": 1,
      "context": {
        "face": "021,0,027,0",
        "voice": "GA302026,3",
        "speaker": "002"
      },
      "original": "ドキドキ……。\n",
      "translation": "두근두근……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0058",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,062,0",
        "voice": "GA302027,3"
      },
      "original": "「異性運は最悪」。\n",
      "translation": "「이성운은 최악」.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0059",
      "channel": 1,
      "context": {
        "voice": "GA302028,3",
        "speaker": "002",
        "face": "021,0,023,0"
      },
      "original": "ええ～っ！？\n",
      "translation": "에에～!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0060",
      "channel": 1,
      "context": {
        "face": "061,0,062,0",
        "voice": "GA302029,3",
        "speaker": "003"
      },
      "original": "「好きでもない男性につきまとわれて、大迷惑。\n　特に、予期せぬ出会いにご用心」……だって。\n",
      "translation": "「좋아하지도 않는 남자가 따라다녀, 큰 민폐.\n특히 뜻밖의 만남을 조심할 것」……이라는데.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0061",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,0,144",
        "voice": "GA302030,3"
      },
      "original": "あれま。\nずいぶんと極端な占いだねぇ。\n",
      "translation": "이런이런. 상당히 극단적인 점술이네.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0062",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,047,0",
        "voice": "GA302031,3"
      },
      "original": "がーん！！\nちょっとショックかも……。\n",
      "translation": "가-앙!! 좀 충격일지도……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0063",
      "channel": 1,
      "context": {
        "voice": "GA302031,3",
        "speaker": "001",
        "face": "004,0,047,0"
      },
      "original": "（ミルフィー、そんなに気にしなくても……。\n　ここは話題を変えた方がいいかな？）\n",
      "translation": "（밀피, 그렇게 신경 쓰지 않아도…… 화제를\n바꾸는 게 좋을까?）\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0064",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,061,0",
        "voice": "GA302031,3"
      },
      "original": "そうだ！\nランファ、オレの占いもしてみてくれない？\n",
      "translation": "맞다! 란파, 내 점도 봐주지 않을래?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0065",
      "channel": 1,
      "context": {
        "face": "061,0,088,0",
        "voice": "GA302032,3",
        "speaker": "003"
      },
      "original": "いいわよ。\nアンタも占いに興味があるとは思わなかったわ。\n",
      "translation": "좋아. 너도 점술에 관심이 있을 줄은 몰랐어.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0066",
      "channel": 1,
      "context": {
        "voice": "GA302032,3",
        "speaker": "001",
        "face": "001,0,088,0"
      },
      "original": "まぁ、少しはね。\nオレの星座、第３おひつじ座なんだけど。\n",
      "translation": "뭐, 조금은 말이야. 내 별자리는\n제3양자리인데.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0067",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,061,0",
        "voice": "GA302033,3"
      },
      "original": "わかったわ、見てあげる。\n好きな食べ物と趣味は？\n",
      "translation": "알았어, 봐줄게. 좋아하는 음식과 취미는?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0068",
      "channel": 1,
      "context": {
        "voice": "GA302033,3",
        "speaker": "001",
        "face": "001,0,061,0"
      },
      "original": "好きな食べ物は玉子焼き。\n趣味は……うーん、昼寝にしておこう。\n",
      "translation": "좋아하는 음식은 계란말이. 취미는…… 음,\n낮잠으로 해둘게.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0069",
      "channel": 1,
      "context": {
        "voice": "GA302034,3",
        "speaker": "002",
        "face": "021,0,0,022"
      },
      "original": "あはは、タクトさんらしいですね。\n",
      "translation": "아하하, 택트 씨답네요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0070",
      "channel": 1,
      "context": {
        "voice": "GA302035,3",
        "speaker": "003",
        "face": "061,0,066,0"
      },
      "original": "昼寝なんて、項目にないわよ。\nとりあえず、「部屋でくつろぐ」にしとくわね。\nさて、結果はと……。\n",
      "translation": "낮잠 같은 건 항목에 없어. 일단 「방에서\n휴식하기」로 해둘게. 자, 결과는……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0071",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,066,0",
        "voice": "GA302035,3"
      },
      "original": "どうなった？\n",
      "translation": "어떻게 됐어?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0072",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,062,0",
        "voice": "GA302036,3"
      },
      "original": "「他人から誤解を受けやすい星の配置です。\n　日ごろの言動には気をつけましょう。\n　積極的な行動で、彼の心をゲット」……だって。\n",
      "translation": "「타인에게 오해받기 쉬운 별의 배치입니다.\n평소 언행에 주의하세요. 적극적인 행동으로,\n그의 마음을 겟」……이라는데.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0073",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,0,173",
        "voice": "GA302080,3"
      },
      "original": "言動に気をつけろってのに、積極的な行動って、\nなんか矛盾してないかい？\n",
      "translation": "언행에 주의하라고 했는데, 적극적인\n행동이라니, 뭔가 모순되지 않았어?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0074",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,173",
        "voice": "GA302080,3"
      },
      "original": "いや、そもそも「彼の心をゲット」って……。\nこれ、女の子向けの占いじゃないか。\n",
      "translation": "아니, 애초에 「그의 마음을 겟」이라니……\n이거 여자애들을 위한 점 아니야?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0075",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,066,0",
        "voice": "GA302037,3"
      },
      "original": "当たり前でしょ、そういう雑誌なんだもの。\nアンタ、なに期待してたの？\n",
      "translation": "당연하잖아, 그런 잡지인걸. 너, 뭘 기대한\n거야?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0076",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,047,0",
        "voice": "GA302037,3"
      },
      "original": "　ミルフィー、あんまり気を落とさないでよ。\n「占いは当たるも八卦、当たらぬも八卦」って、\n　よく言うだろ？\n",
      "translation": "밀피, 너무 낙담하지 마. 「점은 맞을 수도\n있고 틀릴 수도 있다」고, 다들 말하잖아?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0077",
      "channel": 1,
      "context": {
        "face": "021,0,026,0",
        "voice": "GA302038,3",
        "speaker": "002"
      },
      "original": "何ですか、それ？\n",
      "translation": "그게 뭐예요?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0078",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,026,0",
        "voice": "GA302038,3"
      },
      "original": "オレのばーちゃんが使ってた言葉なんだ。\nもっとも、オレもよく意味はわかんないけど。\nとにかく、気にしすぎるなって意味らしいよ。\n",
      "translation": "우리 할머니가 쓰시던 말이야. 나도 정확한\n의미는 모르겠지만, 어쨌든 너무 신경 쓰지\n말라는 뜻인 것 같아.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0079",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,022,0",
        "voice": "GA302039,3"
      },
      "original": "はい、気にしないことにします。\nありがとうございます、タクトさん。\n",
      "translation": "네, 신경 쓰지 않기로 할게요. 감사합니다,\n택트 씨.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0080",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,101,0",
        "voice": "GA302039,3"
      },
      "original": "そうだ、ミントの占いの結果って、どうだったの？\nよかったら教えてよ。\n",
      "translation": "맞다, 민트의 점 결과는 어땠어? 괜찮으면\n알려줘.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0081",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,121,0",
        "voice": "GA302040,3"
      },
      "original": "お聞きになりたいですか？\nミルフィーさんほどユニークな結果というわけで\nはありませんが。\n",
      "translation": "물어보고 싶으신가요? 밀피 씨만큼 유니크한\n결과는 아닙니다만.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0082",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,121,0",
        "voice": "GA302040,3"
      },
      "original": "うん、教えてほしいな。\nどんな結果だったの？\n",
      "translation": "응, 알려줬으면 좋겠어. 어떤 결과였어?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0083",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,109,0",
        "voice": "GA302041,3"
      },
      "original": "「共通の話題を見つけると、異性運は上向きに。\n　今は何とも思わなくても、いずれ意外な結果を\n　生むかも」……だそうですわ。\n",
      "translation": "「공통 화제를 찾으면 이성운은 상승세. 지금은\n아무 생각이 없어도, 머지않아 의외의 결과를\n낳을지도」……라고 합니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0084",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,109,0",
        "voice": "GA302041,3"
      },
      "original": "ふぅん……何だか意味深だね。\n",
      "translation": "흐음…… 왠지 의미심장하네.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0085",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,101,0",
        "voice": "GA302042,3"
      },
      "original": "さぁ、どうでしょう。\nこういったことは、話半分に聞いておくぐらいが\nよろしいかと。\n",
      "translation": "글쎄요, 어떨까요. 이런 건 적당히 흘려듣는 게\n좋을 듯합니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0086",
      "channel": 1,
      "context": {
        "voice": "GA302042,3",
        "speaker": "001",
        "face": "001,0,141,0"
      },
      "original": "そうだ、フォルテの占いの結果はどうだったの？\nよかったら教えてよ。\n",
      "translation": "맞다, 포르테의 점 결과는 어땠어? 괜찮으면\n알려줘.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0087",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,166,0",
        "voice": "GA302043,3"
      },
      "original": "あたしの運勢が知りたいって？\nそれは司令官としてかい、それとも個人的に？\n",
      "translation": "내 운세가 궁금하다는 거야? 지휘관으로서,\n아니면 개인적으로?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0088",
      "channel": 1,
      "context": {
        "voice": "GA302043,3",
        "speaker": "001",
        "face": "012,0,166,0"
      },
      "original": "からかわないでくれよ。\n別に、ちょっと興味があっただけだよ。\n",
      "translation": "놀리지 말아줘. 딱히, 그냥 좀 궁금했을\n뿐이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0089",
      "channel": 1,
      "context": {
        "face": "141,0,141,0",
        "speaker": "005",
        "voice": "GA302044,3"
      },
      "original": "ふぅん、まぁいいけどね。\nあたしの運勢はね……。\n",
      "translation": "흐음, 뭐 상관없지만. 내 운세는 말이지……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0090",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,173,0",
        "voice": "GA302045,3"
      },
      "original": "「異性運は、今は停滞期です。\n　しかし、行動はいつか実を結ぶでしょう。\n　ラッキーアイテムは竹串」……だとさ。\n",
      "translation": "「이성운은 현재 정체기입니다. 하지만 행동은\n언젠가 결실을 맺을 것입니다. 럭키 아이템은\n대나무 꼬치」……라네.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0091",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,173,0",
        "voice": "GA302045,3"
      },
      "original": "いいんだか悪いんだか、よくわからないね。\nとりあえず、そのうち運がよくなるかもしれないっ\nてことかな？\n",
      "translation": "좋다는 건지 나쁘다는 건지 모르겠네. 일단,\n조만간 운이 좋아질 수도 있다는 뜻인가?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0092",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,141,0",
        "voice": "GA302046,3"
      },
      "original": "さぁてね。\nまぁ、当たりゃラッキーってぐらいに思っとくさ。\n",
      "translation": "글쎄다. 뭐, 맞으면 럭키라고 생각하겠어.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0093",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,0,142",
        "voice": "GA302047,3"
      },
      "original": "それじゃランファ、今度はあんたの番だよ。\n",
      "translation": "그럼 란파, 이번엔 네 차례야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0094",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,109,0,142",
        "voice": "GA302048,3"
      },
      "original": "ミルフィーさんよりもあやしげな結果が出たら、\n大変ですわね。\n",
      "translation": "밀피 씨보다 더 수상한 결과가 나오면,\n큰일이겠네요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0095",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,062,0",
        "voice": "GA302049,3"
      },
      "original": "アタシはミルフィーみたいに、ヘンテコな星の下\nに生まれてないの。\nきっと最高の運勢に違いないわ。\n",
      "translation": "난 밀피처럼 이상한 별 아래에서 태어나지\n않았어. 분명 최고의 운세일 거야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0096",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,094,0",
        "voice": "GA302050,3"
      },
      "original": "えーと、第４しし座は……あ、あった。\n好きな食べ物は、辛いもの系。\n趣味は占いっと……あら？\n",
      "translation": "음, 제4사자자리는…… 아, 찾았다. 좋아하는\n음식은 매운 것. 취미는 점술…… 어라?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0097",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,0,046",
        "voice": "GA302051,3"
      },
      "original": "ねえねえ、何だって？\n",
      "translation": "있지 있지, 뭐라고?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0098",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,064,0",
        "voice": "GA302052,3"
      },
      "original": "…………。\n",
      "translation": "…………。\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0099",
      "channel": 1,
      "context": {
        "voice": "GA302053,3",
        "speaker": "004",
        "face": "101,120,0,0"
      },
      "original": "どうなさったんですか、ランファさん？\n突然、黙りこんでしまわれて。\n",
      "translation": "어떻게 된 건가요, 란파 씨? 갑자기 침묵해\n버리셔서.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0100",
      "channel": 1,
      "context": {
        "face": "006,120,0,0",
        "voice": "GA302053,3",
        "speaker": "001"
      },
      "original": "やっぱり運が悪かったのかい？\n",
      "translation": "역시 운이 나빴던 걸까?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0101",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,0,142",
        "voice": "GA302054,3"
      },
      "original": "なら、あたしが代わりに読んでやるよ。\n貸してみな。\n",
      "translation": "그럼, 내가 대신 읽어줄게. 빌려봐.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0102",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,071,0",
        "voice": "GA302055,3"
      },
      "original": "あ、フォルテさん！\n",
      "translation": "아, 포르테 씨!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0103",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,147,0",
        "voice": "GA302056,3"
      },
      "original": "　なになに……。\n「今のあなたは、運命の転換期です」……。\n",
      "translation": "뭐야 뭐야…… 「지금 당신은, 운명의\n전환기입니다」……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0104",
      "channel": 1,
      "context": {
        "voice": "GA302057,3",
        "speaker": "005",
        "face": "141,0,147,0"
      },
      "original": "「身近にいる意外な異性と、思いがけない場所で\n　急接近。\n　これはもう、勝負かけるっきゃない！」\n",
      "translation": "「가까이 있는 의외의 이성과, 뜻밖의 장소에서\n급접근. 이건 이제, 승부를 걸 수밖에 없어!」\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0105",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,166,0",
        "voice": "GA302058,3"
      },
      "original": "……だってさ。\nははっ、なかなかいい運勢じゃないか。\n",
      "translation": "……라는데. 하핫, 꽤 좋은 운세잖아.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0106",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,031,0,0",
        "voice": "GA302059,3"
      },
      "original": "うわー、すごーい！\nおめでとう、ランファ！\nお幸せにね！\n",
      "translation": "우와, 대단해! 축하해, 란파! 행복해야 해!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0107",
      "channel": 1,
      "context": {
        "voice": "GA302060,3",
        "speaker": "003",
        "face": "061,0,063,0"
      },
      "original": "お幸せにって、アンタ大げさすぎよ。\n",
      "translation": "행복해야 한다니, 너 너무 과장이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0108",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,046,0,0",
        "voice": "GA302061,3"
      },
      "original": "でも、意外な異性って、誰のことかな？\n",
      "translation": "그치만 의외의 이성이라니, 누굴까?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0109",
      "channel": 1,
      "context": {
        "face": "141,046,0,173",
        "voice": "GA302062,3",
        "speaker": "005"
      },
      "original": "エルシオールの乗組員で男といったら、けっこう\n限られてるし……。\nあ、ひょっとして……。\n",
      "translation": "에르시올 승무원 중 남자라면 꽤 한정되어\n있고…… 아, 혹시……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0110",
      "channel": 1,
      "context": {
        "voice": "GA302062,3",
        "speaker": "001",
        "face": "006,046,0,173"
      },
      "original": "ん？\n……みんな、何でオレの方を見てるの？\n",
      "translation": "응? ……다들, 왜 나를 보고 있는 거야?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0111",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,109,0,0",
        "voice": "GA302063,3"
      },
      "original": "もしかすると、「身近にいる意外な異性」とは、\nタクトさんのことでは？\n",
      "translation": "어쩌면 「가까이 있는 의외의 이성」은 택트 씨\n아닐까요?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0112",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,072,0",
        "voice": "GA302064,3"
      },
      "original": "な……なに言ってんのよ！\nこ、こんなヤツなわけないじゃない。\nもっとも～っとイイ男に決まってるわ！\n",
      "translation": "무…… 무슨 소릴 하는 거야! 이, 이런 녀석일\n리가 없잖아. 훨씬～훨씬 더 멋진 남자임에\n틀림없어!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0113",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,072,0",
        "voice": "GA302064,3"
      },
      "original": "こ、こんなヤツって……。\n",
      "translation": "이, 이런 녀석이라니……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0114",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,063,0",
        "voice": "GA302065,3"
      },
      "original": "……そうよ、こんなヤツのはずがないわ。\n絶対……。\n",
      "translation": "……그래, 이런 녀석일 리가 없어. 절대로……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0115",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,0,166",
        "voice": "GA302066,3"
      },
      "original": "どうしたんだい、ランファ。\nタクトの顔に、何かついてるのかい？\n",
      "translation": "왜 그래, 란파. 택트의 얼굴에, 뭐라도 묻어\n있어?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0116",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,070,0",
        "voice": "GA302067,3"
      },
      "original": "えっ？\nううん、別に何でも……。\n",
      "translation": "엣? 아니, 딱히 아무것도……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0117",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,063,0",
        "voice": "GA302068,3"
      },
      "original": "あ、アタシ、そろそろ行くわ。\n",
      "translation": "아, 나, 슬슬 갈게.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0118",
      "channel": 1,
      "context": {
        "voice": "GA302069,3",
        "speaker": "002",
        "face": "021,021,0,0"
      },
      "original": "あ、うん。\nじゃあ、あたしも。\n",
      "translation": "아, 응. 그럼, 나도.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0119",
      "channel": 1,
      "context": {
        "speaker": "094",
        "face": "000,0,0,0",
        "voice": "GA302069,3"
      },
      "original": "　\n",
      "translation": "　\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0002f000:dialogue:0120",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "voice": "GA302069,3",
        "speaker": "001"
      },
