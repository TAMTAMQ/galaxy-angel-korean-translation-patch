{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000f1000.txt",
    "encoding": "cp932",
    "sha256": "90f0245bfc7ea130a2c3c067650291332deadd19ccd605be3d1b5f7462e2e896",
    "dialogue_count": 77
  },
  "units": [
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "……あれぇ？\nミント、どこに行ったんだ？\n姿が見当たらない。\n",
      "translation": "……어라? 민트, 어디로 간 거지? 모습이\n보이지 않아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0"
      },
      "original": "かといって、こんな場所で大声を出して呼ぶわけ\nにもいかないし……。\n困ったな。\n",
      "translation": "그렇다고 이런 장소에서 큰 소리로 부를 수도\n없는 노릇이고…… 곤란하네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "うーん、ミント、ミント……。\n",
      "translation": "으음, 민트, 민트……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0"
      },
      "original": "あっ！\nこの曲は……もう最後のダンスが始まったのか？\n",
      "translation": "앗! 이 곡은…… 벌써 마지막 댄스가 시작된\n건가?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,0,0"
      },
      "original": "まずい、このままじゃミントと踊れない！\n早く見つけなきゃ！\n",
      "translation": "큰일이다, 이대로라면 민트와 춤출 수 없어!\n빨리 찾아야 해!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0"
      },
      "original": "うん？\nあそこの異様な人だかりは何だ？\n何かあったのかな。\n",
      "translation": "응? 저기 저 기이한 인파는 뭐지? 무슨\n일이라도 있었나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "118,0,0,0",
        "voice": "GA736001,3"
      },
      "original": "……ちょっと、通してくださいませ。\n私には……。\n",
      "translation": "……잠시만요, 길 좀 비켜주세요. 저에게\n는…… .\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0",
        "voice": "GA736001,3"
      },
      "original": "今の声は、ミント？\nあの人だかりの中にいるのか！？\n",
      "translation": "방금 그 목소리, 민트? 저 인파 속에 있는\n건가!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA736001,3"
      },
      "original": "どうりで姿が見えなかったはずだ。\n……って、納得してる場合じゃない。\nすいませーん、ちょっと通してください！\n",
      "translation": "어쩐지 모습이 보이지 않더라니. ……아니,\n납득하고 있을 때가 아니야. 저기요, 좀\n지나갈게요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "060",
        "face": "726,0,0,0",
        "voice": "GA736002,3"
      },
      "original": "ミント嬢、また私と１曲お願いします。\n",
      "translation": "민트 양, 다시 한번 저와 한 곡 부탁드립니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "041",
        "face": "721,0,0,0",
        "voice": "GA736003,3"
      },
      "original": "いやいや、ぜひ自分と。\nかのブラマンシュ財閥のご令嬢とご一緒できれば、\n光栄の極みですからな！\n",
      "translation": "아니 아니, 부디 저와. 그 브라만슈 재벌의\n영애분과 함께할 수 있다면, 영광 중의\n영광입니다만!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "118,0,0,0",
        "voice": "GA736004,3"
      },
      "original": "ですから、何度も申し上げていますとおり……。\n",
      "translation": "그러니까, 몇 번이나 말씀드렸듯이……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA736004,3"
      },
      "original": "おーい、ミント！\n",
      "translation": "어이, 민트!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,116,0",
        "voice": "GA736005,3"
      },
      "original": "タクトさん……！\n",
      "translation": "택트 씨……!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "060",
        "face": "726,0,0,0",
        "voice": "GA736006,3"
      },
      "original": "君、じゃまをしないでくれないか。\n私はミント嬢と話をしているんだ。\n",
      "translation": "자네, 방해하지 말아 주겠나. 나는 민트 양과\n이야기를 나누고 있는 중이라네.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0016",
      "channel": 1,
      "context": {
        "face": "011,0,0,0",
        "speaker": "001",
        "voice": "GA736006,3"
      },
      "original": "そんなの知ったことか。\nこっちは急いでるんだ。\n",
      "translation": "그딴 건 알 바 아냐. 이쪽은 급하단 말이다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "041",
        "face": "720,0,0,0",
        "voice": "GA736007,3"
      },
      "original": "マ、マイヤーズ君。\nそうだ、私に次のダンスの相手をゆずっては……。\n",
      "translation": "마, 마이어스 군. 그래, 나에게 다음 댄스의\n상대를 양보해 주신다면……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA736007,3"
      },
      "original": "お断りします。\nさあ行こう、ミント。\n",
      "translation": "거절하겠습니다. 자, 가자, 민트.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,116,0",
        "voice": "GA736008,3"
      },
      "original": "はい。\n失礼しますわ、皆様がた。\n",
      "translation": "네. 실례하겠습니다, 여러분.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,115,0",
        "voice": "GA736009,3"
      },
      "original": "はぁ……。\n助かりましたわ、タクトさん。\n",
      "translation": "하아…… 살았어요, 택트 씨.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,115,0",
        "voice": "GA736009,3"
      },
      "original": "あの人だかりは、何だったんだ？\nミント、何かしたの？\n",
      "translation": "저 인파는 뭐였던 거야? 민트, 무슨 일 있었어?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,124,0",
        "voice": "GA736010,3"
      },
      "original": "参加者の中に、昔、父に連れて行かれた舞踏会で\nご一緒したかたがいらしたんですの。\nそれで、私の素性が知られてしまって……。\n",
      "translation": "참가자 중에, 예전에 아버지를 따라갔던\n무도회에서 함께했던 분이 계셨거든요. 그래서\n제 신분이 알려져 버려서……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0023",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,117,0",
        "voice": "GA736011,3"
      },
      "original": "私が、最後のダンスのパートナーはもう決まって\nいるとお断りしても、ぜんぜん聞いてもらえなく\nて……本当に困っていたところでしたの。\n",
      "translation": "제가 마지막 댄스의 파트너는 이미 정해져\n있다고 거절해도, 전혀 들어주지 않아서……\n정말 곤란하던 참이었어요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,117,0",
        "voice": "GA736011,3"
      },
      "original": "そうだったのか。\n早く迎えに行かなくて、ごめんよ。\n",
      "translation": "그랬구나. 빨리 데리러 오지 못해서 미안해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,116,0",
        "voice": "GA736012,3"
      },
      "original": "いいえ。\nそれより、早く踊りましょう。\n",
      "translation": "아니요. 그보다, 빨리 춤을 춰요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,116,0",
        "voice": "GA736012,3"
      },
      "original": "おっと、そうだった。\n早くしないと、最後の曲が終わっちゃうよ。\n",
      "translation": "앗, 맞다. 빨리 하지 않으면, 마지막 곡이\n끝나버려.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,116,0",
        "voice": "GA736012,3"
      },
      "original": "それではミント、お手をどうぞ。\n",
      "translation": "그러면 민트, 손을 부탁해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,115,0",
        "voice": "GA736013,3"
      },
      "original": "はい、タクトさん。\n",
      "translation": "네, 택트 씨.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0029",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "speaker": "001",
        "voice": "GA736013,3"
      },
      "original": "さすが、ミントはダンスもうまいな。\n",
      "translation": "역시, 민트는 춤도 잘 추는구나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "111,0,0,0",
        "voice": "GA736014,3"
      },
      "original": "うふふっ。\n幼いころから習わされたダンスも、こうしてみる\nとムダではありませんでしたわね。\n",
      "translation": "우후훗. 어릴 적부터 배웠던 댄스도, 이렇게\n해보니 헛된 일은 아니었네요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0031",
      "channel": 1,
      "context": {
        "voice": "GA736014,3",
        "speaker": "001",
        "face": "012,0,0,0"
      },
      "original": "すっかりオレの方がリードされてる感じだもんな。\nだけど、こうしてミントと一緒に踊れるなんて、\n思ってもみなかったよ。\n",
      "translation": "완전히 내가 리드당하고 있는 느낌이야.\n하지만, 이렇게 민트와 함께 춤출 수 있을\n줄은 생각도 못 했어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0032",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "119,0,0,0",
        "voice": "GA736015,3"
      },
      "original": "私もですわ。\nタクトさんと出会ってから今まで、いつも予測の\nつかないことばかりで……。\n",
      "translation": "저도요. 택트 씨와 만난 뒤로 지금까지,\n언제나 예측할 수 없는 일들뿐이라서……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "118,0,0,0",
        "voice": "GA736016,3"
      },
      "original": "さっきも、あのまま引きとめられて、もうタクト\nさんと踊れないんじゃないかと思っていました。\n",
      "translation": "아까도, 그대로 붙잡혀서, 이제 택트 씨와\n춤출 수 없는 게 아닐까 생각했어요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0034",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA736016,3"
      },
      "original": "オレも、あのときは焦ったよ。\nつい強引に連れ出して来ちゃったけど。\n",
      "translation": "나도, 그때는 당황했어. 그만 억지로 데리고\n나와 버렸지만.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0035",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,0,0",
        "voice": "GA736017,3"
      },
      "original": "いいえ。\nタクトさんが、あのかたがたにキッパリと言って\nくださったときは、うれしかったですわ。\n",
      "translation": "아니요. 택트 씨가, 그분들에게 단호하게\n말씀해 주셨을 때는, 기뻤답니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0036",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA736017,3"
      },
      "original": "いや、それはまぁ……。\n",
      "translation": "아니, 그건 뭐……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0037",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "speaker": "001",
        "voice": "GA736017,3"
      },
      "original": "（あんなチャラチャラしたロンゲ男や、面白ヒゲ\n　のオヤジなんかに、ミントとのダンスをゆずる\n　わけにはいかないよ）\n",
      "translation": "(저런 가벼운 장발 남자나, 웃긴 수염 　을\n기른 아저씨한테, 민트와의 댄스를 양보할\n수는 없지)\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "111,0,0,0",
        "voice": "GA736018,3"
      },
      "original": "うふふふっ。\n面白ヒゲって……。\nタクトさんは本当にユニークなかたですわね。\n",
      "translation": "우후후훗. 웃긴 수염이라니…… 택트 씨는\n정말 유니크한 분이시네요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0039",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA736018,3"
      },
      "original": "あ……また心を読まれちゃったのか。\n",
      "translation": "아…… 또 마음을 읽혀버린 건가.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0040",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,0,0",
        "voice": "GA736019,3"
      },
      "original": "ええ、少しだけですけど。\n",
      "translation": "네, 조금뿐이지만요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0041",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "119,0,0,0",
        "voice": "GA736020,3"
      },
      "original": "タクトさん……。\nあなたは、私が今までお会いしたどんな殿方とも\n違いますわ。\n",
      "translation": "택트 씨…… 당신은, 제가 지금까지 만난 그\n어떤 공자님과도 다르시네요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0042",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "119,0,0,0",
        "voice": "GA736021,3"
      },
      "original": "タクトさんのようなかたは、初めてです。\n",
      "translation": "택트 씨 같은 분은, 처음이에요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0043",
      "channel": 1,
      "context": {
        "voice": "GA736021,3",
        "speaker": "001",
        "face": "006,0,0,0"
      },
      "original": "そう？\nだけど、オレからしてみたら、ミントも今までに\n出会ったどんな女の子とも違うよ。\n",
      "translation": "그래? 하지만, 내가 보기엔 민트도 지금까지\n만난 그 어떤 여자아이와도 달라.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0044",
      "channel": 1,
      "context": {
        "voice": "GA736022,3",
        "speaker": "004",
        "face": "113,0,0,0"
      },
      "original": "あら、どんなところがですの？\n",
      "translation": "어머, 어떤 점이 그런가요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0045",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA736022,3"
      },
      "original": "それは……。\n",
      "translation": "그건……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0046",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA736022,3"
      },
      "original": "予測がつかないところかな。\n",
      "translation": "예측할 수 없는 점일까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0047",
      "channel": 1,
      "context": {
        "face": "118,0,0,0",
        "speaker": "004",
        "voice": "GA736023,3"
      },
      "original": "それは、私がさっき言ったことと同じですわ。\n",
      "translation": "그건, 제가 아까 말한 것과 같아요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0048",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA736023,3"
      },
      "original": "そうなるね。\nお互い、同じように思っていたわけだ。\n",
      "translation": "그렇게 되겠네. 서로, 똑같이 생각하고 있었던\n거구나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0049",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA736023,3"
      },
      "original": "ミントは、いつも冷静で大人びてるように見えて、\n意外と子供っぽいところもあったりするだろ？\nそのギャップが大きくて、いつも驚かされるんだ。\n",
      "translation": "민트는, 언제나 냉정하고 어른스러워 보이지만,\n의외로 아이 같은 면도 있잖아? 그 갭이 커서,\n항상 놀라곤 해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0050",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "118,0,0,0",
        "voice": "GA736024,3"
      },
      "original": "そうでしたか。\nでも……。\n",
      "translation": "그랬나요. 하지만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0051",
      "channel": 1,
      "context": {
        "voice": "GA736025,3",
        "speaker": "004",
        "face": "110,0,0,0"
      },
      "original": "私がそういった子供っぽいところを見せてしまう\nのは、タクトさんが相手だからかもしれませんわ。\n",
      "translation": "제가 그런 아이 같은 모습을 보여주는 것은,\n택트 씨가 상대이기 때문일지도 모르겠어요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0052",
      "channel": 1,
      "context": {
        "face": "008,0,0,0",
        "voice": "GA736025,3",
        "speaker": "001"
      },
      "original": "え？\nそれって……。\n",
      "translation": "에? 그건……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0053",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "113,0,0,0",
        "voice": "GA736026,3"
      },
      "original": "あっ、タクトさん。\n急に止まらないでくださいませ。\n",
      "translation": "앗, 택트 씨. 갑자기 멈추지 말아 주세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0054",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0",
        "voice": "GA736026,3"
      },
      "original": "おっと、ごめん。\nつ、次のステップは……うわっ！？\n",
      "translation": "어이쿠, 미안. 다, 다음 스텝은…… 우와앗!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0055",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "speaker": "001",
        "voice": "GA736026,3"
      },
      "original": "テレパシーが使えるからだよ。\n",
      "translation": "텔레파시를 쓸 수 있으니까 그래.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0056",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "118,0,0,0",
        "voice": "GA736027,3"
      },
      "original": "……それだけ、ですの？\n",
      "translation": "……그것뿐, 인가요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0057",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA736027,3"
      },
      "original": "え？\nうーん、まぁ……。\nひょっとして、気を悪くしちゃった？\n",
      "translation": "에? 으음, 뭐…… 혹시, 기분 상했어?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0058",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "111,0,0,0",
        "voice": "GA736028,3"
      },
      "original": "いえ、別に。\nさぁ、ダンスの続きをいたしましょう。\n",
      "translation": "아니요, 별로. 자, 댄스를 계속하도록 하죠.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0059",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0",
        "voice": "GA736028,3"
      },
      "original": "あ、うん。\nちょっと、あまり先に行かないでくれよ。\nステップが追いつか……おっとっと！\n",
      "translation": "아, 응. 잠깐, 너무 앞서가지 말아줘. 스텝이\n못 따라…… 어라어라!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0060",
      "channel": 1,
      "context": {
        "face": "002,0,0,0",
        "voice": "GA736028,3",
        "speaker": "001"
      },
      "original": "その大きな耳がついているからさ。\nこれだけの特徴を持っている子なんて、そうそう\nお目にかかれないよ。\n",
      "translation": "그 커다란 귀가 달려 있으니까 말이야.\n이만큼의 특징을 가진 아이는 좀처럼 보기\n힘들다고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0061",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "113,0,0,0",
        "voice": "GA736029,3"
      },
      "original": "何ですって？\n",
      "translation": "뭐라고요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0062",
      "channel": 1,
      "context": {
        "face": "110,0,124,0",
        "voice": "GA736030,3",
        "speaker": "004"
      },
      "original": "もう、タクトさんったら。\n私のことを、そんな風に見ていらしたんですの？\n",
      "translation": "정말이지, 택트 씨도 참. 저를 그런 식으로\n보고 계셨던 건가요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0063",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,124,0",
        "voice": "GA736030,3"
      },
      "original": "いや、ウソだよ、冗談。\nそんなわけないだろ？\n",
      "translation": "아니, 거짓말이야, 농담. 그럴 리가 없잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0064",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,117,0",
        "voice": "GA736031,3"
      },
      "original": "冗談にもほどがありますわ。\n私、もう帰ります！\n",
      "translation": "농담에도 정도가 있어요. 저, 이제 돌아갈래요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0065",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,117,0",
        "voice": "GA736031,3"
      },
      "original": "わっ、待ってよ！\nオレの本当の気持ちは……。\n",
      "translation": "앗, 기다려 봐! 내 진짜 마음은……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0066",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,118,0",
        "voice": "GA736032,3"
      },
      "original": "きゃっ！？\n",
      "translation": "꺄악!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0067",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,118,0",
        "voice": "GA736033,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0068",
      "channel": 1,
      "context": {
        "face": "006,0,118,0",
        "speaker": "001",
        "voice": "GA736033,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0069",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,124,0",
        "voice": "GA736034,3"
      },
      "original": "……演奏、終わりましたわね……。\n",
      "translation": "……연주, 끝났네요……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0070",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,124,0",
        "voice": "GA736034,3"
      },
      "original": "ああ……。\n舞踏会も、これで終わりだな。\n",
      "translation": "아아…… 무도회도, 이걸로 끝이네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0071",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,124,0",
        "voice": "GA736035,3"
      },
      "original": "タクトさんとも……これでお別れですのね……。\n",
      "translation": "택트 씨와도…… 이것으로 작별이네요……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0072",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,124,0",
        "voice": "GA736035,3"
      },
      "original": "そうだな……。\n",
      "translation": "그렇네……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0073",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,125,0",
        "voice": "GA736036,3"
      },
      "original": "あの……タクトさん、私……。\n",
      "translation": "저기…… 택트 씨, 저……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0074",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,118,0",
        "voice": "GA736037,3"
      },
      "original": "きゃああ！\nじ、地震……！？\n",
      "translation": "꺄아악! 지, 지진……!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0075",
      "channel": 1,
      "context": {
        "face": "003,0,118,0",
        "speaker": "001",
        "voice": "GA736037,3"
      },
      "original": "いや、違うな……。\nでも、だとしたら、これは……？\n",
      "translation": "아니, 아니야…… 하지만, 만약 그렇다면,\n이건……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0076",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,118,0",
        "voice": "GA736037,3"
      },
      "original": "こ、今度は何だ！？\n",
      "translation": "이, 이번엔 뭐야!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f1000:dialogue:0077",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "110,0,117,0",
        "voice": "GA736038,3"
      },
      "original": "タクトさん、あれを！\n外に誰かいますわ！\n",
      "translation": "택트 씨, 저걸! 밖에 누군가 있어요!\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
