{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_00101000.txt",
    "encoding": "cp932",
    "sha256": "f84f813c628eb87e397d8bf752507aef7dfcff35f009f3211f45d48735238ade",
    "dialogue_count": 28
  },
  "units": [
    {
      "id": "GADAT001_DAT_00101000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "うーん、眠くはないけど、これといって何もする\n気が起きないな。\nここで少し休んでいようかな？\n",
      "translation": "으음, 졸린 건 아니지만 딱히 뭘 하고 싶은\n마음도 안 드네. 여기서 잠시 쉴까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "いや、まだ大丈夫だ。\nもっと艦内を回ってみよう。\n",
      "translation": "아니, 아직 괜찮아. 좀 더 함내를 돌아다녀\n보자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "気分転換に、音楽でも聴こう。\nゆったりすれば、少しは気分も変わるだろう。\n",
      "translation": "기분 전환 겸, 음악이라도 듣자. 느긋하게\n있으면 조금은 기분도 바뀌겠지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "……うん、だいぶ落ち着いた気がするな。\nまた艦内を回ってみるか。\n",
      "translation": "……응, 꽤 진정된 것 같네. 다시 함내를\n돌아다녀 볼까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GA810001,3"
      },
      "original": "タクトか。\nどうした、ずいぶん早いじゃないか？\n",
      "translation": "택트냐. 웬일이야, 꽤 일찍 왔네?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,221,0",
        "voice": "GA810001,3"
      },
      "original": "いや、やっぱり気になってね。\nファーゴやロームの様子について、あれから何か\n情報は？\n",
      "translation": "아니, 역시 신경 쓰여서 말이야. 파고와 롬의\n상황은 그 뒤로 새로 들어온 정보 없어?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA810002,3"
      },
      "original": "いや、特に新しい情報はない。\n",
      "translation": "아니, 딱히 새로운 정보는 없다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,223,0",
        "voice": "GA810002,3"
      },
      "original": "ないって……。\nあれから、かなりの時間がたってるのに？\n",
      "translation": "없다니…… 그 뒤로 꽤 시간이 지났는데?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,336",
        "voice": "GA810003,3"
      },
      "original": "ファーゴは、いまだ混乱状態です。\nロームも、『黒き月』による砲撃のせいで電離層\nが乱れていて、通信不能なんです。\n",
      "translation": "파고는 여전히 혼란 상태입니다. 롬도 『흑색\n달』의 포격 때문에 전리층이 교란되어 통신\n불능 상태입니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GA810004,3"
      },
      "original": "まぁ、それだけでも、相当な被害が出ていること\nは容易に想像できるがな。\n一応、一部の艦隊が救援に向かっているが……。\n",
      "translation": "뭐, 그것만으로도 상당한 피해가 났다는 건\n쉽게 상상할 수 있지. 일단 일부 함대가\n구조하러 가고 있다만……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,342,0,0",
        "voice": "GA810005,3"
      },
      "original": "「返事がないのは、よい返事」って言葉もあるじゃ\n　ないですか。\n　そう信じましょう、ね？\n",
      "translation": "「무소식이 희소식」이라는 말도 있잖아요.\n그렇게 믿자고요, 네?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,342,0,0",
        "voice": "GA810005,3"
      },
      "original": "……そうだな、信じよう。\nその上で、オレたちは、自分たちにできることを\nしなくちゃ。\n",
      "translation": "……그래, 믿자. 그리고 우리는 우리가 할 수\n있는 일을 해야 해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA810006,3"
      },
      "original": "ああ、そうだな。\nそれで、具体的には？\n",
      "translation": "아아, 그렇지. 그래서 구체적으로는?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,223,0",
        "voice": "GA810006,3"
      },
      "original": "……それは、まだちょっと……。\nもう少し、艦内をぶらつきながら考えてみるよ。\n",
      "translation": "……그건 아직 좀…… 좀 더 함내를\n돌아다니면서 생각해 볼게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GA810007,3"
      },
      "original": "わかった。\n好きなだけ考えてこい。\n",
      "translation": "알았다. 마음껏 생각하고 와.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA810007,3"
      },
      "original": "ん、そういえば……。\nねぇ、ココ？\n",
      "translation": "응, 그러고 보니…… 있지, 코코?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,338",
        "voice": "GA810008,3"
      },
      "original": "はい？\n",
      "translation": "네?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0018",
      "channel": 1,
      "context": {
        "voice": "GA810008,3",
        "speaker": "001",
        "face": "007,0,0,338"
      },
      "original": "しーっ、声が大きい。\n",
      "translation": "쉿, 목소리가 커.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,338,0",
        "voice": "GA810009,3"
      },
      "original": "（あ、はい……。\n　それで、何でしょうか？）\n",
      "translation": "(아, 네…… 그래서, 무엇인가요?)\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,338,0",
        "voice": "GA810009,3"
      },
      "original": "（この前のアルモとレスターの話は、どうなった\n　の？）\n",
      "translation": "(지난번 아르모와 레스터 건은 어떻게 됐어?)\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0021",
      "channel": 1,
      "context": {
        "face": "491,0,336,0",
        "voice": "GA810010,3",
        "speaker": "016"
      },
      "original": "（ああ、アレですか……）\n",
      "translation": "(아아, 그거 말인가요……)\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,336,0",
        "voice": "GA810011,3"
      },
      "original": "（結局、何も進展なしですよ。\n　クールダラス副司令が、あそこまで硬派……と\n　いうか、鈍感だとは思いませんでした）\n",
      "translation": "(결국 아무런 진전도 없어요. 쿨다라스\n부사령관이 그렇게까지 숙맥…… 아니, 둔감할\n줄은 몰랐어요)\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0023",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,336,0",
        "voice": "GA810011,3"
      },
      "original": "（まぁ、舞踏会にいなかった時点で、たぶんそう\n　だろうとは思ってたけど）\n",
      "translation": "(뭐, 무도회에 안 온 걸 보고 아마 그럴 거라\n생각하긴 했지만)\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,337,0",
        "voice": "GA810012,3"
      },
      "original": "（結果的に、もうしばらく一緒にいられることに\n　なりましたから、アルモも内心では喜んでいる\n　みたいですけど）\n",
      "translation": "(결과적으로 당분간은 함께 있을 수 있게\n됐으니까, 아르모도 속으론 기뻐하는 것\n같지만요)\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0025",
      "channel": 1,
      "context": {
        "face": "501,342,0,0",
        "speaker": "017",
        "voice": "GA810013,3"
      },
      "original": "ねぇ、ココ。\nなに話してるの？\nあたしも混ぜて！\n",
      "translation": "있지, 코코. 무슨 얘기 하고 있어? 나도\n끼워 줘!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0026",
      "channel": 1,
      "context": {
        "voice": "GA810014,3",
        "speaker": "016",
        "face": "491,342,0,338"
      },
      "original": "あ、アルモ！\nえーと、特に大した話じゃないの。\n気にしないで。\n",
      "translation": "아, 아르모! 음, 딱히 대단한 이야기는\n아니야. 신경 쓰지 마.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0027",
      "channel": 1,
      "context": {
        "face": "221,0,225,0",
        "speaker": "007",
        "voice": "GA810015,3"
      },
      "original": "お前ら、ブリッジでムダ話してるんじゃない。\nタクトも用がないんなら、さっさと寝ろ。\n",
      "translation": "너희, 브릿지에서 잡담하지 마라.\n택트도 볼일 없으면 얼른 자러 가.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00101000:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,225,0",
        "voice": "GA810015,3"
      },
      "original": "わ、わかった。\nそれじゃ、オレはこれで！\n",
      "translation": "아, 알았어. 그럼, 나는 이만!\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
