{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_00070800.txt",
    "encoding": "cp932",
    "sha256": "48ab0a5a47adef81a84258011667ce09a4064956af9fd87231b1b27021adca5d",
    "dialogue_count": 88
  },
  "units": [
    {
      "id": "GADAT001_DAT_00070800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,094,0",
        "voice": "GA505001,3"
      },
      "original": "うふふふ……★\n",
      "translation": "우후후후……★\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,094,0",
        "voice": "GA505001,3"
      },
      "original": "ん、ランファ？\nどうしたんだい、そんなにニヤニヤして？\n",
      "translation": "음, 란파? 왜 그래, 그렇게 싱글벙글 웃으면서?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,070,0",
        "voice": "GA505002,3"
      },
      "original": "……あっ、タクト！\nやだ、いつから見てたの？\n",
      "translation": "……앗, 택트! 어머, 언제부터 보고 있었던\n거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,070,0",
        "voice": "GA505002,3"
      },
      "original": "いや、今来たところなんだけど。\n何かいいことでもあったの？\n",
      "translation": "아니, 방금 왔는데. 무슨 좋은 일이라도 있어?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,062,0",
        "voice": "GA505003,3"
      },
      "original": "ううん、別に。\n……というより、これからあるかもしれないって\nトコかしらね。\n",
      "translation": "으응, 딱히. ……라기보다, 이제부터 생길지도\n모른다는 거랄까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,062,0",
        "voice": "GA505003,3"
      },
      "original": "これから？\n何だい、それ？\n",
      "translation": "이제부터? 그게 뭔데?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,094,0",
        "voice": "GA505004,3"
      },
      "original": "うふふふ……これよ、これ。\n",
      "translation": "우후후후…… 이거야, 이거.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA505004,3"
      },
      "original": "この石が、どうかしたの？\n",
      "translation": "이 돌이, 왜?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "062,0,0,0",
        "voice": "GA505005,3"
      },
      "original": "ただの石じゃないわよ。\nその名も『宇宙精霊石・アムールＶ』！\n",
      "translation": "그냥 돌이 아니야. 그 이름도 『우주정령석・아\n무르Ｖ』!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA505005,3"
      },
      "original": "はぁ……？\n",
      "translation": "하아……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,094,0",
        "voice": "GA505006,3"
      },
      "original": "この前の補給で買ったの。\n身につけているだけで、ステキな恋人ができるっ\nて、本星の女の子に大人気なんだから★\n",
      "translation": "지난번 보급 때 샀어. 몸에 지니고만 있어도,\n멋진 애인이 생긴다 고 해서, 본성의 여자애들\n한테 대인기라니까★\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,062,0",
        "voice": "GA505007,3"
      },
      "original": "これさえあれば、白馬に乗ったステキな王子様を\nゲットできるって寸法よ！\n",
      "translation": "이것만 있으면, 백마를 탄 멋진 왕자님을 겟할\n수 있다는 계산지!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,062,0",
        "voice": "GA505007,3"
      },
      "original": "なるほど、おまじないグッズか。\n占いといい、そういうの好きだね、ランファ……。\n",
      "translation": "그렇구나, 부적 같은 거네. 점이라든가, 그런\n건 좋아하네, 란파……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0014",
      "channel": 1,
      "context": {
        "face": "061,0,066,0",
        "voice": "GA505008,3",
        "speaker": "003"
      },
      "original": "ほっといてよ！\nこんな戦いのさなかだからこそ、理想の愛を追い\n求めたくなるってモンでしょ？\n",
      "translation": "내버려 둬! 이런 싸움의 한복판이니까야,\n이상적인 사랑을 갈구 하게 되는 법이라고?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,066,0",
        "voice": "GA505008,3"
      },
      "original": "うーん……。\n",
      "translation": "으음……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,066,0",
        "voice": "GA505008,3"
      },
      "original": "それはわかるなぁ。\nオレも、かわいい恋人がいたらいいなーって思う\nもん。\n",
      "translation": "그건 이해해. 나도, 귀여운 애인이 있으면\n좋겠다～라고 생각하니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0017",
      "channel": 1,
      "context": {
        "voice": "GA505009,3",
        "speaker": "003",
        "face": "061,0,094,0"
      },
      "original": "でしょ、でしょ！？\nやっぱり、どんなときにも、心にうるおいは必要\nよね～。\n",
      "translation": "그치, 그치!? 역시, 어떤 때라도, 마음의\n여유는 필요 한 법이지～.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,094,0",
        "voice": "GA505009,3"
      },
      "original": "そういえば、ランファの理想の男性って、どんな\n感じなの？\n",
      "translation": "그러고 보니, 란파의 이상형은 어떤 느낌이야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,090,0",
        "voice": "GA505010,3"
      },
      "original": "やっぱりぃ、若くてぇ、美形でぇ、背が高くてぇ、\nお金持ちでぇ、アタシ一途なひとがいいなぁ～★\nあと、リゾート惑星に別荘があってぇ……。\n",
      "translation": "역시 젊고, 미남에 키도 크고, 부자에 나만\n바라보는 사람이 좋아～★ 게다가 리조트\n행성에 별장도 있고……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0020",
      "channel": 1,
      "context": {
        "voice": "GA505010,3",
        "speaker": "001",
        "face": "012,0,090,0"
      },
      "original": "……はいはい。\n落ち着け、どうどう。\n",
      "translation": "……네, 네. 진정해, 진정하라고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,066,0",
        "voice": "GA505011,3"
      },
      "original": "何よう？\nんじゃ、アンタの好みって、どんなのよ？\n",
      "translation": "뭐야? 그럼, 너의 취향은 어떤데?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,066,0",
        "voice": "GA505011,3"
      },
      "original": "……それはヒミツだ。\n",
      "translation": "……그건 비밀이다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0023",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,072,0",
        "voice": "GA505012,3"
      },
      "original": "アタシが言ったんだから、アンタも言いなさいよ！\n",
      "translation": "내가 말했으니까, 너도 말해!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0024",
      "channel": 1,
      "context": {
        "voice": "GA505012,3",
        "speaker": "001",
        "face": "002,0,072,0"
      },
      "original": "ヒミツったら、ヒミツ♪\n",
      "translation": "비밀이라니까, 비밀♪\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,062,0",
        "voice": "GA505013,3"
      },
      "original": "あ……もしかしたら、この艦の中に、好きな人が\nいたりするんじゃないでしょうね？\n",
      "translation": "아…… 어쩌면, 이 함선 안에, 좋아하는\n사람이 있거나 하는 거 아니에요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,062,0",
        "voice": "GA505013,3"
      },
      "original": "……ご想像にお任せします。\nそれじゃ、オレはこれで。\n",
      "translation": "……상상에 맡기겠습니다. 그럼, 전 이만.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "086,0,0,0",
        "voice": "GA505014,3"
      },
      "original": "あっ、ちょっと待ちなさいよーっ！\n",
      "translation": "앗, 잠깐 기다려!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0028",
      "channel": 1,
      "context": {
        "face": "012,0,066,0",
        "voice": "GA505014,3",
        "speaker": "001"
      },
      "original": "いや、オレには興味がないから……。\nとりあえず、ステキな恋人ができるといいね。\n",
      "translation": "아니, 난 관심 없으니까…… 일단, 멋진\n연인이 생기면 좋겠네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,067,0",
        "voice": "GA505015,3"
      },
      "original": "何よ、それ？\n興味ないんだったら、最初から話題にしないでよ。\n",
      "translation": "뭐야, 그게? 관심 없다면 처음부터 화제로\n꺼내지 마.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0030",
      "channel": 1,
      "context": {
        "voice": "GA505015,3",
        "speaker": "001",
        "face": "012,0,067,0"
      },
      "original": "話題にしたのは、ランファの方だろ。\nオレはお茶を飲んでいくけど、ランファは？\n",
      "translation": "화제를 꺼낸 건 란파 쪽이잖아. 난 차를 좀 더\n마실 건데, 란파는?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0031",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,066,0",
        "voice": "GA505016,3"
      },
      "original": "ロマンを理解しない男といても、しょうがないわ。\n部屋で映画でも見る。\n",
      "translation": "로망을 이해 못 하는 남자와 있어 봤자,\n소용없어. 방에서 영화나 볼래.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0032",
      "channel": 1,
      "context": {
        "face": "001,0,066,0",
        "voice": "GA505016,3",
        "speaker": "001"
      },
      "original": "ベタベタにロマンチックな、恋愛映画？\n",
      "translation": "끈적끈적하게 로맨틱한, 연애 영화?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0033",
      "channel": 1,
      "context": {
        "face": "061,0,072,0",
        "speaker": "003",
        "voice": "GA505017,3"
      },
      "original": "アタシが何見ようと、アタシの勝手でしょ！\nひと言多いのよ、アンタは！\nじゃあねっ！\n",
      "translation": "내가 뭘 보든, 내 마음이야! 말이 너무 많아,\n당신은! 그럼 이만!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0034",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "voice": "GA505017,3",
        "speaker": "001"
      },
      "original": "あれ、ランファ？\n靴のリフォームは、もう終わったの？\n",
      "translation": "어라, 란파? 구두 리폼은 벌써 끝난 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0035",
      "channel": 1,
      "context": {
        "face": "061,0,089,0",
        "speaker": "003",
        "voice": "GA515001,3"
      },
      "original": "それが結局、うまくいかなかったわ。\nあ～あ……。\n",
      "translation": "그게 결국, 잘 안 됐어. 아～아……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0036",
      "channel": 1,
      "context": {
        "face": "012,0,089,0",
        "voice": "GA515001,3",
        "speaker": "001"
      },
      "original": "そう落ちこむなよ。\n味方とうまく合流して、ローム星系に着いたら、\nその靴が見つかるかもしれないじゃないか。\n",
      "translation": "그렇게 낙담하지 마. 아군과 잘 합류해서, 롬\n성계에 도착하면, 그 구두를 찾을 수 있을지도\n모르잖아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0037",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,069,0",
        "voice": "GA515002,3"
      },
      "original": "本物の靴は、ドラマの撮影用に特別に作られた、\n１足だけしかないのよ。\nだから自分で作ろうとしてたんじゃない。\n",
      "translation": "진짜 구두는, 드라마 촬영용으로 특별히\n제작된, 단 한 켤레뿐이라고. 그래서 직접\n만들려고 했던 거야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,069,0",
        "voice": "GA515002,3"
      },
      "original": "ああ、なるほど。\nだけど、物がなくたって、あこがれが消えるわけ\nでもないだろ？\n",
      "translation": "아아, 그렇구나. 하지만, 물건이 없다고 해서,\n동경이 사라지는 건 아니잖아?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0039",
      "channel": 1,
      "context": {
        "face": "061,0,061,0",
        "speaker": "003",
        "voice": "GA515003,3"
      },
      "original": "うん……そうね。\nありがと。\n",
      "translation": "응…… 그렇네. 고마워.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0040",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA515003,3"
      },
      "original": "やあ、ランファ。\nこんなところで何してるの？\n",
      "translation": "안녕, 란파. 이런 곳에서 뭐 하고 있어?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0041",
      "channel": 1,
      "context": {
        "face": "061,0,061,0",
        "speaker": "003",
        "voice": "GA515004,3"
      },
      "original": "せっかくの非番だから、ゆったり休憩よ。\nさっきコンビニで買ってきた雑誌を見てたの。\n",
      "translation": "모처럼의 비번이니까, 느긋하게 휴식 중이야.\n아까 편의점에서 사 온 잡지를 보고 있었어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0042",
      "channel": 1,
      "context": {
        "voice": "GA515004,3",
        "speaker": "001",
        "face": "001,0,061,0"
      },
      "original": "なるほど、この前の補給で新しい本や雑誌が入荷\nされたからな。\nオレも後で寄ってみるかな。\n",
      "translation": "그렇구나, 지난번 보급 때 새로운 책이나\n잡지가 입고 되었으니까 말이야. 나도 나중에\n들러볼까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0043",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,088,0",
        "voice": "GA515005,3"
      },
      "original": "そうだ、ちょっと時間ある？\n雑誌の記事で、アンタにピッタリの心理テストが\nあったのよ。\n",
      "translation": "맞다, 잠깐 시간 있어? 잡지 기사에서, 너에게\n딱 맞는 심리 테스트가 있었거든.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0044",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,088,0",
        "voice": "GA515005,3"
      },
      "original": "心理テスト？\n",
      "translation": "심리 테스트?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0045",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,088,0",
        "voice": "GA515006,3"
      },
      "original": "そう、『あなたはリーダーの資質があるか』って\nヤツ。\nやってみない？\n",
      "translation": "응, 『당신은 리더의 자질이 있는가』라는 거.\n해보지 않을래?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0046",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,088,0",
        "voice": "GA515006,3"
      },
      "original": "おもしろそうだな。\nよし、やろう。\n",
      "translation": "재밌겠네. 좋아, 하자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0047",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,062,0",
        "voice": "GA515007,3"
      },
      "original": "じゃあ、さっそくいくわよ。\n第１問。\n",
      "translation": "그럼, 바로 시작할게. 제1문.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0048",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,061,0",
        "voice": "GA515008,3"
      },
      "original": "『まわりの人間からの意見は、よく聞く方だ』\n　ＹＥＳかＮＯか？\n",
      "translation": "『주변 사람들의 의견은, 잘 듣는 편이다』\nYES인가 NO인가?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0049",
      "channel": 1,
      "context": {
        "face": "004,0,061,0",
        "speaker": "001",
        "voice": "GA515008,3"
      },
      "original": "まわりからの意見か。\nそうだなぁ……。\n",
      "translation": "주위의 의견인가. 그렇네……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0050",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,061,0",
        "voice": "GA515008,3"
      },
      "original": "もちろんＹＥＳさ。\nみんなの意見は尊重しなきゃね。\n",
      "translation": "물론 YES지. 모두의 의견은 존중해야 하니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0051",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,061,0",
        "voice": "GA515008,3"
      },
      "original": "うーん、そうでもないかなぁ。\nそれじゃ、ＮＯで。\n",
      "translation": "으음, 꼭 그렇지는 않을까. 그럼, NO로.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0052",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,061,0",
        "voice": "GA515009,3"
      },
      "original": "ふ～ん……。\nじゃあ、第２問。\n",
      "translation": "흐응…… 그럼, 제2문.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0053",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,088,0",
        "voice": "GA515010,3"
      },
      "original": "『状況に流されず、冷静に自分を見つめることが\n　できる』\n　ＹＥＳかＮＯか？\n",
      "translation": "『상황에 휩쓸리지 않고, 냉정하게 자신을\n바라볼 수 　있다』 　YES인가 NO인가?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0054",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,088,0",
        "voice": "GA515010,3"
      },
      "original": "状況に流されず……。\nうん、それだったら……。\n",
      "translation": "상황에 휩쓸리지 않고…… 음, 그렇다면……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0055",
      "channel": 1,
      "context": {
        "face": "002,0,088,0",
        "voice": "GA515010,3",
        "speaker": "001"
      },
      "original": "ＹＥＳ。\nそれには自信があるぞ。\n",
      "translation": "YES. 그것에는 자신 있어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0056",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,088,0",
        "voice": "GA515010,3"
      },
      "original": "うーん、あんまり自信ないなぁ。\nＮＯだ。\n",
      "translation": "으음, 별로 자신 없는데. NO다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0057",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,061,0",
        "voice": "GA515011,3"
      },
      "original": "あっそう。\nそれじゃ、最後の質問よ。\n",
      "translation": "아, 그래. 그럼, 마지막 질문이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0058",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,088,0",
        "voice": "GA515012,3"
      },
      "original": "『仕事と恋愛、どちらか片方だけを選ぶとしたら、\n　どっち？』\n",
      "translation": "『일과 연애, 둘 중 하나만 선택해야 한다면,\n어느 쪽?』\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0059",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,088,0",
        "voice": "GA515012,3"
      },
      "original": "仕事と恋か。\nそうだなぁ……。\n",
      "translation": "일과 사랑인가. 그렇네……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0060",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,088,0",
        "voice": "GA515012,3"
      },
      "original": "仕事だね。\nリーダーたる者、時には非情な選択をしなければ\nならないんだ。\n",
      "translation": "일이야. 리더라는 자, 때로는 비정한 선택을\n해야만 하는 법이지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0061",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,088,0",
        "voice": "GA515012,3"
      },
      "original": "そんなときは、愛に生きるのが男の道でしょ！\n",
      "translation": "그럴 때는, 사랑에 사는 것이 남자의 길이지!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0062",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,088,0",
        "voice": "GA515012,3"
      },
      "original": "どっちか片方なんて、選べないよ。\nというわけで、どっちも取る。\n",
      "translation": "둘 중 하나라니, 고를 수 없어. 그러니까, 둘\n다 갖는다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0063",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,061,0",
        "voice": "GA515013,3"
      },
      "original": "ふぅん……なるほど。\nじゃあ、結果を言うわね。\n",
      "translation": "흐응…… 그렇구나. 그럼, 결과를 말할게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0064",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,061,0",
        "voice": "GA515013,3"
      },
      "original": "どきどき……。\n",
      "translation": "두근두근……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0065",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,088,0",
        "voice": "GA515014,3"
      },
      "original": "『あなたはまさに、人の上に立つべくして生まれ\n　てきた人です。\n　周囲の人々をうまく導いてください』だって。\n",
      "translation": "『당신은 그야말로, 남의 위에 서기 위해 태어\n난 사람입니다. 　주위 사람들을 잘 이끌어\n주세요』라는데.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0066",
      "channel": 1,
      "context": {
        "face": "061,0,094,0",
        "voice": "GA515015,3",
        "speaker": "003"
      },
      "original": "アンタ、意外とリーダーに向いてたのね。\n見直したわ。\n",
      "translation": "너, 의외로 리더에 적성이 맞았나 보네. 다시\n봤어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0067",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,094,0",
        "voice": "GA515015,3"
      },
      "original": "まぁ、当然の結果だね。\nオレについて来れば、間違いなしさ。\n",
      "translation": "뭐, 당연한 결과지. 나를 따라오면, 틀림없을\n거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0068",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,062,0",
        "voice": "GA515016,3"
      },
      "original": "『リーダーになるには、やや中途ハンパです。\n　無理をせず、縁の下の力持ちになる方が向いて\n　いるかも』……だって。\n",
      "translation": "『리더가 되기에는, 다소 어중간합니다.\n무리하지 말고, 뒤에서 받쳐주는 역할이 더\n어울릴지도』……라는데.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0069",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,061,0",
        "voice": "GA515017,3"
      },
      "original": "まぁ、無難なセンよね。\nこんなもんじゃない？\n",
      "translation": "뭐, 무난한 결과네. 이 정도 아닐까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0070",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,061,0",
        "voice": "GA515017,3"
      },
      "original": "うーん、自分としては、もう少し自信があったん\nだけどなぁ……。\n",
      "translation": "으음, 나로서는 조금 더 자신 있었 는데\n말이야……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0071",
      "channel": 1,
      "context": {
        "face": "061,0,069,0",
        "speaker": "003",
        "voice": "GA515018,3"
      },
      "original": "『リーダーには根本的に向いていない性格です。\n　このままでは、まっとうな職業につくことさえ\n　保証できません』……だって。\n",
      "translation": "『리더에는 근본적으로 맞지 않는 성격입니다.\n이대로라면, 번듯한 직업을 갖는 것조차\n보장할 수 없습니다』……라는데.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0072",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,066,0",
        "voice": "GA515019,3"
      },
      "original": "まぁ、予想どおりと言えば予想どおりだけど……。\n何でアンタが司令官なんかやってんの？\nそれ以前に、人としてどうかって感じよね。\n",
      "translation": "뭐, 예상대로라고 하면 예상대로지만…… 왜\n네가 사령관 같은 걸 하고 있는 거야? 그\n이전에, 사람으로서 어떠냐는 느낌이네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0073",
      "channel": 1,
      "context": {
        "face": "009,0,066,0",
        "voice": "GA515019,3",
        "speaker": "001"
      },
      "original": "ううっ……。\nそこまで言わなくても……。\n",
      "translation": "으윽…… 그렇게까지 말하지 않아도……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0074",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,061,0",
        "voice": "GA515020,3"
      },
      "original": "何にせよ、エルシオールの司令官がアンタである\nことには変わりないワケだし。\nアタシたちを後悔させないよう、がんばってよね。\n",
      "translation": "어쨌든, 에르시올의 사령관이 당신이라는 사실은\n변함없으니까. 우리들을 후회하게 만들지\n않도록, 힘내라고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0075",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,061,0",
        "voice": "GA515020,3"
      },
      "original": "ああ、わかったよ。\nそれじゃ、オレはこれで。\n",
      "translation": "아아, 알았어. 그럼, 난 이만 가볼게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0076",
      "channel": 1,
      "context": {
        "face": "004,0,0,0",
        "voice": "GA515020,3",
        "speaker": "001"
      },
      "original": "ちょっと腹が減ったなぁ。\n何か食べていくか。\n",
      "translation": "좀 배가 고픈데. 뭐 좀 먹고 갈까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0077",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA515020,3"
      },
      "original": "すみませーん、Ａ定食ひとつください。\n",
      "translation": "저기요, A 정식 하나 주세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0078",
      "channel": 1,
      "context": {
        "speaker": "024",
        "face": "581,0,0,0",
        "voice": "GA506001,3"
      },
      "original": "おやまぁ、司令さんじゃないの。\nいつもお疲れさま。\nはい、Ａ定食ね。\n",
      "translation": "어머나, 사령관님 아니야. 항상 수고가 많네.\n자, A 정식이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0079",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA506001,3"
      },
      "original": "あれ？\nライスが大盛りになってますけど？\nおかずの量も増えているような……。\n",
      "translation": "어라? 밥이 곱빼기가 되어 있는데요? 반찬\n양도 늘어난 것 같고……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0080",
      "channel": 1,
      "context": {
        "voice": "GA506002,3",
        "speaker": "024",
        "face": "581,0,0,0"
      },
      "original": "さっき、艦内放送があったのよ。\n司令さんのおかげで、味方と会えるんでしょ？\nだから、それはサービス。\n",
      "translation": "아까, 함내 방송이 있었거든. 사령관님 덕분에\n아군을 만날 수 있게 된 거지? 그러니까, 이건\n서비스야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0081",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA506002,3"
      },
      "original": "あ、そういうことか。\nでも、オレのおかげってわけじゃないですよ。\n",
      "translation": "아, 그런 거였군요. 하지만 제 덕분인 건\n아니에요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0082",
      "channel": 1,
      "context": {
        "speaker": "024",
        "face": "582,0,0,0",
        "voice": "GA506003,3"
      },
      "original": "いいから、いいから。\nあたしゃ、こんな形でしか役に立てないし。\n",
      "translation": "됐어, 됐어. 난 이런 식으로밖에 도움이 안\n되니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0083",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA506003,3"
      },
      "original": "そんなことないですよ。\nおばさんの作る食事のおかげで、オレたちも毎日\n元気で働けるんですから。\n",
      "translation": "그렇지 않아요. 아주머니가 만드는 음식\n덕분에 저희도 매일 기운차게 일할 수 있는걸\n요 .\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0084",
      "channel": 1,
      "context": {
        "speaker": "024",
        "face": "582,0,0,0",
        "voice": "GA506004,3"
      },
      "original": "うれしいこと言ってくれるねぇ。\nよし、もっと大盛りにしてあげるよ。\n",
      "translation": "기쁜 소리를 해주는구나. 좋아, 더 곱빼기로\n줄게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0085",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0",
        "voice": "GA506004,3"
      },
      "original": "わわっ、そんなに盛られても、いっぺんに食べら\nれませんよ。\n",
      "translation": "와앗, 그렇게 많이 주시면 한꺼번에 다 못\n먹어요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0086",
      "channel": 1,
      "context": {
        "speaker": "024",
        "face": "582,0,0,0",
        "voice": "GA506005,3"
      },
      "original": "遠慮することないんだよ？\nこの艦の子たちは、司令さんも含めて、みーんな\nあたしの娘や息子みたいなもんだからねぇ。\n",
      "translation": "사양할 것 없어. 이 함선의 아이들은 사령관님\n을 포함해서, 모두 내 딸이나 아들 같은\n존재니까 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0087",
      "channel": 1,
      "context": {
        "speaker": "024",
        "face": "582,0,0,0",
        "voice": "GA506006,3"
      },
      "original": "特に司令さんには、もっと栄養あるモンたくさん\n食べて、もっともっとがんばってもらわなきゃ。\n",
      "translation": "특히 사령관님은 영양가 있는 걸 잔뜩 먹고서,\n훨씬 더 열심히 해줘야 하니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00070800:dialogue:0088",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA506006,3"
      },
      "original": "わかりました。\nそれじゃ、遠慮なくいただきます。\n",
      "translation": "알겠습니다. 그럼, 사양 않고 잘 먹겠습니다.\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
