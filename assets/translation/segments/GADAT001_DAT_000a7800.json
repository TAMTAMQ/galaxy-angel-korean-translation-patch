{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000a7800.txt",
    "encoding": "cp932",
    "sha256": "70a88efecb7d3e5e80d8cbffc39a87be4da41813d40eb13c75afd897720532e9",
    "dialogue_count": 47
  },
  "units": [
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "明日にはエオニア軍との決戦か……。\nそれにしても……。\n",
      "translation": "내일이면 에오니아군과의 결전인가……\n그나저나……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0"
      },
      "original": "『白き月』の秘密といい、よく考えたらオレって\n　何でこんな一大事に、当事者として参加してる\n　のかなぁ？\n",
      "translation": "『백색 달』의 비밀도 그렇고, 생각해 보면\n난 왜 이런 큰일에 당사자로 참여하고\n있는 걸까?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0"
      },
      "original": "……いや、いかんいかん。\n今は、そんなことを考えてもしかたがない。\n",
      "translation": "……아니, 안 돼, 안 돼. 지금은 그런 생각을\n해봤자 소용없다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "暗い考えになるのは、疲れてる証拠だな。\n少し休もうかな……？\n",
      "translation": "어두운 생각이 드는 건 피곤하다는 증거군.\n조금 쉴까……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0"
      },
      "original": "いや、まだ大丈夫だ。\nもっと艦内を回ってみよう。\n",
      "translation": "아니, 아직 괜찮아. 함내를 좀 더 돌아보자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "こういうときは、頭を空っぽにするに限る。\nコメディ映画でも見て、気分を変えよう。\n",
      "translation": "이럴 때는 머리를 비우는 게 최고지. 코미디\n영화라도 보면서 기분을 전환하자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0"
      },
      "original": "……あっはっはっは！\nいやー、笑った笑った。\n",
      "translation": "……아핫하핫하! 이야ー, 실컷 웃었네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "おかげで、頭もスッキリした気がするなぁ。\nまた艦内を回ってみるか。\n",
      "translation": "덕분에 머리도 개운해진 것 같네. 다시\n함내를 돌아볼까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0"
      },
      "original": "……おや？\nやけに静かだな。\n",
      "translation": "……어라? 유난히 조용하네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "アルモ、ココ。\n何かあったのかい？\n",
      "translation": "아르모, 코코. 무슨 일이라도 있는 거니?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,343,0,0",
        "voice": "GAE05001,3"
      },
      "original": "しーっ。\n司令、ちょっと静かに。\n",
      "translation": "쉿. 사령관, 좀 조용히 하세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,343,0,0",
        "voice": "GAE05001,3"
      },
      "original": "へ？\n",
      "translation": "어?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,343,0,336",
        "voice": "GAE05002,3"
      },
      "original": "副司令が、そこのイスで……。\n",
      "translation": "부사령관이 저기 의자에서……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0014",
      "channel": 1,
      "context": {
        "face": "006,343,0,336",
        "speaker": "001",
        "voice": "GAE05002,3"
      },
      "original": "あ……レスターが寝てる。\nそうか、だから声をひそめていたのか。\n",
      "translation": "아…… 레스터가 자고 있네. 그래서\n목소리를 낮추고 있었구나.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GAE05003,3"
      },
      "original": "ん……？\nなんだ、タクトか。\n",
      "translation": "음……? 뭐냐, 택트인가.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,221,0",
        "voice": "GAE05003,3"
      },
      "original": "ああ、悪い。\n起こすつもりはなかったんだ。\n",
      "translation": "아아, 미안. 깨울 생각은 없었어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,221,0",
        "voice": "GAE05003,3"
      },
      "original": "レスター、部屋に戻ったらどうだ？\nお前が居眠りなんて、珍しいもんな。\n疲れてるんだろ？\n",
      "translation": "레스터, 방으로 돌아가는 게 어때? 네가\n졸다니 드문 일이잖아. 피곤한 거지?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GAE05004,3"
      },
      "original": "そうだな。\n確かに今日は、いつになく疲れた。\n",
      "translation": "그렇군. 확실히 오늘은 평소보다 피곤하다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0019",
      "channel": 1,
      "context": {
        "face": "221,0,223,0",
        "speaker": "007",
        "voice": "GAE05005,3"
      },
      "original": "シャトヤーン様にお会いして、お前からの口づて\nで、『白き月』の秘密まで知らされて……。\n",
      "translation": "샤토얀 님을 만나고 네게 전해 들은\n『백색 달』의 비밀까지 알게 되고……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,224,0",
        "voice": "GAE05006,3"
      },
      "original": "それから、この秘密工場で、エルシオールの突貫\n大改装ときた。\nこんなの、めったに体験できるもんじゃない。\n",
      "translation": "그러고 나서 이 비밀 공장에서 에르시올을\n급하게 대개조까지 했지. 이런 건 좀처럼\n겪을 수 있는 일이 아니라고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,224,0",
        "voice": "GAE05006,3"
      },
      "original": "へぇ……。\nレスターも、気疲れすることなんてあるんだな。\n",
      "translation": "헤에…… 레스터도 신경 쓰다 지칠 때가\n있구나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GAE05007,3"
      },
      "original": "お前の図太さと一緒にするな。\n……まぁ、そんなお前だからこそ、今までやって\nこれたんだろうけどな。\n",
      "translation": "네 뻔뻔함과 같이 보지 마. ……뭐,\n그런 너라서 지금까지 버텨온 거겠지만.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0023",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GAE05008,3"
      },
      "original": "一生経験できないようなことが、次々と起こって\n……まったく、お前の副官やっててよかったよ。\n",
      "translation": "평생 못 겪을 일들이 잇달아 벌어져……\n정말이지 네 부관 하길 잘했어.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,221,0",
        "voice": "GAE05008,3"
      },
      "original": "それって、ほめてるのか？\n",
      "translation": "그거 칭찬하는 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,222,0",
        "voice": "GAE05009,3"
      },
      "original": "さて、どうかな。\nそんじゃ、俺はお先に。\n",
      "translation": "글쎄, 어떨까. 그럼 난 먼저 간다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "094",
        "face": "000,0,0,0",
        "voice": "GAE05009,3"
      },
      "original": "　\n",
      "translation": "　\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,337",
        "voice": "GAE05010,3"
      },
      "original": "マイヤーズ司令も、お休みにならないんですか？\n",
      "translation": "마이어스 사령관도 쉬지 않으시는 건가요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,337",
        "voice": "GAE05010,3"
      },
      "original": "あ、もう少ししたら寝るよ。\n君たちも、もう休んだら？\n",
      "translation": "아, 조금 있으면 잘 거야. 너희도 이제\n쉬는 게 어때?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,342,0,337",
        "voice": "GAE05011,3"
      },
      "original": "はい、そうさせてもらいます。\nクールダラス副司令と同じで、あたしたちも今日\nはいろいろ考えさせられることが多くて……。\n",
      "translation": "네, 그러도록 할게요. 쿨다라스 부사령관처럼\n저희도 오늘 여러 가지 생각할 일이\n많아서……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,342,0,337",
        "voice": "GAE05011,3"
      },
      "original": "そうか……『白き月』が兵器工場だったなんて、\n君たち『月の巫女』にとっては信じたくない事実\nだったろうな。\n",
      "translation": "그런가…… 『백색 달』이 병기 공장이었다니\n너희 『달의 무녀』에겐 믿고 싶지 않은\n사실이었겠구나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0031",
      "channel": 1,
      "context": {
        "face": "491,342,0,336",
        "speaker": "016",
        "voice": "GAE05012,3"
      },
      "original": "はい、少し……いえ、かなりショックでした。\n",
      "translation": "네, 조금…… 아니, 꽤 충격적이었어요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0032",
      "channel": 1,
      "context": {
        "voice": "GAE05013,3",
        "speaker": "017",
        "face": "501,341,0,336"
      },
      "original": "『白き月』って何なんだろう？\n　ロストテクノロジーって何なんだろう？\n　……ずっと、そんなことばかり考えていました。\n",
      "translation": "『백색 달』이란 뭘까? 로스트 테크놀로지란\n뭘까? ……계속 그런 것들만 생각하고\n있었어요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0033",
      "channel": 1,
      "context": {
        "voice": "GAE05014,3",
        "speaker": "016",
        "face": "491,341,0,336"
      },
      "original": "それに、私たちがしていたロストテクノロジーの\n研究は、兵器の研究だったのかもしれない……。\nそう思うと、やるせなくなって……。\n",
      "translation": "게다가 우리가 하던 로스트 테크놀로지 연구도\n병기 연구였을지 모른다고 생각하니\n착잡해져서……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0034",
      "channel": 1,
      "context": {
        "face": "501,342,0,336",
        "voice": "GAE05015,3",
        "speaker": "017"
      },
      "original": "……だけど、考えて考えて、ココとふたりで話し\n合っているうちに、何となく答えが見えたような\n気がします。\n",
      "translation": "……하지만 계속 생각하고 코코와 둘이\n이야기를 나누다 보니 왠지\n답이 보이기 시작한 것 같아요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0035",
      "channel": 1,
      "context": {
        "face": "006,342,0,336",
        "speaker": "001",
        "voice": "GAE05015,3"
      },
      "original": "え……？\n",
      "translation": "어……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0036",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,342,0,337",
        "voice": "GAE05016,3"
      },
      "original": "シャトヤーン様がおっしゃったそうですね。\nこの兵器工場は、『白き月』を発見した人たちに\nよって閉鎖されたと。\n",
      "translation": "샤토얀 님이 말씀하셨다면서요. 이 병기 공장은\n『백색 달』을 발견한 사람들이 폐쇄했다고요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0037",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,342,0,337",
        "voice": "GAE05017,3"
      },
      "original": "それと同じだと思うんです。\nあたしたちが、これからすることも。\n",
      "translation": "우리가 앞으로 할 일도 그와 같다고 생각해요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,342,0,336",
        "voice": "GAE05018,3"
      },
      "original": "ロストテクノロジーの中には、確かに危険なもの\nもあります。\nでも、それは使う人しだいだと思うんです。\n",
      "translation": "로스트 테크놀로지 중에는 분명 위험한 것도\n있습니다. 하지만 결국 쓰는 사람에\n달렸다고 생각해요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0039",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,341,0,336",
        "voice": "GAE05019,3"
      },
      "original": "明日、エオニア軍を倒して、平和が戻ってくれば、\nロストテクノロジーの兵器は必要なくなるわけじゃ\nないですか。\n",
      "translation": "내일 에오니아군을 쓰러뜨리고 평화가 돌아오면\n로스트 테크놀로지 병기는 더는\n필요 없게 되는 거잖아요?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0040",
      "channel": 1,
      "context": {
        "voice": "GAE05019,3",
        "speaker": "001",
        "face": "001,341,0,336"
      },
      "original": "ああ、確かに……。\n",
      "translation": "아, 그렇네……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0041",
      "channel": 1,
      "context": {
        "voice": "GAE05020,3",
        "speaker": "016",
        "face": "491,341,0,336"
      },
      "original": "それに平和になれば、人の心も穏やかになります。\nそうすれば、ロストテクノロジーを、兵器として\n使おうとする人も減ると思います。\n",
      "translation": "게다가 평화로워지면 사람들 마음도 편안해질\n거예요. 그러면 로스트 테크놀로지를 병기로\n쓰려는 사람도 줄어들 거라고 생각해요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0042",
      "channel": 1,
      "context": {
        "voice": "GAE05021,3",
        "speaker": "017",
        "face": "501,341,0,336"
      },
      "original": "兵器となり得る技術も、使い方によっては、生活\nを豊かにする技術にできるかもしれません。\n",
      "translation": "병기가 될 수 있는 기술도 쓰기 나름으로\n생활을 풍요롭게 하는 기술이 될지도 몰라요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0043",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,341,0,337",
        "voice": "GAE05022,3"
      },
      "original": "私たちは、平和を守るためにロストテクノロジー\nを研究し、使っていこうと思うんです。\n",
      "translation": "우리는 평화를 지키기 위해 로스트\n테크놀로지를 연구하고 써 나가려고 해요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0044",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,341,0,337",
        "voice": "GAE05022,3"
      },
      "original": "うん、それはいい考えだと思う。\nオレもロストテクノロジーが平和のために役立つ\nことを祈っているよ。\n",
      "translation": "응, 좋은 생각인 것 같아. 나도 로스트\n테크놀로지가 평화에 도움이 되길\n바라고 있어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0045",
      "channel": 1,
      "context": {
        "voice": "GAE05023,3",
        "speaker": "017",
        "face": "501,342,0,337"
      },
      "original": "ええ、がんばります！\nそのためには、明日は絶対に勝たないと！\n",
      "translation": "네, 열심히 할게요! 그러려면 내일은\n반드시 이겨야 해요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0046",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,342,0,337",
        "voice": "GAE05024,3"
      },
      "original": "がんばりましょう、マイヤーズ司令。\nそれでは、私たちもこれで……。\n",
      "translation": "힘내요, 마이어스 사령관. 그럼 저희도\n이만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000a7800:dialogue:0047",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,342,0,337",
        "voice": "GAE05024,3"
      },
      "original": "ああ、おやすみ。\n明日はよろしく頼むよ、アルモ、ココ。\n",
      "translation": "그래, 잘 자. 내일도 잘 부탁해, 아르모,\n코코.\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
