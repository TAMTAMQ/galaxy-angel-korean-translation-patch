{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000c2800.txt",
    "encoding": "cp932",
    "sha256": "ec8bf261062169abfab1e949600905cc99edb9577961358509f04edf9995c37f",
    "dialogue_count": 17
  },
  "units": [
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "特に、フォルテがザコを蹴散らしてくれたおかげ\nで、『黒き月』を破壊できたんですから。\n",
      "translation": "특히 포르테가 졸개들을 쓸어 준 덕분에 『흑색\n달』을 파괴할 수 있었으니까요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "ありがとう、フォルテ。\n本当に助かったよ。\n",
      "translation": "고마워, 포르테.\n정말 큰 도움이 됐어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "142,0,0,0",
        "voice": "GAF15001,3"
      },
      "original": "なぁに、このぐらい、どうってことないさ。\nタクトが無事でよかったよ。\n",
      "translation": "뭐, 이 정도쯤 아무것도 아니지.\n택트가 무사해서 다행이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "102,0,0,0",
        "voice": "GAF15002,3"
      },
      "original": "あらあら、仲がよろしいですこと。\nそう思いません、ランファさん？\n",
      "translation": "어머나, 사이가 좋으시네요.\n그렇지 않나요, 란파 씨?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "089,0,0,0",
        "voice": "GAF15003,3"
      },
      "original": "そうねぇ～。\nうらやましいわよねぇ～。\n",
      "translation": "그러게 말이야～.\n부럽지～.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GAF15003,3"
      },
      "original": "お、おいおい……。\n",
      "translation": "자, 잠깐……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "142,0,0,0",
        "voice": "GAF15004,3"
      },
      "original": "ま、言いたいやつには言わせときゃいいさ。\n本当のことだしね。\n",
      "translation": "뭐, 떠들고 싶은 사람은 떠들게 둬.\n사실이니까 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "022,0,0,0",
        "voice": "GAF15005,3"
      },
      "original": "わぁ、フォルテさん、すごーい！\nオトナの余裕って感じですね！\n",
      "translation": "와아, 포르테 씨, 대단해요!\n정말 어른의 여유가 느껴져요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,0,0",
        "voice": "GAF15006,3"
      },
      "original": "……そうなのですか？\n",
      "translation": "……그런 건가요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "174,0,0,0",
        "voice": "GAF15007,3"
      },
      "original": "ふふふっ……さぁてね。\n",
      "translation": "후후훗…… 글쎄.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "089,0,0,0",
        "voice": "GAF15008,3"
      },
      "original": "やっぱり、この前の医務室で、何かあったんだわ。\nタクト、何があったのか教えなさいよぉ！\n",
      "translation": "역시 지난번 의무실에서 무슨 일이 있었던\n거야. 택트, 무슨 일이 있었는지 말해 봐!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0012",
      "channel": 1,
      "context": {
        "voice": "GAF15008,3",
        "speaker": "001",
        "face": "007,0,0,0"
      },
      "original": "えぇっ！？\nいや、それは……。\n",
      "translation": "어엇!?\n아니, 그건……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0013",
      "channel": 1,
      "context": {
        "face": "022,0,0,0",
        "voice": "GAF15009,3",
        "speaker": "002"
      },
      "original": "あっ、あたしも聞きたいですー！\n",
      "translation": "앗, 저도 듣고 싶어요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,0,0",
        "voice": "GAF15010,3"
      },
      "original": "……興味深いです。\n",
      "translation": "……흥미롭군요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "164,0,0,0",
        "voice": "GAF15011,3"
      },
      "original": "　悪いけど、人に言うようなもんじゃないよ。\n「秘するが花」ってね。\n",
      "translation": "미안하지만 남에게 말할 일은 아니야.\n비밀은 숨겨야 제맛이지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0016",
      "channel": 1,
      "context": {
        "face": "122,0,0,0",
        "voice": "GAF15012,3",
        "speaker": "004"
      },
      "original": "つまり、ふたりだけの秘密にしたいことがあった\nと認めるわけですのね？\n",
      "translation": "즉, 두 사람만의 비밀로 하고 싶은 일이\n있었다고 인정하는 셈이군요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000c2800:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GAF15012,3"
      },
      "original": "あ、あはは……。\nと、とりあえず、『白き月』に帰ろう、うん！\n",
      "translation": "아, 아하하……\n우, 우선 『백색 달』로 돌아가자. 그래!\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
