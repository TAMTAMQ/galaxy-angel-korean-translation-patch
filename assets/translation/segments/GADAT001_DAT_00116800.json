  "units": [
    {
      "id": "GADAT001_DAT_00116800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0"
      },
      "original": "それに……オレには、まだ死ねない理由がある。\nここで道連れにされてたまるか。\n",
      "translation": "게다가…… 나에게는, 아직 죽을 수 없는\n이유가 있어. 여기서 길동무로 잡혀갈까 보냐.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00116800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA909001,3"
      },
      "original": "ん？\n何のことだ？\n",
      "translation": "응? 무슨 소리지?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00116800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,223,0",
        "voice": "GA909001,3"
      },
      "original": "あ、いや、何でもない。\nオレ、格納庫に行ってくるよ。\nエンジェル隊をねぎらってあげなきゃ。\n",
      "translation": "아, 아니, 아무것도 아냐. 나, 격납고에\n다녀올게. 엔젤대를 격려해 줘야 하니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00116800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,224,0",
        "voice": "GA909002,3"
      },
      "original": "ちょっと待て、タクト。\n戦闘も無事終わったことだし、さっきの言い訳を\n聞かせてもらおうか？\n",
      "translation": "잠깐 기다려, 택트. 전투도 무사히 끝난\n참이니, 아까 그 변명을 들려주셔야겠어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00116800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,224,0",
        "voice": "GA909002,3"
      },
      "original": "そ、それはまた今度！\nそれじゃ、行ってきまーす！\n",
      "translation": "그, 그건 다음에! 그럼, 다녀오겠습니다!\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
