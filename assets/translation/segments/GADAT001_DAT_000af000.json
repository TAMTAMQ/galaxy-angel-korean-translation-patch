{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000af000.txt",
    "encoding": "cp932",
    "sha256": "18d6f284cc7511a8a48f4bdba11755165ce26c54f0aa26a8a7ac24ebde548160",
    "dialogue_count": 97
  },
  "units": [
    {
      "id": "GADAT001_DAT_000af000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0"
      },
      "original": "ん、この音は……。\nやっぱり、ランファはここだったか。\n",
      "translation": "음, 이 소리는…… 역시 란파는 여기 있었구나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0"
      },
      "original": "おーい、ランファ！\n",
      "translation": "어이, 란파!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,074,0",
        "voice": "GAE20001,3"
      },
      "original": "……あら、タクトじゃない。\n",
      "translation": "……어라, 택트잖아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,074,0",
        "voice": "GAE20001,3"
      },
      "original": "こんな時間まで、トレーニングしてたの？\n",
      "translation": "이 시간까지 훈련하고 있었던 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,075,0",
        "voice": "GAE20002,3"
      },
      "original": "うん、まぁね。\n何だか、目がさえちゃって。\n",
      "translation": "응, 뭐 그렇지. 왠지 잠이 달아나서.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,075,0",
        "voice": "GAE20002,3"
      },
      "original": "さしずめ、明日の決戦に向けて、気合い十分って\nところかな？\n",
      "translation": "아마 내일 결전을 앞두고\n기합이 잔뜩 들어간 거겠지?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,078,0",
        "voice": "GAE20003,3"
      },
      "original": "そう見える？\n",
      "translation": "그렇게 보여?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,078,0",
        "voice": "GAE20003,3"
      },
      "original": "ああ、今のランファなら、無敵って感じだな。\n",
      "translation": "아, 지금 란파라면 무적일 것 같네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,093,0",
        "voice": "GAE20004,3"
      },
      "original": "……そうだといいんだけど……。\nふぅ……。\n",
      "translation": "……그렇다면 좋겠지만…… 후우……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,093,0",
        "voice": "GAE20004,3"
      },
      "original": "どうしたんだい？\n急に、ため息なんかついて。\n",
      "translation": "왜 그래? 갑자기 한숨은 왜 쉬어?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,093,0",
        "voice": "GAE20005,3"
      },
      "original": "ううん……別に。\n",
      "translation": "아니…… 별거 아니야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,093,0",
        "voice": "GAE20005,3"
      },
      "original": "ランファ……？\n",
      "translation": "란파……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,093,0",
        "voice": "GAE20006,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,093,0",
        "voice": "GAE20007,3"
      },
      "original": "本当はね……こうして身体を動かしていないと、\n不安でしょうがないの。\n",
      "translation": "사실은 말이야…… 이렇게 몸을 움직이지\n않으면 불안해서 견딜 수가 없어.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,093,0",
        "voice": "GAE20007,3"
      },
      "original": "え……？\n",
      "translation": "어……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,093,0",
        "voice": "GAE20008,3"
      },
      "original": "この戦いには、皇国の運命がかかってるんでしょ？\nそんなにたくさんの人の未来を、アタシたちだけ\nで本当に救えるの……？\n",
      "translation": "이 싸움에는 황국의 운명이 걸려 있잖아?\n그렇게 많은 사람의 미래를 우리만으로\n정말 구할 수 있는 거야……?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,093,0",
        "voice": "GAE20008,3"
      },
      "original": "どうしたんだい、ランファ。\nいつものランファらしくないじゃないか？\n",
      "translation": "왜 그래, 란파. 평소 란파답지 않잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,093,0",
        "voice": "GAE20009,3"
      },
      "original": "いつものアタシ？\nそれって、どんなアタシよ？\n",
      "translation": "평소의 나? 그게 어떤 나를 말하는 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,093,0",
        "voice": "GAE20009,3"
      },
      "original": "どんなって……。\nそうだな、いつも強気で明るくて……。\n",
      "translation": "어떤가 하면…… 글쎄, 항상 자신만만하고\n밝고……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,093,0",
        "voice": "GAE20010,3"
      },
      "original": "そんなの、アタシの一面でしかないわ。\nアタシは平凡な、どこにでもいる、ただの１８歳\nの女の子よ。\n",
      "translation": "그런 건 내 한 모습일 뿐이야. 난 어디에나\n있는 평범한 18살 여자애야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0021",
      "channel": 1,
      "context": {
        "face": "004,0,093,0",
        "voice": "GAE20010,3",
        "speaker": "001"
      },
      "original": "ランファ……？\n",
      "translation": "란파……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,093,0",
        "voice": "GAE20011,3"
      },
      "original": "違うところがあるとしたら、カンフーファイター\nを動かせるってことだけ。\nそれなのに……。\n",
      "translation": "다른 점이 있다면 쿵푸 파이터를 움직일 수\n있다는 것뿐. 그런데도……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0023",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,080,0",
        "voice": "GAE20012,3"
      },
      "original": "なんでアタシが、こんなバカみたいに大きな話に\n巻き込まれなきゃなんないワケ？\n正直、今すぐ逃げ出したいくらいよ……。\n",
      "translation": "왜 내가 이렇게 터무니없이 큰일에 휘말려야\n하는 건데? 솔직히 지금 당장 도망치고 싶을\n정도라고……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0024",
      "channel": 1,
      "context": {
        "voice": "GAE20012,3",
        "speaker": "001",
        "face": "004,0,080,0"
      },
      "original": "ランファ……。\n",
      "translation": "란파……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0025",
      "channel": 1,
      "context": {
        "voice": "GAE20013,3",
        "speaker": "003",
        "face": "069,0,093,0"
      },
      "original": "ねぇ、タクト。\nアタシ、どうしたらいいの？\nどうしたら、皇国のみんなの期待に応えられるの？\n",
      "translation": "있잖아, 택트. 나 어떻게 해야 해?\n어떻게 해야 황국 모두의 기대에\n부응할 수 있는 거야?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,093,0",
        "voice": "GAE20013,3"
      },
      "original": "……「皇国のみんな」って、漠然と考えるから、\n必要以上にスケールが大きく感じてしまうんだと\n思うな。\n",
      "translation": "……「황국 사람들」이라고 막연히 생각하니까\n필요 이상으로 일이 크게 느껴지는 거라고\n생각해.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,078,0",
        "voice": "GAE20014,3"
      },
      "original": "どういうこと？\n",
      "translation": "그게 무슨 소리야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,078,0",
        "voice": "GAE20014,3"
      },
      "original": "もっと身近な人たちのことを思えばいいのさ。\nたとえば……ランファは、家族のことが好きだろ？\n",
      "translation": "좀 더 가까운 사람들을 생각하면 돼. 예를\n들어…… 란파는 가족을 좋아하잖아?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,078,0",
        "voice": "GAE20015,3"
      },
      "original": "え……？\nも、もちろんよ。\n",
      "translation": "어……? 무, 물론이지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,078,0",
        "voice": "GAE20015,3"
      },
      "original": "お守りを作ってくれた弟さんたちを、守りたいと\n思うだろう？\n",
      "translation": "부적을 만들어 준 남동생들을 지키고 싶잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0031",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,080,0",
        "voice": "GAE20016,3"
      },
      "original": "うん。\n当然じゃない！\n",
      "translation": "응. 당연하잖아!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0032",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,078,0",
        "voice": "GAE20016,3"
      },
      "original": "それに、母星にいる友達も、大切だと思うだろう？\n",
      "translation": "게다가 모성에 있는 친구들도\n소중하다고 생각하지?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,093,0",
        "voice": "GAE20017,3"
      },
      "original": "うん、大切よ。\n幸せになってもらいたいし、その人たちの未来を\n守りたいと思う。\n",
      "translation": "응, 소중해. 행복해졌으면 좋겠고\n그 사람들의 미래도 지키고 싶어.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0034",
      "channel": 1,
      "context": {
        "face": "002,0,093,0",
        "speaker": "001",
        "voice": "GAE20017,3"
      },
      "original": "だったら、ランファはその人たちを、その人たち\nの幸せを……。\nきっと守れるさ。\n",
      "translation": "그렇다면 란파는 그 사람들을,\n그 사람들의 행복을……\n분명 지킬 수 있을 거야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0035",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,078,0",
        "voice": "GAE20018,3"
      },
      "original": "どうして……？\n",
      "translation": "어째서……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0036",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,078,0",
        "voice": "GAE20018,3"
      },
      "original": "世界ってのは、そんな風に、小さくてもかけがえ\nのない人たちが集まってできているんだ。\n",
      "translation": "세상은 그렇게 작지만 소중한 사람들이\n모여 이루어진 거야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0037",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,078,0",
        "voice": "GAE20018,3"
      },
      "original": "その大切な人たちを守ろうと思う気持ちがあれば、\nきっと世界全体を救えるんだよ。\n",
      "translation": "그 소중한 사람들을 지키고 싶다는 마음이\n있다면 분명 세계 전체를 구할 수 있어.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,074,0",
        "voice": "GAE20019,3"
      },
      "original": "そっか……そうね。\nそう考えると、何だか胸の中が軽くなったような\n気がするわ。\n",
      "translation": "그렇구나…… 그러네. 그렇게 생각하니\n왠지 가슴이 한결 가벼워진 것 같아.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0039",
      "channel": 1,
      "context": {
        "face": "069,0,075,0",
        "voice": "GAE20020,3",
        "speaker": "003"
      },
      "original": "アタシ、がんばる。\nアタシの大切な人たちと、もっと大切な人のため\nに。\n",
      "translation": "나, 열심히 할게. 내 소중한 사람들과\n더 소중한 사람을 위해서.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0040",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,075,0",
        "voice": "GAE20020,3"
      },
      "original": "その意気だよ。\n皇国の平和のために、力いっぱい戦おう！\n",
      "translation": "그 기세야. 황국의 평화를 위해 힘껏 싸우자!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0041",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,077,0",
        "voice": "GAE20021,3"
      },
      "original": "もう……それじゃダメよ。\n",
      "translation": "정말…… 그러면 안 돼.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0042",
      "channel": 1,
      "context": {
        "voice": "GAE20021,3",
        "face": "012,0,077,0",
        "speaker": "001"
      },
      "original": "ダメって、どうしてさ？\n",
      "translation": "안 된다니, 왜 그래?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0043",
      "channel": 1,
      "context": {
        "face": "069,0,076,0",
        "speaker": "003",
        "voice": "GAE20022,3"
      },
      "original": "ちゃんと聞いてなかったの？\nアタシは、アタシにとっていちばん大切な人……\nタクトのために戦いたいの。\n",
      "translation": "제대로 안 들었어? 난 나한테 가장 소중한\n사람…… 택트를 위해 싸우고 싶어.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0044",
      "channel": 1,
      "context": {
        "face": "006,0,076,0",
        "voice": "GAE20022,3",
        "speaker": "001"
      },
      "original": "えっ……オレ？\n",
      "translation": "어…… 나?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0045",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,075,0",
        "voice": "GAE20023,3"
      },
      "original": "そう。\nアタシは、タクトと自分の幸せのために戦うわ。\n",
      "translation": "그래. 난 택트와 내 행복을 위해 싸울 거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0046",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,077,0",
        "voice": "GAE20024,3"
      },
      "original": "だからタクトも、アタシのために戦うって言って。\n",
      "translation": "그러니까 택트도 나를 위해 싸우겠다고 말해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0047",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,077,0",
        "voice": "GAE20024,3"
      },
      "original": "オ、オレも……？\n",
      "translation": "나, 나도……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0048",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,080,0",
        "voice": "GAE20025,3"
      },
      "original": "アタシだけじゃ、不公平じゃない。\nタクトも約束して。\n",
      "translation": "나만 싸우는 건, 불공평하잖아. 택트도 약속해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0049",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,080,0",
        "voice": "GAE20025,3"
      },
      "original": "それは……。\n",
      "translation": "그건……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0050",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,080,0",
        "voice": "GAE20025,3"
      },
      "original": "ああ、約束するよ。\nオレはランファのために戦う。\nそして、ランファのために勝つ。\n",
      "translation": "아, 약속할게. 난 란파를 위해 싸울게.\n그리고 란파를 위해 이길게.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0051",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,093,0",
        "voice": "GAE20026,3"
      },
      "original": "本当に？\n",
      "translation": "정말?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0052",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,093,0",
        "voice": "GAE20026,3"
      },
      "original": "このオレの、ありったけの勇気と正義にかけて、\n誓うよ。\nオレの気持ちは、わかってるはずだろ？\n",
      "translation": "내 모든 용기와 정의를 걸고 맹세할게.\n내 마음은 알고 있잖아?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0053",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,075,0",
        "voice": "GAE20027,3"
      },
      "original": "うん、わかってる。\nありがとう……うれしいわ★\n",
      "translation": "응, 알고 있어. 고마워…… 기뻐★\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0054",
      "channel": 1,
      "context": {
        "face": "001,0,093,0",
        "voice": "GAE20027,3",
        "speaker": "001"
      },
      "original": "もちろんさ。\nオレのありったけの勇気と正義にかけて、誓うよ。\n",
      "translation": "물론이지. 내 모든 용기와 정의를 걸고\n맹세할게.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0055",
      "channel": 1,
      "context": {
        "face": "069,0,075,0",
        "voice": "GAE20028,3",
        "speaker": "003"
      },
      "original": "本当に約束してくれるのね？\nうれしい！\n",
      "translation": "정말로 약속해 주는 거지? 기뻐!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0056",
      "channel": 1,
      "context": {
        "face": "069,0,076,0",
        "speaker": "003",
        "voice": "GAE20029,3"
      },
      "original": "それじゃあ……。\n",
      "translation": "그럼……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0057",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "071,0,0,0",
        "voice": "GAE20030,3"
      },
      "original": "誓いの証に、キスして。\n",
      "translation": "맹세의 증표로 키스해 줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0058",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0",
        "voice": "GAE20030,3"
      },
      "original": "ええっ？\nキ……キス！？\n",
      "translation": "어어? 키…… 키스!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0059",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "093,0,0,0",
        "voice": "GAE20031,3"
      },
      "original": "アタシにとって、いちばん大切なのはタクトよ。\nだから、キスでタクトの力を分けてほしいの。\nお願い★\n",
      "translation": "나한테 가장 소중한 건 택트야.\n그러니까 키스로 택트의 힘을 나눠 줘.\n부탁이야★\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0060",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GAE20031,3"
      },
      "original": "え、えーと……。\n",
      "translation": "어, 어ー……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0061",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "093,0,0,0",
        "voice": "GAE20032,3"
      },
      "original": "タクトがキスしてくれたら、この戦いにも絶対に\n勝てるわ。\nアタシにはわかるの。\n",
      "translation": "택트가 키스해 주면 이 싸움도 반드시\n이길 수 있어. 난 알아.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0062",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "008,0,0,0",
        "voice": "GAE20032,3"
      },
      "original": "……皇国の存亡がかかったキスだね。\n",
      "translation": "……황국의 존망이 걸린 키스네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0063",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,0,0",
        "voice": "GAE20033,3"
      },
      "original": "そう。\nそして、アタシとタクトの運命もね。\n",
      "translation": "그래. 그리고 나와 택트의 운명도 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0064",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "008,0,0,0",
        "voice": "GAE20033,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0065",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "071,0,0,0",
        "voice": "GAE20034,3"
      },
      "original": "タクト……お願い。\n",
      "translation": "택트…… 부탁해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0066",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "008,0,0,0",
        "voice": "GAE20034,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0067",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAE20034,3"
      },
      "original": "……わかった。\nランファ……好きだよ。\n",
      "translation": "……알았어. 란파…… 좋아해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0068",
      "channel": 1,
      "context": {
        "face": "0,0,0,0",
        "voice": "GAE20034,3",
        "speaker": "094"
      },
      "original": "……チュッ★\n",
      "translation": "……쪽★\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0069",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "071,0,0,0",
        "voice": "GAE20035,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0070",
      "channel": 1,
      "context": {
        "face": "008,0,0,0",
        "voice": "GAE20035,3",
        "speaker": "001"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0071",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "071,0,0,0",
        "voice": "GAE20036,3"
      },
      "original": "タクト……。\n",
      "translation": "택트……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0072",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "070,0,0,0",
        "voice": "GAE20037,3"
      },
      "original": "アタシ、タクトのためにがんばるわ。\n絶対に勝ってみせる。\n",
      "translation": "나, 택트를 위해 힘낼게. 반드시 이겨 보일게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0073",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "071,0,0,0",
        "voice": "GAE20038,3"
      },
      "original": "だから……ずっとそばにいてね。\n戦いの間も、その後も……ずっと……。\n",
      "translation": "그러니까…… 계속 곁에 있어 줘. 전투 중에도\n그 후에도…… 계속……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0074",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAE20038,3"
      },
      "original": "オレはいつでも、ランファのそばにいるよ。\nランファをひとりぼっちにはしない。\n",
      "translation": "난 언제나 란파 곁에 있을게.\n란파를 혼자 두지 않을 거야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0075",
      "channel": 1,
      "context": {
        "face": "069,0,0,0",
        "voice": "GAE20039,3",
        "speaker": "003"
      },
      "original": "うん！\n",
      "translation": "응!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0076",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,080,0",
        "voice": "GAE20039,3"
      },
      "original": "……悪いけど、その約束はできない。\n",
      "translation": "……미안하지만, 그 약속은 할 수 없어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0077",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,078,0",
        "voice": "GAE20040,3"
      },
      "original": "え……？\n",
      "translation": "어……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0078",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,078,0",
        "voice": "GAE20040,3"
      },
      "original": "オレは、エンジェル隊とエルシオールの司令官だ。\n誰かひとりのためじゃなく、もっと大勢の人々の\n命をあずかる責任がある。\n",
      "translation": "난 엔젤대와 에르시올의 사령관이야.\n한 사람만이 아니라 더 많은 사람의\n목숨을 책임져야 해.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0079",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,078,0",
        "voice": "GAE20040,3"
      },
      "original": "だから……ランファの気持ちには応えられない。\n",
      "translation": "그러니까…… 란파의 마음에 답해 줄 수 없어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0080",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,093,0",
        "voice": "GAE20041,3"
      },
      "original": "そんな……どうして！？\n",
      "translation": "말도 안 돼…… 어째서!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0081",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,080,0",
        "voice": "GAE20042,3"
      },
      "original": "だって……だって、この間は、好きだって言って\nくれたじゃない！\nあれはウソだったの！？\n",
      "translation": "그치만…… 그치만, 얼마 전엔 좋아한다고\n말해 줬잖아! 그건 거짓말이었던 거야!?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0082",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,080,0",
        "voice": "GAE20042,3"
      },
      "original": "ランファのことが嫌いなわけじゃない。\nそれは本当だ。\nでも……。\n",
      "translation": "란파가 싫은 건 아니야. 그건 진심이야.\n하지만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0083",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,080,0",
        "voice": "GAE20042,3"
      },
      "original": "……すまない。\n",
      "translation": "……미안하다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0084",
      "channel": 1,
      "context": {
        "voice": "GAE20044,3",
        "speaker": "003",
        "face": "069,0,093,0"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0085",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,093,0",
        "voice": "GAE20045,3"
      },
      "original": "……そっか……。\n結局、アタシのカン違いだったんだ。\n",
      "translation": "……그렇구나…… 결국 내 착각이었던 거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0086",
      "channel": 1,
      "context": {
        "face": "006,0,093,0",
        "speaker": "001",
        "voice": "GAE20045,3"
      },
      "original": "ランファ……。\n",
      "translation": "란파……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0087",
      "channel": 1,
      "context": {
        "face": "069,0,093,0",
        "voice": "GAE20046,3",
        "speaker": "003"
      },
      "original": "そうだよね。\nタクトは司令官なんだもの。\n",
      "translation": "그렇겠지. 택트는 사령관이니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0088",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,093,0",
        "voice": "GAE20047,3"
      },
      "original": "アタシだけのヒーローなんかじゃなくて、みんな\nのヒーローだもんね……。\n",
      "translation": "나만의 히어로가 아니라 모두의\n히어로인 거니까……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0089",
      "channel": 1,
      "context": {
        "face": "004,0,093,0",
        "speaker": "001",
        "voice": "GAE20047,3"
      },
      "original": "ランファ、オレは……。\n",
      "translation": "란파, 나는……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000af000:dialogue:0090",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "069,0,074,0",
        "voice": "GAE20048,3"
      },
      "original": "気にしないでよ。\nタクトがそう言うのは、当然なんだから。\n",
      "translation": "신경 쓰지 마. 택트가 그렇게 말하는 건\n당연하니까.\n",
      "state": "draft",
      "use_translation": true
    },
