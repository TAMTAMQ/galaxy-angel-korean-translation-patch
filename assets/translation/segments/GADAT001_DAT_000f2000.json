{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000f2000.txt",
    "encoding": "cp932",
    "sha256": "9aa8d449c215591dc98e9a33c568c4df66e5fa1753b15a784edbe2893bad44e6",
    "dialogue_count": 137
  },
  "units": [
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "えーっと、フォルテ、フォルテはと……。\n",
      "translation": "어디 보자, 포르테, 포르테는 그리고……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0"
      },
      "original": "あいてっ！\n",
      "translation": "아얏!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "075",
        "face": "0,0,0,0"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0"
      },
      "original": "あ、どうもすいません。\nよそ見をしていて、うっかり……。\n",
      "translation": "아, 정말 죄송합니다. 딴 데를 보느라,\n깜빡하고……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "075",
        "face": "0,0,0,0",
        "voice": "GA737001,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA737001,3"
      },
      "original": "あ、ちょっと？\n……何なんだ、あのボーイさん。\nこっちは、ちゃんと謝ったのに。\n",
      "translation": "아, 잠깐만? ……뭐야, 저 보이 씨는. 이쪽은\n제대로 사과했는데.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA737001,3"
      },
      "original": "まぁ、いいや。\nそれより、フォルテを捜さないと。\n",
      "translation": "뭐, 됐어. 그보다 포르테를 찾아야 해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA737001,3"
      },
      "original": "……ん？\nあそこにいるのは……。\n",
      "translation": "……응? 저기에 있는 건……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA737001,3"
      },
      "original": "フォルテだ！\nやっと見つけた。\nおーい、フォルテ！\n",
      "translation": "포르테다! 겨우 찾아냈어. 어이, 포르테!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,155,0",
        "voice": "GA737002,3"
      },
      "original": "ああ、タクト。\nいいところに来てくれたね。\n",
      "translation": "아아, 택트. 마침 잘 왔네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,155,0",
        "voice": "GA737002,3"
      },
      "original": "捜したんだよ……って、何の話だ？\n",
      "translation": "찾고 있었던 거야……라니, 무슨 소리야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,157,0",
        "voice": "GA737003,3"
      },
      "original": "いいかい、落ち着いて聞いとくれ。\nこの会場に、どうも妙なヤツがまぎれ込んでいる\nようなんだよ。\n",
      "translation": "잘 들어, 진정하고 들어. 이 회장에, 아무래도\n수상한 녀석이 숨어든 것 같아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,157,0",
        "voice": "GA737003,3"
      },
      "original": "妙なヤツ……？\n",
      "translation": "수상한 녀석……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,157,0",
        "voice": "GA737004,3"
      },
      "original": "あそこにいるボーイをご覧よ。\n",
      "translation": "저기 있는 보이를 봐.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA737004,3"
      },
      "original": "あれ？\nあのボーイさん、さっきぶつかった人じゃないか。\n",
      "translation": "어라? 저 보이 씨, 아까 부딪힌 사람이잖아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "154,0,0,0",
        "voice": "GA737005,3"
      },
      "original": "あのふたり、さっきから見てるけど、一度も給仕\nらしいことをしていない。\nそれに、はいてる靴が、ほかのボーイと違う。\n",
      "translation": "저 두 사람, 아까부터 보고 있는데, 한 번도\n웨이터다운 일을 하지 않고 있어. 게다가, 신고\n있는 구두가 다른 보이들과 달라.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "154,0,0,0",
        "voice": "GA737006,3"
      },
      "original": "「化粧室はどこだ」って聞いて、それとなく探り\n　を入れてみたんだけど、要領を得ない答えしか\n　返ってこなかった。\n",
      "translation": "「화장실은 어디냐」라고 물어서 슬쩍 떠\n보았는데, 알맹이 없는 대답밖에 돌아오지\n않았어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0018",
      "channel": 1,
      "context": {
        "face": "004,0,0,0",
        "speaker": "001",
        "voice": "GA737006,3"
      },
      "original": "確かに、あやしいな……。\nだけど、どこかのお偉いさんの個人的な警護かも\nしれないぞ？\n",
      "translation": "확실히 수상하네…… 하지만, 어디 높으신\n분의 개인 경호원일지도 모른다고?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0019",
      "channel": 1,
      "context": {
        "face": "154,0,0,0",
        "speaker": "005",
        "voice": "GA737007,3"
      },
      "original": "いや、違うね。\nあいつらの目つきは、ボディガードとは正反対の\n世界にいる連中の目だよ。\n",
      "translation": "아니, 틀렸어. 저 녀석들의 눈빛은,\n보디가드와는 정반대인 세계에 있는 자들의\n눈이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA737007,3"
      },
      "original": "それって……まさか、殺し屋ってこと！？\n",
      "translation": "그렇다는 건…… 설마, 살인청부업자라는\n거야!?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "155,0,0,0",
        "voice": "GA737008,3"
      },
      "original": "シッ、静かに。\nとにかく、目を離さない方がいい。\n",
      "translation": "쉿, 조용히. 어쨌든, 눈을 떼지 않는 게 좋아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,0,0",
        "voice": "GA737008,3"
      },
      "original": "あっ！\nあの男たち、動き始めたぞ。\n",
      "translation": "앗! 저 남자들, 움직이기 시작했어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0023",
      "channel": 1,
      "context": {
        "voice": "GA737008,3",
        "speaker": "001",
        "face": "003,0,0,0"
      },
      "original": "二手に分かれて、階段を昇っていった……。\nあっちは、貴賓席のある方向じゃないか。\n",
      "translation": "두 갈래로 나뉘어서, 계단을 올라갔어……\n저쪽은 귀빈석이 있는 방향이잖아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "010,0,0,0",
        "voice": "GA737008,3"
      },
      "original": "ということは、まさかシヴァ皇子の命を！？\n",
      "translation": "그렇다는 건, 설마 시바 황자의 목숨을!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,157,0",
        "voice": "GA737009,3"
      },
      "original": "どうやら、余裕こいてる時間はなさそうだね。\n",
      "translation": "아무래도, 여유 부리고 있을 시간은 없는 것\n같네.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,157,0",
        "voice": "GA737009,3"
      },
      "original": "ああ……エオニア軍の手の者かもしれない。\n念のため、警備の衛兵に教えた方が……。\n",
      "translation": "아아…… 에오니아군의 자객일지도 몰라.\n만약을 위해, 경비병에게 알려두는 편이……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,157,0",
        "voice": "GA737010,3"
      },
      "original": "いや、下手に騒ぎになるとマズイ。\nまだ相手が殺し屋だと決まったわけでもないしね。\n",
      "translation": "아니, 어설프게 소란을 피우면 곤란해. 아직\n상대가 살인청부업자라고 정해진 것도 아니니까\n말이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0028",
      "channel": 1,
      "context": {
        "face": "004,0,157,0",
        "voice": "GA737010,3",
        "speaker": "001"
      },
      "original": "じゃあ、どうすれば……。\n",
      "translation": "그럼, 어떻게 하면……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,157,0",
        "voice": "GA737011,3"
      },
      "original": "あたしらで、後をつけよう。\n",
      "translation": "우리들이 뒤를 쫓자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,157,0",
        "voice": "GA737011,3"
      },
      "original": "えぇっ！？\n",
      "translation": "에엣!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0031",
      "channel": 1,
      "context": {
        "face": "152,0,155,0",
        "voice": "GA737012,3",
        "speaker": "005"
      },
      "original": "そうだ、タクト。\nコレを持っていきな。\n",
      "translation": "맞다, 택트. 이걸 가져가.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0032",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0",
        "voice": "GA737012,3"
      },
      "original": "じ……銃ぅ～っ！？\n",
      "translation": "조…… 총～!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "155,0,0,0",
        "voice": "GA737013,3"
      },
      "original": "シーッ！\n声がでかいっつーの！\n",
      "translation": "쉬잇! 목소리가 크다고!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0034",
      "channel": 1,
      "context": {
        "face": "012,0,0,0",
        "speaker": "001",
        "voice": "GA737013,3"
      },
      "original": "あ……ご、ごめん。\n",
      "translation": "아…… 미, 미안.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0035",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,0,0",
        "voice": "GA737014,3"
      },
      "original": "こんなこともあろうかと思ってね。\n２丁持って来といて、よかったよ。\n",
      "translation": "이런 일이 있을 줄 알고 말이야. 두 자루\n챙겨오길 잘했어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0036",
      "channel": 1,
      "context": {
        "face": "012,0,0,0",
        "speaker": "001",
        "voice": "GA737014,3"
      },
      "original": "「こんなことも」って……どんなことを想定して\n　たんだよ？\n　そもそも、どこに隠し持って……。\n",
      "translation": "「이런 일」이라니…… 어떤 일을 상상하고\n있었던 거야? 애초에, 어디에 숨겨두고……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0037",
      "channel": 1,
      "context": {
        "voice": "GA737015,3",
        "speaker": "005",
        "face": "153,0,0,0"
      },
      "original": "細かいことは気にしないの。\nそれより、早く追わないと、連中を見失っちまう\nよ。\n",
      "translation": "자잘한 건 신경 쓰지 마. 그보다 빨리 쫓지\n않으면, 저 녀석들을 놓쳐버린다고.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA737015,3"
      },
      "original": "あ、ああ……。\nそれじゃ、借りるよ。\n",
      "translation": "아, 아아…… 그럼, 빌릴게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0039",
      "channel": 1,
      "context": {
        "face": "006,0,0,0",
        "voice": "GA737015,3",
        "speaker": "001"
      },
      "original": "うん？\nそういえば、いつもの火薬の銃じゃないんだね。\n",
      "translation": "응? 그러고 보니, 평소의 화약 총이 아니네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0040",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,0,0",
        "voice": "GA737016,3"
      },
      "original": "こんな場所で火薬の銃なんか撃ったら、その音で\n大騒ぎになっちまうだろ？\nそれぐらい考えてるさ。\n",
      "translation": "이런 장소에서 화약총 같은 걸 쏘면, 그 소리\n때문에 대소동이 일어날 거 아냐? 그 정도는\n생각하고 있다고.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0041",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "154,0,0,0",
        "voice": "GA737017,3"
      },
      "original": "そんなことより、早く行くよ。\nタクトは向こうのヤツを頼む。\n",
      "translation": "그런 것보다, 빨리 가자. 택트는 저쪽 녀석을\n부탁해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0042",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA737017,3"
      },
      "original": "わ、わかった。\nフォルテ、気をつけろよ。\n",
      "translation": "아, 알았어. 포르테, 조심해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0043",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "154,0,0,0",
        "voice": "GA737018,3"
      },
      "original": "タクトもね。\nそれじゃ、また後で。\n",
      "translation": "택트 너도 말이야. 그럼, 나중에 봐.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0044",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "009,0,0,0",
        "voice": "GA737018,3"
      },
      "original": "う～ん、どうしてこんなことになっちゃったんだ\nろう……？\n",
      "translation": "으음, 어째서 이렇게 되어버린 걸까……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0045",
      "channel": 1,
      "context": {
        "face": "003,0,0,0",
        "voice": "GA737018,3",
        "speaker": "001"
      },
      "original": "いや、今はそれどころじゃない。\nあの男の後をつけないと。\n",
      "translation": "아니, 지금은 그럴 때가 아니야. 저 남자의\n뒤를 쫓아야 해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0046",
      "channel": 1,
      "context": {
        "face": "0,0,0,0",
        "speaker": "075",
        "voice": "GA737019,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0047",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA737019,3"
      },
      "original": "よし、見つけたぞ。\nやっぱり、シヴァ皇子のいる方に近づいてる……。\n",
      "translation": "좋아, 찾았다. 역시, 시바 황자가 있는 쪽으로\n다가가고 있어……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0048",
      "channel": 1,
      "context": {
        "speaker": "075",
        "face": "0,0,0,0",
        "voice": "GA737020,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0049",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "010,0,0,0",
        "voice": "GA737020,3"
      },
      "original": "あっ、懐に手をかけた！\n……銃を持ってる！\n",
      "translation": "앗, 품에 손을 넣었다! ……총을 가지고 있어!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0050",
      "channel": 1,
      "context": {
        "face": "011,0,0,0",
        "speaker": "001",
        "voice": "GA737020,3"
      },
      "original": "おい、そこのお前！\n何をするつもりだ！？\n",
      "translation": "어이, 거기 너! 무슨 짓을 할 셈이지!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0051",
      "channel": 1,
      "context": {
        "face": "0,0,0,0",
        "voice": "GA737021,3",
        "speaker": "075"
      },
      "original": "なにっ……！？\n",
      "translation": "뭐라고……!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0052",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "011,0,0,0",
        "voice": "GA737021,3"
      },
      "original": "銃を床に置いて、こっちに放れ。\nゆっくり両手を上げろ。\n",
      "translation": "총을 바닥에 내려놓고, 이쪽으로 던져. 천천히\n양손을 올려라.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0053",
      "channel": 1,
      "context": {
        "speaker": "075",
        "face": "0,0,0,0",
        "voice": "GA737022,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0054",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA737022,3"
      },
      "original": "やはり、狙いはシヴァ皇子か？\n",
      "translation": "역시, 목표는 시바 황자인가?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0055",
      "channel": 1,
      "context": {
        "face": "0,0,0,0",
        "voice": "GA737023,3",
        "speaker": "075"
      },
      "original": "くそっ……。\nこうなったら、テメェから先に始末してやる！\n",
      "translation": "젠장…… 이렇게 된 이상, 네놈부터 먼저\n해치워 주마!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0056",
      "channel": 1,
      "context": {
        "face": "003,0,0,0",
        "speaker": "001",
        "voice": "GA737023,3"
      },
      "original": "くっ……！\n",
      "translation": "큭……!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0057",
      "channel": 1,
      "context": {
        "face": "005,0,0,0",
        "speaker": "001",
        "voice": "GA737023,3"
      },
      "original": "ええいっ！\n",
      "translation": "에잇!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0058",
      "channel": 1,
      "context": {
        "speaker": "075",
        "face": "000,0,0,0",
        "voice": "GA737024,3"
      },
      "original": "ぐうっ……。\n",
      "translation": "구욱……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0059",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA737024,3"
      },
      "original": "ふぅ……。\n気絶してくれたか。\nフォルテから借りた銃が役に立ったな。\n",
      "translation": "후우…… 기절해 준 건가. 포르테에게 빌린\n총이 도움이 됐군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0060",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,158,0",
        "voice": "GA737025,3"
      },
      "original": "タクト！\n無事かい？\n",
      "translation": "택트! 무사하니?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0061",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,158,0",
        "voice": "GA737025,3"
      },
      "original": "大丈夫だ。\nこっちは片づけたよ。\nフォルテの方は？\n",
      "translation": "괜찮아. 이쪽은 정리했어. 포르테 쪽은?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0062",
      "channel": 1,
      "context": {
        "face": "152,0,155,0",
        "speaker": "005",
        "voice": "GA737026,3"
      },
      "original": "こっちも気絶させて、すみっこに転がしてあるよ。\n",
      "translation": "이쪽도 기절시켜서 구석에 굴러다니게 해뒀어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0063",
      "channel": 1,
      "context": {
        "face": "001,0,155,0",
        "voice": "GA737026,3",
        "speaker": "001"
      },
      "original": "そうか、これでひとまず安心だな。\nとりあえず、身体をしばっておくか。\n",
      "translation": "그래, 이걸로 일단 안심이네. 우선, 몸을\n묶어둘까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0064",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,155,0",
        "voice": "GA737027,3"
      },
      "original": "そこいらのテーブルクロスなら、ロープ代わりに\nなるんじゃないかい？\n",
      "translation": "저기 있는 테이블보라면, 로프 대신 쓸 수 있지\n않을까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0065",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,155,0",
        "voice": "GA737027,3"
      },
      "original": "そうだな、取ってこよう。\n",
      "translation": "그렇네, 가져올게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0066",
      "channel": 1,
      "context": {
        "face": "152,0,155,0",
        "voice": "GA737028,3",
        "speaker": "005"
      },
      "original": "あたしは、衛兵に連絡してくるよ。\nちょっとここを頼む。\n",
      "translation": "나는, 위병에게 연락하고 올게. 잠시 여기를\n부탁해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0067",
      "channel": 1,
      "context": {
        "speaker": "075",
        "face": "0,0,0,0",
        "voice": "GA737029,3"
      },
      "original": "うっ……。\nくそっ……。\n",
      "translation": "윽…… 젠장……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0068",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA737029,3"
      },
      "original": "あっ！\nあの男が逃げる！\nまだ意識があったのか！\n",
      "translation": "앗! 저 남자가 도망친다! 아직 의식이 있었던\n건가!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0069",
      "channel": 1,
      "context": {
        "voice": "GA737029,3",
        "speaker": "001",
        "face": "011,0,0,0"
      },
      "original": "待てっ！\n",
      "translation": "기다려!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0070",
      "channel": 1,
      "context": {
        "face": "0,0,0,0",
        "speaker": "075",
        "voice": "GA737030,3"
      },
      "original": "うるせぇ！\n",
      "translation": "시끄러워!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0071",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "010,0,0,0",
        "voice": "GA737030,3"
      },
      "original": "くっ……！\n",
      "translation": "큭……!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0072",
      "channel": 1,
      "context": {
        "face": "010,0,0,0",
        "speaker": "001",
        "voice": "GA737030,3"
      },
      "original": "しまった、銃を拾われた！\n……フォルテを狙ってる！\n",
      "translation": "이런, 총을 빼앗겼다! ……포르테를 노리고\n있어!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0073",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "011,0,0,0",
        "voice": "GA737030,3"
      },
      "original": "このおっ！\n",
      "translation": "이 녀석!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0074",
      "channel": 1,
      "context": {
        "voice": "GA737031,3",
        "speaker": "075",
        "face": "0,0,0,0"
      },
      "original": "うおっ！？\n",
      "translation": "우왁!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0075",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,0,0",
        "voice": "GA737031,3"
      },
      "original": "フォルテを撃たせるものか。\nおとなしくしろ！\n",
      "translation": "포르테를 쏘게 둘 줄 알고! 얌전히 있어!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0076",
      "channel": 1,
      "context": {
        "speaker": "075",
        "face": "0,0,0,0",
        "voice": "GA737032,3"
      },
      "original": "こ、この野郎！\n",
      "translation": "이, 이 자식이!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0077",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,0,0,0",
        "voice": "GA737032,3"
      },
      "original": "うわっ！\n",
      "translation": "우와!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0078",
      "channel": 1,
      "context": {
        "speaker": "075",
        "face": "0,0,0,0",
        "voice": "GA737033,3"
      },
      "original": "死ねっ！\n",
      "translation": "죽어라!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0079",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "154,0,0,0",
        "voice": "GA737034,3"
      },
      "original": "タクト！\nそこを離れな！\n",
      "translation": "택트! 거기서 떨어져!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0080",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "010,0,0,0",
        "voice": "GA737034,3"
      },
      "original": "フォルテ……！\n",
      "translation": "포르테……!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0081",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "011,0,0,0",
        "voice": "GA737034,3"
      },
      "original": "フォルテ、危ない！\n",
      "translation": "포르테, 위험해!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0082",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "155,0,0,0",
        "voice": "GA737035,3"
      },
      "original": "なにっ……？\n",
      "translation": "뭐라고……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0083",
      "channel": 1,
      "context": {
        "speaker": "075",
        "face": "0,0,0,0",
        "voice": "GA737036,3"
      },
      "original": "うおおおっ！\n",
      "translation": "우오오오!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0084",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "154,0,0,0",
        "voice": "GA737037,3"
      },
      "original": "チッ……！\n",
      "translation": "칫……!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0085",
      "channel": 1,
      "context": {
        "face": "011,0,0,0",
        "voice": "GA737037,3",
        "speaker": "001"
      },
      "original": "みんな、逃げろ！\nエオニア軍の刺客だ！\n",
      "translation": "모두, 도망쳐! 에오니아군의 자객이다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0086",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "155,0,0,0",
        "voice": "GA737038,3"
      },
      "original": "バカ！\nそんな大声を出したら……！\n",
      "translation": "바보야! 그렇게 큰 소리를 내면……!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0087",
      "channel": 1,
      "context": {
        "face": "007,0,0,0",
        "speaker": "001",
        "voice": "GA737038,3"
      },
      "original": "あ、しまった……。\n",
      "translation": "아, 아차……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0088",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "154,0,0,0",
        "voice": "GA737039,3"
      },
      "original": "いいから、下がって！\n",
      "translation": "됐으니까, 물러나!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0089",
      "channel": 1,
      "context": {
        "speaker": "075",
        "face": "0,0,0,0",
        "voice": "GA737040,3"
      },
      "original": "ぐわっ！\n",
      "translation": "구악!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0090",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA737040,3"
      },
      "original": "フォルテ！\n",
      "translation": "포르테!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0091",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,0,0",
        "voice": "GA737041,3"
      },
      "original": "安心おし、急所は外してあるよ。\n",
      "translation": "안심해, 급소는 피해서 쐈으니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0092",
      "channel": 1,
      "context": {
        "voice": "GA737041,3",
        "speaker": "001",
        "face": "001,0,155,0"
      },
      "original": "さすがフォルテ、助かったよ。\n",
      "translation": "역시 포르테야, 살았어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0093",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,156,0",
        "voice": "GA737042,3"
      },
      "original": "助かったのは、あたしの方だよ。\nタクトがあいつを止めてくれなかったら、今ごろ\nあたしは……。\n",
      "translation": "살아남은 건 내 쪽이야. 택트 네가 저 녀석을\n막아주지 않았다면, 지금쯤 나는……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0094",
      "channel": 1,
      "context": {
        "face": "001,0,156,0",
        "speaker": "001",
        "voice": "GA737042,3"
      },
      "original": "いや、フォルテが無事でよかったよ。\nすばやく片づけられたから、まわりにも気づかれ\nなかったみたいだしね。\n",
      "translation": "아니, 포르테가 무사해서 다행이야. 재빨리\n처리한 덕분에 주변에서도 눈치채지 못한 것\n같고 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0095",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,156,0",
        "voice": "GA737042,3"
      },
      "original": "ともかく、今度こそ念入りにしばり上げて、衛兵\nに突き出そう。\n",
      "translation": "어쨌든, 이번에야말로 철저히 묶어서, 위병에게\n넘기자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0096",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,155,0",
        "voice": "GA737043,3"
      },
      "original": "まぁ、こいつらを尋問しても、どうせ大した情報\nは持ってないだろうけどね。\n何にせよ、早いとこ片づけちまおうか。\n",
      "translation": "뭐, 이 녀석들을 심문해도 어차피 별다른\n정보는 없겠지만 말이야. 어쨌든 빨리 끝내버리\n자고.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0097",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,156,0",
        "voice": "GA737044,3"
      },
      "original": "だけど、見直したよ、タクト。\nあんたも、やるときゃやるモンだね。\n",
      "translation": "하지만, 다시 봤어, 택트. 너도, 할 때는\n하는구나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0098",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,156,0",
        "voice": "GA737044,3"
      },
      "original": "あはは、フォルテにきたえられたからね。\n",
      "translation": "아하하, 포르테에게 훈련받았으니까 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0099",
      "channel": 1,
      "context": {
        "voice": "GA737044,3",
        "speaker": "001",
        "face": "006,0,155,0"
      },
      "original": "フォルテ、ケガはないか？\n",
      "translation": "포르테, 다친 데는 없나?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0100",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,156,0",
        "voice": "GA737045,3"
      },
      "original": "ああ、大丈夫。\nタクトが声をかけてくれたおかげで、助かったよ。\n",
      "translation": "아아, 괜찮아. 택트가 말을 걸어준 덕분에,\n살았어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0101",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,156,0",
        "voice": "GA737045,3"
      },
      "original": "いや、オレが不注意だったんだ。\n幸い、まわりには気づかれなかったみたいだな。\n",
      "translation": "아니, 내가 부주의했던 거야. 다행히, 주변\n사람들에게는 들키지 않은 모양이군.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0102",
      "channel": 1,
      "context": {
        "face": "152,0,155,0",
        "speaker": "005",
        "voice": "GA737046,3"
      },
      "original": "そのようだね。\nじゃあ、こいつを早く衛兵に突き出そう。\nまったく、手間かけさせてくれるよ。\n",
      "translation": "그런 것 같네. 그럼, 이 녀석을 빨리 위병에게\n넘기자. 정말이지, 번거롭게 만든다니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0103",
      "channel": 1,
      "context": {
        "face": "001,0,155,0",
        "voice": "GA737046,3",
        "speaker": "001"
      },
      "original": "さすがフォルテ、助かったよ。\n",
      "translation": "역시 포르테야, 고마워.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0104",
      "channel": 1,
      "context": {
        "speaker": "066",
        "face": "621,374,0,0",
        "voice": "GA737047,3"
      },
      "original": "マイヤーズ君！\n今の声は、いったい何事かね？\n",
      "translation": "마이어스 군! 방금 그 소리는, 대체 무슨\n일인가?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0105",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,374,0,0",
        "voice": "GA737047,3"
      },
      "original": "あ、ジーダマイア大将。\n実は、この男がシヴァ皇子の命を狙ってたんです。\n",
      "translation": "아, 지더마이어 대장. 실은, 이 남자가 시바\n황자의 목숨을 노리고 있었습니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0106",
      "channel": 1,
      "context": {
        "speaker": "066",
        "face": "621,373,0,0",
        "voice": "GA737048,3"
      },
      "original": "な、何だと！？\nそれは一大事だ！\n",
      "translation": "뭐, 뭐라고!? 그건 큰일이군!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0107",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,373,0,155",
        "voice": "GA737049,3"
      },
      "original": "驚いてないで、早く衛兵に連絡してもらえません\nかね？\n",
      "translation": "놀라고만 있지 말고, 빨리 위병에게 연락해\n주시지 않겠습니까?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0108",
      "channel": 1,
      "context": {
        "voice": "GA737050,3",
        "speaker": "066",
        "face": "621,371,0,155"
      },
      "original": "う、うむ。\n",
      "translation": "으, 으음.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0109",
      "channel": 1,
      "context": {
        "face": "152,0,155,0",
        "speaker": "005",
        "voice": "GA737051,3"
      },
      "original": "やれやれ……。\n何とか片づいたか。\n",
      "translation": "이런 이런…… 어떻게든 마무리됐나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0110",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,169,0",
        "voice": "GA737052,3"
      },
      "original": "まわりには気づかれないようにしたかったんだけ\nどねぇ。\nタクトが大声なんか出すからだよ。\n",
      "translation": "주변에 들키지 않게 하고 싶었는데 말이야.\n택트가 큰 소리를 내는 바람에 그렇잖아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0111",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,169,0",
        "voice": "GA737052,3"
      },
      "original": "す、すまない。\nついとっさに……。\n",
      "translation": "미, 미안해. 나도 모르게 순간적으로……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0112",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,155,0",
        "voice": "GA737053,3"
      },
      "original": "まぁ、被害が出なかったから、いいけどさ。\n",
      "translation": "뭐, 피해가 없었으니까 괜찮지만 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0113",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,158,0",
        "voice": "GA737054,3"
      },
      "original": "ん……？\nこの音楽は……。\n",
      "translation": "음……? 이 음악은……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0114",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,158,0",
        "voice": "GA737054,3"
      },
      "original": "ラストダンスが始まったんだな。\nいつの間にか、そんな時間になっていたのか。\n",
      "translation": "라스트 댄스가 시작됐구나. 어느새, 그런\n시간이 되었던 건가.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0115",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,155,0",
        "voice": "GA737055,3"
      },
      "original": "遅れてダンスの輪に入るのもマヌケだし、ここは\n見物するだけにしとこうか。\n",
      "translation": "뒤늦게 댄스의 원에 들어가는 것도 바보\n같으니까, 여기는 구경만 하기로 할까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0116",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,155,0",
        "voice": "GA737055,3"
      },
      "original": "そうだな。\nフォルテと踊れないのは残念だけど……。\n",
      "translation": "그렇네. 포르테와 춤추지 못하는 건\n아쉽지만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0117",
      "channel": 1,
      "context": {
        "voice": "GA737056,3",
        "speaker": "005",
        "face": "152,0,155,0"
      },
      "original": "そう気を落とすことないよ。\nあたしは、これはこれでよかったと思ってるし。\n",
      "translation": "그렇게 낙담할 거 없어. 나는, 이건 이대로\n괜찮다고 생각하니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0118",
      "channel": 1,
      "context": {
        "face": "001,0,155,0",
        "voice": "GA737056,3",
        "speaker": "001"
      },
      "original": "どうしてだい？\n",
      "translation": "어째서지?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0119",
      "channel": 1,
      "context": {
        "face": "152,0,155,0",
        "voice": "GA737057,3",
        "speaker": "005"
      },
      "original": "タクトのカッコいいところを、この目で見られた\nからね。\n",
      "translation": "택트의 멋진 모습을, 내 눈으로 볼 수\n있었으니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0120",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "008,0,155,0",
        "voice": "GA737057,3"
      },
      "original": "な、何だよ、急に？\n",
      "translation": "뭐, 뭐야, 갑자기?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0121",
      "channel": 1,
      "context": {
        "voice": "GA737058,3",
        "speaker": "005",
        "face": "152,0,156,0"
      },
      "original": "ふふっ、照れてんのかい？\n",
      "translation": "후훗, 부끄러워하는 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0122",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "008,0,156,0",
        "voice": "GA737058,3"
      },
      "original": "か、からかわないでくれよ。\n",
      "translation": "노, 놀리지 말아줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0123",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,155,0",
        "voice": "GA737059,3"
      },
      "original": "おや。\nあたしは、けっこう本気で言ったんだけどねぇ。\n",
      "translation": "어머. 나는 꽤 진심으로 말한 건데 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0124",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,155,0",
        "voice": "GA737059,3"
      },
      "original": "え……？\n",
      "translation": "에……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0125",
      "channel": 1,
      "context": {
        "face": "152,0,155,0",
        "voice": "GA737060,3",
        "speaker": "005"
      },
      "original": "あの刺客のせいで舞踏会が台無しにならなかった\nだけ、マシだと思わなきゃ。\n",
      "translation": "그 자객 때문에 무도회가 엉망이 되지 않은\n것만으로도 다행이라고 생각해야 해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0126",
      "channel": 1,
      "context": {
        "face": "012,0,155,0",
        "speaker": "001",
        "voice": "GA737060,3"
      },
      "original": "それもそうだな。\nまったく、寿命がちぢまったよ。\n",
      "translation": "그것도 그렇군. 정말이지, 수명이 줄어들었어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0127",
      "channel": 1,
      "context": {
        "voice": "GA737061,3",
        "speaker": "005",
        "face": "152,0,156,0"
      },
      "original": "それじゃ、バーラウンジに行こうか。\nあそこなら静かだし、ダンスがよく見えるよ。\n",
      "translation": "그럼, 바 라운지로 갈까. 저곳이라면 조용하고,\n댄스가 잘 보여.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0128",
      "channel": 1,
      "context": {
        "voice": "GA737061,3",
        "speaker": "001",
        "face": "001,0,0,0"
      },
      "original": "……これで舞踏会も終わりだな……。\n",
      "translation": "……이걸로 무도회도 끝이군……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0129",
      "channel": 1,
      "context": {
        "face": "152,0,169,0",
        "speaker": "005",
        "voice": "GA737062,3"
      },
      "original": "ああ……。\nタクトとも、お別れだね……。\n",
      "translation": "아아…… 택트와도, 작별이네……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0130",
      "channel": 1,
      "context": {
        "voice": "GA737062,3",
        "speaker": "001",
        "face": "004,0,169,0"
      },
      "original": "うん……。\n",
      "translation": "응……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0131",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,169,0",
        "voice": "GA737063,3"
      },
      "original": "ねぇ、タクト。\n",
      "translation": "있지, 택트.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0132",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,169,0",
        "voice": "GA737063,3"
      },
      "original": "何だい？\n",
      "translation": "왜 그래?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0133",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,170,0",
        "voice": "GA737064,3"
      },
      "original": "最後だから言うけどさ……。\nあたしは……。\n",
      "translation": "마지막이니까 말하는 건데 말이야…… 나는……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0134",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "152,0,158,0",
        "voice": "GA737065,3"
      },
      "original": "な……何だい！\n地震……！？\n",
      "translation": "뭐…… 뭐야! 지진……!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0135",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,158,0",
        "voice": "GA737065,3"
      },
      "original": "いや、違うな……。\nでも、だとしたら、これは……？\n",
      "translation": "아니, 지진은 아니야…… 하지만, 그렇다면\n이건……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000f2000:dialogue:0136",
      "channel": 1,
      "context": {
