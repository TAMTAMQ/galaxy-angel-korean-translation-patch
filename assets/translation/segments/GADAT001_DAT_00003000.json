    },
    {
      "id": "GADAT001_DAT_00003000:dialogue:0130",
      "channel": 1,
      "context": {
        "speaker": "026",
        "face": "601,0,368,0"
      },
      "original": "チュートリアルテスト\n",
      "translation": "튜토리얼 테스트\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00003000:dialogue:0131",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,0,0",
        "voice": "GA101066,3"
      },
      "original": "わかった、わかった。\nランファもミルフィーも、少し落ち着きなって。\n",
      "translation": "알았어, 알았다고. 란파도 밀피도, 좀\n진정해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00003000:dialogue:0132",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,0,0",
        "voice": "GA101066,3"
      },
      "original": "わかった、わかった。\nランファもミルフィーも、少し落ち着きなって。\n",
      "translation": "알았어, 알았다고. 란파도 밀피도, 좀\n진정해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
