{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_0000e800.txt",
    "encoding": "cp932",
    "sha256": "05b5b621a0b4e2aab14c1ec642871f7635c9cce5e9760070034beacde984f25d",
    "dialogue_count": 70
  },
  "units": [
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "040",
        "face": "354,0,0,0",
        "voice": "GA107001,3"
      },
      "original": "お……おのれ、旧体制の犬どもめ。\n紋章機の力をかさに、力ずくで我々を押しつぶす\nとは、なんと卑劣な！\n",
      "translation": "이…… 이놈들, 구체제의 개들 같으니.\n문장기의 힘을 등에 업고, 무력으로 우리를\n짓누르다니, 참으로 비열하구나!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "066,0,0,0",
        "voice": "GA107002,3"
      },
      "original": "何よ、それ。\n最初にたった５機で何ができるって言ったのは、\nそっちじゃない。\n",
      "translation": "뭐라는 거야, 그게. 처음에 고작 5기로 무엇을\n할 수 있겠냐고 말한 건, 그쪽이잖아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "173,0,0,0",
        "voice": "GA107003,3"
      },
      "original": "だいいち、力ずくで押しつぶさない戦闘ってな、\nどんなのだい？\n",
      "translation": "애초에, 무력으로 짓누르지 않는 전투란 게,\n뭐지?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "040",
        "face": "351,0,0,0",
        "voice": "GA107004,3"
      },
      "original": "よかろう！\n明日のために、今日の屈辱を耐え忍ぼう！\n",
      "translation": "좋다! 내일을 위해, 오늘의 굴욕을 참아내겠다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "048,0,0,0",
        "voice": "GA107005,3"
      },
      "original": "えっとぉ……それはやっぱり、ジャンケンとか、\nクジ引きとか……。\n",
      "translation": "저기…… 그건 역시, 가위바위보라든가,\n제비뽑기라든가……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "040",
        "face": "351,0,0,0",
        "voice": "GA107006,3"
      },
      "original": "我々はお前たちには思いもつかない早さで、日々\n進歩している！\n明日の我々は、今日の我々ではない！\n",
      "translation": "우리들은 너희들이 상상도 못 할 속도로,\n나날이 진보하고 있다! 내일의 우리는, 오늘의\n우리가 아니다!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "102,0,0,0",
        "voice": "GA107007,3"
      },
      "original": "ミルフィーさん、それでは戦闘ではなく、単なる\n勝敗の決め方になってしまいますわ。\n",
      "translation": "밀피 씨, 그러면 전투가 아니라, 단순한\n승패를 결정하는 방법이 되어버립니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "040",
        "face": "351,0,0,0",
        "voice": "GA107008,3"
      },
      "original": "……おーい、誰か聞いてるかー。\n",
      "translation": "……어이, 누구 듣고 있나—.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "066,0,0,0",
        "voice": "GA107009,3"
      },
      "original": "聞いてるわけないでしょ。\n",
      "translation": "듣고 있을 리 없잖아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "040",
        "face": "354,0,0,0",
        "voice": "GA107010,3"
      },
      "original": "聞いてないのに、どうして返事をするんだ！\n",
      "translation": "듣고 있지 않은데, 왜 대답을 하는 거냐!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0011",
      "channel": 1,
      "context": {
        "face": "173,0,0,0",
        "voice": "GA107011,3",
        "speaker": "005"
      },
      "original": "なんだ、返事してほしくなかったのかい？\nだったら、最初から聞くんじゃないよ。\nおかしな男だね。\n",
      "translation": "뭐야, 대답 안 해줬으면 좋였던 거야? 그렇다\n면 , 처음부터 묻지 말라고. 이상한 남자네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "040",
        "face": "351,0,0,0",
        "voice": "GA107012,3"
      },
      "original": "う……うう……。\n満天の星空なんて、大っきらいだぁ～っ！\n",
      "translation": "으…… 으으…… 만천의 별하늘 따위, 정말\n싫어—!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,0,0",
        "voice": "GA107013,3"
      },
      "original": "……敵が退却していきます……。\n",
      "translation": "……적이 퇴각하고 있습니다……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "009",
        "face": "251,254,0,0",
        "voice": "GA107014,3"
      },
      "original": "……あの敵に、ちょっとだけ同情してもいいじゃ\nろうか。\n",
      "translation": "……저 적에게, 조금은 동정해도 괜찮을까\n싶구나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,254,0,224",
        "voice": "GA107015,3"
      },
      "original": "見事なまでに叩きつぶされましたからね。\n物理的にも、精神的にも。\n",
      "translation": "보기 좋게 짓눌려 버렸으니까요. 물리적으로도,\n정신적으로도.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,254,0,224",
        "voice": "GA107015,3"
      },
      "original": "ま、何はともあれ、オレたちの勝利だ。\nよかったよかった。\nみんな、もう帰還してくれていいぞ。\n",
      "translation": "뭐, 어쨌든 우리들의 승리다. 다행이야,\n다행이야. 모두, 이제 귀환해도 좋다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,0,223",
        "voice": "GA107016,3"
      },
      "original": "報告によると、エルシオールの修理が終わるには、\nまだ時間がかかるようだ。\n機関部にもダメージを受けているらしい。\n",
      "translation": "보고에 따르면, 에르시올의 수리가 끝나려면,\n아직 시간이 걸릴 모양이다. 기관부에도\n데미지를 입은 것 같더군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "009",
        "face": "251,254,0,223",
        "voice": "GA107017,3"
      },
      "original": "ここまで逃げてくる間にも、何度か攻撃を受けた\nからのう。\nしかし、ここに留まっているのも危険じゃな。\n",
      "translation": "여기까지 도망쳐 오는 동안에도, 몇 번인가\n공격을 받았 구먼. 하지만, 여기에 머물러\n있는 것도 위험하겠어.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,337",
        "voice": "GA107018,3"
      },
      "original": "ですが、さっきの戦闘で被害を受けなかったので、\n修理も意外と早く終わるかもしれません。\nありがとうございました、マイヤーズ司令！\n",
      "translation": "하지만, 아까의 전투에서 피해를 입지 않았기\n에 , 수리도 의외로 빨리 끝날지도 모릅니다.\n감사합니다, 마이어스 사령관님!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0020",
      "channel": 1,
      "context": {
        "voice": "GA107018,3",
        "speaker": "001",
        "face": "002,0,0,337"
      },
      "original": "いやぁ、なんのなんの。\nエンジェル隊ががんばってくれたおかげだよ。\n",
      "translation": "아니야, 별거 아니야. 엔젤대가 열심히 해준\n덕분이지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,336",
        "voice": "GA107019,3"
      },
      "original": "さっきの戦闘で、また被害が増えましたしね……。\n戦いだから、しかたないですけど……。\n",
      "translation": "아까의 전투로, 또 피해가 늘었으니까요……\n전투니까, 어쩔 수 없지만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,336",
        "voice": "GA107020,3"
      },
      "original": "あと少しで、修理どころの話じゃなくなるところ\nでしたけれどね……。\nマイヤーズ司令、これから先、大丈夫ですか？\n",
      "translation": "조금만 더 했으면, 수리 수준의 문제가 아니게\n될 뻔 했습니다만…… 마이어스 사령관님,\n앞으로 괜찮을까요?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0023",
      "channel": 1,
      "context": {
        "face": "004,0,0,336",
        "speaker": "001",
        "voice": "GA107020,3"
      },
      "original": "うう……ちょっと判断を間違えたよ。\n今度また戦いがあるようだったら、そのときは、\nこの艦が被害を受けないようにがんばるから。\n",
      "translation": "으으…… 조금 판단을 잘못했어. 다음에 또\n전투가 있을 것 같다면, 그때는, 이 함선이\n피해를 입지 않도록 노력할게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GA107021,3"
      },
      "original": "ともかく、修理が必要なことに変わりはない。\nなるべく速やかに応急処置をして、こことは別の\nアステロイド帯に避難しよう。\n",
      "translation": "어쨌든, 수리가 필요한 건 변함없다. 가급적\n신속하게 응급처치를 하고, 이곳과는 다른\n아스테로이드대에 피난하자.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,221,0",
        "voice": "GA107021,3"
      },
      "original": "そうだな、本格的な修理はそれからだ。\nクリオム星系駐留艦隊の人員も使って、応急処置\nを急ぐように通達してくれ。\n",
      "translation": "그렇군, 본격적인 수리는 그 다음이다. 크리옴\n성계 주둔 함대의 인원도 동원해서, 응급처치\n를 서두르도록 통지해 줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,181,0",
        "voice": "GA107022,3"
      },
      "original": "……エンジェル隊、帰艦しました。\n",
      "translation": "……엔젤대, 귀환했습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0027",
      "channel": 1,
      "context": {
        "face": "001,0,181,0",
        "voice": "GA107022,3",
        "speaker": "001"
      },
      "original": "ああ、みんな。\nお疲れさま。\nおかげで無事に勝てたよ。\n",
      "translation": "아아, 모두들. 수고했어. 덕분에 무사히\n이겼어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,181,0",
        "voice": "GA107023,3"
      },
      "original": "……お役に立てて、光栄です。\n",
      "translation": "……도움이 되어 영광입니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,181,0",
        "voice": "GA107024,3"
      },
      "original": "……エルシオールが無事で、何よりでした……。\n",
      "translation": "……에르시올이 무사해서 정말로 다행입니다……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,186,0",
        "voice": "GA107025,3"
      },
      "original": "……次は……もっと早い段階での修理命令を希望\nします……。\n",
      "translation": "……다음은…… 좀 더 이른 단계에서의 수리\n명령을 희망 합니다……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0031",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,186,0",
        "voice": "GA107025,3"
      },
      "original": "あ、ごめん……。\n次は、もっと早く指示を出すよ。\n",
      "translation": "아, 미안…… 다음에는, 좀 더 빨리 지시를\n내릴게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0032",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,142,0",
        "voice": "GA107026,3"
      },
      "original": "上出来だよ、マイヤーズ司令！\nお前さん、もう戦い方に慣れてきたようだね。\n",
      "translation": "훌륭해, 마이어스 사령관! 자네, 이제 싸우는\n법에 익숙해진 모양이군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,141,0",
        "voice": "GA107027,3"
      },
      "original": "まだ指揮のしかたに慣れてないようだね、司令官\nどの。\nまぁ、焦らずゆっくり覚えていきなよ。\n",
      "translation": "아직 지휘하는 법에 익숙해지지 않은 모양이네,\n사령관 님. 뭐, 서두르지 말고 천천히 익혀\n나가라고.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0034",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,173,0",
        "voice": "GA107028,3"
      },
      "original": "司令官どの、どこ見てたんだい？\nお前さんが修理させてくれなかったから、ひどい\n目にあったよ。\n",
      "translation": "사령관님, 어디 보고 있었던 거야? 자네가\n수리하게 해주지 않아서, 끔찍한 꼴을 당했다\n고 .\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0035",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,173,0",
        "voice": "GA107028,3"
      },
      "original": "いやぁ、ちょっと気を抜いたスキに……。\n申し訳ない。\n",
      "translation": "아니, 잠깐 방심한 사이에…… 미안해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0036",
      "channel": 1,
      "context": {
        "voice": "GA107029,3",
        "speaker": "003",
        "face": "061,0,088,0"
      },
      "original": "アタシはぜんぜん疲れてないわよ。\nむしろ、スカッとしたわ！\nなかなかやるじゃない、マイヤーズ司令。\n",
      "translation": "난 전혀 지치지 않았어. 오히려 상쾌해!\n제법인데, 마이어스 사령관.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0037",
      "channel": 1,
      "context": {
        "voice": "GA107030,3",
        "speaker": "003",
        "face": "061,0,069,0"
      },
      "original": "個人的には、ちょっと物足りないわね。\nまぁ、こんなもんかな。\n",
      "translation": "개인적으로는, 좀 아쉬워. 뭐, 이 정도인가.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,072,0",
        "voice": "GA107031,3"
      },
      "original": "何がお疲れさまよ！\nアンタの指揮のおかげで、カンフーファイターが\n壊されちゃったじゃない！\n",
      "translation": "수고하긴 무슨! 당신의 지휘 덕분에, 쿵푸\n파이터가 부서져 버렸잖아!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0039",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,072,0",
        "voice": "GA107031,3"
      },
      "original": "ご、ごめん。\nまだ、君たちの指揮に慣れてなくて……。\n",
      "translation": "미, 미안. 아직, 너희들의 지휘에 익숙하지\n않아서……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0040",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,102,0",
        "voice": "GA107032,3"
      },
      "original": "マイヤーズ司令官を信じて正解でした。\n期待した通りのかたでしたわ。\n",
      "translation": "마이어스 사령관님을 믿길 잘했습니다. 기대한\n대로의 분이셨어요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0041",
      "channel": 1,
      "context": {
        "voice": "GA107033,3",
        "speaker": "004",
        "face": "101,0,101,0"
      },
      "original": "お疲れさまですわ、マイヤーズ司令。\n適切な指示をいただき、助かりました。\n",
      "translation": "수고하셨습니다, 마이어스 사령관. 적절한\n지시를 내려주셔서, 도움이 되었습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0042",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,102,0",
        "voice": "GA107034,3"
      },
      "original": "もう少し、指揮のしかたに慣れてくださいませ。\n戦闘のたびに大破するのは、少し困りますわ。\n",
      "translation": "조금 더, 지휘하는 법에 익숙해지도록 하세요.\n전투 때마다 대파되는 건, 조금 곤란하답니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0043",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,102,0",
        "voice": "GA107034,3"
      },
      "original": "わかった、がんばるよ。\n修理が遅れて、迷惑かけちゃったね……。\n",
      "translation": "알았어, 노력할게. 수리가 늦어져서, 폐를\n끼쳤네……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0044",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,046,0",
        "voice": "GA107035,3"
      },
      "original": "マイヤーズ司令の指揮のおかげで、自分でも驚く\nぐらいうまく戦えました！\nありがとうございます、マイヤーズ司令！\n",
      "translation": "마이어스 사령의 지휘 덕분에, 저 스스로도\n놀랄 정도로 잘 싸울 수 있었습니다! 감사합니\n다, 마이어스 사령!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0045",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,046,0",
        "voice": "GA107035,3"
      },
      "original": "いや、みんなが無事でよかったよ。\nお疲れさま。\n",
      "translation": "아니, 모두 무사해서 다행이야. 수고했어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0046",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,046,0",
        "voice": "GA107035,3"
      },
      "original": "……ああ、そうだ。\nひとつ言い忘れてたんだけど。\n",
      "translation": "……아아, 맞다. 한 가지 말하는 걸 잊었는데.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0047",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,022,0",
        "voice": "GA107036,3"
      },
      "original": "勝てましたね、マイヤーズ司令！\nこれなら、この先もうまくいけそうな気がします。\n",
      "translation": "이겼네요, 마이어스 사령관님! 이 정도라면,\n앞으로도 잘 풀릴 것 같은 기분이 듭니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0048",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,022,0",
        "voice": "GA107036,3"
      },
      "original": "勝てたのは、みんなのおかげだよ。\n本当にお疲れさま。\n",
      "translation": "이길 수 있었던 건, 모두 덕분이야. 정말\n수고했어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0049",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,022,0",
        "voice": "GA107036,3"
      },
      "original": "……ああ、そうだ。\nひとつ言い忘れてたんだけど。\n",
      "translation": "……아, 맞다. 하나 말하는 걸 잊었었는데.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0050",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,028,0",
        "voice": "GA107037,3"
      },
      "original": "マイヤーズ司令、もっと早く修理させてください。\nあたし、大変だったんですからね？\n",
      "translation": "마이어스 사령관님, 좀 더 빨리 수리하게 해\n주세요. 저, 정말 힘들었단 말이에요?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0051",
      "channel": 1,
      "context": {
        "face": "004,0,028,0",
        "voice": "GA107037,3",
        "speaker": "001"
      },
      "original": "すまない、今度からは気をつけるよ……。\n",
      "translation": "미안해, 다음부터는 조심할게……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0052",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,028,0",
        "voice": "GA107037,3"
      },
      "original": "……ああ、そうだ。\nひとつ言い忘れてたんだけど。\n",
      "translation": "……아, 맞다. 하나 말하는 걸 잊었었는데.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0053",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,026,0",
        "voice": "GA107038,3"
      },
      "original": "はい、何ですか？\n",
      "translation": "네, 무엇인가요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0054",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,026,0",
        "voice": "GA107038,3"
      },
      "original": "戦闘が終わったら、オレのことはタクトでいいよ。\n長い呼ばれ方って、どうも苦手なんだ。\n",
      "translation": "전투가 끝나면, 나는 택트로 불러도 좋아. 긴\n이름은 아무래도 좀 서툴러서 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0055",
      "channel": 1,
      "context": {
        "voice": "GA107038,3",
        "speaker": "001",
        "face": "002,0,026,0"
      },
      "original": "そのかわり、オレも君のことをミルフィーユって\n呼んでいいかな？\n",
      "translation": "그 대신, 나도 너를 밀피유라고 불러도 될까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0056",
      "channel": 1,
      "context": {
        "face": "021,0,022,0",
        "speaker": "002",
        "voice": "GA107039,3"
      },
      "original": "はい！\nもちろんです、タクトさん。\n",
      "translation": "네! 물론이죠, 택트 씨.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0057",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,046,0",
        "voice": "GA107040,3"
      },
      "original": "それから、あたしのことはミルフィーでいいです。\n",
      "translation": "그리고, 저는 밀피라고 불러주세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0058",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,046,0",
        "voice": "GA107040,3"
      },
      "original": "わかったよ、ミルフィー。\n",
      "translation": "알았어, 밀피.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0059",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,173,0,0",
        "voice": "GA107041,3"
      },
      "original": "おや、名前で呼び合うのはミルフィーとだけかい？\n妬けるねぇ。\n",
      "translation": "어라, 이름으로 부르는 건 밀피뿐인가? 질투\n나는걸.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0060",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,173,0,0",
        "voice": "GA107041,3"
      },
      "original": "とんでもない。\nみんなも、オレを名前で呼んでくれていいよ。\n",
      "translation": "천만의 말씀. 다들 나를 이름으로 불러줘도\n좋아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0061",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,142,0,0",
        "voice": "GA107042,3"
      },
      "original": "そんじゃ、あたしもそうさせてもらおうか。\nあたしのことも、フォルテでいいよ。\n",
      "translation": "그럼, 나도 그렇게 해도 될까? 나도 포르테라고\n불러줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0062",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,142,0,102",
        "voice": "GA107043,3"
      },
      "original": "タクトさん、でよろしいかしら？\n司令官を名前で呼ぶなんて、何だか照れますわね。\n私のことは、ミントとお呼びください。\n",
      "translation": "택트 씨, 라고 불러도 괜찮을까요? 사령관님을\n이름으로 부르다니, 왠지 쑥스럽네요. 저를는\n민트라고 불러주세요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0063",
      "channel": 1,
      "context": {
        "face": "061,0,0,062",
        "speaker": "003",
        "voice": "GA107044,3"
      },
      "original": "どうしてもって言うんなら、しょうがないわね。\nタクトって呼ぶから、あたしのこともランファっ\nて呼んでちょうだい。\n",
      "translation": "정 그렇다면 어쩔 수 없네. 택트라고 부를\n거라면, 나도 란파라고 불러줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0064",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,185,0,062",
        "voice": "GA107045,3"
      },
      "original": "……ヴァニラで結構です、タクトさん。\n",
      "translation": "……바닐라로 충분합니다, 택트 씨.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0065",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,0,224",
        "voice": "GA107046,3"
      },
      "original": "あーあ、タクトのやつ、さっそく女の子を口説き\nにかかってやがる。\nしかも、一度に５人も。\n",
      "translation": "아-아, 택트 녀석, 벌써 여자애들을 꼬시려고\n드는구먼. 게다가 한꺼번에 다섯 명이나\n말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0066",
      "channel": 1,
      "context": {
        "face": "251,253,0,223",
        "voice": "GA107047,3",
        "speaker": "009"
      },
      "original": "まぁ、そういうところもひっくるめて、タクトに\n白羽の矢を立てたんじゃが……。\n予想以上の順応ぶりじゃわい。\n",
      "translation": "뭐, 그런 점까지 포함해서 택트에게 기대를\n걸어본 것이지만…… 예상 이상의 적응력이로\n구나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0067",
      "channel": 1,
      "context": {
        "voice": "GA107047,3",
        "speaker": "001",
        "face": "002,253,0,223"
      },
      "original": "いやぁ、女の子に立て続けに名前を呼ばれるって、\n何だかいいな～。\n幸せだなぁ～。\n",
      "translation": "이야～ 여자애들에게 연달아 이름으로 불리다\n니, 왠지 기분 좋은걸～. 행복하다～～\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0068",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,253,0,224",
        "voice": "GA107048,3"
      },
      "original": "ルフト先生……タクトを選んだこと、本当に後悔\nしてませんか？\n",
      "translation": "루프트 선생님…… 택트를 선택한 것, 정말로\n후회 하고 있지 않나요?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0069",
      "channel": 1,
      "context": {
        "speaker": "009",
        "face": "251,254,0,224",
        "voice": "GA107049,3"
      },
      "original": "……ノーコメントにしておいてくれ。\n本当に大丈夫じゃろうか、この先。\n",
      "translation": "……노코멘트로 해두게. 정말로 괜찮은 걸까,\n앞으로의 일은.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0000e800:dialogue:0070",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA107049,3"
      },
      "original": "ま、そのうち何とかなるでしょう！\n",
      "translation": "뭐, 조만간 어떻게든 되겠지!\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
