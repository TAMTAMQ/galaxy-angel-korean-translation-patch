{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000ca000.txt",
    "encoding": "cp932",
    "sha256": "66176d0051afb0ff6a950c5327b2aee6c3e2338db8a5a116e95d857c8e6fbe3e",
    "dialogue_count": 24
  },
  "units": [
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0001",
      "channel": 1,
      "context": {
        "face": "058,0,0,0",
        "speaker": "002",
        "voice": "GAF23001,3"
      },
      "original": "あ～あ、バスが行っちゃった。\nタッチの差だったのになぁ。\n次のバスが来るのは……。\n",
      "translation": "아～아, 버스가 가버렸어. 간발의 차이였는데\n말이야. 다음 버스가 오는 건……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0002",
      "channel": 1,
      "context": {
        "face": "056,0,0,0",
        "speaker": "002",
        "voice": "GAF23002,3"
      },
      "original": "えーっ、３時間後！？\nツイてないなぁ……。\n",
      "translation": "뭐, 3시간 후!? 운도 없지……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0003",
      "channel": 1,
      "context": {
        "face": "058,0,0,0",
        "speaker": "002",
        "voice": "GAF23003,3"
      },
      "original": "……って、そうか。\nもう、ツイてるツイてないは関係ないのよね。\n",
      "translation": "……아니, 그렇구나. 이제 운이 있고 없고는\n상관없는 거였지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0004",
      "channel": 1,
      "context": {
        "face": "058,0,0,0",
        "speaker": "002",
        "voice": "GAF23020,3"
      },
      "original": "……はぁ……。\nタクトさんは……今ごろ、どうしてるのかな……？\n",
      "translation": "……하아…… 택트 씨는…… 지금쯤 어떻게\n하고 있을까……?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0005",
      "channel": 1,
      "context": {
        "face": "058,0,0,0",
        "speaker": "002",
        "voice": "GAF23021,3"
      },
      "original": "……うん……。\nさて、と。\nバスが来るまで、お茶でも飲んでようっと。\n",
      "translation": "……응…… 자, 그럼. 버스가 올 때까지,\n차라도 마시고 있어야지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0006",
      "channel": 1,
      "context": {
        "face": "0,0,0,0",
        "speaker": "094",
        "voice": "GAF23021,3"
      },
      "original": "そこの、きれいなお嬢さん。\nお茶しない？\n",
      "translation": "거기, 예쁜 아가씨. 차 한잔 안 할래?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0007",
      "channel": 1,
      "context": {
        "face": "056,0,0,0",
        "speaker": "002",
        "voice": "GAF23005,3"
      },
      "original": "えっ……！？\n",
      "translation": "어……!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0008",
      "channel": 1,
      "context": {
        "face": "013,0,0,0",
        "speaker": "001",
        "voice": "GAF23005,3"
      },
      "original": "やあ、ミルフィー。\nひさしぶり。\n",
      "translation": "안녕, 밀피. 오랜만이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0009",
      "channel": 1,
      "context": {
        "face": "056,0,0,0",
        "speaker": "002",
        "voice": "GAF23006,3"
      },
      "original": "た、タクトさん……！\nどうして！？\n",
      "translation": "택트 씨……! 어떻게 된 거예요!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "013,0,0,0",
        "voice": "GAF23006,3"
      },
      "original": "オレ、軍を除隊したんだ。\n",
      "translation": "나, 군대에서 제대했어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "056,0,0,0",
        "voice": "GAF23007,3"
      },
      "original": "ええっ！？\n",
      "translation": "뭐라고요!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0012",
      "channel": 1,
      "context": {
        "face": "013,0,0,0",
        "voice": "GAF23007,3",
        "speaker": "001"
      },
      "original": "ねぇ、ミルフィー。\n前に、またピクニックに行こうって約束したよね？\n",
      "translation": "있지, 밀피. 전에, 다시 피크닉 가자고\n약속했었지?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0013",
      "channel": 1,
      "context": {
        "voice": "GAF23008,3",
        "speaker": "002",
        "face": "056,0,0,0"
      },
      "original": "は、はい……。\n",
      "translation": "네, 네……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "013,0,0,0",
        "voice": "GAF23008,3"
      },
      "original": "あの約束は、まだ有効かな？\n",
      "translation": "그 약속 아직 유효할까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "056,0,0,0",
        "voice": "GAF23009,3"
      },
      "original": "え……？\n",
      "translation": "네……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0016",
      "channel": 1,
      "context": {
        "face": "013,0,0,0",
        "voice": "GAF23009,3",
        "speaker": "001"
      },
      "original": "オレ、これからは、どこかで平穏な生活をしよう\nと思ってるんだ。\n",
      "translation": "나, 이제부터는 어딘가에서 평온하게\n살려고 해.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "013,0,0,0",
        "voice": "GAF23009,3"
      },
      "original": "そう……のどかな場所で、誰かと毎日ピクニック\nできるような生活を……ね。\n",
      "translation": "그래…… 한적한 곳에서 누군가와 매일\n피크닉을 할 수 있는 삶을…… 말이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "056,0,0,0",
        "voice": "GAF23010,3"
      },
      "original": "タクトさん……！\n",
      "translation": "택트 씨……!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "014,0,0,0",
        "voice": "GAF23010,3"
      },
      "original": "というわけで……どう？\nオレとピクニックに行かない？\n",
      "translation": "그래서…… 어때? 나랑 피크닉 가지 않을래?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "054,0,0,0",
        "voice": "GAF23011,3"
      },
      "original": "……はい！\n",
      "translation": "……네!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0021",
      "channel": 1,
      "context": {
        "face": "054,0,0,0",
        "voice": "GAF23012,3",
        "speaker": "002"
      },
      "original": "もちろんです。\n行きます、あたし！\n",
      "translation": "물론이죠. 저, 갈게요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "014,0,0,0",
        "voice": "GAF23012,3"
      },
      "original": "よかったぁ。\nありがとう、ミルフィー。\n",
      "translation": "다행이다. 고마워, 밀피.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0023",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "013,0,0,0",
        "voice": "GAF23012,3"
      },
      "original": "それじゃ、行こうか。\nオレたちだけのピクニックに。\n",
      "translation": "그럼 갈까. 우리 둘만의 피크닉으로.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000ca000:dialogue:0024",
      "channel": 1,
      "context": {
        "face": "054,0,0,0",
        "speaker": "002",
        "voice": "GAF23013,3"
      },
      "original": "はい！\nどこまでもついて行きます！\n",
      "translation": "네! 어디까지든 따라갈게요!\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
