{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_0008c000.txt",
    "encoding": "cp932",
    "sha256": "c7006652f79d77ca0a8a7b319967e79a6aa11b307fcf7d51954fb77ea57df05b",
    "dialogue_count": 109
  },
  "units": [
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,181,0",
        "voice": "GA602001,3"
      },
      "original": "……乗組員の集合、完了しました。\n",
      "translation": "……승무원 집결, 완료했습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,181,0",
        "voice": "GA602001,3"
      },
      "original": "ありがとう、ヴァニラ。\nいやー、みんな楽しそうだなぁ。\n",
      "translation": "고마워, 바닐라. 아니ー 다들 즐거워 보이네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,022,0",
        "voice": "GA602002,3"
      },
      "original": "みなさーん、飲み物は行き渡りましたかー？\nそれでは乗組員を代表して、司令官のタクトさん\nから、ひと言どうぞ！\n",
      "translation": "여러분ー 음료는 다 돌았나요ー? 그럼 승무원을\n대표해서, 사령관인 택트 씨 께서 한 말씀\n부탁드립니다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA602002,3"
      },
      "original": "えー、ゴホン。\n本日はお忙しいところを、たくさんお集まりいた\nだき……。\n",
      "translation": "에ー, 흠흠. 오늘은 바쁘신 와중에 많이들\n모여주셔서……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,166,0,0",
        "voice": "GA602003,3"
      },
      "original": "ごたくはいいから、早くしろ～い。\n",
      "translation": "사설은 됐으니까, 빨리 해～.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA602003,3"
      },
      "original": "……というわけで、中略。\n今夜は無礼講だ！\nカンパーイ！\n",
      "translation": "……라는 이유로, 중략. 오늘 밤은 격식 없이\n즐기자! 건배!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "099",
        "face": "0,0,0,0",
        "voice": "GA602004,3"
      },
      "original": "カンパーイ！！\n",
      "translation": "건배!!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "022,0,0,0",
        "voice": "GA602005,3"
      },
      "original": "うわぁ、きれい！\n",
      "translation": "우와아, 예쁘다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "087,0,0,0",
        "voice": "GA602006,3"
      },
      "original": "ほんと、ほんと。\nお花見ってのも、なかなかいいもんじゃない。\n",
      "translation": "정말, 정말로. 꽃구경이라는 것도, 제법\n괜찮은 법이군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "122,0,0,0",
        "voice": "GA602007,3"
      },
      "original": "夜に見るお花というのも、風情がありますわね。\n",
      "translation": "밤에 보는 꽃 또한, 운치가 있군요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,0,0",
        "voice": "GA602008,3"
      },
      "original": "フォルテさん……飲み物のおかわりをどうぞ。\n",
      "translation": "포르테 씨…… 음료 리필 드릴게요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0012",
      "channel": 1,
      "context": {
        "voice": "GA602009,3",
        "speaker": "005",
        "face": "174,0,0,0"
      },
      "original": "おっ、ありがと。\nさてと、そんじゃミルフィーの弁当をいただくと\nしようかね。\n",
      "translation": "오, 고마워. 자 그럼 밀피의 도시락을\n먹어 볼까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "022,0,0,0",
        "voice": "GA602010,3"
      },
      "original": "はい、たくさん食べてくださいね！\n",
      "translation": "네, 많이 드세요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "102,0,0,0",
        "voice": "GA602011,3"
      },
      "original": "いただきますわ。\nほかのみなさんも、お誘いしてまいりましょう。\n",
      "translation": "잘 먹겠습니다. 다른 분들도, 초대하러 가도록\n하죠.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GA602012,3"
      },
      "original": "ったく……何をやるのかと思えば、また宴会かよ。\nこの前も、やったばかりじゃねぇか。\n",
      "translation": "정말이지…… 뭘 하나 했더니 또 연회냐.\n얼마 전에도 한 지 얼마 안 됐잖아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,221,0",
        "voice": "GA602012,3"
      },
      "original": "あれはピクニック。\n今回のは、お花見。\n趣旨が違うということで。\n",
      "translation": "그건 피크닉. 이번 건, 꽃구경. 취지가\n다르다는 거지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,221,0",
        "voice": "GA602012,3"
      },
      "original": "それに、花の命は短いんだ。\n咲いているうちにやっておかないと、お花見じゃ\nなくなるだろ？\n",
      "translation": "게다가, 꽃의 생명은 짧아. 피어 있는 동안\n해두지 않으면, 꽃구경이 아니게 되잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA602013,3"
      },
      "original": "そりゃそうかもしれんが……。\nだからといって、こんなときにやらなくても。\n",
      "translation": "그건 그럴지도 모르지만…… 그렇다고 이런\n때에 할 필요는 없잖아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,223,0",
        "voice": "GA602013,3"
      },
      "original": "こんなときだからこそ、だよ。\n後ろに大きな作戦が控えているときだからこそ、\n息抜きできるときには、そうした方がいい。\n",
      "translation": "이런 때니까 하는 거야. 뒤에 큰 작전이\n기다리고 있을 때일수록, 숨을 돌릴 수 있을\n때는, 그렇게 하는 게 좋아.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0020",
      "channel": 1,
      "context": {
        "voice": "GA602014,3",
        "speaker": "005",
        "face": "141,141,223,0"
      },
      "original": "ちょいと。\nなーに男同士で、コソコソ話してるんだい？\n",
      "translation": "잠깐. 뭐야 남자들끼리, 소곤소곤 이야기하고\n있는 거야?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0021",
      "channel": 1,
      "context": {
        "voice": "GA602015,3",
        "speaker": "007",
        "face": "221,141,0,225"
      },
      "original": "別に、コソコソなんかしていない。\nあまりくっつくな。\n",
      "translation": "딱히, 소곤거리는 건 아니다. 너무 붙지 마라.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,102,0",
        "voice": "GA602016,3"
      },
      "original": "タクトさんたちも、楽しんでいらっしゃいますか？\n",
      "translation": "택트 씨 일행도, 즐기고 계신가요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0023",
      "channel": 1,
      "context": {
        "voice": "GA602017,3",
        "speaker": "003",
        "face": "061,088,0,0"
      },
      "original": "ねぇタクト、こっち来てゲームやらない？\n",
      "translation": "있지 택트, 이쪽으로 와서 게임 안 할래?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0024",
      "channel": 1,
      "context": {
        "voice": "GA602018,3",
        "speaker": "016",
        "face": "491,088,0,337"
      },
      "original": "あ、私も仲間に入れてください！\n",
      "translation": "아, 저도 끼워 주세요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,224,0",
        "voice": "GA602019,3"
      },
      "original": "いやー、タクト君、モテモテだねぇ。\nうらやましい限りだよ。\nじゃ、俺は失礼する。\n",
      "translation": "이야ー, 택트 군, 인기 많네. 부럽기 짝이\n없어. 그럼, 난 이만 실례할게.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "019",
        "face": "521,0,224,347",
        "voice": "GA602020,3"
      },
      "original": "なに言ってるんですか。\n副司令も一緒ですよ。\n",
      "translation": "무슨 말씀을 하시는 거예요. 부사령관도\n함께예요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,347",
        "voice": "GA602021,3"
      },
      "original": "え？\n",
      "translation": "에?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,0,342,0",
        "voice": "GA602022,3"
      },
      "original": "たまにはつきあってくださいよ。\nほらほら、グラスが空ですよ★\n",
      "translation": "가끔은 같이 놀아달라고요. 자, 자, 잔이\n비었어요★\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,225,0",
        "voice": "GA602023,3"
      },
      "original": "や、やめろ！\nわかったから、手を離せ！\n",
      "translation": "그, 그만해! 알았으니까, 손 놓으라고!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,225,0",
        "voice": "GA602023,3"
      },
      "original": "いやー、レスター君も、モテモテだねぇ。\n",
      "translation": "이야ー, 레스터 군도, 인기 많네.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0031",
      "channel": 1,
      "context": {
        "face": "102,0,102,0",
        "voice": "MIN03054,3",
        "speaker": "004"
      },
      "original": "みなさ～ん、\n私こういうものを持ってきたんですの。\n",
      "translation": "여러분～, 제가 이런 걸 가져왔답니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0032",
      "channel": 1,
      "context": {
        "face": "141,141,0,0",
        "voice": "GAPS034,3",
        "speaker": "005"
      },
      "original": "お？なんだい、そりゃ。\n",
      "translation": "오? 뭐야, 그건.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,141,0,061",
        "voice": "GAPS023,3"
      },
      "original": "へーぇ、なになに？\nこれは…フライングディスク？\n",
      "translation": "헤에ー, 뭐야 뭐야? 이건… 플라잉 디스크?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0034",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "022,022,0,061",
        "voice": "GAPS006,3"
      },
      "original": "こんなの初めて見るな～♪\n",
      "translation": "이런 건 처음 보네～♪\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0035",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,022,0,101",
        "voice": "MIN03055,3"
      },
      "original": "はい、実はこれ\n『宇宙フライングディスク』なんですの。\n",
      "translation": "네, 사실 이건 『우주 플라잉 디스크』랍니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0036",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,181,0,101",
        "voice": "GAPS038,3"
      },
      "original": "…最近発売された、ＡＩ搭載のニューモデルです。\n難易度調整や、オートリリース機能を搭載してい\nます。\n",
      "translation": "…최근 출시된 AI 탑재 신형 모델입니다.\n난이도 조절과 자동 투척 기능을 탑재하고\n있습니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0037",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,181,0,101",
        "voice": "GAPS038,3"
      },
      "original": "へーぇ、ヴァニラは物知りなんだね。\n",
      "translation": "헤에ー, 바닐라는 박학하네.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "102,181,0,102",
        "voice": "MIN03056,3"
      },
      "original": "ヴァニラさんのおっしゃるとおりですわ。\nこれは、最新型のフライングディスクなんです\nの。\n",
      "translation": "바닐라 씨의 말씀대로예요. 이것은, 최신형\n플라잉 디스크랍니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0039",
      "channel": 1,
      "context": {
        "voice": "MIN03057,3",
        "speaker": "004",
        "face": "102,0,102,0"
      },
      "original": "せっかくですから、\n皆さんも御一緒に遊びませんか？\n",
      "translation": "모처럼이니까, 여러분도 함께 놀지 않으실래요?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0040",
      "channel": 1,
      "context": {
        "voice": "GAPS035,3",
        "speaker": "005",
        "face": "142,0,142,0"
      },
      "original": "お、いいねぇ。やろうじゃないか！\n",
      "translation": "오, 좋네. 하자고!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0041",
      "channel": 1,
      "context": {
        "face": "022,0,022,0",
        "speaker": "002",
        "voice": "GAPS007,3"
      },
      "original": "わあ、私もやりたいですぅ～！\n",
      "translation": "와아, 저도 하고 싶어요～!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0042",
      "channel": 1,
      "context": {
        "voice": "GAPS036,3",
        "speaker": "005",
        "face": "146,0,147,0"
      },
      "original": "でも、こう暗くっちゃ、フライングディスクが\nうまく見えやしないよ。こまったねぇ…。\n",
      "translation": "하지만 이렇게 어두우면 플라잉 디스크가 잘\n보이지 않아. 곤란하네…\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0043",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "022,0,022,0",
        "voice": "GAPS008,3"
      },
      "original": "あ、そうだ～！ほんのちょっとの間だけ公園を\nお昼にしてもらいましょうよ～！そうすれば、\nみんなでフライングディスクできますよ～！\n",
      "translation": "아, 맞다～! 아주 잠깐만 공원을 낮으로\n바꿔버리자고요～! 그러면, 다 같이 플라잉\n디스크를 할 수 있어요～!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0044",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,022,0",
        "voice": "GAPS008,3"
      },
      "original": "夜を昼にぃ～～！？\n",
      "translation": "밤을 낮으로오～～!?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0045",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,021,0",
        "voice": "GAPS009,3"
      },
      "original": "ほら、はじめにご案内した時に言ったじゃない\nですか！ここの空や太陽は、全部バーチャル\nウィンドウに映されているって！\n",
      "translation": "봐요, 처음에 안내해 드릴 때 말했잖아요!\n이곳의 하늘과 태양은, 전부 버추얼 윈도우에\n비춰지고 있다고요!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0046",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,021,0",
        "voice": "GAPS009,3"
      },
      "original": "そ、そういえば、\nそんなコト言ってたっけなぁ…。\n",
      "translation": "그, 그러고 보니 그런 말을 했던가…\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0047",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "066,0,066,0",
        "voice": "GAPS024,3"
      },
      "original": "ミルフィー、\nアンタ、それちょっと強引じゃない？\n",
      "translation": "밀피, 너, 그거 좀 억지 아니야?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0048",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "102,0,102,0",
        "voice": "MIN03058,3"
      },
      "original": "あら、私はミルフィーさんに賛成ですわ。こんな\n最中にせっかく皆さんで集まったんですもの。\nちょっとだけワガママ言わせていただきましょう。\n",
      "translation": "어머, 저는 밀피 씨에게 찬성이에요. 이런\n와중에 모처럼 여러분이 모였는걸요. 조금만\n제멋대로 굴어도 괜찮겠죠.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0049",
      "channel": 1,
      "context": {
        "face": "181,0,181,0",
        "voice": "GAPS039,3",
        "speaker": "006"
      },
      "original": "…ニューモデルの性能に…\n興味がそそられます…。\n",
      "translation": "…뉴 모델의 성능에… 흥미가 생기네요…\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0050",
      "channel": 1,
      "context": {
        "face": "022,0,022,0",
        "voice": "GAPS010,3",
        "speaker": "002"
      },
      "original": "じゃ、決まりですね～！\nあたし頼んできま～す！\n",
      "translation": "그럼, 결정됐네요～! 제가 부탁하고 올게요～!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0051",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GAPS010,3"
      },
      "original": "うーん…さすがエンジェル隊だ…。\nおそるべし…！\n",
      "translation": "으음… 역시 엔젤대다… 두렵도다…!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0052",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,181,0",
        "voice": "GA602024,3"
      },
      "original": "……それでは、私はこれで……。\n",
      "translation": "……그럼, 저는 이만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0053",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,181,0",
        "voice": "GA602024,3"
      },
      "original": "あれ、ヴァニラ？\nもう行っちゃうの？\n",
      "translation": "어라, 바닐라? 벌써 가는 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0054",
      "channel": 1,
      "context": {
        "face": "181,0,185,0",
        "speaker": "006",
        "voice": "GA602025,3"
      },
      "original": "……はい。\nまだ、することが残っていますので。\n……失礼します。\n",
      "translation": "……네. 아직 해야 할 일이 남아서요.\n……실례하겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0055",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA602025,3"
      },
      "original": "あ、ヴァニラ……。\n",
      "translation": "아, 바닐라……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0056",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "087,0,0,0",
        "voice": "GA602026,3"
      },
      "original": "タクト！\n早くしないと、始めちゃうわよ？\n",
      "translation": "택트! 서두르지 않으면, 시작해 버린다?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0057",
      "channel": 1,
      "context": {
        "voice": "GA602026,3",
        "speaker": "001",
        "face": "012,0,0,0"
      },
      "original": "あ、ああ……。\n",
      "translation": "아, 아아……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0058",
      "channel": 1,
      "context": {
        "voice": "GA602026,3",
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "ふぅ～……。\nちょっと離れて、ひと息入れるか。\n",
      "translation": "후우～…… 잠시 떨어져서, 한숨 돌릴까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0059",
      "channel": 1,
      "context": {
        "voice": "GA602027,3",
        "speaker": "002",
        "face": "021,0,026,0"
      },
      "original": "あ、タクトさん。\nどうしたんですか？\n",
      "translation": "아, 택트 씨. 무슨 일인가요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0060",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,026,0",
        "voice": "GA602027,3"
      },
      "original": "いや、ちょっと騒ぎ疲れたんで、ひと休みしよう\nかと思ってね。\n",
      "translation": "아니, 좀 떠들다 지쳐서 한숨 돌릴까 싶어서\n말이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0061",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,024,0",
        "voice": "GA602028,3"
      },
      "original": "あの……だったら、こちらに来ませんか？\nお花がよく見える場所を見つけたんです。\n",
      "translation": "저기…… 그렇다면, 이쪽으로 오지 않으실래요?\n꽃이 잘 보이는 장소를 발견했거든요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0062",
      "channel": 1,
      "context": {
        "voice": "GA602028,3",
        "speaker": "001",
        "face": "006,0,024,0"
      },
      "original": "あ、そうなのかい？\nえーと……。\n",
      "translation": "아, 그래? 음……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0063",
      "channel": 1,
      "context": {
        "voice": "GA602028,3",
        "speaker": "001",
        "face": "001,0,024,0"
      },
      "original": "じゃあ、一緒に見ようか。\n",
      "translation": "그럼, 같이 볼까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0064",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,022,0",
        "voice": "GA602029,3"
      },
      "original": "はい！\nこっちです！\n",
      "translation": "네! 이쪽이에요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0065",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,0,0",
        "voice": "GA602030,3"
      },
      "original": "どうです？\nすごくいい場所でしょう？\n",
      "translation": "어때요? 정말 좋은 장소죠?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0066",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA602030,3"
      },
      "original": "本当だね。\nここからなら、満開の花がよく見えるよ。\n",
      "translation": "정말이네. 여기서라면, 만개한 꽃이 잘 보여.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0067",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,0,0",
        "voice": "GA602031,3"
      },
      "original": "今のうちに、じっくり見ておきましょう。\n次に咲くのは、１００年後ですから。\n",
      "translation": "지금 볼 수 있을 때 찬찬히 봐 두죠. 다음에\n피는 건 100년 후니까요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0068",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,0,0",
        "voice": "GA602032,3"
      },
      "original": "知ってます？\nこのカフカフの木の樹齢って、およそ１０００年\nなんだそうですよ。\n",
      "translation": "알고 계세요? 이 카프카프 나무의 수령은\n대략 1000년이라고 하더라고요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0069",
      "channel": 1,
      "context": {
        "face": "007,0,0,0",
        "voice": "GA602032,3",
        "speaker": "001"
      },
      "original": "１０００年も前の木なの！？\n想像しただけで、気が遠くなるような時間だなぁ。\n",
      "translation": "1000년 전의 나무라고!? 상상하는 것만으로도,\n아득해지는 시간이다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0070",
      "channel": 1,
      "context": {
        "face": "021,0,0,0",
        "speaker": "002",
        "voice": "GA602033,3"
      },
      "original": "時空震よりも前の時代を知っているんですよね。\n昔の人たちも、こんな風にお花の下で宴会をした\nのかなぁ。\n",
      "translation": "시공진보다 이전 시대를 알고 있는 거네요.\n옛날 사람들도, 이런 식으로 꽃 아래에서\n연회를 했을까요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0071",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA602033,3"
      },
      "original": "そうかもね。\n……もっとも、オレたち以外、もう誰も花なんて\n見てないみたいだけど。\n",
      "translation": "그럴지도 모르겠네. ……다만, 우리 말고는,\n이제 아무도 꽃 같은 건 보고 있지 않은 것\n같지만.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0072",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "022,0,0,0",
        "voice": "GA602034,3"
      },
      "original": "楽しければ、いいじゃないですか。\nお花は、そのためのきっかけなんです。\n",
      "translation": "즐거우면, 됐잖아요. 꽃은, 그것을 위한\n계기인 거예요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0073",
      "channel": 1,
      "context": {
        "voice": "GA602034,3",
        "face": "001,0,0,0",
        "speaker": "001"
      },
      "original": "まぁ、それもそうだな。\n",
      "translation": "뭐, 그것도 그렇네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0074",
      "channel": 1,
      "context": {
        "face": "021,0,0,0",
        "speaker": "002",
        "voice": "GA602035,3"
      },
      "original": "……ねぇ、タクトさん。\nお花って不思議ですね。\n",
      "translation": "……있잖아요, 택트 씨. 꽃이란 건 신기하네요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0075",
      "channel": 1,
      "context": {
        "face": "006,0,0,0",
        "speaker": "001",
        "voice": "GA602035,3"
      },
      "original": "不思議って？\n",
      "translation": "신기하다니?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0076",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,0,0",
        "voice": "GA602036,3"
      },
      "original": "たった一輪でも、そこに咲いているのを見ただけ\nで、心がぱあっと明るくなります。\nそういうのって、なんだかステキですよね。\n",
      "translation": "단 한 송이라도, 그곳에 피어 있는 걸 보는\n것만으로도 마음이 환하게 밝아져요. 그런 건\n왠지 멋진 일이죠.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0077",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "speaker": "001",
        "voice": "GA602036,3"
      },
      "original": "うん。\nそういや、ミルフィーもそうだね。\n",
      "translation": "응. 그러고 보니, 밀피도 그렇네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0078",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "026,0,0,0",
        "voice": "GA602037,3"
      },
      "original": "え？\n",
      "translation": "에?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0079",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA602037,3"
      },
      "original": "ギスギスしてるときでも、ミルフィーがいるだけ\nで、まわりの空気がやわらかくなる。\n心が明るくなるんだ。\n",
      "translation": "험악한 분위기일 때라도, 밀피가 있는\n것만으로도 주변 공기가 부드러워져. 마음이\n밝아진다고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0080",
      "channel": 1,
      "context": {
        "face": "024,0,0,0",
        "speaker": "002",
        "voice": "GA602038,3"
      },
      "original": "そ、そんなこと、ないですよ。\n",
      "translation": "그, 그런 거, 아니에요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0081",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA602038,3"
      },
      "original": "そんなことあるよ。\nミルフィーは、不思議な力を持ってると思う。\n",
      "translation": "그런 일 있어. 밀피는 신기한 힘을 가지고\n있다고 생각해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0082",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "024,0,0,0",
        "voice": "GA602039,3"
      },
      "original": "そ、それは……その……。\nタクトさんだって、そうですよ。\n",
      "translation": "그, 그건…… 그게…… 택트 씨도 그래요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0083",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA602039,3"
      },
      "original": "オレが？\n",
      "translation": "내가?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0084",
      "channel": 1,
      "context": {
        "voice": "GA602040,3",
        "speaker": "002",
        "face": "021,0,0,0"
      },
      "original": "はい。\n戦いのときも、タクトさんが指示を出してくれて\nいると、安心して戦えますもの。\n",
      "translation": "네. 전투 때도, 택트 씨가 지시를 내려주고\n있으면 안심하고 싸울 수 있는걸요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0085",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "049,0,0,0",
        "voice": "GA602041,3"
      },
      "original": "ちょうど、この大きな木みたいに、そばにいると\n安心するっていうか……。\n",
      "translation": "마치 이 커다란 나무처럼, 곁에 있으면\n안심된다고 해야 할까……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0086",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "008,0,0,0",
        "voice": "GA602041,3"
      },
      "original": "ミルフィー……。\n",
      "translation": "밀피……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0087",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "024,0,0,0",
        "voice": "GA602042,3"
      },
      "original": "それだけじゃなくて、タクトさんと一緒にいると、\n楽しいし……。\nだから、あたし、えーっと……。\n",
      "translation": "그것뿐만 아니라, 택트 씨와 함께 있으면,\n즐겁고…… 그래서 저, 그러니까……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0088",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "008,0,0,0",
        "voice": "GA602042,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0089",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "023,0,0,0",
        "voice": "GA602043,3"
      },
      "original": "えーっと、ですね……。\nやだ……なに言ってんだろ、あたし……。\n",
      "translation": "저기, 그러니까…… 싫다…… 나 무슨 말을\n하는 거야……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0090",
      "channel": 1,
      "context": {
        "voice": "GA602043,3",
        "speaker": "001",
        "face": "008,0,0,0"
      },
      "original": "……ありがとう、ミルフィー。\nオレも同じ気持ちだよ。\n",
      "translation": "……고마워, 밀피. 나도 같은 마음이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0091",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "024,0,0,0",
        "voice": "GA602044,3"
      },
      "original": "タクトさん……。\n",
      "translation": "택트 씨……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0092",
      "channel": 1,
      "context": {
        "speaker": "026",
        "face": "601,366,0,0",
        "voice": "GA602045,3"
      },
      "original": "あ、見つけた！\nいなくなったと思ったら、こんなところにいたの\nね？\n",
      "translation": "아, 찾았다! 없어진 줄 알았더니, 이런 곳에\n있었네?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0093",
      "channel": 1,
      "context": {
        "voice": "GA602046,3",
        "speaker": "016",
        "face": "491,366,0,337"
      },
      "original": "向こうで、カラオケ大会をやってるんですよ。\n司令も１曲、いかがですか？\n",
      "translation": "저쪽에서 노래방 대회를 하고 있어요. 사령관\n도 한 곡, 어떠신가요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0094",
      "channel": 1,
      "context": {
        "face": "012,366,0,337",
        "speaker": "001",
        "voice": "GA602046,3"
      },
      "original": "あ、いやぁ……。\n悪いけど、もうちょっと休ませてくれよ。\n",
      "translation": "아, 아니…… 미안하지만, 좀 더 쉬게 해줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0095",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,366,0,337",
        "voice": "GA602047,3"
      },
      "original": "いいじゃないですか。\n今日は無礼講なんですよね？\n",
      "translation": "괜찮잖아요. 오늘은 격식 없는 자리라고요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0096",
      "channel": 1,
      "context": {
        "speaker": "026",
        "face": "601,368,0,337",
        "voice": "GA602048,3"
      },
      "original": "……あらぁ～？\nそれとも、もしかしておジャマだったかしら～？\n",
      "translation": "……어머～? 아니면, 혹시 방해가 됐던 걸까～?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0097",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,030,0",
        "voice": "GA602049,3"
      },
      "original": "えっ、な、何が？\nぜんぜん、そんなことないですよ。\n",
      "translation": "엣, 무, 뭐야? 전혀, 그런 거 아니에요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0098",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,022,0",
        "voice": "GA602050,3"
      },
      "original": "じ、じゃあ、タクトさん。\nそろそろ戻りましょう。\n",
      "translation": "그, 그럼, 택트 씨. 슬슬 돌아가요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0099",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,022,0",
        "voice": "GA602050,3"
      },
      "original": "う、うん……。\n",
      "translation": "으, 응……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0100",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,024,0",
        "voice": "GA602050,3"
      },
      "original": "いや、せっかくだけど、遠慮しておくよ。\nここで冷たい空気に当たっていたいんだ。\n",
      "translation": "아니, 기왕 이렇게 된 거, 사양할게. 여기서\n차가운 공기를 쐬고 있고 싶어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0101",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,027,0",
        "voice": "GA602051,3"
      },
      "original": "そ、そうですか……。\nじゃあ、あたしはこれで……。\n",
      "translation": "그, 그렇습니까…… 그럼, 저는 이만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0102",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "voice": "GA602051,3",
        "speaker": "001"
      },
      "original": "うん、ミルフィーも楽しんでね。\nそれじゃあ。\n",
      "translation": "응, 밀피도 즐거운 시간 보내. 그럼 이만.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0103",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,069,0",
        "voice": "GA602052,3"
      },
      "original": "……あれぇ？\nなんか、目がかゆいわね。\n",
      "translation": "……어라? 왠지, 눈이 가렵네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0104",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,069,0",
        "voice": "GA602052,3"
      },
      "original": "え、そう？\nオレは何ともないけど。\n",
      "translation": "에, 그래? 난 아무렇지도 않은데.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0105",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,0,0,106",
        "voice": "GA602053,3"
      },
      "original": "いえ、私もですわ。\nそれに……は、鼻もムズムズして……。\n",
      "translation": "아니요, 저도요. 게다가…… 코도\n근질근질해서……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0106",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,146,0,106",
        "voice": "GA602054,3"
      },
      "original": "どうしちまったんだい、こりゃ！？\n目が痛い～！\n",
      "translation": "어떻게 된 거야, 이거!? 눈이 따가워～!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0107",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,073,0,0",
        "voice": "GA602055,3"
      },
      "original": "いやぁ～っ、目がシバシバするぅぅ！\n",
      "translation": "아아앙～! 눈이 뻑뻑해애애!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0108",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,073,0,106",
        "voice": "GA602056,3"
      },
      "original": "グスッ……。\nな、何ですの、これ？\n",
      "translation": "훌쩍…… 무, 무엇인가요, 이거?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_0008c000:dialogue:0109",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "007,073,0,106",
        "voice": "GA602056,3"
      },
      "original": "おい、みんな！？\nいったい……何が起こっているんだ！？\n",
      "translation": "어이, 모두들!? 도대체…… 무슨 일이 일어나고\n있는 거야!?\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
