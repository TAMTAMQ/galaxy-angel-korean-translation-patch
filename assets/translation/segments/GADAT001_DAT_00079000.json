{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_00079000.txt",
    "encoding": "cp932",
    "sha256": "5b7ea5e055e8d083ac1393dc4a2a774db305c6caf32e77dee8a6804627718949",
    "dialogue_count": 122
  },
  "units": [
    {
      "id": "GADAT001_DAT_00079000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "042",
        "face": "362,0,0,0",
        "voice": "GA518001,3"
      },
      "original": "ウフフ……なかなかやるじゃない。\nさすがに、ここまで生き残ってきただけのことは\nあるわ。\n",
      "translation": "우후후…… 제법이네. 괜히 여기까지 살아남은\n게 아니군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA518001,3"
      },
      "original": "いやぁ、それほどでも。\nそっちこそ、そろそろ引きあげないとヤバイんじゃ\nないかい？\n",
      "translation": "이야, 그 정도까지는. 그쪽이야말로 슬슬\n퇴각하지 않으면 위험한 거 아니야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "042",
        "face": "362,0,0,0",
        "voice": "GA518002,3"
      },
      "original": "そうね、そうさせてもらおうかしら。\nだけど、これで終わりじゃないわよ。\nウフフフ……。\n",
      "translation": "그렇네, 그렇게 하도록 할까. 하지만, 이걸로\n끝이 아니야. 우후후후……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,0,0",
        "voice": "GA518003,3"
      },
      "original": "敵艦、離脱していきます。\n",
      "translation": "적함, 이탈합니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GA518004,3"
      },
      "original": "ふん、あれでも余裕を見せたつもりか？\n新型といっても、足が速いだけで、たいしたこと\nはないな。\n",
      "translation": "흥, 저래놓고 여유를 부린 척한 건가?\n신형이라고 해도, 발이 빠를 뿐이지 별거\n아니군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA518005,3"
      },
      "original": "戦おうと思えば、まだやれたはずだ。\n余裕のあるうちに引いたのか……？\n",
      "translation": "싸우려 했다면, 아직 더 할 수 있었을 텐데.\n여유가 있을 때 물러난 건가……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA518006,3"
      },
      "original": "こっちのハッタリは見透かしてるって顔だったな。\n今度の新型艦は、かなり手ごわいぞ。\nあの女司令官もな。\n",
      "translation": "이쪽의 허세를 꿰뚫어 보고 있다는 표정이었지.\n이번 신형함은, 상당히 까다롭다. 저 여자\n사령관도 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,223,0",
        "voice": "GA518006,3"
      },
      "original": "ああ……。\nだが、最後に残した言葉が気になるな。\nレーダーに何か反応はないか？\n",
      "translation": "아아…… 하지만, 마지막에 남긴 말이 신경\n쓰이는군. 레이더에 무슨 반응은 없나?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0009",
      "channel": 1,
      "context": {
        "face": "491,0,0,0",
        "voice": "GA518007,3",
        "speaker": "016"
      },
      "original": "いえ、特に……。\n",
      "translation": "아니요, 딱히……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "493,0,0,0",
        "voice": "GA518008,3"
      },
      "original": "待ってください！\n前方に艦影確認！\n",
      "translation": "기다려 주세요! 전방에 함영 확인!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0011",
      "channel": 1,
      "context": {
        "voice": "GA518009,3",
        "speaker": "007",
        "face": "221,0,225,0"
      },
      "original": "な、何だと！？\n敵の第２波か！\n",
      "translation": "뭐, 뭐라고!? 적의 제2파인가!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "016",
        "face": "491,0,225,0",
        "voice": "GA518010,3"
      },
      "original": "さらにその後方からも、艦隊が接近中！\n第３波と思われます！\n",
      "translation": "게다가 그 후방에서도, 함대가 접근 중!\n제3파로 보입니다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "503,0,225,0",
        "voice": "GA518011,3"
      },
      "original": "うそ……。\nこんなの初めてだわ……。\n",
      "translation": "말도 안 돼…… 이런 건 처음이야……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0014",
      "channel": 1,
      "context": {
        "voice": "GA518011,3",
        "face": "003,0,225,0",
        "speaker": "001"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "011,0,0,0",
        "voice": "GA518011,3"
      },
      "original": "……エンジェル隊のみんな、そっちの状況は？\n",
      "translation": "……엔젤대 여러분, 그쪽 상황은?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0016",
      "channel": 1,
      "context": {
        "voice": "GA518012,3",
        "face": "103,0,0,0",
        "speaker": "004"
      },
      "original": "こちらのレーダーでも確認しましたわ。\n私はまだ戦えますが……どうなさいます？\n",
      "translation": "이쪽 레이더로도 확인했습니다. 저는 아직\n싸울 수 있습니다만…… 어떻게 하시겠어요?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "103,0,0,0",
        "voice": "GA518013,3"
      },
      "original": "こちらのレーダーでも確認しましたわ。\n……少々、苦労しそうですわね。\n",
      "translation": "이쪽 레이더로도 확인했습니다. ……조금,\n고생할 것 같네요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0018",
      "channel": 1,
      "context": {
        "voice": "GA518014,3",
        "speaker": "004",
        "face": "105,0,0,0"
      },
      "original": "こちらのレーダーでも確認しましたわ。\nですが、３番機はまだ戦線に復帰できません。\n修理中ですの。\n",
      "translation": "이쪽 레이더로도 확인했습니다. 하지만,\n3번기는 아직 전선에 복귀할 수 없습니다.\n수리 중이니까요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0019",
      "channel": 1,
      "context": {
        "face": "064,0,0,0",
        "voice": "GA518015,3",
        "speaker": "003"
      },
      "original": "アタシは大丈夫よ！\n今回みたいに、いい指示を出してくれたら、増援\nだってお茶の子さいさいだわ！\n",
      "translation": "나는 괜찮아! 이번처럼 좋은 지시를 내려주면,\n증원쯤은 식은 죽 먹기라구!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "068,0,0,0",
        "voice": "GA518016,3"
      },
      "original": "う～ん……まだ何とかなるわ。\nたぶん……。\n",
      "translation": "으음…… 아직 어떻게든 돼. 아마도……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "067,0,0,0",
        "voice": "GA518017,3"
      },
      "original": "状況？\n見てたんなら、わかってるでしょ！\n誰かさんのヘボな指示のせいで、格納庫の中よ！\n",
      "translation": "상황? 보고 있었다면, 알고 있잖아! 누군가의\n허술한 지시 때문에, 격납고 안이야!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "022,0,0,0",
        "voice": "GA518018,3"
      },
      "original": "何とかなりますよ！\nこのまま、一気にやっつけちゃいましょう。\n",
      "translation": "어떻게든 될 거예요! 이대로, 단번에 해치워\n버리자고요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0023",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "023,0,0,0",
        "voice": "GA518019,3"
      },
      "original": "まだ新手が来るんですか？\nもう、かなりヘトヘトなんですけど……。\n",
      "translation": "또 새로운 적이 오는 건가요? 이제, 꽤\n지쳤는데요……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "023,0,0,0",
        "voice": "GA518020,3"
      },
      "original": "えーん、ラッキースター、まだ修理中ですぅ。\nど、どうしましょう、タクトさん？\n",
      "translation": "에엥, 럭키 스타, 아직 수리 중이라구우.\n어, 어떡하죠, 택트 씨?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,0,0",
        "voice": "GA518021,3"
      },
      "original": "……戦闘を続行しますか？\n指示を願います。\n",
      "translation": "……전투를 속행합니까? 지시를 바랍니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0026",
      "channel": 1,
      "context": {
        "voice": "GA518022,3",
        "speaker": "006",
        "face": "181,0,0,0"
      },
      "original": "ハーベスター、ナノマシンの補充が必要です。\n帰艦の許可を願います。\n",
      "translation": "하베스터, 나노머신의 보충이 필요합니다.\n귀함 허가를 바랍니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "182,0,0,0",
        "voice": "GA518023,3"
      },
      "original": "……ハーベスター、まだ修理完了していません。\nナノマシンの補充も必要です。\n",
      "translation": "……하베스터, 아직 수리가 완료되지\n않았습니다. 나노머신 보충도 필요합니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0028",
      "channel": 1,
      "context": {
        "voice": "GA518024,3",
        "speaker": "005",
        "face": "142,0,0,0"
      },
      "original": "ハッピートリガーなら、心配はいらないよ。\nやってやろうじゃないか。\nいざとなったら、あたしがしんがりを引き受ける。\n",
      "translation": "해피 트리거라면 걱정할 거 없어. 한판\n붙어보자고. 만약의 경우에는, 내가 후방을\n맡을게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "173,0,0,0",
        "voice": "GA518025,3"
      },
      "original": "ちょいと弾薬が足りなくなってきたよ。\n新手の相手までしてられるかどうかは、微妙だね。\nどうする？\n",
      "translation": "탄약이 좀 부족해졌어. 새로 오는 적까지\n상대할 수 있을지는 미묘하네. 어떡할 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "146,0,0,0",
        "voice": "GA518026,3"
      },
      "original": "悪いけど、あたしは出られそうにないよ。\nお前さんの指示も、ちょいと後手後手に回ってる\nようだし……ここは引くのも手じゃないかい？\n",
      "translation": "미안하지만, 나는 나갈 수 없을 것 같아. 너의\n지시도 좀 뒤처지고 있는 것 같고…… 여기서는\n물러나는 것도 방법 아닐까?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0031",
      "channel": 1,
      "context": {
        "face": "004,0,0,0",
        "voice": "GA518026,3",
        "speaker": "001"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0032",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA518027,3"
      },
      "original": "タクト！\n敵の第２波は、もうすぐそこだぞ！\nどうするんだ！\n",
      "translation": "택트! 적의 제2파가 곧 코앞이야! 어떡할\n거야!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,223,0",
        "voice": "GA518027,3"
      },
      "original": "これだけの数の敵を、相手にできるのか……？\nいや……。\n",
      "translation": "이만큼 많은 적을 상대할 수 있는 건가……?\n아니……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0034",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,225,0",
        "voice": "GA518028,3"
      },
      "original": "タクト、早く指示を！\nこの宙域を離脱するか？\n",
      "translation": "택트, 빨리 지시를! 이 우주 영역을 이탈할까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0035",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,0,0,0",
        "voice": "GA518029,3"
      },
      "original": "今なら、１０時方向にクロノ・ドライヴの航路が\n取れます！\n",
      "translation": "지금이라면, 10시 방향으로 크로노・드라이브\n항로를 잡을 수 있습니다!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0036",
      "channel": 1,
      "context": {
        "face": "491,0,0,0",
        "voice": "GA518030,3",
        "speaker": "016"
      },
      "original": "ちょうど第２ランデブーポイントのＹＪｅ６３０\nがある方向ですね。\n",
      "translation": "마침 제2 랑데부 포인트인 YJe630이\n있는 방향이네요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0037",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "010,0,0,0",
        "voice": "GA518030,3"
      },
      "original": "……それしかないか。\nエンジェル隊、全機撤退！\n収容を急げ！\n",
      "translation": "……그것뿐인가. 엔젤대, 전 기체 철수!\n수용을 서둘러라!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,0,0",
        "voice": "GA518030,3"
      },
      "original": "１０時方向に転進、クロノ・ドライヴ準備！\n目標ポイントはＹＪｅ６３０！\n",
      "translation": "10시 방향으로 선회, 크로노・드라이브 준비!\n목표 포인트는 YJe630!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0039",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,225,0",
        "voice": "GA518031,3"
      },
      "original": "ん……ちょっと待て。\n逃げ道の先に、ちょうど第２ランデブーポイント\nがあるなんて、偶然にしちゃできすぎだぞ。\n",
      "translation": "음…… 잠깐 기다려 봐. 도주로 끝에 마침 제2\n랑데부 포인트가 있다니, 우연치고는 너무 딱\n맞아떨어지는데.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0040",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,225,0",
        "voice": "GA518031,3"
      },
      "original": "わかってる。\nそれでも、このまま戦い続けるよりはマシだ。\n少しでも危険性の少ない方へ賭ける。\n",
      "translation": "알고 있어. 그래도 이대로 계속 싸우는\n것보다는 낫다. 조금이라도 위험성이 적은\n쪽에 걸지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0041",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,0,0,0",
        "voice": "GA518032,3"
      },
      "original": "紋章機、すべて収容しました。\nクロノ・ドライヴに入ります！\n",
      "translation": "문장기, 모두 수용했습니다.\n크로노・드라이브에 들어갑니다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0042",
      "channel": 1,
      "context": {
        "speaker": "042",
        "face": "362,0,0,0",
        "voice": "GA518033,3"
      },
      "original": "……そうよ。\nどこまでもお逃げなさい。\n",
      "translation": "……그래요. 어디까지든 도망치세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0043",
      "channel": 1,
      "context": {
        "speaker": "042",
        "face": "362,0,0,0",
        "voice": "GA518034,3"
      },
      "original": "だけど……あなたたちはもう、エオニア様の手の\n中よ。\nフフフフ……。\n",
      "translation": "하지만…… 당신들은 이미, 에오니아 님의 손\n안에 있어요. 후후후후……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0044",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,143,0",
        "voice": "GA518035,3"
      },
      "original": "……エンジェル隊、フォルテ・シュトーレン以下\n５名、戻りました。\n",
      "translation": "……엔젤대, 포르테・슈토렌 이하 5명,\n복귀했습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0045",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,143,0",
        "voice": "GA518035,3"
      },
      "original": "ああ、みんなお疲れさま。\n",
      "translation": "아아, 다들 수고했어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0046",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,067,0",
        "voice": "GA518036,3"
      },
      "original": "お疲れさま、じゃないわよ。\nあれはいったい、どういうこと？\n説明してよ！\n",
      "translation": "수고한 게 아니야. 그건 대체 어떻게 된 거야?\n설명해 봐!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0047",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,067,0",
        "voice": "GA518036,3"
      },
      "original": "説明って？\n",
      "translation": "설명이라니?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0048",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,0,072,0",
        "voice": "GA518037,3"
      },
      "original": "決まってるでしょ。\n何であのとき、あんなに敵がわいて出てきたのよ？\n",
      "translation": "뻔하잖아. 왜 그때, 그렇게 적이 쏟아져 나온\n거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0049",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,0,047",
        "voice": "GA518038,3"
      },
      "original": "あんなにたくさん敵がいるなんて……。\n逃げ出せてよかったぁ……。\n",
      "translation": "저렇게나 많은 적이 있다니…… 도망칠 수\n있어서 다행이야……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0050",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,120,0,047",
        "voice": "GA518039,3"
      },
      "original": "ですが、このまま逃げ切れるとは限りませんわ。\n",
      "translation": "하지만, 이대로 계속 도망칠 수 있을지는\n장담할 수 없어요.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0051",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,120,0,028",
        "voice": "GA518040,3"
      },
      "original": "うーん、そうだよね。\n早く味方と合流しないと……。\n",
      "translation": "으음, 그렇네. 빨리 아군과 합류해야 해……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0052",
      "channel": 1,
      "context": {
        "face": "101,107,0,028",
        "voice": "GA518041,3",
        "speaker": "004"
      },
      "original": "そうなのですが……。\nタクトさん、その合流するはずの味方は、どこへ\n行ってしまわれたんですの？\n",
      "translation": "그렇긴 합니다만…… 택트 씨, 그 합류할\n예정이었던 아군은 어디로 가 버린 건가요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0053",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,107,0,028",
        "voice": "GA518041,3"
      },
      "original": "それは……。\n",
      "translation": "그건……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0054",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,0,186",
        "voice": "GA518042,3"
      },
      "original": "……ギムソン星系駐留艦隊がいるはずのところに、\nエオニア軍がいました……。\n",
      "translation": "……김슨 성계 주둔 함대가 있어야 할 곳에,\n에오니아군이 있었습니다……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0055",
      "channel": 1,
      "context": {
        "face": "061,065,0,186",
        "voice": "GA518043,3",
        "speaker": "003"
      },
      "original": "まさか、敵のワナ？\nそれとも、味方がやられちゃったの！？\n",
      "translation": "설마, 적의 함정? 아니면, 아군이 당해버린\n거야!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0056",
      "channel": 1,
      "context": {
        "face": "021,065,0,027",
        "speaker": "002",
        "voice": "GA518044,3"
      },
      "original": "もしそうだったら……どうしよう？\nひょっとしたら、まわりじゅう敵だらけなのかも。\n",
      "translation": "만약 그렇다면…… 어떡하지? 어쩌면 주변이\n온통 적뿐일지도 몰라.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0057",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,106,0,027",
        "voice": "GA518045,3"
      },
      "original": "それどころか、目的地のローム星系もエオニア軍\nに制圧されているかもしれませんわ……。\n",
      "translation": "그뿐만 아니라, 목적지인 롬 성계도\n에오니아군에게 제압당하고 있을지도\n몰라요……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0058",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,106,0,027",
        "voice": "GA518045,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0059",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,106,0,027",
        "voice": "GA518045,3"
      },
      "original": "まぁまぁ、落ち着いて。\n憶測だけであれこれ考えていても、しかたないよ。\n",
      "translation": "자자, 진정해. 추측만으로 이것저것 생각하고\n있어 봤자, 별수 없어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0060",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,106,0,027",
        "voice": "GA518045,3"
      },
      "original": "ともかく、この場は解散。\nみんな身体を休めてくれ。\n",
      "translation": "어쨌든, 이 자리는 해산. 다들 몸을 좀 쉬도록\n해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0061",
      "channel": 1,
      "context": {
        "voice": "GA518046,3",
        "speaker": "003",
        "face": "061,072,0,0"
      },
      "original": "ちょっと待ちなさいよ！\nまだ肝心な話を聞いてないわ！\n",
      "translation": "잠깐 기다려 봐! 아직 중요한 이야기를 못\n들었다고!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0062",
      "channel": 1,
      "context": {
        "voice": "GA518047,3",
        "speaker": "006",
        "face": "181,072,0,187"
      },
      "original": "……友軍は、どこへ行ったのですか……？\n",
      "translation": "……우군은, 어디로 간 건가요……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0063",
      "channel": 1,
      "context": {
        "face": "003,072,0,187",
        "voice": "GA518047,3",
        "speaker": "001"
      },
      "original": "さっきまでいたポイントに留まっていても、友軍\nは来ない。\nいま言えるのは、それだけだ。\n",
      "translation": "아까까지 있던 포인트에 머물러 있어도,\n우군은 오지 않아. 지금 말할 수 있는 건,\n그것뿐이다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0064",
      "channel": 1,
      "context": {
        "face": "061,068,0,186",
        "speaker": "003",
        "voice": "GA518048,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0065",
      "channel": 1,
      "context": {
        "voice": "GA518049,3",
        "speaker": "006",
        "face": "181,068,0,186"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0066",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,068,0,186",
        "voice": "GA518049,3"
      },
      "original": "きっと次のランデブーポイントで待ってるはずさ。\nそのために、こうしてクロノ・ドライヴに入った\nんだから。\n",
      "translation": "분명 다음 란데부 포인트에서 기다리고 있을\n거야. 그러기 위해서, 이렇게\n크로노・드라이브에 들어온 거니까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0067",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA518049,3"
      },
      "original": "さぁさぁ、解散解散。\n今は部屋に戻って休むのが先だよ。\n休むのだって、大事な任務だろ？\n",
      "translation": "자자, 해산, 해산. 지금은 방으로 돌아가서\n쉬는 게 우선이야. 쉬는 것도 중요한 임무잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0068",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "021,0,0,027",
        "voice": "GA518050,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0069",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,106,0,027",
        "voice": "GA518051,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0070",
      "channel": 1,
      "context": {
        "face": "141,0,165,0",
        "speaker": "005",
        "voice": "GA518052,3"
      },
      "original": "そうだね……クロノ・ドライヴの間、あたしらの\n出番はないんだ。\nここはお言葉に甘えて、休ませてもらおうかね。\n",
      "translation": "그렇네…… 크로노・드라이브 동안, 우리들의\n차례는 없어. 여기는 말씀하신 대로, 좀\n쉬도록 할까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0071",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "061,069,0,0",
        "voice": "GA518053,3"
      },
      "original": "でも、フォルテさん……。\n",
      "translation": "하지만, 포르테 씨……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0072",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,142,0",
        "voice": "GA518054,3"
      },
      "original": "さ、行こう行こう！\n司令の言うとおり、ゆっくり休もうじゃないの。\n",
      "translation": "자, 가자 가자! 사령관이 말씀하신 대로, 푹\n쉬자고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0073",
      "channel": 1,
      "context": {
        "face": "021,0,0,028",
        "voice": "GA518055,3",
        "speaker": "002"
      },
      "original": "……はぁい、わかりました……。\n",
      "translation": "……네에, 알겠습니다……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0074",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "101,107,0,028",
        "voice": "GA518056,3"
      },
      "original": "……それでは、参りましょう。\n",
      "translation": "……그러면, 가도록 하죠.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0075",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,187,0",
        "voice": "GA518057,3"
      },
      "original": "……失礼します……。\n",
      "translation": "……실례하겠습니다……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0076",
      "channel": 1,
      "context": {
        "speaker": "094",
        "face": "000,0,0,0",
        "voice": "GA518057,3"
      },
      "original": "　\n",
      "translation": "　\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0077",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA518057,3"
      },
      "original": "ふぅ～……。\n",
      "translation": "후우～……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0078",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA518058,3"
      },
      "original": "マズイことになったな。\n",
      "translation": "난처하게 됐군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0079",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,223,0",
        "voice": "GA518058,3"
      },
      "original": "そうだな。\nはっきり言って今のオレたちは、敵の思うように\n追いつめられている状況だ。\n",
      "translation": "그렇네. 솔직히 말해서 지금 우리들은, 적이\n원하는 대로 몰리고 있는 상황이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0080",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,223,0",
        "voice": "GA518059,3"
      },
      "original": "それだけじゃない。\nエンジェル隊の士気が落ちてしまっている。\n",
      "translation": "그것뿐만이 아니야. 엔젤대의 사기가 떨어져\n있어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0081",
      "channel": 1,
      "context": {
        "voice": "GA518060,3",
        "speaker": "007",
        "face": "221,0,223,0"
      },
      "original": "知ってのとおり、紋章機はパイロットの精神状態\nによって性能が変化する。\n今のあいつらじゃ、まともに戦えないぞ。\n",
      "translation": "알고 있듯이 문장기는 파일럿의 정신 상태에\n따라 성능이 변해. 지금 저 녀석들이라면\n제대로 싸울 수 없어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0082",
      "channel": 1,
      "context": {
        "face": "012,0,223,0",
        "voice": "GA518060,3",
        "speaker": "001"
      },
      "original": "……だからって、何をどう言えばよかったんだよ。\nそりゃ、オレだってこの状況を何とかしたいけど\nさ……。\n",
      "translation": "……그렇다고 해서, 뭐라고 어떻게 말했어야\n했다는 거야. 나라고 이 상황을 어떻게든 하고\n싶지만 말이야……\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0083",
      "channel": 1,
      "context": {
        "speaker": "007",
        "face": "221,0,221,0",
        "voice": "GA518061,3"
      },
      "original": "そうだ。\nそこを何とかするのが、お前の仕事だ。\n",
      "translation": "그래. 그 상황을 어떻게든 하는 게 네 일이다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0084",
      "channel": 1,
      "context": {
        "face": "012,0,221,0",
        "voice": "GA518061,3",
        "speaker": "001"
      },
      "original": "簡単に言ってくれるねぇ……。\n",
      "translation": "말이야 쉽지……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0085",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,221,0",
        "voice": "GA518061,3"
      },
      "original": "……少し頭を冷やしてくるよ。\nしばらくブリッジを頼む。\n",
      "translation": "……잠시 머리 좀 식히고 올게. 당분간\n브릿지를 부탁해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0086",
      "channel": 1,
      "context": {
        "face": "221,0,222,0",
        "voice": "GA518062,3",
        "speaker": "007"
      },
      "original": "ああ、行ってこい。\n",
      "translation": "아아, 다녀와라.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0087",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA518062,3"
      },
      "original": "まいったなぁ。\n先行きはわからないことだらけだし、エンジェル\n隊は落ち込んでるし。\n",
      "translation": "곤란하네. 앞날은 알 수 없는 것투성이고,\n엔젤대는 낙담하고 있고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0088",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA518062,3"
      },
      "original": "たぶん、ギムソン星系駐留艦隊は、エオニア軍に\nやられたんだろうな。\nそして、ドライヴ・アウトした先には……。\n",
      "translation": "아마, 김슨 성계 주둔 함대는 에오니아군에게\n당한 거겠지. 그리고, 드라이브・아웃한\n곳에는……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0089",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GA518062,3"
      },
      "original": "でも、こんな予想を言ったら、みんなをますます\n不安にさせてしまうだけだ。\nこれだけは言うわけにいかない。\n",
      "translation": "하지만, 이런 예상을 말하면 모두를 더욱\n불안하게 만들 뿐이야. 이것만큼은 말할 수\n없어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0090",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA518062,3"
      },
      "original": "うーん……どうしたもんかなぁ……？\n",
      "translation": "으음…… 어떻게 해야 할까……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0091",
      "channel": 1,
      "context": {
        "face": "141,0,141,0",
        "speaker": "005",
        "voice": "GA518063,3"
      },
      "original": "司令官どの、ちょっといいかい？\n",
      "translation": "사령관 나리, 잠깐 괜찮을까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0092",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,141,0",
        "voice": "GA518063,3"
      },
      "original": "フォルテじゃないか。\nどうしたの？\n",
      "translation": "포르테잖아. 무슨 일이야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0093",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,145,0",
        "voice": "GA518064,3"
      },
      "original": "さっきのことだけど……あまり感心しないね。\n",
      "translation": "아까 일 말인데…… 별로 마음에 안 드는군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0094",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,145,0",
        "voice": "GA518064,3"
      },
      "original": "さっきのこと？\n",
      "translation": "아까 일?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0095",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,143,0",
        "voice": "GA518065,3"
      },
      "original": "ああいうときは、ヘタにごまかしたりしないで、\nビシッと言うべきだったんじゃないかい？\n",
      "translation": "그런 때는, 어설프게 얼버무리지 말고, 딱\n잘라 말해야 했던 거 아니겠나?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0096",
      "channel": 1,
      "context": {
        "face": "004,0,143,0",
        "speaker": "001",
        "voice": "GA518065,3"
      },
      "original": "……ああ、そのことか。\nあの状態じゃ、オレが何を言っても、右から左に\n流れていくだけと思ったからね。\n",
      "translation": "……아아, 그 일인가. 그 상태로는 내가 무슨\n말을 해도, 한 귀로 흘려버릴 뿐이라고\n생각했으니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0097",
      "channel": 1,
      "context": {
        "face": "004,0,143,0",
        "speaker": "001",
        "voice": "GA518065,3"
      },
      "original": "みんながもう少し落ち着いたら、改めて召集する\nつもりだよ。\n",
      "translation": "모두가 조금 더 진정되면, 다시 소집할\n생각이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0098",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,173,0",
        "voice": "GA518066,3"
      },
      "original": "なるほど。\n……それで、今度のクロノ・ドライヴ先の安全は、\nどうなんだい？\n",
      "translation": "그렇군. ……그래서 이번 크로노・드라이브\n목적지는 안전한가?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0099",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,173,0",
        "voice": "GA518066,3"
      },
      "original": "……それは言えないなぁ。\n",
      "translation": "……그건 말할 수 없겠네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0100",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,165,0",
        "voice": "GA518067,3"
      },
      "original": "ふぅん。\nとりあえず、口に出せないような状況だってこと\nだけはわかったよ。\n",
      "translation": "흐음. 일단 입 밖으로 꺼낼 수 없는\n상황이라는 것만은 알겠어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0101",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,165,0",
        "voice": "GA518067,3"
      },
      "original": "……フォルテ、あのさ……。\n",
      "translation": "……포르테, 저기 말이야……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0102",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,141,0",
        "voice": "GA518068,3"
      },
      "original": "ん？\n何か言いたいことでもあるのかい？\n",
      "translation": "응? 하고 싶은 말이라도 있는 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0103",
      "channel": 1,
      "context": {
        "face": "004,0,141,0",
        "voice": "GA518068,3",
        "speaker": "001"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0104",
      "channel": 1,
      "context": {
        "face": "008,0,141,0",
        "voice": "GA518068,3",
        "speaker": "001"
      },
      "original": "さっきは助かったよ。\nあの場を収拾できたのは、フォルテのおかげだ。\n",
      "translation": "아까는 고마웠어. 그 자리를 수습할 수 있었던\n건, 포르테 덕분이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0105",
      "channel": 1,
      "context": {
        "voice": "GA518069,3",
        "speaker": "005",
        "face": "141,0,165,0"
      },
      "original": "そんなことかい。\nエンジェル隊の……エルシオールの一員として、\n物事をスムーズに進めるのも、仕事のうちさ。\n",
      "translation": "별거 아니야. 엔젤대의…… 에르시올의\n일원으로서, 일을 원활하게 진행하는 것도 업무\n중 하나니까.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0106",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,165,0",
        "voice": "GA518069,3"
      },
      "original": "だけど、フォルテは本当は、ビシッと言った方が\nいいと思ってたんだろう？\nどうして、それを曲げて手を貸してくれたんだい？\n",
      "translation": "하지만, 포르테는 사실, 따끔하게 말하는 게\n좋다고 생각했었지? 어째서, 그걸 굽히고 손을\n빌려준 거야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0107",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,141,0",
        "voice": "GA518070,3"
      },
      "original": "別に、たいしたことじゃないよ。\nお前さんは司令官だ。\n司令官の言うことにゃ、従うのがスジだろ？\n",
      "translation": "딱히, 대단한 일은 아니야. 너는 사령관이다.\n사령관의 말에는, 따르는 게 도리잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0108",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,141,0",
        "voice": "GA518070,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0109",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,173,0",
        "voice": "GA518071,3"
      },
      "original": "なんだいなんだい、その情けないツラは？\nシャキッとしなよ。\n",
      "translation": "뭐야 뭐야, 그 한심한 표정은? 정신 좀 차려.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0110",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,173,0",
        "voice": "GA518071,3"
      },
      "original": "ああ……。\n",
      "translation": "아아……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0111",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,141,0",
        "voice": "GA518071,3"
      },
      "original": "……いや、やっぱり何でもない。\n",
      "translation": "……아니, 역시 아무것도 아니야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0112",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,173,0",
        "voice": "GA518072,3"
      },
      "original": "ふぅん……。\nまぁ、別にそれならそれでいいけどね。\n",
      "translation": "흐음…… 뭐, 그렇다면 그걸로 됐지만 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0113",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,141,0",
        "voice": "GA518072,3"
      },
      "original": "オレの方こそ、感心しないな。\n司令官のやることに、口を出さないでくれないか。\n",
      "translation": "나야말로, 실망스럽군. 사령관이 하는 일에,\n참견하지 말아줄래.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0114",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,173,0",
        "voice": "GA518073,3"
      },
      "original": "……あ、そう。\nそいつは失礼いたしました、司令官どの。\n",
      "translation": "……아, 그래. 그건 실례했습니다, 사령관 나리.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0115",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,173,0",
        "voice": "GA518073,3"
      },
      "original": "オレはオレなりに、今の状況を考えているんだ。\n安心して、任せてくれたらいい。\n",
      "translation": "나는 나대로, 지금의 상황을 생각하고 있어.\n안심하고, 맡겨두면 돼.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0116",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "141,0,143,0",
        "voice": "GA518074,3"
      },
      "original": "ふぅん、そうかい。\n困ってんのかと思ったけど……あたしのカン違い\nだったようだね。\n",
      "translation": "흐음, 그런가. 곤란한 건가 싶었는데…… 내\n착각이었던 모양이네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0117",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,143,0",
        "voice": "GA518074,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0118",
      "channel": 1,
      "context": {
        "voice": "GA518075,3",
        "speaker": "005",
        "face": "141,0,141,0"
      },
      "original": "じゃあ、あたしはもう行くよ。\nちょいと、やることがあるんでね。\n",
      "translation": "그럼, 난 이만 갈게. 잠시, 해야 할 일이\n있어서 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0119",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,141,0",
        "voice": "GA518075,3"
      },
      "original": "ああ、それじゃあ。\n",
      "translation": "아아, 그럼.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0120",
      "channel": 1,
      "context": {
        "voice": "GA518075,3",
        "speaker": "094",
        "face": "000,0,0,0"
      },
      "original": "　\n",
      "translation": "　\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0121",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA518075,3"
      },
      "original": "……さてと、オレも頭を切り替えなきゃ。\nエンジェル隊のみんなの様子も気になるし……。\n",
      "translation": "……자, 나도 마음을 가다듬어야겠어. 엔젤대\n모두의 상태도 신경 쓰이고……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_00079000:dialogue:0122",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GA518075,3"
      },
      "original": "３０分くらい、艦内をぶらついてみるか。\nそうしている間に、気分転換もできるだろう。\n",
