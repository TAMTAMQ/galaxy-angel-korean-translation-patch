  },
  "units": [
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "057,0,0,0",
        "voice": "GAE26001,3"
      },
      "original": "任せてください！\nシャトヤーン様のおかげで、あの翼が出せるよう\nになったんですから、負けるはずないです！\n",
      "translation": "맡겨 주세요! 샤토얀 님 덕분에, 그 날개를 낼\n수 있게 되었으니까, 질 리가 없어요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "062,0,0,0",
        "voice": "GAE26002,3"
      },
      "original": "こっちは、いつでもＯＫよ。\n紋章機の１００パーセントの力、見せてあげる！\n",
      "translation": "이쪽은, 언제든 OK야. 문장기의 100퍼센트의\n힘, 보여줄게!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "103,0,0,0",
        "voice": "GAE26003,3"
      },
      "original": "ここまで来たら、後は勝つしかありませんわ！\n",
      "translation": "여기까지 왔으니, 남은 건 이기는 것뿐이에요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "158,0,0,0",
        "voice": "GAE26004,3"
      },
      "original": "それじゃ、最後の大暴れといこうか！\n",
      "translation": "그럼, 마지막 대난동을 시작해 볼까!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "195,0,0,0",
        "voice": "GAE26005,3"
      },
      "original": "絶対に、負けません……。\n",
      "translation": "절대로, 지지 않아요……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "025,0,0,0",
        "voice": "GAE26006,3"
      },
      "original": "出撃命令をお願いします、タクトさん！\n",
      "translation": "출격 명령을 부탁합니다, 택트 씨!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GAE26006,3"
      },
      "original": "ミルフィー……。\nきびしい戦いになると思うけど、無理はしないで\nくれよ？\n",
      "translation": "밀피……. 힘든 싸움이 되겠지만, 무리는 하지 마.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "022,0,0,0",
        "voice": "GAE26007,3"
      },
      "original": "大丈夫です！\nあたし、いま何だか身体中から力がわいて来てる\nような気がするんです！\n",
      "translation": "괜찮아요! 저, 지금 왠지 온몸에서 힘이\n솟아오르는 것 같은 기분이 들어요!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0009",
      "channel": 1,
      "context": {
        "voice": "GAE26007,3",
        "speaker": "001",
        "face": "003,0,0,0"
      },
      "original": "わかった。\nそれじゃ、よろしく頼むよ、ミルフィー。\n",
      "translation": "알았다. 그럼, 잘 부탁한다, 밀피.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "057,0,0,0",
        "voice": "GAE26008,3"
      },
      "original": "はい！\n",
      "translation": "네!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "027,0,0,0",
        "voice": "GAE26009,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "068,0,0,0",
        "voice": "GAE26010,3"
      },
      "original": "ミルフィー、どうしたのよ？\n",
      "translation": "밀피, 왜 그래?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "042,0,0,0",
        "voice": "GAE26011,3"
      },
      "original": "あ……。\nううん、何でもない。\n",
      "translation": "아…… 아니, 아무것도 아니야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0014",
      "channel": 1,
      "context": {
        "face": "066,0,0,0",
        "voice": "GAE26012,3",
        "speaker": "003"
      },
      "original": "しっかりしなさいよ。\nここで負けたら、今までの苦労が水の泡なんだか\nらね！\n",
      "translation": "정신 차려. 여기서 지면, 지금까지의 고생이\n수포로 돌아간 다구!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "042,0,0,0",
        "voice": "GAE26013,3"
      },
      "original": "うん……。\n",
      "translation": "응……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0016",
      "channel": 1,
      "context": {
        "voice": "GAE26013,3",
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "……ミルフィー……。\n",
      "translation": "……밀피……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "002",
        "face": "048,0,0,0",
        "voice": "GAE26014,3"
      },
      "original": "あの……出撃命令をください、マイヤーズ司令。\n",
      "translation": "저기…… 출격 명령을 내려주세요, 마이어스\n사령관님.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0018",
      "channel": 1,
      "context": {
        "voice": "GAE26014,3",
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "087,0,0,0",
        "voice": "GAE26015,3"
      },
      "original": "行きましょ、タクト！\nアタシのことなら心配ないわ！\n",
      "translation": "가자, 택트! 내 걱정은 안 해도 돼!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "062,0,0,0",
        "voice": "GAE26016,3"
      },
      "original": "なんたって、昨日タクトから、元気をもらったん\nだもん！\n",
      "translation": "그치만 말이야, 어제 택트한테서 기운을 얻었\n는걸!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0021",
      "channel": 1,
      "context": {
        "face": "057,0,0,0",
        "voice": "GAE26017,3",
        "speaker": "002"
      },
      "original": "え？\nそれって何のこと？\n",
      "translation": "에? 그게 무슨 소리야?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "089,0,0,0",
        "voice": "GAE26018,3"
      },
      "original": "ウフフフ……あのね、実は……。\n",
      "translation": "우후후후…… 있잖아, 사실은……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0023",
      "channel": 1,
      "context": {
        "voice": "GAE26018,3",
        "speaker": "001",
        "face": "007,0,0,0"
      },
      "original": "わーっ！\nその話は、戦いが終わってからということで！\n",
      "translation": "와아-! 그 이야기는, 싸움이 끝나고 나서 하는\n걸로!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0024",
      "channel": 1,
      "context": {
        "voice": "GAE26019,3",
        "speaker": "003",
        "face": "085,0,0,0"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0025",
      "channel": 1,
      "context": {
        "face": "048,0,0,0",
        "voice": "GAE26020,3",
        "speaker": "002"
      },
      "original": "あれ？\nランファ、どうしたの？\n元気ないみたいだけど……。\n",
      "translation": "어라? 란파, 왜 그래? 기운이 없는 것 같은\n데… ….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "068,0,0,0",
        "voice": "GAE26021,3"
      },
      "original": "あ……。\nううん、何でもないわ。\n",
      "translation": "아…… 아니, 아무것도 아니야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GAE26021,3"
      },
      "original": "ランファ……。\n",
      "translation": "란파……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0028",
      "channel": 1,
      "context": {
        "face": "064,0,0,0",
        "voice": "GAE26022,3",
        "speaker": "003"
      },
      "original": "行きましょ……マイヤーズ司令。\n",
      "translation": "가시죠…… 마이어스 사령관님.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GAE26022,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0030",
      "channel": 1,
      "context": {
        "face": "101,0,0,0",
        "voice": "GAE26023,3",
        "speaker": "004"
      },
      "original": "タクトさん……。\n",
      "translation": "택트 씨……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0031",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GAE26023,3"
      },
      "original": "ミント、きびしい戦いになると思うけど……。\n",
      "translation": "민트, 힘든 싸움이 될 것 같지만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0032",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "122,0,0,0",
        "voice": "GAE26024,3"
      },
      "original": "おっしゃらなくても、わかっていますわ。\n私ならご心配いりません。\n",
      "translation": "말씀하시지 않아도 알고 있어요. 저라면\n걱정하실 것 없답니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAE26024,3"
      },
      "original": "……そうだな。\nそれじゃ、行こうか。\n",
      "translation": "……그렇군. 그럼, 가볼까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0034",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "103,0,0,0",
        "voice": "GAE26025,3"
      },
      "original": "はい！\n",
      "translation": "네!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0035",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "105,0,0,0",
        "voice": "GAE26026,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0036",
      "channel": 1,
      "context": {
        "voice": "GAE26027,3",
        "speaker": "006",
        "face": "181,0,0,0"
      },
      "original": "……ミントさん、ご気分でも悪いのですか……？\n",
      "translation": "……민트 씨, 몸 상태라도 안 좋으신가요……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0037",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "104,0,0,0",
        "voice": "GAE26028,3"
      },
      "original": "あ……。\nいえ、何でもありませんわ。\n",
      "translation": "아…… 아니에요, 아무것도 아니랍니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0038",
      "channel": 1,
      "context": {
        "face": "004,0,0,0",
        "voice": "GAE26028,3",
        "speaker": "001"
      },
      "original": "……ミント……。\n",
      "translation": "……민트……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0039",
      "channel": 1,
      "context": {
        "face": "103,0,0,0",
        "speaker": "004",
        "voice": "GAE26029,3"
      },
      "original": "大丈夫ですわ。\n出撃命令をください、マイヤーズ司令。\n",
      "translation": "괜찮아요. 출격 명령을 내려주세요, 마이어스\n사령관님.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0040",
      "channel": 1,
      "context": {
        "voice": "GAE26029,3",
        "speaker": "001",
        "face": "004,0,0,0"
      },
      "original": "……わかった。\n",
      "translation": "……알았다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0041",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "164,0,0,0",
        "voice": "GAE26030,3"
      },
      "original": "タクトの指揮を受けるのも、今度こそ最後になる\nわけか。\n何だか、ちょいと残念ではあるね。\n",
      "translation": "택트의 지휘를 받는 것도, 이번이 마지막인가.\n왠지 좀 아쉽네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0042",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "008,0,0,0",
        "voice": "GAE26030,3"
      },
      "original": "フォルテ……。\n",
      "translation": "포르테……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0043",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "142,0,0,0",
        "voice": "GAE26031,3"
      },
      "original": "あはは、冗談だよ。\nタクトも、気を抜くんじゃないよ？\n最後の大勝負なんだから。\n",
      "translation": "아하하, 농담이야. 택트도 방심하지 마?\n마지막 승부니까 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0044",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAE26031,3"
      },
      "original": "ああ、フォルテもな。\n",
      "translation": "그래, 포르테 너도 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0045",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "146,0,0,0",
        "voice": "GAE26032,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0046",
      "channel": 1,
      "context": {
        "speaker": "004",
        "face": "104,0,0,0",
        "voice": "GAE26033,3"
      },
      "original": "フォルテさん、どうかなさいましたの？\n",
      "translation": "포르테 씨, 왜 그러시나요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0047",
      "channel": 1,
      "context": {
        "face": "144,0,0,0",
        "voice": "GAE26034,3",
        "speaker": "005"
      },
      "original": "あ、いや……。\n何でもない。\n",
      "translation": "아, 아니…… 아무것도 아냐.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0048",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GAE26034,3"
      },
      "original": "……フォルテ……。\n",
      "translation": "……포르테……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0049",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "173,0,0,0",
        "voice": "GAE26035,3"
      },
      "original": "あたしに話しかけるんじゃないよ。\n早く命令しとくれ、司令官どの。\n",
      "translation": "나한테 말 걸지 마. 빨리 명령이나 내리라고,\n사령관님.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0050",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GAE26035,3"
      },
      "original": "あ、ああ……。\n",
      "translation": "아, 아아……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0051",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,0,0",
        "voice": "GAE26036,3"
      },
      "original": "これで終わりにしましょう……。\nタクトさんのお役に立てるよう、がんばります。\n",
      "translation": "이것으로 끝내도록 하죠…… 택트 씨에게\n도움이 될 수 있도록, 노력하겠습니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0052",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "voice": "GAE26036,3",
        "speaker": "001"
      },
      "original": "ああ、よろしく頼む。\nだけど、無理はするなよ？\n",
      "translation": "아아, 잘 부탁한다. 하지만, 무리는 하지 마?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0053",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,0,0",
        "voice": "GAE26037,3"
      },
      "original": "はい……。\nご命令をお願いします。\n",
      "translation": "네…… 명령을 내려주세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0054",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GAE26037,3"
      },
      "original": "うん。\n行こう、ヴァニラ。\n",
      "translation": "응. 가자, 바닐라.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0055",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "182,0,0,0",
        "voice": "GAE26038,3"
      },
      "original": "…………。\n",
      "translation": "…………\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0056",
      "channel": 1,
      "context": {
        "speaker": "005",
        "face": "146,0,0,0",
        "voice": "GAE26039,3"
      },
      "original": "ヴァニラ、どうしたんだい？\nなんか、さっきからヘンだよ？\n",
      "translation": "바닐라, 왜 그래? 왠지 아까부터 이상해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0057",
      "channel": 1,
      "context": {
        "face": "183,0,0,0",
        "voice": "GAE26040,3",
        "speaker": "006"
      },
      "original": "……いえ、何でもありません……。\n",
      "translation": "……아니요, 아무것도 아닙니다……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0058",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GAE26040,3"
      },
      "original": "……ヴァニラ……。\n",
      "translation": "……바닐라……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0059",
      "channel": 1,
      "context": {
        "speaker": "006",
        "face": "181,0,0,0",
        "voice": "GAE26041,3"
      },
      "original": "……マイヤーズ司令、出撃命令を……。\n",
      "translation": "……마이어스 사령관, 출격 명령을……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0060",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,0,0",
        "voice": "GAE26041,3"
      },
      "original": "あ……ああ……。\n",
      "translation": "아…… 아아……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0061",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "011,0,0,0",
        "voice": "GAE26041,3"
      },
      "original": "エンジェル隊、出撃！\n",
      "translation": "엔젤대, 출격!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0062",
      "channel": 1,
      "context": {
        "speaker": "099",
        "face": "0,0,0,0",
        "voice": "GAE26042,3"
      },
      "original": "了解！\n",
      "translation": "네！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0063",
      "channel": 1,
      "context": {
        "face": "501,0,0,0",
        "speaker": "017",
        "voice": "GAE26043,3"
      },
      "original": "司令！\n敵の旗艦から通信です！\n",
      "translation": "사령관님! 적의 기함으로부터 통신입니다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0064",
      "channel": 1,
      "context": {
        "face": "011,0,0,0",
        "voice": "GAE26043,3",
        "speaker": "001"
      },
      "original": "エオニアから！？\n……よし、つないでくれ。\n",
      "translation": "에오니아에서!? ……좋아, 연결해 줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0065",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "311,0,0,0",
        "voice": "GAE26044,3"
      },
      "original": "……まだ抵抗を続ける気かね？\nエルシオールとエンジェル隊の諸君。\n",
      "translation": "……아직 저항을 계속할 셈인가? 에르시올과\n엔젤대 여러분.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0066",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "011,0,0,0",
        "voice": "GAE26044,3"
      },
      "original": "ああ、そのつもりだとも。\nお前と『黒き月』を打ち倒すまで！\n",
      "translation": "아아, 그럴 생각이다. 너와 『흑색 달』을\n쓰러뜨릴 때까지!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0067",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "311,0,0,0",
        "voice": "GAE26045,3"
      },
      "original": "こちらの力は、十分わかっているはずだろう。\n勝てると思っているのか？\n",
      "translation": "이쪽의 힘은 충분히 알고 있을 텐데. 이길 수\n있다고 생각하는 건가?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0068",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAE26045,3"
      },
      "original": "やってみなくちゃ、わからないだろ？\n",
      "translation": "해보기 전에는 모르는 법이잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0069",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "voice": "GAE26045,3",
        "speaker": "001"
      },
      "original": "言っておくが、エルシオールも紋章機も、『白き\n月』で強化してもらったんだ。\n少なくとも、負ける気はしないね。\n",
      "translation": "말해두겠는데, 에르시올도 문장기도 『백색\n달』로 강화받았어. 적어도, 질 것 같지는\n않네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0070",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "313,0,0,0",
        "voice": "GAE26046,3"
      },
      "original": "なに……？\n",
      "translation": "뭐라고……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0071",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "315,0,0,0",
        "voice": "GAE26047,3"
      },
      "original": "おのれ、シャトヤーン……。\n５年前も今回も、私のことは拒絶しておきながら、\nなぜこの者たちには『白き月』の技術を与える！？\n",
      "translation": "이놈, 샤토얀…… 5년 전에도 이번에도, 나를\n거절하면서, 왜 이 자들에게는 『백색 달』의\n기술을 주는 거지!?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0072",
      "channel": 1,
      "context": {
        "speaker": "010",
        "face": "268,0,0,0",
        "voice": "GAE26048,3"
      },
      "original": "私が与えたのではありません。\n彼らは、ロストテクノロジーに選ばれたのです。\n",
      "translation": "내가 준 것이 아닙니다. 그들은, 로스트\n테크놀로지에 선택받은 것입니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0073",
      "channel": 1,
      "context": {
        "face": "006,0,0,0",
        "voice": "GAE26048,3",
        "speaker": "001"
      },
      "original": "シャトヤーン様……！\n",
      "translation": "샤토얀 님……!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0074",
      "channel": 1,
      "context": {
        "speaker": "010",
        "face": "266,263,0,273",
        "voice": "GAE26049,3"
      },
      "original": "エンジェル隊は、『白き月』のロストテクノロジー\nの結晶である紋章機に選ばれたパイロットたち。\n",
      "translation": "엔젤대는, 『백색 달』의 로스트 테크놀로지\n의 결정인 문장기에 선택된 파일럿들.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0075",
      "channel": 1,
      "context": {
        "face": "266,263,0,273",
        "voice": "GAE26050,3",
        "speaker": "010"
      },
      "original": "そして、マイヤーズ司令は、エンジェル隊がその\n翼をゆだねた人物。\n",
      "translation": "그리고, 마이어스 사령관은, 엔젤대가 그\n날개를 맡긴 인물.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0076",
      "channel": 1,
      "context": {
        "face": "266,263,0,273",
        "speaker": "010",
        "voice": "GAE26051,3"
      },
      "original": "その人々を、『白き月』を預かる私が信頼するの\nは当然のことです。\n",
      "translation": "그 사람들을, 『백색 달』을 맡고 있는 내가\n신뢰하는 것은 당연한 일입니다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0077",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "314,263,0,273",
        "voice": "GAE26052,3"
      },
      "original": "お前たちは、何もわかっていない。\nロストテクノロジーには、もっと有効な使い道が\nあるのだ。\n",
      "translation": "너희들은, 아무것도 모르고 있다. 로스트\n테크놀로지에는, 더 유효한 사용처가 있다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0078",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "312,0,0,0",
        "voice": "GAE26053,3"
      },
      "original": "私は、かねがね思っていた……。\nすぐれたロストテクノロジーの力を、なぜ皇国の\n外に向けて使わないのかと。\n",
      "translation": "나는, 전부터 생각하고 있었다…… 뛰어난\n로스트 테크놀로지의 힘을, 왜 황국의 밖으로\n사용하지 않는가 하고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0079",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "312,0,0,0",
        "voice": "GAE26054,3"
      },
      "original": "トランスバール皇国が現在の領域を形作って以来、\n歴代の皇王たちはその維持につとめるばかりで、\nそれ以上に版図を広げようとはしなかった。\n",
      "translation": "트랜스벌 황국이 현재의 영역을 형성한 이래,\n역대 황왕들은 그 유지에만 힘써왔을 뿐, 그\n이상으로 판도를 넓히려 하지 않았다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0080",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "315,0,0,0",
        "voice": "GAE26055,3"
      },
      "original": "私には、それが歯がゆかった。\n皇国の領域を広げれば、さらなる富と栄華が手に\n入るものを。\n",
      "translation": "내게는, 그것이 답답했다. 황국의 영역을\n넓혔다면, 더욱한 부와 영화를 손에 넣었을\n것을.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0081",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "315,0,0,0",
        "voice": "GAE26056,3"
      },
      "original": "『白き月』のロストテクノロジーを使えば、それ\n　はいつでも実現できるはずだった。\n　数百年もの時を、ムダにしてきたようなものだ！\n",
      "translation": "『백색 달』의 로스트 테크놀로지를 썼다면\n언제든 실현할 수 있었을 터였다. 수백 년을\n헛되이 보낸 셈이다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0082",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "316,0,0,0",
        "voice": "GAE26057,3"
      },
      "original": "５年前も、その考えを皆に理解させようとしたの\nだが……。\nその結果、待っていたのは辺境への追放だ。\n",
      "translation": "5년 전에도, 그 생각을 모두에게 이해시키려\n했으나 …… 그 결과, 기다리고 있던 것은\n변방으로의 추방이다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0083",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "312,0,286,0",
        "voice": "GAE26058,3"
      },
      "original": "しかし、運命とは皮肉なものだ。\n名もなき星々をさまよううちに、私は『黒き月』\nを見つけたのだからな。\n",
      "translation": "하지만, 운명이란 아이러니한 법이지. 이름\n없는 별들을 방황하던 중에, 나는 『흑색 달』\n을 발견했으니까 말이다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0084",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "312,0,286,0",
        "voice": "GAE26059,3"
      },
      "original": "この『黒き月』こそが、何よりの証拠だ。\n皇国の外には、まだ数多くのロストテクノロジー\nが眠っている……私はそう確信を得た。\n",
      "translation": "이 『흑색 달』이 무엇보다 확실한 증거다.\n황국 밖에는 아직 수많은 로스트 테크놀로지가\n잠들어 있다…… 나는 확신했다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0085",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "312,0,288,0",
        "voice": "GAE26060,3"
      },
      "original": "『白き月』と『黒き月』……ふたつの月の技術を\n　もってすれば、その探索はさらに容易となる。\n　皇国は、飛躍的な発展をとげられるのだ。\n",
      "translation": "『백색 달』과 『흑색 달』…… 두 달의 기술을\n가지고 있다면, 그 탐색은 더욱 용이해진다. 황\n국은, 비약적인 발전을 이룰 수 있는 것이다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0086",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "312,0,291,0",
        "voice": "GAE26061,3"
      },
      "original": "そう……かつて銀河に覇を誇っていた、旧文明の\n再興すらも可能に違いない。\nロストテクノロジーの力さえあれば！\n",
      "translation": "그래…… 과거 은하에 패도를 자랑하던,\n구문명의 재건조차도 가능함이 틀림없다.\n로스트 테크놀로지의 힘만 있다면!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0087",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "003,0,0,0",
        "voice": "GAE26061,3"
      },
      "original": "……それがお前の理想か、エオニア。\nなるほど、ご立派な考えだ。\n",
      "translation": "……그것이 네 이상인가, 에오니아. 과연,\n훌륭한 생각이군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0088",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "005,0,0,0",
        "voice": "GAE26061,3"
      },
      "original": "だが、そんな身勝手な理想を、ほかの人々にまで\n押しつけるな！\n",
      "translation": "하지만, 그런 이기적인 이상을, 다른 사람들에\n게까지 강요하지 마라!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0089",
      "channel": 1,
      "context": {
        "voice": "GAE26061,3",
        "speaker": "001",
        "face": "005,0,0,0"
      },
      "original": "武力で実現させる理想など、何の価値もない。\n力ずくでことを成しとげようとする人間に、誰が\n従うものか！\n",
      "translation": "무력으로 실현시키는 이상 따위, 아무런\n가치도 없다. 힘으로 일을 성취하려는 인간에\n게 , 누가 따르겠느냐!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0090",
      "channel": 1,
      "context": {
        "face": "314,0,0,0",
        "voice": "GAE26062,3",
        "speaker": "012"
      },
      "original": "ここまで言っても、まだ理解できないのか！\nトランスバール皇国は、今こそ永遠の楽園として\n生まれ変われるのだ！\n",
      "translation": "여기까지 말해도, 아직 이해하지 못하는 거냐!\n트랜스벌 황국은, 지금이야말로 영원한\n낙원으로서 다시 태어날 수 있는 것이다!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0091",
      "channel": 1,
      "context": {
        "speaker": "011",
        "face": "283,0,0,0",
        "voice": "GAE26063,3"
      },
      "original": "住む者のいない、廃墟の楽園として……か？\n",
      "translation": "사는 이가 없는, 폐허의 낙원으로서……\n말인가?\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0092",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "313,0,0,0",
        "voice": "GAE26064,3"
      },
      "original": "何だと……！？\n",
      "translation": "뭐라고……!?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0093",
      "channel": 1,
      "context": {
        "voice": "GAE26065,3",
        "speaker": "011",
        "face": "283,0,0,0"
      },
      "original": "いいかげんに目を覚ませ。\n貴様のしていることは、理想に名を借りた、過去\nへの復しゅうにすぎない！\n",
      "translation": "적당히 정신 차려라. 네놈이 하고 있는 짓은,\n이상이라는 이름을 빌린, 과거 에 대한 복수에\n불과하다!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0094",
      "channel": 1,
      "context": {
        "face": "283,0,0,0",
        "voice": "GAE26066,3",
        "speaker": "011"
      },
      "original": "貴様が願うのは、皇国の人々の幸せではない。\n人々の幸せを思わぬ貴様に、皇王を名乗る資格は\nない！\n",
      "translation": "네가 바라는 것은, 황국 사람들의 행복이\n아니다. 사람들의 행복을 생각지 않는 네놈에\n게 , 황왕을 자처할 자격은 없다!\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0095",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "011,0,0,0",
        "voice": "GAE26066,3"
      },
      "original": "そのとおりだ！\nエオニア、お前のようなやつに皇国の……みんな\nの未来は渡せない！\n",
      "translation": "그 말이 맞다! 에오니아, 너 같은 녀석에게\n황국의…… 모두 의 미래를 맡길 순 없다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0096",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "312,0,286,0",
        "voice": "GAE26067,3"
      },
      "original": "ふふふ……それが答えか。\nいいだろう。\n",
      "translation": "후후후…… 그것이 답인가. 좋다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0097",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "312,0,286,0",
        "voice": "GAE26068,3"
      },
      "original": "力あるものが未来を作る。\n力あるものだけが理想を成し得る。\n力あるものこそが、後の世に正義と呼ばれるのだ。\n",
      "translation": "힘 있는 자가 미래를 만든다. 힘 있는 자만이\n이상을 이룰 수 있다. 힘 있는 자야말로,\n후세에 정의라 불리는 것이다.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0098",
      "channel": 1,
      "context": {
        "speaker": "012",
        "face": "312,0,291,0",
        "voice": "GAE26069,3"
      },
      "original": "我が名はエオニア！\nトランスバールの歴史の前に我が力を示し、その\n名を永遠に刻み込んでくれようぞ！\n",
      "translation": "내 이름은 에오니아! 트랜스벌의 역사 앞에\n나의 힘을 보여주고, 그 이름을 영원히\n새겨주마!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0099",
      "channel": 1,
      "context": {
        "speaker": "017",
        "face": "501,0,0,0",
        "voice": "GAE26070,3"
      },
      "original": "通信、切れました。\n",
      "translation": "통신, 끊겼습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0100",
      "channel": 1,
      "context": {
        "face": "491,0,0,0",
        "voice": "GAE26071,3",
        "speaker": "016"
      },
      "original": "エオニア軍、移動を開始しました！\n",
      "translation": "에오니아군, 이동을 개시했습니다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0101",
      "channel": 1,
      "context": {
        "face": "283,0,0,0",
        "voice": "GAE26072,3",
        "speaker": "011"
      },
      "original": "いよいよだな。\n皇国の命運は、この一戦にかかっている。\n頼むぞ、マイヤーズ。\n",
      "translation": "드디어 시작이로군. 황국의 운명은 이 일전에\n달려 있다. 부탁하네, 마이어스.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0102",
      "channel": 1,
      "context": {
        "voice": "GAE26072,3",
        "speaker": "001",
        "face": "003,0,0,0"
      },
      "original": "はい、シヴァ皇子。\n皇子とシャトヤーン様のいらっしゃる『白き月』\nには、指一本触れさせませんよ。\n",
      "translation": "예, 시바 황자님. 황자님과 샤토얀 님이\n계시는 『백색 달』 에는 손가락 하나 대지\n못하게 하겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0103",
      "channel": 1,
      "context": {
        "voice": "GAE26073,3",
        "speaker": "010",
        "face": "268,0,0,0"
      },
      "original": "私にできることは、ここまでです。\nどうか、無事に戻ってきてください。\n",
      "translation": "제가 할 수 있는 일은 여기까지입니다. 부디,\n무사히 돌아와 주세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0104",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAE26073,3"
      },
      "original": "任せてください、シャトヤーン様。\n強化されたエルシオールと紋章機があれば、何が\nあっても大丈夫ですよ。\n",
      "translation": "맡겨 주십시오, 샤토얀 님. 강화된 에르시올과\n문장기가 있다면, 어떤 일이 있어도 괜찮습니\n다 .\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0105",
      "channel": 1,
      "context": {
        "speaker": "010",
        "face": "266,0,0,0",
        "voice": "GAE26074,3"
      },
      "original": "よろしくお願いします、マイヤーズ司令。\nご武運を……。\n",
      "translation": "잘 부탁드립니다, 마이어스 사령관님. 무운\n을… ….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0106",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GAE26074,3"
      },
      "original": "ありがとうございます。\n見ていてください、オレたちの戦いを。\n",
      "translation": "감사합니다. 지켜봐 주십시오, 우리들의\n싸움을.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000b4800:dialogue:0107",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "011,0,0,0",
        "voice": "GAE26074,3"
      },
      "original": "行くぞ、みんな。\n戦闘開始だ！！\n",
      "translation": "가자, 모두들. 전투 개시다!!\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
