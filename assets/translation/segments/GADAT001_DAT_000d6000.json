{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000d6000.txt",
    "encoding": "cp932",
    "sha256": "8b210530c0ec49138c9fae4c992d0f035f98070d87cdc34e5a11bfc8596a07b5",
    "dialogue_count": 25
  },
  "units": [
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "024",
        "face": "581,0,0,0",
        "voice": "GA706001,3"
      },
      "original": "あら、司令さん。\nいらっしゃい。\n",
      "translation": "어라, 사령관 씨. 어서 오세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA706001,3"
      },
      "original": "どうも、こんにちは。\nデラックス定食ひとつください。\n",
      "translation": "아, 안녕하세요. 데럭스 정식 하나 주세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "024",
        "face": "581,0,0,0",
        "voice": "GA706002,3"
      },
      "original": "おや、珍しいね。\n司令さんが、デラックス定食頼むなんて、初めて\nじゃないかい？\n",
      "translation": "어머, 드문 일이네. 사령관 씨가 데럭스 정식을\n주문하다니, 처음 아닌가?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA706002,3"
      },
      "original": "そうでしたっけ？\n……って、よく覚えてますね。\n",
      "translation": "그랬던가요? ……그나저나, 잘 기억하고\n계시네요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "024",
        "face": "582,0,0,0",
        "voice": "GA706003,3"
      },
      "original": "そりゃそうさ。\nあたしゃ、乗組員ひとりひとりの好みを全部覚え\nてるからね。\n",
      "translation": "당연하지. 난 승무원 한 명 한 명의 취향을\n전부 기억하고 있으니까 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA706003,3"
      },
      "original": "そ、そうだったんですか。\nさすがプロというか……。\n",
      "translation": "그, 그랬던 건가요. 역시 프로라고 해야\n할지……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "024",
        "face": "581,0,0,0",
        "voice": "GA706004,3"
      },
      "original": "察するところ、任務を達成できた自分へのお祝い\nかい？\n",
      "translation": "짐작건대, 임무를 달성한 자신에게 주는 축하\n인가?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA706004,3"
      },
      "original": "まぁ、それもありますね。\n後は……。\n",
      "translation": "뭐, 그것도 있네요. 그리고……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA706004,3"
      },
      "original": "もうすぐ、エルシオールから配置換えになるんで、\nその前に、ここの食堂の味を満喫しておこうかな\nと思って。\n",
      "translation": "이제 곧 에르시올에서 보직 변경이 돼서,\n그전에 여기 식당의 맛을 만끽해 둘까 해서요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "024",
        "face": "583,0,0,0",
        "voice": "GA706005,3"
      },
      "original": "えっ？\n司令さん、エルシオールを降りちまうのかい？\nさびしくなるねぇ。\n",
      "translation": "엣? 사령관 씨, 에르시올에서 내리는 건가?\n쓸쓸해지겠네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA706005,3"
      },
      "original": "まぁ、オレは臨時の代役みたいなもんでしたし。\nおばさん、今までありがとうございました。\n",
      "translation": "뭐, 저는 임시 대역 같은 거였으니까요.\n아줌마, 지금까지 감사했습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "024",
        "face": "582,0,0,0",
        "voice": "GA706006,3"
      },
      "original": "なに言ってんだい。\nお礼を言うのは、あたしの方だよ。\n司令さん、あんたも元気でね。\n",
      "translation": "무슨 소리를 하는 거야. 고맙다는 말은 내가\n해야지. 사령관 씨, 당신도 건강하게 잘\n지내게나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0013",
      "channel": 1,
      "context": {
        "face": "582,0,0,0",
        "speaker": "024",
        "voice": "GA706007,3"
      },
      "original": "そうだ！\n今までのお礼と、せん別を兼ねて、今日は特盛り\nにしてあげるよ。\n",
      "translation": "맞다! 지금까지의 감사 인사와 송별을 겸해서,\n오늘은 특대 사이즈로 줄게.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0014",
      "channel": 1,
      "context": {
        "voice": "GA706007,3",
        "speaker": "001",
        "face": "002,0,0,0"
      },
      "original": "え、いいんですか？\nそれじゃ、遠慮なくいただきまーす！\n",
      "translation": "에, 그래도 되나요? 그럼 사양 않고 잘\n먹겠습니다!\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "025",
        "face": "561,0,0,0",
        "voice": "GA707001,3"
      },
      "original": "いらっしゃいませ～。\n",
      "translation": "어서 오세요～.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0016",
      "channel": 1,
      "context": {
        "face": "001,0,0,0",
        "speaker": "001",
        "voice": "GA707001,3"
      },
      "original": "ああ、買い物に来たわけじゃないんだ。\n今日は、お別れのあいさつをしようかと思ってね。\n",
      "translation": "아니, 쇼핑을 하러 온 건 아니야. 오늘은 작별\n인사를 하러 왔지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "025",
        "face": "561,0,0,0",
        "voice": "GA707002,3"
      },
      "original": "お別れですか～？\nマイヤーズ司令、どこかへ行かれるんですか～？\n",
      "translation": "작별인가요～? 마이어스 사령관님, 어디론가\n가시는 건가요～?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,0,0",
        "voice": "GA707002,3"
      },
      "original": "うん、配置換えでね。\nもうじき、この艦を降りることになる。\n",
      "translation": "응, 보직 변경 때문에 말이야. 이제 곧 이\n함선을 떠나게 돼.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "025",
        "face": "561,0,0,0",
        "voice": "GA707003,3"
      },
      "original": "そうでしたか～。\nでも～、出会いがあれば別れもあります～。\n",
      "translation": "그랬군요～. 하지만～ 만남이 있으면 이별도\n있는 법이죠～.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "025",
        "face": "561,0,0,0",
        "voice": "GA707004,3"
      },
      "original": "ぼくたちの商売も～、ご来店いただいたお客様と\nの一期一会だと思っています～。\nだから、いつもどおりにお別れするです～。\n",
      "translation": "저희 장사도～ 방문해 주신 손님과의\n일기일회라고 생각하고 있어요～. 그러니까,\n평소처럼 작별 인사를 할게요～.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "002,0,0,0",
        "voice": "GA707004,3"
      },
      "original": "そうだね……ありがとう。\n君も元気でね。\n",
      "translation": "그렇네…… 고마워. 너도 건강하게 잘 지내렴.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "025",
        "face": "561,0,0,0",
        "voice": "GA707005,3"
      },
      "original": "はい～。\nいつも笑顔で元気にサービスが～、うちのモットー\nですから～。\n",
      "translation": "네～. 언제나 웃으며 활기차게 서비스하는 게～\n저희 모토니까요～.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0023",
      "channel": 1,
      "context": {
        "speaker": "025",
        "face": "561,0,0,0",
        "voice": "GA707006,3"
      },
      "original": "司令の新たな門出を祝して～、これから転任の日\nまで『さよならマイヤーズ司令キャンペーン』を\n実施させていただきます～。\n",
      "translation": "사령관님의 새로운 출발을 축하하며～, 앞으로\n전임하는 날까지 『안녕히 계세요 마이어스\n사령관 캠페인』을 실시하겠습니다～.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,0,0",
        "voice": "GA707006,3"
      },
      "original": "あ、ありがとう……。\n",
      "translation": "고, 고마워……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000d6000:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "025",
        "face": "561,0,0,0",
        "voice": "GA707007,3"
      },
      "original": "ありがとうございました～。\nまたのご来店をお待ちしてます～。\n",
      "translation": "감사했습니다～. 다시 방문해 주시길 기다리고\n있겠습니다～.\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
