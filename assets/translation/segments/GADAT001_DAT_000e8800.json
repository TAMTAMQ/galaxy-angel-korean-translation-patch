{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "GADAT001_DAT_000e8800.txt",
    "encoding": "cp932",
    "sha256": "7e01160ea1af1f209b2a4862512b89d8144e64069fa10588c56ea4e36aecb3ed",
    "dialogue_count": 31
  },
  "units": [
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "076,0,082,0",
        "voice": "GA729001,3"
      },
      "original": "ほら、タクト。\nアタシたちも行きましょ。\n",
      "translation": "자, 택트. 우리도 가자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "008,0,082,0",
        "voice": "GA729001,3"
      },
      "original": "うん。\nだけど、その前に……。\n",
      "translation": "응. 하지만, 그 전에……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "076,0,085,0",
        "voice": "GA729002,3"
      },
      "original": "なによ？\n",
      "translation": "왜 그래?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "008,0,085,0",
        "voice": "GA729002,3"
      },
      "original": "さっき言いかけた続きだけど……。\nその、とても……。\n",
      "translation": "아까 하려던 말의 뒷부분인데…… 그게,\n아주……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "076,0,081,0",
        "voice": "GA729003,3"
      },
      "original": "とても？\n",
      "translation": "아주?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,081,0",
        "voice": "GA729003,3"
      },
      "original": "とても……きれいだよ。\n",
      "translation": "아주…… 예뻐.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "076,0,083,0",
        "voice": "GA729004,3"
      },
      "original": "え……？\n",
      "translation": "에……?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "076,0,086,0",
        "voice": "GA729005,3"
      },
      "original": "……バ、バカねぇ。\nもっと気の利いたセリフのひとつも言えないの？\n",
      "translation": "……바, 바보 같긴. 좀 더 센스 있는 대사\n하나쯤은 못 해?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "012,0,086,0",
        "voice": "GA729005,3"
      },
      "original": "そ、そういうもんかな？\n思ったことを素直に言ったんだけど。\n",
      "translation": "그, 그런 건가? 생각한 걸 솔직하게 말했을\n뿐인데.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "076,0,086,0",
        "voice": "GA729006,3"
      },
      "original": "そうよ。\nせっかくの華やかな場所なんだから。\nそれにふさわしい言葉ってモンがあるでしょ？\n",
      "translation": "그래. 모처럼 화려한 장소니까. 그에 어울리는\n말이 있잖아?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "004,0,086,0",
        "voice": "GA729006,3"
      },
      "original": "うーん、そうか。\n何か考えてくればよかったかな。\n",
      "translation": "으음, 그렇네. 뭔가 생각해 올 걸 그랬나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "076,0,081,0",
        "voice": "GA729007,3"
      },
      "original": "……なーんて。\n面と向かって言われると、やっぱり照れるわね。\n",
      "translation": "……라니깐. 정면으로 들으니까 역시 쑥스럽네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,081,0",
        "voice": "GA729007,3"
      },
      "original": "え？\n",
      "translation": "에?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "076,0,083,0",
        "voice": "GA729008,3"
      },
      "original": "それじゃあ、アタシも思ったことを素直に言って\nみようかな。\n",
      "translation": "그럼, 나도 생각한 걸 솔직하게 말해볼까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "076,0,082,0",
        "voice": "GA729009,3"
      },
      "original": "……ありがと、タクト。\nうれしいわ。\n",
      "translation": "……고마워, 택트. 기뻐.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "008,0,082,0",
        "voice": "GA729009,3"
      },
      "original": "ランファ……。\n",
      "translation": "란파……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "006,0,0,0",
        "voice": "GA729009,3"
      },
      "original": "ん？\nこの音楽は……。\n",
      "translation": "응? 이 음악은……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "076,0,085,0",
        "voice": "GA729010,3"
      },
      "original": "あ、もう始まっちゃったみたいね。\n",
      "translation": "아, 벌써 시작된 모양이네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "001,0,085,0",
        "voice": "GA729010,3"
      },
      "original": "本当だ。\nみんな踊り始めたな。\nオレたちも行こうか。\n",
      "translation": "정말이다. 다들 춤추기 시작했어. 우리도 갈까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0020",
      "channel": 1,
      "context": {
        "voice": "GA729011,3",
        "speaker": "060",
        "face": "726,0,0,0"
      },
      "original": "失礼、エンジェル隊のお嬢さん。\n次の曲は、先約がおありですかな？\n",
      "translation": "실례합니다, 엔젤대 아가씨. 다음 곡은 선약이\n있으신지요?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "076,0,085,0",
        "voice": "GA729012,3"
      },
      "original": "え？\n別に、そういうわけじゃないけど……。\n",
      "translation": "에? 딱히 그런 건 아니지만……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0022",
      "channel": 1,
      "context": {
        "voice": "GA729013,3",
        "speaker": "060",
        "face": "726,0,0,0"
      },
      "original": "それでは、私と踊っていただけないでしょうか。\n",
      "translation": "그렇다면, 저와 춤춰 주시지 않겠습니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0023",
      "channel": 1,
      "context": {
        "face": "076,0,085,0",
        "speaker": "003",
        "voice": "GA729014,3"
      },
      "original": "えぇっ？\nでも、アタシはタクトのパートナーで……。\n",
      "translation": "에엣? 하지만 난 택트의 파트너라서……\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0024",
      "channel": 1,
      "context": {
        "voice": "GA729015,3",
        "speaker": "060",
        "face": "726,0,0,0"
      },
      "original": "それは、ラストダンスのときのことでしょう。\nそのときまでは、うわさに名高いエンジェル隊と\n踊る機会を、我々にも与えてくださいませんか？\n",
      "translation": "그건 라스트 댄스 때의 이야기겠지요. 그때\n전까지는, 소문이 자자한 엔젤대와 춤출\n기회를 저희에게도 주시지 않겠습니까?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0025",
      "channel": 1,
      "context": {
        "face": "076,0,082,0",
        "voice": "GA729016,3",
        "speaker": "003"
      },
      "original": "あ……あら、うわさに名高いだなんて。\nそんな、やーねぇ。\nま、当然だけど？\n",
      "translation": "아…… 어머, 소문이 자자하다니. 그럴\n리가요～. 뭐, 당연한 거지만?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0026",
      "channel": 1,
      "context": {
        "face": "004,0,082,0",
        "voice": "GA729016,3",
        "speaker": "001"
      },
      "original": "おいおい……。\nまぁ、確かにラストダンスまでは、誰とでも踊る\n権利はあるけど。\n",
      "translation": "어이어이…… 뭐, 확실히 라스트 댄스 전까지는\n누구와든 춤출 권리는 있지만 말이야.\n",
      "state": "needs_human",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "060",
        "face": "726,0,0,0",
        "voice": "GA729017,3"
      },
      "original": "それでは、パートナー君にも納得していただいた\nところで……。\n踊っていただけますか、お嬢さん？\n",
      "translation": "그럼, 파트너 군도 납득한 것 같으니…… 춤춰\n주시겠습니까, 아가씨?\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "003",
        "face": "076,0,082,0",
        "voice": "GA729018,3"
      },
      "original": "ふふん、しょうがないわねぇ。\nそこまで言うなら、踊って差し上げてもよくって\nよ？\n",
      "translation": "후훗, 어쩔 수 없네. 그렇게까지 말한다면, 춰\n드려도 괜찮 아,\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0029",
      "channel": 1,
      "context": {
        "face": "012,0,082,0",
        "speaker": "001",
        "voice": "GA729018,3"
      },
      "original": "ラストダンスの時間が近くなったら迎えに行くよ、\nランファ。\n",
      "translation": "라스트 댄스 시간이 가까워지면 데리러 갈게,\n란파.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0030",
      "channel": 1,
      "context": {
        "voice": "GA729019,3",
        "speaker": "003",
        "face": "076,0,081,0"
      },
      "original": "わかったわ。\nじゃあタクト、また後でね～。\n",
      "translation": "알았어. 그럼 택트, 나중에 봐～.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "GADAT001_DAT_000e8800:dialogue:0031",
      "channel": 1,
      "context": {
        "speaker": "001",
        "face": "009,0,0,0",
        "voice": "GA729019,3"
      },
      "original": "ちぇっ、せっかくいいところだったのに。\nそれにしても、やっぱりエンジェル隊は注目され\nているんだなぁ。\n",
      "translation": "쳇, 기껏 좋은 분위기였는데. 그나저나, 역시\n엔젤대는 주목받고 있구나.\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
